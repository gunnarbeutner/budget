@page "/cashflow"
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.WebUtilities
@using System.Globalization
@inject BudgetService BudgetService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IStringLocalizer<Cashflow> L

<PageTitle>@(projectName != null ? L["PageTitle_WithProject", projectName] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <h1>@L["NotFound_Heading"]</h1>
    <p class="text-muted">@L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]</p>
    return;
}

<h1 class="mb-3">@(projectName != null ? L["Heading_Cashflow_WithProject", projectName] : L["Heading_Cashflow"])</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">@L["Label_Year"]</label>
        <select class="form-select" @bind="selectedYear" @bind:after="OnYearChanged">
            @if (availableYears != null)
            {
                foreach (var y in availableYears)
                {
                    <option value="@y">@y</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">@L["Label_BudgetOptional"]</label>
        <select class="form-select" @bind="selectedBudgetId" @bind:after="OnBudgetChanged">
            <option value="0">@L["Option_NoBudget"]</option>
            @if (availableBudgets != null)
            {
                foreach (var budget in availableBudgets)
                {
                    <option value="@budget.Id">@(budget.IsActive ? L["Option_BudgetEntry_Active", budget.Year, budget.Name] : L["Option_BudgetEntry", budget.Year, budget.Name])</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">@L["Label_IncomeProjection"]</label>
        <div class="btn-group d-flex" role="group" aria-label="@L["Aria_IncomeProjectionMode"]">
            <input type="radio" class="btn-check" name="incomeProj" id="incomeProjBudget"
                   checked="@(incomeProjectionMode == "budget")"
                   @onchange="@(() => OnIncomeModeChanged("budget"))" />
            <label class="btn btn-outline-primary" for="incomeProjBudget">@L["Projection_Budget"]</label>

            <input type="radio" class="btn-check" name="incomeProj" id="incomeProjBreakeven"
                   checked="@(incomeProjectionMode == "breakeven")"
                   @onchange="@(() => OnIncomeModeChanged("breakeven"))" />
            <label class="btn btn-outline-primary" for="incomeProjBreakeven">@L["Projection_Breakeven"]</label>

            <input type="radio" class="btn-check" name="incomeProj" id="incomeProjRecent"
                   checked="@(incomeProjectionMode == "recent")"
                   @onchange="@(() => OnIncomeModeChanged("recent"))" />
            <label class="btn btn-outline-primary" for="incomeProjRecent">@L["Projection_LastMonth"]</label>
        </div>
        <small class="form-text text-muted d-block mt-1">
            @(incomeProjectionMode switch
            {
                "budget" => L["Projection_Budget_Help"],
                "recent" => L["Projection_LastMonth_Help"],
                _ => L["Projection_Breakeven_Help"]
            })
        </small>
        <div class="form-check form-switch mt-2 small">
            <input class="form-check-input" type="checkbox" id="balanceFloorEnabled"
                   checked="@balanceFloorEnabled"
                   @onchange="OnBalanceFloorToggleChanged" />
            <label class="form-check-label" for="balanceFloorEnabled">
                @L["BalanceFloor_Label"]
            </label>
            <div class="input-group input-group-sm mt-1" style="max-width: 180px;">
                <span class="input-group-text">€</span>
                <input type="number" class="form-control"
                       step="50"
                       disabled="@(!balanceFloorEnabled)"
                       @bind="balanceFloor" @bind:after="OnBalanceFloorChanged" />
            </div>
            <small class="form-text text-muted d-block mt-1">@L["BalanceFloor_Help"]</small>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@L["Status_Loading"]</span>
        </div>
    </div>
}
else if (incomeCategories.Any() || expenseCategories.Any())
{
    @* Balance & watermarks first: the alerts here ("balance dips below floor on …") are the
       most decision-relevant content; the cashflow bar chart below provides the breakdown
       behind that line. *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Card_AccountBalanceWatermarks", selectedYear]</h5>
                    @if (hasAssignedAccounts && balanceDaily.Length > 0)
                    {
                        <small class="text-muted">
                            @L["Balance_YearMin"] <span class="@(yearMinBalance < 0 ? "text-danger fw-semibold" : "fw-semibold")">@FormatEuro(yearMinBalance)</span>
                            @L["Balance_YearMin_On", FormatMonthDay(new DateTime(selectedYear, 1, 1).AddDays(yearMinDayOfYear - 1))]
                        </small>
                    }
                </div>
                <div class="card-body">
                    @if (!hasAssignedAccounts)
                    {
                        <div class="alert alert-info mb-0 py-2 small">
                            @L["Balance_NoAccountsAssigned_Before"]<a href="/projects/@selectedProjectId">@L["Balance_NoAccountsAssigned_LinkText"]</a>@L["Balance_NoAccountsAssigned_After"]
                        </div>
                    }
                    else if (balanceDaily.Length == 0)
                    {
                        <p class="text-muted mb-0">@L["Balance_NoData"]</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">
                            @L["Balance_StartingBalance_Before"]<strong>@FormatEuro(startingBalance)</strong>@L["Balance_StartingBalance_After"]
                        </p>
                        @if (balanceFloorEnabled && balanceDaily.Length > 0 && yearMinBalance < EffectiveFloor)
                        {
                            var floor = EffectiveFloor;
                            var floorLabel = balanceFloorEnabled && balanceFloor != 0m
                                ? L["Floor_TheXFloor", FormatEuro(balanceFloor)].Value
                                : L["Floor_Zero"].Value;
                            // Year-min covers the whole year; future-min is today onward. The
                            // FutureNegative / CurrentlyNegative alerts talk about an upcoming
                            // low, so they need future-min — otherwise a January dip would
                            // show up as the quoted date in a June-onward alert.
                            var futureMinDate = new DateTime(selectedYear, 1, 1).AddDays(Math.Max(futureMinDayOfYear, 1) - 1);
                            var futureTopUp = floor - futureMinBalance;
                            var yearMinDate = new DateTime(selectedYear, 1, 1).AddDays(yearMinDayOfYear - 1);
                            if (firstFutureNegativeDayOfYear > 0)
                            {
                                var firstFutureDate = new DateTime(selectedYear, 1, 1).AddDays(firstFutureNegativeDayOfYear - 1);
                                <div class="alert alert-danger py-2 small mb-2">
                                    @{
                                        var heading = balanceFloor == 0m
                                            ? L["Alert_FutureNegative_HeadingPart_Zero", FormatMonthDay(firstFutureDate)]
                                            : L["Alert_FutureNegative_HeadingPart_Floor", floorLabel, FormatMonthDay(firstFutureDate)];
                                    }
                                    <strong>@heading</strong>@L["Alert_FutureNegative_BodyPart", FormatEuro(futureMinBalance), FormatMonthDay(futureMinDate), FormatEuro(futureTopUp), FormatMonthDay(firstFutureDate), floorLabel]
                                </div>
                            }
                            else if (currentlyNegative)
                            {
                                <div class="alert alert-danger py-2 small mb-2">
                                    <strong>@L["Alert_CurrentlyNegative_HeadingPart", FormatEuro(currentBalanceForYear)]</strong>@L["Alert_CurrentlyNegative_BodyPart", floorLabel, FormatEuro(futureMinBalance), FormatMonthDay(futureMinDate), FormatEuro(futureTopUp), floorLabel]
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-2 small mb-2">
                                    @L["Alert_PastDip_Before"]<strong>@FormatEuro(yearMinBalance)</strong>@L["Alert_PastDip_After", FormatMonthDay(yearMinDate), FormatEuro(currentBalanceForYear), floorLabel]
                                </div>
                            }
                        }
                        <div style="position: relative; height: 320px;">
                            <canvas id="balanceChart"></canvas>
                        </div>
                        <div class="table-responsive mt-3">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Table_Month"]</th>
                                        <th class="text-end">@L["Table_LowestBalance"]</th>
                                        <th class="text-end">@L["Table_HighestBalance"]</th>
                                        <th class="text-end">@L["Table_MonthEndBalance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var wm in monthlyWatermarks)
                                    {
                                        var rowClass = wm.Low < 0 ? "table-danger" : "";
                                        var lowClass = wm.Low < 0 ? "text-danger fw-semibold" : "";
                                        <tr class="@rowClass">
                                            <td>@(new DateTime(selectedYear, wm.Month, 1).ToString("MMM"))</td>
                                            <td class="text-end @lowClass">@FormatEuro(wm.Low)</td>
                                            <td class="text-end">@FormatEuro(wm.High)</td>
                                            <td class="text-end">@FormatEuro(wm.End)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>@L["Card_MonthlyCashflow", selectedYear]</h5>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 400px; max-height: 600px;">
                        <canvas id="cashflowChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>@L["Card_IncomeContributionCalculator"]</h5>
                </div>
                <div class="card-body">
                    <details class="mb-3">
                        <summary class="text-muted small" style="cursor: pointer;">@L["Calculator_HowItWorks_Summary"]</summary>
                        <div class="text-muted small mt-2">
                            @(incomeProjectionMode switch
                            {
                                "budget" => L["Calculator_HowItWorks_Budget"],
                                "recent" => L["Calculator_HowItWorks_Recent"],
                                _ => L["Calculator_HowItWorks_Breakeven"]
                            })
                        </div>
                    </details>

                    @if (firstProjectedMonth <= 12)
                    {
                        var rangeLabel = $"{new DateTime(selectedYear, firstProjectedMonth, 1):MMMM}–{new DateTime(selectedYear, 12, 1):MMMM}";
                        <div class="alert alert-info py-2 small">
                            @if (incomeProjectionMode == "recent" && recentIncomePerItem != null)
                            {
                                var sourceLabel = new DateTime(recentIncomeSourceMonth.Year, recentIncomeSourceMonth.Month, 1).ToString("MMMM yyyy");
                                <text>@L["Calculator_Range_Recent", rangeLabel, sourceLabel]</text>
                            }
                            else if (incomeProjectionMode == "budget")
                            {
                                <text>@L["Calculator_Range_Budget", rangeLabel]</text>
                            }
                            else
                            {
                                <text>@L["Calculator_Range_Breakeven", rangeLabel]</text>
                            }
                        </div>

                    }

                    @if (rollupCollisions.Any())
                    {
                        <div class="alert alert-warning py-2 small mb-3">
                            @L["Rollup_CollisionWarning"]
                            <ul class="mb-0 mt-1">
                                @foreach (var col in rollupCollisions)
                                {
                                    <li>@($"{(col.ItemType == CategoryItemType.Group ? "Group" : "Category")} #{col.CategoryId}") &mdash; @col.ChildName</li>
                                }
                            </ul>
                        </div>
                    }

                    @{
                        var showOrigin = incomeCategories.Select(c => c.OriginProjectId).Distinct().Count() > 1;
                    }

                    @if (incomeCategories.Any() && incomeProjectionMode == "recent")
                    {
                        var sourceMonthLabel = new DateTime(recentIncomeSourceMonth.Year, recentIncomeSourceMonth.Month, 1).ToString("MMM yyyy");
                        var yearlyIncome = incomeCategories.Sum(c => c.MonthlyAmounts.Sum());
                        var netYearly = yearlyIncome - totalExpenses;
                        var netClass = netYearly >= 0 ? "text-success" : "text-danger";
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>@L["Table_IncomeCategory"]</th>
                                        @if (showOrigin) { <th>@L["Table_Origin"]</th> }
                                        <th class="text-end">@L["Table_SourceMonth", sourceMonthLabel]</th>
                                        <th class="text-end">@L["Table_ProjectedYearly"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var income in incomeCategories)
                                    {
                                        var sourceMonthAmount = recentIncomePerItem?.GetValueOrDefault((income.CategoryId, income.ItemType), 0m) ?? 0m;
                                        var yearly = income.MonthlyAmounts.Sum();
                                        <tr>
                                            <td>@income.CategoryName</td>
                                            @if (showOrigin) { <td><small class="text-muted">@income.OriginProjectName</small></td> }
                                            <td class="text-end">@FormatEuro(sourceMonthAmount)</td>
                                            <td class="text-end">@FormatEuro(yearly)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-primary">
                                        <th colspan="@(showOrigin ? 2 : 1)">@L["Table_TotalIncome"]</th>
                                        <th></th>
                                        <th class="text-end">@FormatEuro(yearlyIncome)</th>
                                    </tr>
                                    <tr>
                                        <th colspan="@(showOrigin ? 3 : 2)" class="text-end">@L["Table_VsProjectedYearlyExpenses", FormatEuro(totalExpenses)]</th>
                                        <th class="text-end @netClass">@FormatEuro(netYearly)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else if (incomeCategories.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["Label_ContributionSplit"]</label>
                            <div class="row">
                                @foreach (var income in incomeCategories)
                                {
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label small">@income.CategoryName</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control"
                                                   @bind="contributionSplits[income.CategoryName]"
                                                   @bind:after="RecalculateContributions"
                                                   min="0" max="100" step="1" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @{
                                var splitsTotal = contributionSplits.Values.Sum();
                                var splitsValid = splitsTotal == 100m;
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="@(splitsValid ? "text-muted" : "text-danger fw-semibold")">
                                    @L["Splits_Total", splitsTotal]
                                    @if (!splitsValid)
                                    {
                                        <span>@L["Splits_ShouldSumTo100"]</span>
                                    }
                                </small>
                                @if (selectedBudgetId > 0)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        @if (splitsDirty)
                                        {
                                            <small class="text-muted">@L["Splits_UnsavedChanges"]</small>
                                        }
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@(!splitsDirty || splitsSaving)"
                                                @onclick="SaveSplits">
                                            @(splitsSaving ? L["Button_Saving"] : L["Button_SaveSplits"])
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">@L["Splits_SelectBudgetToSave"]</small>
                                }
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>@L["Table_IncomeCategory"]</th>
                                        @if (showOrigin) { <th>@L["Table_Origin"]</th> }
                                        <th class="text-end">@L["Table_YearlyIncome"]</th>
                                        <th class="text-end">@L["Table_SplitPercent"]</th>
                                        <th class="text-end">@L["Table_RequiredContribution"]</th>
                                        <th class="text-end">@L["Table_Remaining"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var income in incomeCategories)
                                    {
                                        var split = contributionSplits.GetValueOrDefault(income.CategoryName, 0);
                                        var totalIncome = income.MonthlyAmounts.Sum();
                                        var requiredContribution = totalExpenses * split / 100;
                                        var remaining = totalIncome - requiredContribution;
                                        var remainingClass = remaining >= 0 ? "text-success" : "text-danger";

                                        <tr>
                                            <td>@income.CategoryName</td>
                                            @if (showOrigin) { <td><small class="text-muted">@income.OriginProjectName</small></td> }
                                            <td class="text-end">@FormatEuro(totalIncome)</td>
                                            <td class="text-end">@split%</td>
                                            <td class="text-end">@FormatEuro(requiredContribution)</td>
                                            <td class="text-end @remainingClass">@FormatEuro(remaining)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-primary">
                                        <th colspan="@(showOrigin ? 2 : 1)">@L["Table_Total"]</th>
                                        <th class="text-end">@FormatEuro(incomeCategories.Sum(c => c.MonthlyAmounts.Sum()))</th>
                                        <th class="text-end @(splitsValid ? "" : "text-danger")">@splitsTotal%</th>
                                        <th class="text-end">@FormatEuro(totalExpenses)</th>
                                        <th class="text-end">@FormatEuro(incomeCategories.Sum(c => c.MonthlyAmounts.Sum()) - totalExpenses)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">@L["NoIncomeCategories"]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>@L["Card_Summary"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h6>@L["Summary_TotalIncome"]</h6>
                            <h3 class="text-success">@FormatEuro(incomeCategories.Sum(c => c.MonthlyAmounts.Sum()))</h3>
                        </div>
                        <div class="col-md-4">
                            <h6>@L["Summary_TotalExpenses"]</h6>
                            <h3 class="text-danger">@FormatEuro(totalExpenses)</h3>
                        </div>
                        <div class="col-md-4">
                            <h6>@L["Summary_NetCashflow"]</h6>
                            <h3 class="@(netCashflow >= 0 ? "text-success" : "text-danger")">@FormatEuro(netCashflow)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        @L["NoData_YearAndFilters"]
    </div>
}

@code {
    private List<Budget>? availableBudgets;
    private List<int>? availableYears;
    private int selectedYear = DateTime.UtcNow.Year;
    private int selectedProjectId = 0;
    private int selectedBudgetId = 0;
    private bool isLoading = false;
    private string? projectName;
    private int projectSourceId = SourceScope.LegacySourceId;
    private bool notFound = false;

    private List<CategoryCashflow> incomeCategories = new();
    private List<CategoryCashflow> expenseCategories = new();
    private Dictionary<string, decimal> contributionSplits = new();
    private decimal totalExpenses = 0;
    private decimal netCashflow = 0;
    private bool needsChartRender = false;
    private int firstProjectedMonth = 13;
    private decimal totalMonthlyIncomeNeeded = 0m;
    private bool splitsDirty = false;
    private bool splitsSaving = false;

    /// <summary>"budget" (default) projects income from the selected budget's monthly income
    /// amounts (per-category, with seasonality intact). "breakeven" derives income at the level
    /// needed to cover budgeted expenses, attributed by contribution split. "recent" repeats
    /// each income category's last completed calendar month flat across the projected months
    /// for stress-testing.</summary>
    private string incomeProjectionMode = "budget";
    /// <summary>The calendar month whose actuals are repeated in "recent" mode. Used both for
    /// the projection math and the per-category readout label.</summary>
    private (int Year, int Month) recentIncomeSourceMonth;
    /// <summary>Per-item income for <see cref="recentIncomeSourceMonth"/>. Populated by
    /// LoadCashflowData in "recent" mode; null otherwise.</summary>
    private Dictionary<(long Id, CategoryItemType ItemType), decimal>? recentIncomePerItem;
    /// <summary>Per-item monthly budget amounts (12-element arrays) for the selected budget.
    /// Used by "budget" mode to project income, and by expense projection below. Populated
    /// when a budget is selected and the page is projecting (firstProjectedMonth ≤ 12).</summary>
    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]>? budgetMonthlyAmounts;

    /// <summary>When the selected project has child projects, each child uses its own active
    /// budget for the year. Keyed by ProjectId so ApplyIncomeProjection can route each row's
    /// future months to the right budget. Includes the parent's own entry.</summary>
    private Dictionary<int, Dictionary<(long Id, CategoryItemType ItemType), decimal[]>> budgetMonthlyAmountsByProject = new();

    /// <summary>Keys tracked by both the parent and a child project. Recorded during the
    /// per-project slice load so the page can warn the user — without dedupe their actuals
    /// would be summed twice in the rollup. Tuple: (catId, itemType, child project name).</summary>
    private HashSet<(long CategoryId, CategoryItemType ItemType, string ChildName)> rollupCollisions = new();

    /// <summary>Master switch for the balance-floor alert. When off, no alert fires regardless
    /// of where the projection dips — a user who doesn't care to be warned about negative
    /// balances gets a quiet page. When on, the banner fires whenever the line dips below
    /// <see cref="balanceFloor"/> and the recommended top-up scales accordingly. Does NOT
    /// change the income projection — the user is expected to plan a one-time top-up rather
    /// than sustain a higher income (which would over-shoot by year end).</summary>
    private bool balanceFloorEnabled = false;
    private decimal balanceFloor = 0m;
    /// <summary>The floor value used by the watermark/banner detection. Only meaningful when
    /// <see cref="balanceFloorEnabled"/> is true — callers must gate display on the toggle
    /// themselves, since this property doesn't.</summary>
    private decimal EffectiveFloor => balanceFloor;

    // Lifted cache: GetProjectActualDailyDeltaAsync / GetCategoryDayOfMonthWeightsAsync are
    // fetched once per LoadCashflowData so the floor algorithm and LoadBalanceDataAsync share
    // their results.
    private ProjectDailyDeltaResult? cachedDeltaResult;
    private Dictionary<(long Id, CategoryItemType ItemType), DayOfMonthDistribution>? cachedHistograms;

    // Balance / watermark state. Populated from GetProjectActualDailyDeltaAsync after the bar
    // chart's projection arrays exist; future months are layered on top via spreading the
    // projected monthly net across days.
    private bool hasAssignedAccounts = false;
    private decimal startingBalance = 0m;
    private decimal[] balanceDaily = Array.Empty<decimal>();
    private MonthWatermark[] monthlyWatermarks = Array.Empty<MonthWatermark>();
    private decimal yearMinBalance = 0m;
    private int yearMinDayOfYear = 0;
    /// <summary>Min balance over the future portion of the year (today onward). Used by the
    /// FutureNegative / CurrentlyNegative alerts — those sentences talk about an upcoming
    /// dip, so seeding them with the full-year min would otherwise quote a date in January
    /// when the projected future low is much closer to today.</summary>
    private decimal futureMinBalance = 0m;
    private int futureMinDayOfYear = 0;
    /// <summary>1-indexed day-of-year where the line first dips below zero in the FUTURE
    /// (relative to the "today" cursor for the selected year). 0 if no future dip. Used to
    /// frame the actionable date — past dips can't be acted on, so they get a different message.</summary>
    private int firstFutureNegativeDayOfYear = 0;
    /// <summary>Balance at the "today" position in the selected year, or 0 if the year is
    /// entirely in the future.</summary>
    private decimal currentBalanceForYear = 0m;
    private bool currentlyNegative = false;
    private int lastActualDayOfYear = 0;
    private bool needsBalanceChartRender = false;
    private record struct MonthWatermark(int Month, decimal Low, decimal High, decimal End);

    /// <summary>
    /// Adds <paramref name="amount"/> × <paramref name="weights"/> across the days of a month
    /// into the day-of-year <paramref name="deltas"/> array. Any weight mass on day-of-month
    /// indices past <paramref name="daysInMonth"/> is folded into the last day so a "31st"
    /// historical pattern still lands on Feb 28/29.
    /// </summary>
    private static void DistributeAcrossMonth(
        decimal[] deltas,
        int startDoy,
        int daysInMonth,
        decimal amount,
        decimal[] weights,
        int sign)
    {
        for (int d = 1; d <= daysInMonth; d++)
        {
            decimal w = weights[d - 1];
            if (d == daysInMonth)
            {
                for (int extraIdx = daysInMonth; extraIdx < weights.Length; extraIdx++)
                    w += weights[extraIdx];
            }
            int idx = startDoy - 1 + (d - 1);
            if (idx >= 0 && idx < deltas.Length)
                deltas[idx] += sign * amount * w;
        }
    }

    private class CategoryCashflow
    {
        public long CategoryId { get; set; }
        public CategoryItemType ItemType { get; set; }
        public string CategoryName { get; set; } = "";
        public decimal[] MonthlyAmounts { get; set; } = new decimal[12];

        /// <summary>
        /// The project this row's actuals and projected amounts came from. For a project with
        /// children, the cashflow view loads rows from the parent and each child; this lets
        /// the per-category table show which sub-project each line belongs to.
        /// </summary>
        public int OriginProjectId { get; set; }
        public string OriginProjectName { get; set; } = "";
    }

    /// <summary>
    /// Per-project intermediate result of <see cref="LoadOneProjectCashflowSliceAsync"/>: the
    /// income and expense rows we'd add to the unified list, plus the project's name for
    /// display, the keys it covers (used to detect collisions when the parent and a child
    /// track the same item), and the budget amounts that drive its own projection.
    /// </summary>
    private class ProjectCashflowSlice
    {
        public int ProjectId { get; set; }
        public string ProjectName { get; set; } = "";
        public List<CategoryCashflow> IncomeCategories { get; set; } = new();
        public List<CategoryCashflow> ExpenseCategories { get; set; } = new();
        public HashSet<(long Id, CategoryItemType ItemType)> Keys { get; set; } = new();
        public decimal TotalExpensesForProjection { get; set; }
        public decimal TotalIncomeYtd { get; set; }
        public List<(long Id, CategoryItemType ItemType)> ProjectionItems { get; set; } = new();
        public Dictionary<(long Id, CategoryItemType ItemType), decimal[]>? BudgetAmounts { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // This page is project-scoped via ?projectId=<id>; the only way to land here legitimately
        // is from the dashboard buttons. A bare URL or unknown project is an actual 404.
        var initialProjectId = ReadProjectIdFromQuery();
        if (!initialProjectId.HasValue)
        {
            notFound = true;
            return;
        }

        var project = await BudgetService.GetProjectAsync(initialProjectId.Value);
        if (project == null)
        {
            notFound = true;
            return;
        }

        selectedProjectId = project.Id;
        projectName = project.Name;
        projectSourceId = project.SourceId;

        // Overlay URL-provided state before the year clamp / budget defaulting runs, so a
        // shared link reproducing a specific year + budget + projection mode + floor wins
        // over the page defaults.
        ReadStateFromQuery();

        // Populate the Year dropdown from years the project's tracked categories have
        // transactions in, plus the next two years so the user can plan ahead with
        // budget-driven projections.
        var historicalYears = await BudgetService.GetYearsWithTransactionsForProjectAsync(selectedProjectId);
        var today = DateTime.UtcNow.Year;
        var futureYears = new[] { today + 1, today + 2 };
        availableYears = futureYears
            .Concat(historicalYears)
            .Distinct()
            .OrderByDescending(y => y)
            .ToList();
        if (!availableYears.Any())
            availableYears = new List<int> { today };
        if (!availableYears.Contains(selectedYear))
            selectedYear = availableYears.Contains(today) ? today : availableYears.First();

        await LoadAvailableBudgets();
        await LoadCashflowData();
        // Canonicalize the URL after init in case the URL referenced a budgetId that doesn't
        // belong to this project (LoadAvailableBudgets re-picks the active one in that case).
        UpdateUrl();
    }

    private int? ReadProjectIdFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("projectId", out var value)
            && int.TryParse(value, out var parsed))
        {
            return parsed;
        }
        return null;
    }

    /// <summary>
    /// Overlays URL query parameters onto the view-shaping fields. Defaults stay in place when
    /// a param is absent. Invalid values (bad year, unknown projection mode, malformed floor)
    /// are ignored — downstream code clamps/validates further if needed.
    /// </summary>
    private void ReadStateFromQuery()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("year", out var y) && int.TryParse(y, out var py))
            selectedYear = py;

        if (query.TryGetValue("budgetId", out var b) && int.TryParse(b, out var pb))
            selectedBudgetId = pb;

        if (query.TryGetValue("mode", out var m))
        {
            var v = m.ToString();
            if (v is "budget" or "breakeven" or "recent") incomeProjectionMode = v;
        }

        if (query.TryGetValue("floorOn", out var fo) && bool.TryParse(fo, out var pfo))
            balanceFloorEnabled = pfo;

        if (query.TryGetValue("floor", out var f)
            && decimal.TryParse(f, NumberStyles.Number, CultureInfo.InvariantCulture, out var pf))
            balanceFloor = pf;
    }

    /// <summary>
    /// Writes the current view-shaping state back to the URL so reloads/back-button preserve
    /// it and links are shareable. Defaults are omitted to keep URLs short. Uses replace:true
    /// to avoid creating a history entry per keystroke; guarded against no-op navigations that
    /// would otherwise 302-loop during ServerPrerendered.
    /// </summary>
    private void UpdateUrl()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["projectId"] = selectedProjectId,
            ["year"] = selectedYear,
            ["budgetId"] = selectedBudgetId == 0 ? null : selectedBudgetId,
            ["mode"] = incomeProjectionMode == "budget" ? null : incomeProjectionMode,
            ["floorOn"] = balanceFloorEnabled ? "true" : null,
            ["floor"] = balanceFloor == 0m ? null : balanceFloor.ToString(CultureInfo.InvariantCulture),
        });
        if (uri == Navigation.Uri) return;
        Navigation.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private async Task LoadAvailableBudgets()
    {
        availableBudgets = await BudgetService.GetBudgetsForProjectAsync(selectedProjectId);
        // Default the selection to the active budget for the displayed year (if any). Keep
        // the user's manual choice intact when the dropdown is reloaded for the same year.
        if (availableBudgets.All(b => b.Id != selectedBudgetId))
        {
            selectedBudgetId = availableBudgets
                .FirstOrDefault(b => b.Year == selectedYear && b.IsActive)?.Id ?? 0;
        }
    }

    private async Task OnIncomeModeChanged(string mode)
    {
        if (incomeProjectionMode == mode) return;
        incomeProjectionMode = mode;
        await LoadCashflowData();
        UpdateUrl();
    }

    private async Task OnBudgetChanged()
    {
        await LoadCashflowData();
        UpdateUrl();
    }

    private async Task OnBalanceFloorToggleChanged(ChangeEventArgs e)
    {
        balanceFloorEnabled = e.Value is bool b && b;
        await OnBalanceFloorChanged();
    }

    /// <summary>
    /// Recomputes the floor-dependent alert state (currentlyNegative,
    /// firstFutureNegativeDayOfYear, future-min) without going through the full LoadCashflowData
    /// path — that would re-seed contributionSplits from storedSplits and wipe any unsaved edits
    /// the user made in the calculator. The balance line itself doesn't depend on the floor,
    /// so this is enough.
    /// </summary>
    private async Task OnBalanceFloorChanged()
    {
        await LoadBalanceDataAsync();
        UpdateUrl();
    }

    private async Task OnYearChanged()
    {
        // Re-pick the active budget for the new year unless the user already chose one
        // for it explicitly.
        var currentMatch = availableBudgets?.FirstOrDefault(b => b.Id == selectedBudgetId);
        if (currentMatch == null || currentMatch.Year != selectedYear)
        {
            selectedBudgetId = availableBudgets?
                .FirstOrDefault(b => b.Year == selectedYear && b.IsActive)?.Id ?? 0;
        }
        await LoadCashflowData();
        UpdateUrl();
    }

    private async Task LoadCashflowData()
    {
        if (selectedProjectId <= 0) return;

        isLoading = true;
        StateHasChanged();

        incomeCategories.Clear();
        expenseCategories.Clear();
        contributionSplits.Clear();
        rollupCollisions.Clear();

        // Compute the projection window once — every sub-project uses the same calendar year,
        // so firstProjectedMonth is shared. Each child uses its own active budget for that
        // year (loaded inside the slice helper). 13 = sentinel "no projection".
        firstProjectedMonth = 13;
        var selectedBudget = availableBudgets?.FirstOrDefault(b => b.Id == selectedBudgetId);
        if (selectedBudgetId > 0 && selectedBudget != null && selectedBudget.Year == selectedYear)
        {
            var today = DateTime.UtcNow;
            if (selectedYear > today.Year) firstProjectedMonth = 1;
            else if (selectedYear == today.Year) firstProjectedMonth = today.Month + 1;
        }

        // The recent-mode source month is global (last completed calendar month).
        recentIncomePerItem = null;
        if (firstProjectedMonth <= 12 && incomeProjectionMode == "recent")
        {
            var today = DateTime.UtcNow;
            var sourceMonthStart = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
            recentIncomeSourceMonth = (sourceMonthStart.Year, sourceMonthStart.Month);
        }

        // Build the list of projects to roll up: this one, plus its immediate children. Each
        // child uses its own active budget for the year (so child projections stay self-
        // consistent even though the parent budget is the one driving "selected budget" UI).
        var children = await BudgetService.GetChildProjectsAsync(selectedProjectId);
        var parent = (await BudgetService.GetProjectAsync(selectedProjectId))!;

        var parentSlice = await LoadOneProjectCashflowSliceAsync(
            parent, isSelectedProject: true, budgetIdOverride: selectedBudgetId);
        var slices = new List<ProjectCashflowSlice> { parentSlice };
        foreach (var child in children)
        {
            // Each child's projection uses ITS active budget for the same year (not the parent's).
            var childActiveBudget = (await BudgetService.GetBudgetsForProjectAsync(child.Id))
                .FirstOrDefault(b => b.Year == selectedYear && b.IsActive);
            slices.Add(await LoadOneProjectCashflowSliceAsync(
                child, isSelectedProject: false,
                budgetIdOverride: childActiveBudget?.Id ?? 0));
        }

        // Cross-slice collision detection: a key tracked by the parent AND a child would
        // double-count the same transactions. Record the offending keys so the page can warn.
        var keysByProject = slices.ToDictionary(s => s.ProjectId, s => s.Keys);
        foreach (var key in parentSlice.Keys)
        {
            foreach (var child in slices.Skip(1))
            {
                if (child.Keys.Contains(key))
                    rollupCollisions.Add((key.Id, key.ItemType, child.ProjectName));
            }
        }

        // Merge slices into the page-level income/expense lists. We keep each (project, key)
        // as a separate row rather than summing across projects so the per-category table can
        // show the origin column; chart aggregation happens downstream in RecomputeTotals.
        foreach (var slice in slices)
        {
            incomeCategories.AddRange(slice.IncomeCategories);
            expenseCategories.AddRange(slice.ExpenseCategories);
        }

        // Aggregated projection totals (sum across all slices) feed the income contribution
        // calculator's "Total Expenses" reference and the breakeven-mode income gap.
        bool projecting = firstProjectedMonth <= 12;
        var totalExpensesForProjection = slices.Sum(s => s.TotalExpensesForProjection);
        var totalIncomeYtd = slices.Sum(s => s.TotalIncomeYtd);
        var remainingMonthsForProjection = 13 - firstProjectedMonth;
        totalMonthlyIncomeNeeded = projecting && remainingMonthsForProjection > 0
            ? Math.Max(0m, (totalExpensesForProjection - totalIncomeYtd) / remainingMonthsForProjection)
            : 0m;

        // For "budget" projection mode, ApplyIncomeProjection looks at budgetMonthlyAmounts
        // keyed by (catId, itemType) — but with rollup, each row in incomeCategories carries
        // its origin project. We stitch together a per-origin lookup so income rows from child
        // projects use the child's budget values for their future months.
        budgetMonthlyAmountsByProject = slices
            .Where(s => s.BudgetAmounts != null)
            .ToDictionary(s => s.ProjectId, s => s.BudgetAmounts!);
        // Back-compat: ApplyIncomeProjection still also reads budgetMonthlyAmounts (parent's).
        budgetMonthlyAmounts = parentSlice.BudgetAmounts;

        // Seed contribution splits: prefer the budget's saved splits when a budget is
        // selected, fall back to equal splits otherwise. Items missing from the saved set
        // get an equal-share fallback so newly-added income sources aren't silently zero.
        Dictionary<(long, CategoryItemType), decimal> storedSplits = new();
        if (selectedBudgetId > 0)
        {
            storedSplits = await BudgetService.GetBudgetContributionSplitsAsync(selectedBudgetId);
        }
        if (incomeCategories.Any())
        {
            var equalSplit = Math.Round(100m / incomeCategories.Count, 0);
            foreach (var income in incomeCategories)
            {
                var key = (income.CategoryId, income.ItemType);
                contributionSplits[income.CategoryName] = storedSplits.TryGetValue(key, out var saved)
                    ? saved
                    : equalSplit;
            }
        }
        splitsDirty = false;

        // Fetch real account deltas + day-of-month histograms once. Both the balance chart and
        // the floor algorithm consume them; LoadBalanceDataAsync reads the cached values. With
        // rollup we use the parent's accounts only — if the user wants child accounts in the
        // balance line they should be assigned to the parent project too (no schema change
        // needed; assignments are independent of the parent/child relationship).
        cachedDeltaResult = await BudgetService.GetProjectActualDailyDeltaAsync(selectedProjectId, selectedYear);
        cachedHistograms = null;
        if (projecting)
        {
            var projItems = slices.SelectMany(s => s.ProjectionItems).Distinct().ToList();
            cachedHistograms = await BudgetService.GetCategoryDayOfMonthWeightsAsync(projItems, projectSourceId);
        }

        // Attribute projected income to each source via the contribution splits and
        // recompute the rollup totals from the resulting per-source arrays.
        ApplyIncomeProjection();
        RecomputeTotals();

        await LoadBalanceDataAsync();

        isLoading = false;

        // Defer chart render until after Blazor has rendered the canvas element.
        // RenderCashflowChart depends on `cashflowChart` existing in the DOM, but at this
        // point we're still inside OnInitializedAsync / a bind handler and the post-await
        // render that creates the canvas hasn't happened yet.
        needsChartRender = incomeCategories.Any() || expenseCategories.Any();
        needsBalanceChartRender = hasAssignedAccounts && balanceDaily.Length > 0;
    }

    /// <summary>
    /// Loads one project's slice of the cashflow view — its tracking items expanded into per-
    /// category rows with actuals + (optionally) budget-driven future-month overlays. The
    /// caller stitches multiple slices together for the parent + child rollup. <paramref
    /// name="budgetIdOverride"/> is the budget whose monthly amounts drive this slice's
    /// projection (the parent slice uses the UI-selected budget; each child slice uses its
    /// own active budget for the same year).
    /// </summary>
    private async Task<ProjectCashflowSlice> LoadOneProjectCashflowSliceAsync(
        Project project, bool isSelectedProject, int budgetIdOverride)
    {
        var slice = new ProjectCashflowSlice
        {
            ProjectId = project.Id,
            ProjectName = project.Name
        };

        var trackingItems = await BudgetService.GetProjectTrackingItemsAsync(project.Id);
        var availableCategories = new List<CategoryGroupWithChildCount>();
        if (trackingItems.Any())
        {
            var allCategories = await BudgetService.GetAllCategoriesWithChildCountsAsync(project.SourceId);
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    var cat = allCategories.FirstOrDefault(c =>
                        c.ItemType == CategoryItemType.Group && c.Id == item.CategoryGroupId.Value);
                    if (cat != null) availableCategories.Add(cat);
                }
                else if (item.CategoryId.HasValue)
                {
                    var cat = allCategories.FirstOrDefault(c =>
                        c.ItemType == CategoryItemType.Category && c.Id == item.CategoryId.Value);
                    if (cat != null) availableCategories.Add(cat);
                }
            }
        }
        slice.Keys = availableCategories.Select(c => (c.Id, c.ItemType)).ToHashSet();
        slice.ProjectionItems = availableCategories.Select(c => (c.Id, c.ItemType)).ToList();

        var batch = await BudgetService.GetMonthlyIncomeAndExpenseBatchAsync(
            slice.ProjectionItems, selectedYear, project.SourceId, project.Id);

        // Budget projection: only when projecting AND this slice has a budget for the year.
        Dictionary<(long, CategoryItemType), decimal[]>? budgetAmounts = null;
        HashSet<(long, CategoryItemType)>? incomeItems = null;
        if (firstProjectedMonth <= 12 && budgetIdOverride > 0)
        {
            budgetAmounts = await BudgetService.GetMonthlyBudgetAmountsAsync(budgetIdOverride);
            incomeItems = await BudgetService.GetIncomeItemsForProjectAsync(project.Id);
        }
        slice.BudgetAmounts = budgetAmounts;
        bool projecting = budgetAmounts != null && firstProjectedMonth <= 12;

        // "Recent" mode pre-fetch (per-project, but the source month is global so we just
        // reuse recentIncomeSourceMonth set by the caller). Only the selected/parent slice
        // populates recentIncomePerItem; child rows in recent mode default to zero for the
        // future — rollup income reporting is otherwise too noisy to interpret.
        if (isSelectedProject && projecting && incomeProjectionMode == "recent")
        {
            recentIncomePerItem = await BudgetService.GetMonthlyIncomePerItemAsync(
                slice.ProjectionItems, project.SourceId, project.Id,
                recentIncomeSourceMonth.Year, recentIncomeSourceMonth.Month);
        }

        if (projecting)
        {
            foreach (var cat in availableCategories)
            {
                bool isIncome = incomeItems!.Contains((cat.Id, cat.ItemType));
                var (income, expenses) = batch[(cat.Id, cat.ItemType)];
                if (!isIncome)
                {
                    slice.TotalExpensesForProjection += expenses.Take(firstProjectedMonth - 1).Sum();
                    if (budgetAmounts!.TryGetValue((cat.Id, cat.ItemType), out var monthly))
                    {
                        for (int m = firstProjectedMonth - 1; m < 12; m++)
                            slice.TotalExpensesForProjection += monthly[m];
                    }
                }
                else
                {
                    slice.TotalIncomeYtd += income.Take(firstProjectedMonth - 1).Sum();
                }
            }
        }

        foreach (var category in availableCategories)
        {
            var (income, expenses) = batch[(category.Id, category.ItemType)];
            bool isIncomeItem = incomeItems?.Contains((category.Id, category.ItemType)) == true;

            // Expense projection: overwrite future months with the budget's per-month values
            // (preserves seasonality). Income future months are written later by
            // ApplyIncomeProjection based on the selected mode.
            if (projecting && !isIncomeItem
                && budgetAmounts!.TryGetValue((category.Id, category.ItemType), out var budgetMonthly))
            {
                for (int m = firstProjectedMonth - 1; m < 12; m++)
                    expenses[m] = budgetMonthly[m];
            }

            if (income.Any(m => m > 0) || isIncomeItem)
            {
                slice.IncomeCategories.Add(new CategoryCashflow
                {
                    CategoryId = category.Id,
                    ItemType = category.ItemType,
                    CategoryName = category.Name,
                    MonthlyAmounts = income,
                    OriginProjectId = project.Id,
                    OriginProjectName = project.Name
                });
            }

            if (expenses.Any(m => m > 0))
            {
                slice.ExpenseCategories.Add(new CategoryCashflow
                {
                    CategoryId = category.Id,
                    ItemType = category.ItemType,
                    CategoryName = category.Name,
                    MonthlyAmounts = expenses,
                    OriginProjectId = project.Id,
                    OriginProjectName = project.Name
                });
            }
        }

        return slice;
    }

    private Task LoadBalanceDataAsync()
    {
        // Data already fetched in LoadCashflowData; this method only reshapes the cached
        // result into a balance line + watermarks. Returns a completed Task so callers'
        // await semantics stay unchanged.
        var data = cachedDeltaResult ?? new ProjectDailyDeltaResult();
        hasAssignedAccounts = data.HasAccounts;
        startingBalance = data.StartingBalance;
        lastActualDayOfYear = data.LastActualDayOfYear;
        balanceDaily = Array.Empty<decimal>();
        monthlyWatermarks = Array.Empty<MonthWatermark>();
        yearMinBalance = 0m;
        yearMinDayOfYear = 0;
        futureMinBalance = 0m;
        futureMinDayOfYear = 0;
        if (!hasAssignedAccounts) return Task.CompletedTask;

        var deltas = (decimal[])data.DailyDelta.Clone();

        // Layer projection: per category, multiply the projected monthly amount by a learned
        // day-of-month histogram so projected months show real-looking patterns (payday lumps,
        // mid-month groceries, end-of-month rent). firstProjectedMonth is "next month" in the
        // current year, so the current month's remaining days get neither real txns nor
        // projection — the line goes flat for those days. Accepting that gap for now.
        if (firstProjectedMonth <= 12 && cachedHistograms != null)
        {
            var weights = cachedHistograms;

            for (int m = firstProjectedMonth; m <= 12; m++)
            {
                int daysInMonth = DateTime.DaysInMonth(selectedYear, m);
                if (daysInMonth == 0) continue;
                int startDoy = new DateTime(selectedYear, m, 1).DayOfYear; // 1-indexed

                foreach (var income in incomeCategories)
                {
                    var amount = income.MonthlyAmounts[m - 1];
                    if (amount == 0m) continue;
                    if (!weights.TryGetValue((income.CategoryId, income.ItemType), out var dist)) continue;
                    DistributeAcrossMonth(deltas, startDoy, daysInMonth, amount, dist.Weights, sign: +1);
                }

                foreach (var expense in expenseCategories)
                {
                    var amount = expense.MonthlyAmounts[m - 1];
                    if (amount == 0m) continue;
                    if (!weights.TryGetValue((expense.CategoryId, expense.ItemType), out var dist)) continue;
                    DistributeAcrossMonth(deltas, startDoy, daysInMonth, amount, dist.Weights, sign: -1);
                }
            }
        }

        // Cumulate into the daily balance line.
        var balance = new decimal[deltas.Length];
        decimal running = startingBalance;
        for (int i = 0; i < deltas.Length; i++)
        {
            running += deltas[i];
            balance[i] = running;
        }
        balanceDaily = balance;

        // Per-month low/high/end.
        var wm = new List<MonthWatermark>(12);
        for (int m = 1; m <= 12; m++)
        {
            int start = new DateTime(selectedYear, m, 1).DayOfYear - 1;
            int endExclusive = m == 12
                ? balance.Length
                : new DateTime(selectedYear, m + 1, 1).DayOfYear - 1;
            if (endExclusive <= start) continue;
            decimal low = decimal.MaxValue, high = decimal.MinValue;
            for (int i = start; i < endExclusive; i++)
            {
                if (balance[i] < low) low = balance[i];
                if (balance[i] > high) high = balance[i];
            }
            wm.Add(new MonthWatermark(m, low, high, balance[endExclusive - 1]));
        }
        monthlyWatermarks = wm.ToArray();

        // Year-min summary used in the card header.
        decimal min = balance[0];
        int minIdx = 0;
        for (int i = 1; i < balance.Length; i++)
        {
            if (balance[i] < min) { min = balance[i]; minIdx = i; }
        }
        yearMinBalance = min;
        yearMinDayOfYear = minIdx + 1;

        // Locate "today" within the balance array so we can talk about future risk separately
        // from historical dips. Past years collapse "today" to year-end; future years sit before
        // the array entirely.
        var todayUtc = DateTime.UtcNow;
        int currentDayIdx;
        if (selectedYear < todayUtc.Year) currentDayIdx = balance.Length - 1;
        else if (selectedYear > todayUtc.Year) currentDayIdx = -1;
        else currentDayIdx = lastActualDayOfYear - 1;

        currentBalanceForYear = currentDayIdx >= 0 ? balance[currentDayIdx] : 0m;
        var floor = EffectiveFloor;
        currentlyNegative = currentDayIdx >= 0 && balance[currentDayIdx] < floor;

        // Min over today..end-of-year, used by the FutureNegative / CurrentlyNegative alerts.
        // Including today (not currentDayIdx+1) so "Projected low" can quote today's balance
        // when we're currently negative and don't dip further. Past years collapse currentDayIdx
        // to balance.Length-1, leaving futureStart at the last day — a degenerate one-element
        // window that won't fire either alert anyway.
        int futureStart = Math.Max(0, currentDayIdx);
        if (futureStart < balance.Length)
        {
            decimal fMin = balance[futureStart];
            int fIdx = futureStart;
            for (int i = futureStart + 1; i < balance.Length; i++)
            {
                if (balance[i] < fMin) { fMin = balance[i]; fIdx = i; }
            }
            futureMinBalance = fMin;
            futureMinDayOfYear = fIdx + 1;
        }

        // First FUTURE crossing below the floor — the actionable date. Only meaningful when
        // the line is currently above the floor; if we're already underwater, there's no
        // "before D" to act on and the banner falls through to a different message.
        firstFutureNegativeDayOfYear = 0;
        if (!currentlyNegative)
        {
            int searchFrom = Math.Max(0, currentDayIdx + 1);
            for (int i = searchFrom; i < balance.Length; i++)
            {
                if (balance[i] < floor) { firstFutureNegativeDayOfYear = i + 1; break; }
            }
        }
        return Task.CompletedTask;
    }

    private void ApplyIncomeProjection()
    {
        if (firstProjectedMonth > 12) return;

        if (incomeProjectionMode == "budget")
        {
            // Pull each income category's future months straight from the budget — routed by
            // origin project so rolled-up child rows use the CHILD's budget, not the parent's.
            // Items missing from the budget (or with zero rows there) project to zero.
            foreach (var income in incomeCategories)
            {
                decimal[]? monthly = null;
                if (budgetMonthlyAmountsByProject.TryGetValue(income.OriginProjectId, out var byKey))
                    byKey.TryGetValue((income.CategoryId, income.ItemType), out monthly);
                for (int m = firstProjectedMonth - 1; m < 12; m++)
                {
                    income.MonthlyAmounts[m] = monthly?[m] ?? 0m;
                }
            }
            return;
        }

        if (incomeProjectionMode == "recent")
        {
            // Repeat each category's source-month income flat across the projection. Categories
            // missing from the lookup (or with zero income that month) project to zero — useful
            // for stress testing irregular income.
            var src = recentIncomePerItem ?? new Dictionary<(long, CategoryItemType), decimal>();
            foreach (var income in incomeCategories)
            {
                var perMonth = src.GetValueOrDefault((income.CategoryId, income.ItemType), 0m);
                for (int m = firstProjectedMonth - 1; m < 12; m++)
                {
                    income.MonthlyAmounts[m] = perMonth;
                }
            }
            return;
        }

        // "breakeven" mode: distribute the global income gap by contribution-split %.
        if (totalMonthlyIncomeNeeded <= 0m) return;
        foreach (var income in incomeCategories)
        {
            var split = contributionSplits.GetValueOrDefault(income.CategoryName, 0m);
            var perMonth = totalMonthlyIncomeNeeded * (split / 100m);
            for (int m = firstProjectedMonth - 1; m < 12; m++)
            {
                income.MonthlyAmounts[m] = perMonth;
            }
        }
    }

    private void RecomputeTotals()
    {
        totalExpenses = expenseCategories.Sum(c => c.MonthlyAmounts.Sum());
        netCashflow = incomeCategories.Sum(c => c.MonthlyAmounts.Sum()) - totalExpenses;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsChartRender)
        {
            needsChartRender = false;
            await RenderCashflowChart();
        }
        if (needsBalanceChartRender)
        {
            needsBalanceChartRender = false;
            await RenderBalanceChart();
        }
    }

    private async Task<HashSet<long>> GetAllSubGroupIdsAsync(long categoryGroupId, List<CategoryGroupWithChildCount> allCategories)
    {
        var result = new HashSet<long>();
        var children = allCategories.Where(c => c.ParentCategoryGroupId == categoryGroupId).ToList();
        foreach (var child in children)
        {
            result.Add(child.CategoryGroup.Id);
            var subIds = await GetAllSubGroupIdsAsync(child.CategoryGroup.Id, allCategories);
            foreach (var subId in subIds)
            {
                result.Add(subId);
            }
        }
        return result;
    }

    private async Task RecalculateContributions()
    {
        splitsDirty = true;
        ApplyIncomeProjection();
        RecomputeTotals();
        await LoadBalanceDataAsync();
        needsBalanceChartRender = hasAssignedAccounts && balanceDaily.Length > 0;
        await RenderCashflowChart();
        StateHasChanged();
    }

    private async Task SaveSplits()
    {
        if (selectedBudgetId <= 0 || !incomeCategories.Any()) return;
        splitsSaving = true;
        try
        {
            var payload = incomeCategories
                .Select(c => (c.CategoryId, c.ItemType, Percent: contributionSplits.GetValueOrDefault(c.CategoryName, 0m)))
                .ToList();
            await BudgetService.SaveBudgetContributionSplitsAsync(selectedBudgetId, payload);
            splitsDirty = false;
        }
        finally
        {
            splitsSaving = false;
        }
    }

    private async Task RenderCashflowChart()
    {
        if (!incomeCategories.Any() && !expenseCategories.Any())
            return;

        var monthLabels = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

        var datasets = new List<object>();

        // Sort by average monthly amount (descending) so the largest contributor sits at the
        // bottom of the stack — matching the Budgets chart convention.
        var sortedIncome = incomeCategories
            .OrderByDescending(c => c.MonthlyAmounts.Length > 0 ? c.MonthlyAmounts.Average() : 0m)
            .ToList();
        var sortedExpense = expenseCategories
            .OrderByDescending(c => c.MonthlyAmounts.Length > 0 ? c.MonthlyAmounts.Average() : 0m)
            .ToList();

        // Share one palette across both stacks so each category gets a distinct color. Income
        // takes the first slots, expenses continue from there. Income/expense distinction is
        // still legible via the side-by-side stacks and the "Income"/"Expenses" captions the
        // monthlyNetLabels plugin draws above them.
        var palette = GenerateColors(sortedIncome.Count + sortedExpense.Count);
        for (int i = 0; i < sortedIncome.Count; i++)
        {
            var income = sortedIncome[i];
            datasets.Add(new
            {
                label = L["Chart_DatasetIncome", income.CategoryName].Value,
                data = income.MonthlyAmounts,
                backgroundColor = string.Format(palette[i], "0.7"),
                borderColor = string.Format(palette[i], "1"),
                borderWidth = 1,
                stack = "income"
            });
        }

        // Expense datasets — drawn as positive values too so they share a baseline with the
        // income stack; Chart.js groups the two stack keys side-by-side per month.
        for (int i = 0; i < sortedExpense.Count; i++)
        {
            var expense = sortedExpense[i];
            var color = palette[sortedIncome.Count + i];
            datasets.Add(new
            {
                label = L["Chart_DatasetExpense", expense.CategoryName].Value,
                data = expense.MonthlyAmounts,
                backgroundColor = string.Format(color, "0.7"),
                borderColor = string.Format(color, "1"),
                borderWidth = 1,
                stack = "expenses"
            });
        }

        // Anchor the y-axis bottom at 0 only when no row has a negative month — otherwise let
        // Chart.js auto-fit so refund-heavy months (negative net) still render as visible
        // bars dropping below the zero line.
        bool hasNegativeMonth =
            incomeCategories.Any(c => c.MonthlyAmounts.Any(v => v < 0))
            || expenseCategories.Any(c => c.MonthlyAmounts.Any(v => v < 0));
        decimal? yMin = hasNegativeMonth ? null : 0m;

        var chartData = new
        {
            type = "bar",
            data = new
            {
                labels = monthLabels,
                datasets = datasets.ToArray()
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new
                    {
                        position = "bottom"
                    },
                    tooltip = new
                    {
                        mode = "index",
                        intersect = false,
                        position = "outerEdge",
                        callbacks = new
                        {
                            label = "function(context) { return context.dataset.label + ': €' + context.parsed.y.toFixed(2); }"
                        }
                    },
                    // Picked up by the forecastShading plugin in wwwroot/js/charts.js. 13 means
                    // "no projection active", so the plugin draws nothing.
                    forecastShading = new
                    {
                        startMonth = firstProjectedMonth
                    }
                },
                scales = new
                {
                    x = new
                    {
                        stacked = true
                    },
                    y = new
                    {
                        stacked = true,
                        // Explicit min anchors the bottom for Chart.js's grace algorithm,
                        // which only skips padding an end when that end has a user-defined
                        // bound. We pass 0 for all-positive data and null when negatives
                        // exist so refund-heavy months stay visible below the zero line.
                        min = yMin,
                        grace = "30%",
                        ticks = new
                        {
                            callback = "function(value) { return '€' + value.toFixed(0); }"
                        },
                        title = new
                        {
                            display = true,
                            text = L["Chart_AmountAxis"].Value
                        }
                    }
                }
            }
        };

        await JSRuntime.InvokeVoidAsync("renderChart", "cashflowChart", chartData);
    }

    private async Task RenderBalanceChart()
    {
        if (balanceDaily.Length == 0) return;

        // Labels: only the 1st of each month gets a string; other days are empty so the axis
        // doesn't try to render 365 overlapping labels. The tooltip recomputes the full date
        // from the data index via the tooltip.title callback below.
        var labels = new string[balanceDaily.Length];
        var monthNames = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        for (int i = 0; i < balanceDaily.Length; i++)
        {
            var dt = new DateTime(selectedYear, 1, 1).AddDays(i);
            labels[i] = dt.Day == 1 ? monthNames[dt.Month - 1] : "";
        }

        var pointBackground = new string[balanceDaily.Length];
        var pointRadius = new int[balanceDaily.Length];
        for (int i = 0; i < balanceDaily.Length; i++)
        {
            pointBackground[i] = "rgba(54, 162, 235, 1)";
            pointRadius[i] = 0;
        }
        // Highlight the year minimum so the watermark is visually anchored.
        if (yearMinDayOfYear >= 1 && yearMinDayOfYear <= balanceDaily.Length)
        {
            pointBackground[yearMinDayOfYear - 1] = "rgba(220, 53, 69, 1)";
            pointRadius[yearMinDayOfYear - 1] = 5;
        }

        var chartData = new
        {
            type = "line",
            data = new
            {
                labels,
                datasets = new object[]
                {
                    new
                    {
                        label = L["Chart_BalanceLabel"].Value,
                        data = balanceDaily,
                        borderColor = "rgba(54, 162, 235, 1)",
                        backgroundColor = "rgba(54, 162, 235, 0.15)",
                        borderWidth = 2,
                        fill = true,
                        tension = 0.1,
                        pointRadius,
                        pointBackgroundColor = pointBackground,
                        pointHoverRadius = 4
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new { display = false },
                    tooltip = new
                    {
                        mode = "index",
                        intersect = false,
                        callbacks = new
                        {
                            // Reconstruct the full date from the data index — labels[] only carries
                            // month names on day-1, so we can't use the label string for tooltips.
                            title = $"function(items) {{ if (!items.length) return ''; var i = items[0].dataIndex; var d = new Date({selectedYear}, 0, 1 + i); return d.toLocaleDateString('en-US', {{ month: 'short', day: 'numeric' }}); }}",
                            label = $"function(context) {{ return '{L["Chart_BalanceLabel"].Value}: €' + context.parsed.y.toLocaleString('de-DE', {{ minimumFractionDigits: 2, maximumFractionDigits: 2 }}); }}"
                        }
                    },
                    forecastShading = new
                    {
                        // Day index (1-based) where projection starts. lastActualDayOfYear+1 keeps
                        // the real-transaction portion unshaded.
                        startIndex = lastActualDayOfYear + 1
                    },
                    zeroLine = new { enabled = true }
                },
                scales = new
                {
                    x = new
                    {
                        // Labels contain month names only on day-1 of each month and "" elsewhere
                        // (see RenderBalanceChart label setup), so Chart.js draws 12 axis labels
                        // at the right positions without needing a tick filter.
                        ticks = new
                        {
                            autoSkip = false,
                            maxRotation = 0
                        },
                        grid = new { display = false }
                    },
                    y = new
                    {
                        ticks = new
                        {
                            callback = "function(value) { return '€' + value.toFixed(0); }"
                        },
                        title = new { display = true, text = L["Chart_BalanceAxis"].Value }
                    }
                }
            }
        };

        await JSRuntime.InvokeVoidAsync("renderChart", "balanceChart", chartData);
    }

    /// <summary>
    /// Returns rgba color templates (each with a "{0}" placeholder for alpha) drawn from the
    /// same fixed palette as the Budgets chart. Cycles via modulo when more colors are
    /// requested than the palette has.
    /// </summary>
    private string[] GenerateColors(int count)
    {
        var palette = new[]
        {
            "rgba(255, 99, 132, {0})",
            "rgba(54, 162, 235, {0})",
            "rgba(255, 206, 86, {0})",
            "rgba(75, 192, 192, {0})",
            "rgba(153, 102, 255, {0})",
            "rgba(255, 159, 64, {0})",
            "rgba(199, 199, 199, {0})",
            "rgba(83, 102, 255, {0})",
            "rgba(255, 99, 255, {0})",
            "rgba(99, 255, 132, {0})"
        };

        var result = new string[count];
        for (int i = 0; i < count; i++)
        {
            result[i] = palette[i % palette.Length];
        }
        return result;
    }

    private string FormatEuro(decimal value)
    {
        if (value < 0)
        {
            return $"-€{Math.Abs(value):N2}";
        }
        return $"€{value:N2}";
    }

    /// <summary>
    /// Renders a month + day using the current culture's MonthDayPattern so the order matches
    /// each locale's convention (en: "June 17", de: "17. Juni") — a hardcoded "MMM d" pins
    /// English ordering and produces "Juni 17" in German, which reads wrong.
    /// </summary>
    private static string FormatMonthDay(DateTime d) =>
        d.ToString(CultureInfo.CurrentCulture.DateTimeFormat.MonthDayPattern, CultureInfo.CurrentCulture);
}
