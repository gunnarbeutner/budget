@page "/projects/{BudgetId:int}"
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@inject BudgetService BudgetService
@inject NavigationManager Navigation

<PageTitle>@(budget?.Name ?? "Project Details")</PageTitle>

@if (budget == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@budget.Name</h1>
            @if (!string.IsNullOrEmpty(budget.Description))
            {
                <p class="text-muted">@budget.Description</p>
            }
        </div>
        <div>
            <a href="/" class="btn btn-secondary me-2">Back to Dashboard</a>
            <button class="btn btn-danger" @onclick="ShowDeleteDialog">Delete Project</button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Category Assignments</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddCategoryDialog">Add Category</button>
                </div>
                <div class="card-body">
                    @if (!budget.CategoryAssignments.Any())
                    {
                        <p class="text-muted">No categories assigned yet.</p>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in budget.CategoryAssignments)
                                {
                                    var categoryName = categoryNames.GetValueOrDefault(assignment.CategoryId, "Loading...");

                                    <tr>
                                        <td>@categoryName</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveCategory(assignment.CategoryId)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Current Month Overview</h5>
                </div>
                <div class="card-body">
                    @if (spendingSummary == null)
                    {
                        <p><em>Loading spending data...</em></p>
                    }
                    else
                    {
                        <h6>@spendingSummary.ToMonth/@spendingSummary.Year</h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span>Total Project Budget:</span>
                                <strong>€@spendingSummary.TotalBudget.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total Spent:</span>
                                <strong class="@(spendingSummary.TotalSpent > spendingSummary.TotalBudget ? "text-danger" : "text-success")">
                                    €@spendingSummary.TotalSpent.ToString("N2")
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Remaining:</span>
                                <strong class="@(spendingSummary.TotalRemaining < 0 ? "text-danger" : "text-success")">
                                    €@spendingSummary.TotalRemaining.ToString("N2")
                                </strong>
                            </div>
                        </div>

                        @if (spendingSummary.CategorySpending.Any())
                        {
                            <h6 class="mt-4">By Category:</h6>
                            @foreach (var cat in spendingSummary.CategorySpending.OrderByDescending(c => c.PercentUsed))
                            {
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small">
                                        <span>@cat.CategoryName</span>
                                        <span>€@cat.Spent.ToString("N2") / €@cat.Budget.ToString("N2")</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar @(cat.PercentUsed > 100 ? "bg-danger" : cat.PercentUsed > 80 ? "bg-warning" : "bg-success")"
                                             role="progressbar"
                                             style="width: @Math.Min(cat.PercentUsed, 100)%"
                                             aria-valuenow="@cat.PercentUsed"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                            @cat.PercentUsed.ToString("F0")%
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Category Income/Expense Configuration</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Configure which categories are income vs expense for cashflow analysis.
                        Categories not marked as income will default to expenses. Settings on parent categories inherit to children.
                    </p>

                    @if (isLoadingCategoryTypes)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (incomeExpenseCategories.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th>Type</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var categoryWithLevel in incomeExpenseCategories)
                                    {
                                        var typeInfo = GetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType);
                                        var isIncome = typeInfo.IsIncome;
                                        var isInherited = typeInfo.IsInherited;
                                        var isExplicit = typeInfo.IsExplicit;

                                        var displayType = isIncome ? "Income" : "Expense";
                                        if (isInherited) displayType += " (inherited)";
                                        else if (!isExplicit) displayType += " (default)";

                                        var badgeClass = isIncome ? "bg-success" : "bg-danger";
                                        if (isInherited || !isExplicit) badgeClass = isIncome ? "bg-success bg-opacity-50" : "bg-danger bg-opacity-50";

                                        <tr>
                                            <td style="padding-left: @((categoryWithLevel.Level * 20))px">@categoryWithLevel.CategoryGroup.Name</td>
                                            <td><span class="badge @badgeClass">@displayType</span></td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-success"
                                                            @onclick="() => SetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType, true)"
                                                            disabled="@isInherited">
                                                        Income
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger"
                                                            @onclick="() => SetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType, false)"
                                                            disabled="@isInherited">
                                                        Expense
                                                    </button>
                                                    @if (isExplicit)
                                                    {
                                                        <button type="button" class="btn btn-outline-secondary"
                                                                @onclick="() => ClearCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType)">
                                                            Clear
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No categories assigned to this project yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Budget Tracking Configuration</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowTrackingDialog">Configure Tracking</button>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Configure which categories/groups to track for budgets and analysis.
                        This controls what appears in budget creation and spending analysis.
                    </p>
                    @if (trackingItems == null || !trackingItems.Any())
                    {
                        <p class="text-muted">No tracking items configured. Click "Configure Tracking" to set up.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in trackingItems)
                            {
                                var name = item.CategoryGroupId.HasValue
                                    ? trackingCategoryNames.GetValueOrDefault(item.CategoryGroupId.Value, "Loading...")
                                    : trackingCategoryNames.GetValueOrDefault(item.CategoryId!.Value, "Loading...");
                                var type = item.CategoryGroupId.HasValue ? "Group" : "Category";

                                <span class="badge bg-secondary">@name (@type)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Budgets</h5>
                    <a class="btn btn-sm btn-primary" href="/budgets/wizard">New Budget</a>
                </div>
                <div class="card-body">
                    @if (projectBudgets == null)
                    {
                        <p class="text-muted">Loading…</p>
                    }
                    else if (!projectBudgets.Any())
                    {
                        <p class="text-muted">No budgets yet. Click "New Budget" to launch the wizard.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    <th>Notes</th>
                                    <th>Last modified</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in projectBudgets.OrderByDescending(b => b.Year))
                                {
                                    <tr>
                                        <td>@b.Year</td>
                                        <td>@b.Notes</td>
                                        <td class="text-muted small">
                                            @(b.LastModifiedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                ?? b.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary me-1" href="/budgets/@b.Id/edit">Edit</a>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteBudgetDialog(b)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (budgetPendingDelete != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Budget</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteBudgetDialog"></button>
                </div>
                <div class="modal-body">
                    <p>Delete the @budgetPendingDelete.Year budget@(string.IsNullOrEmpty(budgetPendingDelete.Notes) ? "" : $" ({budgetPendingDelete.Notes})")?</p>
                    <p class="text-muted small mb-0">All of its monthly entries will be removed. This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="HideDeleteBudgetDialog">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteBudget">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (showDeleteDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Project</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteDialog"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@budget?.Name</strong>?</p>
                    <p class="text-muted small mb-0">This will also remove the project's tracking items, category type assignments, and any budgets attached to it. This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteDialog">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteProject">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (showTrackingDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Configure Budget Tracking</h5>
                    <button type="button" class="btn-close" @onclick="HideTrackingDialog"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Select which categories/groups to track for budgeting and analysis.
                        Deselecting a parent will automatically select its children for more granular control.
                    </p>

                    <div style="max-height: 500px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
                        @if (allAvailableCategories != null && allActualCategories != null)
                        {
                            // Treat any group whose parent is outside the filtered subset as a render
                            // root, since IsRootCategory only matches MoneyMoney's top-level groups and
                            // the project might be scoped to a sub-tree.
                            var filteredGroupIds = allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group)
                                .Select(c => c.Id)
                                .ToHashSet();
                            @foreach (var rootCat in allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group
                                    && !filteredGroupIds.Contains(c.ParentCategoryGroupId ?? -1))
                                .OrderBy(c => c.CategoryGroup.Name))
                            {
                                <CategoryTree
                                    CategoryGroup="@rootCat"
                                    Level="0"
                                    RenderMode="CategoryTreeRenderMode.Checkbox"
                                    ParentSelected="false"
                                    SelectedCategoryGroupIds="@selectedTrackingGroupIds"
                                    SelectedCategoryIds="@selectedTrackingCategoryIds"
                                    OnCategoryGroupToggle="@HandleTrackingGroupToggle"
                                    OnCategoryToggle="@HandleTrackingCategoryToggle"
                                    AllCategories="@allAvailableCategories"
                                    ActualCategories="@allActualCategories" />
                            }
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideTrackingDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveTrackingConfiguration">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@if (showAddCategoryDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Category to Project</h5>
                    <button type="button" class="btn-close" @onclick="HideAddCategoryDialog"></button>
                </div>
                <div class="modal-body">
                    @if (availableCategoriesWithCounts == null)
                    {
                        <p><em>Loading categories...</em></p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Select Category</label>
                            <select class="form-select" @bind="selectedCategoryId" size="15">
                                <option value="0">-- Select a category --</option>
                                @{
                                    // Group by parent to show hierarchy
                                    var rootCategories = availableCategoriesWithCounts.Where(c => c.IsRootCategory).OrderBy(c => c.CategoryGroup.Name);

                                    foreach (var rootCat in rootCategories)
                                    {
                                        var childInfo = rootCat.DirectChildCount > 0 ? $" ({rootCat.DirectChildCount} sub-categories)" : "";
                                        <option value="@rootCat.CategoryGroup.Id">@rootCat.CategoryGroup.Name@childInfo</option>

                                        // Show first-level children (e.g., Auslagen, Barauszahlung under Umbuchungen)
                                        var firstLevelChildren = availableCategoriesWithCounts
                                            .Where(c => c.ParentCategoryGroupId == rootCat.CategoryGroup.Id)
                                            .OrderBy(c => c.CategoryGroup.Name);

                                        foreach (var child1 in firstLevelChildren)
                                        {
                                            var child1Info = child1.DirectChildCount > 0 ? $" ({child1.DirectChildCount} sub-categories)" : "";
                                            <option value="@child1.CategoryGroup.Id">  ↳ @child1.CategoryGroup.Name@child1Info</option>

                                            // Show second-level children (e.g., Sparkasse under Barauszahlung)
                                            var secondLevelChildren = availableCategoriesWithCounts
                                                .Where(c => c.ParentCategoryGroupId == child1.CategoryGroup.Id)
                                                .OrderBy(c => c.CategoryGroup.Name);

                                            foreach (var child2 in secondLevelChildren)
                                            {
                                                var child2Info = child2.DirectChildCount > 0 ? $" ({child2.DirectChildCount} sub-categories)" : "";
                                                <option value="@child2.CategoryGroup.Id">    ↳↳ @child2.CategoryGroup.Name@child2Info</option>
                                            }
                                        }
                                    }
                                }
                            </select>
                            <small class="form-text text-muted">Parent categories automatically include all their sub-categories in project calculations</small>
                        </div>

                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideAddCategoryDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddCategory" disabled="@(selectedCategoryId == 0)">Add Category</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Parameter]
    public int BudgetId { get; set; }

    private Project? budget;
    private ProjectSpendingSummary? spendingSummary;
    private Dictionary<long, string> categoryNames = new();
    private List<CategoryGroupWithChildCount>? availableCategoriesWithCounts;

    private bool showAddCategoryDialog = false;
    private long selectedCategoryId = 0;
    private bool showDeleteDialog = false;

    // Budgets card state
    private List<Budget>? projectBudgets;
    private Budget? budgetPendingDelete;

    // Tracking configuration
    private List<ProjectTrackingItem>? trackingItems;
    private Dictionary<long, string> trackingCategoryNames = new();
    private bool showTrackingDialog = false;
    private HashSet<long> selectedTrackingGroupIds = new();
    private HashSet<long> selectedTrackingCategoryIds = new();
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private List<Category>? allActualCategories;

    // Income/Expense configuration
    private List<CategoryWithLevel> incomeExpenseCategories = new();
    private List<CategoryTypeAssignment> categoryTypeAssignments = new();
    private bool isLoadingCategoryTypes = false;

    private class CategoryWithLevel
    {
        public CategoryGroupWithChildCount CategoryGroup { get; set; } = null!;
        public int Level { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBudget();
        await LoadSpendingSummary();
        await LoadTrackingItems();
        await LoadIncomeExpenseConfiguration();
        await LoadProjectBudgets();
    }

    private async Task LoadProjectBudgets()
    {
        projectBudgets = await BudgetService.GetBudgetsForProjectAsync(BudgetId);
    }

    private void ShowDeleteBudgetDialog(Budget b)
    {
        budgetPendingDelete = b;
    }

    private void HideDeleteBudgetDialog()
    {
        budgetPendingDelete = null;
    }

    private async Task ConfirmDeleteBudget()
    {
        if (budgetPendingDelete == null) return;
        var id = budgetPendingDelete.Id;
        budgetPendingDelete = null;
        await BudgetService.DeleteBudgetAsync(id);
        await LoadProjectBudgets();
    }

    private async Task LoadBudget()
    {
        budget = await BudgetService.GetProjectAsync(BudgetId);

        if (budget != null)
        {
            // Load category group names
            foreach (var assignment in budget.CategoryAssignments)
            {
                var categoryGroup = await BudgetService.GetCategoryWithSubCategoriesAsync(assignment.CategoryId);
                if (categoryGroup != null)
                {
                    categoryNames[assignment.CategoryId] = categoryGroup.Name ?? "Unknown";
                }
            }
        }
    }

    private async Task LoadSpendingSummary()
    {
        var now = DateTime.UtcNow;
        spendingSummary = await BudgetService.GetSpendingSummaryAsync(BudgetId, now.Year, now.Month, now.Month);
    }

    private async Task ShowAddCategoryDialog()
    {
        availableCategoriesWithCounts = await BudgetService.GetAllCategoriesWithChildCountsAsync();
        selectedCategoryId = 0;
        showAddCategoryDialog = true;
    }

    private void HideAddCategoryDialog()
    {
        showAddCategoryDialog = false;
    }

    private async Task AddCategory()
    {
        if (selectedCategoryId == 0)
            return;

        await BudgetService.AssignCategoryToProjectAsync(BudgetId, selectedCategoryId);

        showAddCategoryDialog = false;
        await LoadBudget();
        await LoadSpendingSummary();
    }

    private async Task RemoveCategory(long categoryId)
    {
        await BudgetService.RemoveCategoryFromProjectAsync(BudgetId, categoryId);
        await LoadBudget();
        await LoadSpendingSummary();
    }

    private void ShowDeleteDialog() => showDeleteDialog = true;
    private void HideDeleteDialog() => showDeleteDialog = false;

    private async Task DeleteProject()
    {
        await BudgetService.DeleteProjectAsync(BudgetId);
        showDeleteDialog = false;
        Navigation.NavigateTo("/");
    }

    // Tracking configuration methods
    private async Task LoadTrackingItems()
    {
        var project = await BudgetService.GetProjectAsync(BudgetId);
        trackingItems = project?.TrackingItems.ToList() ?? new List<ProjectTrackingItem>();

        // Load names for tracking items
        if (trackingItems != null)
        {
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    var categoryGroup = await BudgetService.GetCategoryWithSubCategoriesAsync(item.CategoryGroupId.Value);
                    if (categoryGroup != null)
                    {
                        trackingCategoryNames[item.CategoryGroupId.Value] = categoryGroup.Name ?? "Unknown";
                    }
                }
                else if (item.CategoryId.HasValue)
                {
                    var categories = await BudgetService.GetAllCategoriesAsync();
                    var category = categories.FirstOrDefault(c => c.Id == item.CategoryId.Value);
                    if (category != null)
                    {
                        trackingCategoryNames[item.CategoryId.Value] = category.Name ?? "Unknown";
                    }
                }
            }
        }
    }

    private async Task ShowTrackingDialog()
    {
        // Show dialog immediately
        showTrackingDialog = true;
        StateHasChanged();

        // Load all categories
        var allCategoryGroups = await BudgetService.GetAllCategoriesWithChildCountsAsync();
        allActualCategories = await BudgetService.GetAllCategoriesAsync();

        // Get all category group IDs that are in the project
        if (budget != null)
        {
            var projectCategoryGroupIds = new HashSet<long>();
            foreach (var assignment in budget.CategoryAssignments)
            {
                projectCategoryGroupIds.Add(assignment.CategoryId);
                CategoryGroupWithChildCount.CollectDescendantIds(assignment.CategoryId, allCategoryGroups, projectCategoryGroupIds, includeLeafCategories: false);
            }

            // Filter to only categories in the project
            allAvailableCategories = allCategoryGroups
                .Where(c => c.CategoryGroup.Id != 1 && projectCategoryGroupIds.Contains(c.CategoryGroup.Id))
                .ToList();
        }

        // Load current tracking configuration
        selectedTrackingGroupIds.Clear();
        selectedTrackingCategoryIds.Clear();

        if (trackingItems != null)
        {
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    selectedTrackingGroupIds.Add(item.CategoryGroupId.Value);
                }
                else if (item.CategoryId.HasValue)
                {
                    selectedTrackingCategoryIds.Add(item.CategoryId.Value);
                }
            }
        }

        StateHasChanged();
    }

    private void HideTrackingDialog()
    {
        showTrackingDialog = false;
    }

    private async Task SaveTrackingConfiguration()
    {
        await BudgetService.UpdateProjectTrackingItemsAsync(BudgetId, selectedTrackingGroupIds, selectedTrackingCategoryIds);
        showTrackingDialog = false;
        await LoadTrackingItems();
    }

    private async Task HandleTrackingGroupToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedTrackingGroupIds.Add(args.Id);
            RemoveTrackingDescendantsFromSelection(args.Id);
        }
        else
        {
            selectedTrackingGroupIds.Remove(args.Id);
            SelectTrackingImmediateChildren(args.Id);
        }
        await Task.CompletedTask;
    }

    private async Task HandleTrackingCategoryToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedTrackingCategoryIds.Add(args.Id);
        }
        else
        {
            selectedTrackingCategoryIds.Remove(args.Id);
        }
        await Task.CompletedTask;
    }

    private void RemoveTrackingDescendantsFromSelection(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Use the shared helper, which handles ID-collision between Groups and Categories
        // correctly (Category items have a placeholder CategoryGroup.Id pointing at their
        // parent group; recursing on that value caused a stack overflow).
        var descendants = CategoryGroupWithChildCount.CollectDescendants(
            parentCategoryGroupId, allAvailableCategories, includeLeafCategories: true);

        foreach (var descendant in descendants)
        {
            if (descendant.ItemType == CategoryItemType.Group)
            {
                selectedTrackingGroupIds.Remove(descendant.Id);
            }
            else
            {
                selectedTrackingCategoryIds.Remove(descendant.Id);
            }
        }
    }

    private void SelectTrackingImmediateChildren(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Filter children by ItemType so a Category item (whose ParentCategoryGroupId would
        // also match) doesn't get treated as a sub-Group.
        var childGroups = allAvailableCategories
            .Where(c => c.ItemType == CategoryItemType.Group && c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        var childCategories = allAvailableCategories
            .Where(c => c.ItemType == CategoryItemType.Category && c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        foreach (var child in childGroups)
        {
            selectedTrackingGroupIds.Add(child.Id);
        }

        foreach (var child in childCategories)
        {
            selectedTrackingCategoryIds.Add(child.Id);
        }
    }

    // Income/Expense configuration methods
    private async Task LoadIncomeExpenseConfiguration()
    {
        if (budget == null)
            return;

        isLoadingCategoryTypes = true;
        StateHasChanged();

        // Get category IDs assigned to this project
        var assignedCategoryIds = budget.CategoryAssignments.Select(ca => ca.CategoryId).ToHashSet();

        // Load all categories
        var allCategories = await BudgetService.GetAllCategoriesWithChildCountsAsync();

        // Build complete set: assigned categories + their ancestors + all descendants
        // Use HashSet of actual items to avoid ID collision issues
        var projectCategoryItems = new HashSet<CategoryGroupWithChildCount>();
        foreach (var assignedId in assignedCategoryIds)
        {
            // Assigned IDs should be CategoryGroups only - filter by ItemType to avoid ID collision
            var category = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == assignedId);
            if (category == null)
                continue; // Skip if not found as a CategoryGroup

            projectCategoryItems.Add(category);

            // Add all ancestors (for hierarchy display)
            var current = category;
            while (current != null && current.ParentCategoryGroupId.HasValue)
            {
                var parent = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == current.ParentCategoryGroupId.Value);
                if (parent != null)
                {
                    projectCategoryItems.Add(parent);
                    current = parent;
                }
                else
                {
                    break;
                }
            }

            // Add all descendants (sub-groups and sub-categories) using shared helper
            var descendants = CategoryGroupWithChildCount.CollectDescendants(assignedId, allCategories);
            foreach (var descendant in descendants)
            {
                projectCategoryItems.Add(descendant);
            }
        }

        var filteredCategories = projectCategoryItems
            .Where(c => c.Id != 1)
            .ToList();

        // Build hierarchy with levels
        incomeExpenseCategories = BuildHierarchy(filteredCategories);

        // Load category type assignments
        categoryTypeAssignments = await BudgetService.GetCategoryTypeAssignmentsAsync(BudgetId);

        isLoadingCategoryTypes = false;
        StateHasChanged();
    }

    private List<CategoryWithLevel> BuildHierarchy(List<CategoryGroupWithChildCount> categories)
    {
        var result = new List<CategoryWithLevel>();
        // Only check CategoryGroups for parent existence to avoid ID collision with Categories
        var roots = categories.Where(c => c.IsRootCategory || !categories.Any(x => x.ItemType == CategoryItemType.Group && x.Id == c.ParentCategoryGroupId)).ToList();

        foreach (var root in roots.OrderBy(c => c.Name))
        {
            AddCategoryWithChildren(root, 0, categories, result);
        }

        return result;
    }

    private void AddCategoryWithChildren(CategoryGroupWithChildCount category, int level, List<CategoryGroupWithChildCount> allCategories, List<CategoryWithLevel> result)
    {
        result.Add(new CategoryWithLevel { CategoryGroup = category, Level = level });

        // Only CategoryGroups can have children; Categories are leaf nodes
        // This prevents ID collision issues between Categories and CategoryGroups
        if (category.ItemType == CategoryItemType.Group)
        {
            var children = allCategories
                .Where(c => c.ParentCategoryGroupId == category.Id)
                .OrderBy(c => c.Name)
                .ToList();

            foreach (var child in children)
            {
                AddCategoryWithChildren(child, level + 1, allCategories, result);
            }
        }
    }

    private (bool IsIncome, bool IsInherited, bool IsExplicit) GetCategoryType(long categoryId, CategoryItemType itemType)
    {
        // Check if this item has an explicit assignment
        var explicitAssignment = categoryTypeAssignments.FirstOrDefault(a => a.CategoryId == categoryId && a.ItemType == itemType);
        if (explicitAssignment != null)
        {
            return (explicitAssignment.IsIncome, false, true);
        }

        // Check if any parent has an assignment (inheritance)
        var allCats = incomeExpenseCategories.Select(c => c.CategoryGroup).ToList();
        var currentItem = allCats.FirstOrDefault(c => c.Id == categoryId && c.ItemType == itemType);

        while (currentItem != null && currentItem.ParentCategoryGroupId.HasValue)
        {
            // Parents are always CategoryGroups
            var parentAssignment = categoryTypeAssignments.FirstOrDefault(a => a.CategoryId == currentItem.ParentCategoryGroupId.Value && a.ItemType == CategoryItemType.Group);
            if (parentAssignment != null)
            {
                return (parentAssignment.IsIncome, true, false);
            }
            // Move up to parent (which is always a CategoryGroup)
            currentItem = allCats.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == currentItem.ParentCategoryGroupId.Value);
        }

        // Default to expense
        return (false, false, false);
    }

    private List<(long Id, CategoryItemType ItemType)> GetAllDescendantItems(long categoryId, CategoryItemType itemType)
    {
        var result = new List<(long Id, CategoryItemType ItemType)>();

        // Only CategoryGroups can have children (Categories are leaf nodes)
        if (itemType != CategoryItemType.Group)
            return result;

        var allCats = incomeExpenseCategories.Select(c => c.CategoryGroup).ToList();
        var children = allCats.Where(c => c.ParentCategoryGroupId == categoryId).ToList();

        foreach (var child in children)
        {
            result.Add((child.Id, child.ItemType));

            // Only recurse for CategoryGroups (Categories are leaf nodes)
            if (child.ItemType == CategoryItemType.Group)
            {
                result.AddRange(GetAllDescendantItems(child.Id, child.ItemType));
            }
        }
        return result;
    }

    private async Task SetCategoryType(long categoryId, CategoryItemType itemType, bool isIncome)
    {
        // Set for this item
        await BudgetService.SetCategoryTypeAsync(BudgetId, categoryId, itemType, isIncome);

        // Clear explicit assignments for all descendants so they inherit
        var descendantItems = GetAllDescendantItems(categoryId, itemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(BudgetId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }

    private async Task ClearCategoryType(long categoryId, CategoryItemType itemType)
    {
        // Clear for this item
        await BudgetService.DeleteCategoryTypeAsync(BudgetId, categoryId, itemType);

        // Also clear for all descendants
        var descendantItems = GetAllDescendantItems(categoryId, itemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(BudgetId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }
}
