@page "/"
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Index> L

<PageTitle>@L["PageTitle"]</PageTitle>

@if (freshness != null)
{
    // One banner per registered source — multi-source installs need to see staleness per source
    // because each is uploaded independently.
    var nowUtc = DateTime.UtcNow;
    var showSourceLabel = freshness.Count > 1;
    foreach (var f in freshness)
    {
        var uploaded = f.DbUploadedUtc;
        var age = uploaded.HasValue ? nowUtc - uploaded.Value : (TimeSpan?)null;
        var errorAccounts = f.AccountsWithErrors.ToList();
        var isFresh = age is { TotalHours: <= 36 } && !errorAccounts.Any();
        if (isFresh) continue;

        string ageLabel = age.HasValue ? FormatRelativeAge(age.Value) : L["Freshness_Unknown"];
        string ageClass = age switch
        {
            null => "alert-warning",
            { TotalDays: > 7 } => "alert-danger",
            { TotalHours: > 36 } => "alert-warning",
            _ => "alert-secondary"
        };
        var errorKey = errorAccounts.Count == 1 ? "Freshness_RefreshErrors_One" : "Freshness_RefreshErrors_Other";
        <div class="alert @ageClass py-1 px-2 small mb-3 d-flex flex-wrap align-items-center gap-2">
            @if (showSourceLabel)
            {
                <span class="badge bg-secondary">@f.SourceName</span>
            }
            <span>@L["Freshness_Uploaded"] <strong>@ageLabel</strong>@(uploaded.HasValue ? $" ({uploaded.Value.ToLocalTime():yyyy-MM-dd HH:mm})" : "").</span>
            @if (errorAccounts.Any())
            {
                <span>
                    @L[errorKey, errorAccounts.Count]
                    @string.Join(", ", errorAccounts.Select(a => a.Name ?? $"#{a.AccountId}")).
                </span>
            }
        </div>
    }
}

@if (uncategorized != null)
{
    var showSourceLabel = uncategorized.Count > 1;
    foreach (var u in uncategorized.Values.Where(u => u.Count > 0))
    {
        string uncategorizedClass = u.Count switch
        {
            >= 50 => "alert-danger",
            >= 10 => "alert-warning",
            _ => "alert-secondary"
        };
        var uncategorizedKey = u.Count == 1 ? "Uncategorized_One" : "Uncategorized_Other";
        var sourceName = sourceNamesById.GetValueOrDefault(u.SourceId, $"#{u.SourceId}");
        <div class="alert @uncategorizedClass py-1 px-2 small mb-3 d-flex flex-wrap align-items-center gap-2">
            @if (showSourceLabel)
            {
                <span class="badge bg-secondary">@sourceName</span>
            }
            <span>@L[uncategorizedKey, u.Count, $"€{u.AbsoluteAmount.ToString("N2")}"]</span>
        </div>
    }
}

@{
    var anchorDate = new DateTime(anchor.Year, anchor.Month, 1);
    var headingText = period switch
    {
        "year" => L["Heading_Year", anchor.Year].Value,
        "ytd" => L["Heading_YTD", anchorDate.ToString("MMMM yyyy")].Value,
        _ => anchorDate.ToString("MMMM yyyy")
    };
}
<div class="d-flex flex-wrap mb-4 align-items-center gap-2">
    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="() => StepAnchor(-1)" aria-label="@L["Aria_Previous"]">
        <span class="oi oi-chevron-left" aria-hidden="true"></span>
    </button>
    <h3 class="mb-0 d-inline-flex align-items-center gap-2 position-relative"
        role="button" tabindex="0"
        style="cursor: pointer;"
        title="@L["Title_PickMonth"]"
        @onclick="OpenMonthPicker"
        @onkeydown="OnHeadingKey">
        <span>@headingText</span>
        <input @ref="monthInputRef" type="month"
               style="position: absolute; left: 50%; bottom: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; border: 0;"
               max="@MaxMonthValue"
               @bind="AnchorMonthValue" @bind:format="yyyy-MM" @bind:after="OnAnchorPicked"
               tabindex="-1" aria-hidden="true" />
    </h3>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="() => StepAnchor(1)" aria-label="@L["Aria_Next"]"
            disabled="@IsAtMaxAnchor">
        <span class="oi oi-chevron-right" aria-hidden="true"></span>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="GoToToday" disabled="@IsTodayAnchor">@L["Button_Today"]</button>
    <div>
        <div class="btn-group btn-group-sm" role="group" aria-label="@L["Aria_Period"]">
            <button type="button"
                    class="btn @(period == "month" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("month")'>@L["Button_Month"]</button>
            <button type="button"
                    class="btn @(period == "ytd" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("ytd")'>@L["Button_YTD"]</button>
            <button type="button"
                    class="btn @(period == "year" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("year")'>@L["Button_Year"]</button>
        </div>
    </div>
</div>

@if (budgetSummaries == null)
{
    <p><em>@L["Status_Loading"]</em></p>
}
else if (!budgetSummaries.Any())
{
    <div class="alert alert-info">
        <h4>@L["Welcome_Heading"]</h4>
        <p>@L["Welcome_Body"]</p>
    </div>
}
else
{
    <div class="row">
        @for (int i = 0; i < budgetSummaries.Count; i++)
        {
            var summary = budgetSummaries[i];
            var isFirst = i == 0;
            var isLast = i == budgetSummaries.Count - 1;
            var overallPercent = summary.TotalBudget > 0 ? (summary.TotalSpent / summary.TotalBudget * 100) : 0;
            string statusClass;
            if (summary.HasBudget)
            {
                statusClass = overallPercent > 100 ? "danger" : overallPercent > 80 ? "warning" : "success";
            }
            else
            {
                statusClass = summary.MonthNet >= 0 ? "success" : "danger";
            }
            var projectId = summary.ProjectId;

            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-@statusClass text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@summary.ProjectName</h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-link text-white p-0"
                                    title="@L["Aria_MoveUp"]" aria-label="@L["Aria_MoveUp"]"
                                    disabled="@isFirst"
                                    @onclick="() => MoveProject(projectId, -1)">
                                <span class="oi oi-chevron-top" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="btn btn-link text-white p-0"
                                    title="@L["Aria_MoveDown"]" aria-label="@L["Aria_MoveDown"]"
                                    disabled="@isLast"
                                    @onclick="() => MoveProject(projectId, 1)">
                                <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                            </button>
                            <a href="/projects/@projectId" class="text-white text-decoration-none" title="@L["Aria_ProjectSettings"]" aria-label="@L["Aria_ProjectSettings"]">
                                <span class="oi oi-cog" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @{
                            var balanceInfo = projectBalances.GetValueOrDefault(projectId);
                            var hasBalance = balanceInfo is { AccountCount: > 0 };
                        }
                        @if (hasBalance)
                        {
                            <div class="d-flex justify-content-between align-items-baseline pb-2 mb-3 border-bottom">
                                <div>
                                    <div class="text-muted small">@L["Label_CurrentBalance"]</div>
                                    <div class="h5 mb-0 text-nowrap @(balanceInfo!.Balance < 0 ? "text-danger" : "")">
                                        €@balanceInfo.Balance.ToString("N2")
                                    </div>
                                </div>
                                <div class="text-muted small">
                                    @L[balanceInfo.AccountCount == 1 ? "Label_Account_One" : "Label_Account_Other", balanceInfo.AccountCount]
                                </div>
                            </div>
                        }
                        @if (summary.HasBudget)
                        {
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Budget"]</div>
                                    <div class="h5 text-nowrap">€@summary.TotalBudget.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Spent"]</div>
                                    <div class="h5 text-nowrap text-@statusClass">€@summary.TotalSpent.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Remaining"]</div>
                                    <div class="h5 text-nowrap text-@statusClass">€@summary.TotalRemaining.ToString("N2")</div>
                                </div>
                            </div>

                            <div class="progress mb-3" style="height: 25px;">
                                <div class="progress-bar bg-@statusClass"
                                     role="progressbar"
                                     style="width: @(Math.Min(overallPercent, 100).ToString(CultureInfo.InvariantCulture))%"
                                     aria-valuenow="@overallPercent.ToString(CultureInfo.InvariantCulture)"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @overallPercent.ToString("F0")%
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Income"]</div>
                                    <div class="h5 text-nowrap text-success">€@summary.MonthIncome.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Expenses"]</div>
                                    <div class="h5 text-nowrap text-danger">€@summary.MonthExpenses.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">@L["Label_Net"]</div>
                                    <div class="h5 text-nowrap text-@statusClass">€@summary.MonthNet.ToString("N2")</div>
                                </div>
                            </div>
                            <p class="small text-muted mb-3">
                                @L[summary.IsSingleMonth ? "NoBudget_ThisMonth" : "NoBudget_YearToDate", summary.Year]
                            </p>
                        }

                        @{
                            var expenseCategories = summary.CategorySpending
                                .Where(c => !c.IsIncome)
                                .OrderByDescending(c => c.Spent)
                                .ToList();
                            var isExpanded = expanded.Contains(projectId);
                            var shownCategories = isExpanded ? expenseCategories : expenseCategories.Take(3).ToList();
                        }
                        @if (expenseCategories.Any())
                        {
                            <div class="mt-3">
                                <h6 class="text-muted">@(isExpanded ? L["Label_Categories"] : L["Label_TopCategories"])</h6>
                                @foreach (var cat in shownCategories)
                                {
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="small">@cat.CategoryName</span>
                                            @if (summary.HasBudget)
                                            {
                                                <span class="badge bg-@(cat.PercentUsed > 100 ? "danger" : cat.PercentUsed > 80 ? "warning" : "secondary")">
                                                    <span class="text-nowrap">€@cat.Spent.ToString("N2")</span> / <span class="text-nowrap">€@cat.Budget.ToString("N2")</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-nowrap">€@cat.Spent.ToString("N2")</span>
                                            }
                                        </div>
                                        @if (isExpanded && summary.HasBudget && cat.Budget > 0)
                                        {
                                            <div class="progress mt-1" style="height: 6px;">
                                                <div class="progress-bar bg-@(cat.PercentUsed > 100 ? "danger" : cat.PercentUsed > 80 ? "warning" : "success")"
                                                     role="progressbar"
                                                     style="width: @(Math.Min(cat.PercentUsed, 100).ToString(CultureInfo.InvariantCulture))%"
                                                     aria-valuenow="@cat.PercentUsed.ToString(CultureInfo.InvariantCulture)"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100"></div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (expenseCategories.Count > 3)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0"
                                            @onclick="() => ToggleExpanded(projectId)">
                                        @(isExpanded ? L["Button_ShowTop3"] : L["Button_ShowAll", expenseCategories.Count])
                                    </button>
                                }
                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">
                            <a href="/budgets?projectId=@summary.ProjectId" class="btn btn-sm btn-outline-primary flex-fill">@L["Button_Budgets"]</a>
                            <a href="/cashflow?projectId=@summary.ProjectId" class="btn btn-sm btn-outline-primary flex-fill">@L["Button_Cashflow"]</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <button class="btn btn-primary" @onclick="ShowCreateDialog">@L["Button_NewProject"]</button>
</div>

@if (showCreateDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Modal_CreateNewProject"]</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="projectName" class="form-label">@L["Form_NameLabel"]</label>
                        <input type="text" class="form-control" id="projectName" @bind="newProjectName" />
                    </div>
                    <div class="mb-3">
                        <label for="projectDescription" class="form-label">@L["Form_DescriptionLabel"]</label>
                        <textarea class="form-control" id="projectDescription" @bind="newProjectDescription" rows="3"></textarea>
                    </div>
                    @if (availableSources.Count > 1)
                    {
                        <div class="mb-3">
                            <label for="projectSource" class="form-label">MoneyMoney source</label>
                            <select id="projectSource" class="form-select" @bind="newProjectSourceId">
                                @foreach (var s in availableSources)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateDialog">@L["Button_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateProject" disabled="@string.IsNullOrWhiteSpace(newProjectName)">@L["Button_Create"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<ProjectSpendingSummary>? budgetSummaries;
    private Dictionary<int, ProjectBalanceSummary> projectBalances = new();
    private List<DataFreshness>? freshness;
    private Dictionary<int, UncategorizedSummary>? uncategorized;
    private List<ImportSource> availableSources = new();
    private Dictionary<int, string> sourceNamesById = new();
    private bool showCreateDialog = false;
    private string newProjectName = "";
    private string newProjectDescription = "";
    private int newProjectSourceId = SourceScope.LegacySourceId;

    // "month" = anchor month only, "ytd" = Jan..anchor.Month of anchor.Year,
    // "year" = full anchor year (Jan..Dec). Default is "month".
    private string period = "month";

    // The user-selected reference point. Drives both the heading and the range
    // passed to GetSpendingSummaryAsync — period reinterprets this anchor.
    private (int Year, int Month) anchor;

    private ElementReference monthInputRef;

    // Project IDs whose category list is expanded to show all rows. Persisted in the URL
    // so a shared link can come up pre-expanded.
    private HashSet<int> expanded = new();

    protected override async Task OnInitializedAsync()
    {
        ReadStateFromQuery();
        await LoadDashboard();
    }

    private void ReadStateFromQuery()
    {
        var now = DateTime.Now;
        anchor = (now.Year, now.Month);

        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("period", out var p))
        {
            var v = p.ToString();
            if (v is "month" or "ytd" or "year") period = v;
        }

        expanded = new HashSet<int>();
        if (query.TryGetValue("expanded", out var ex) && !string.IsNullOrWhiteSpace(ex))
        {
            foreach (var part in ex.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (int.TryParse(part, out var id)) expanded.Add(id);
            }
        }

        int year = anchor.Year;
        int month = anchor.Month;
        if (query.TryGetValue("year", out var y) && int.TryParse(y, out var py) && py >= 1900 && py <= now.Year)
            year = py;
        if (query.TryGetValue("month", out var m) && int.TryParse(m, out var pm) && pm >= 1 && pm <= 12)
            month = pm;

        // Clamp future anchors back to current — never serve a future view.
        var picked = new DateTime(year, month, 1);
        var max = new DateTime(now.Year, now.Month, 1);
        if (picked > max) picked = max;
        anchor = (picked.Year, picked.Month);
    }

    private void UpdateUrl()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["year"] = anchor.Year,
            ["month"] = anchor.Month,
            ["period"] = period,
            ["expanded"] = expanded.Count == 0 ? null : string.Join(",", expanded.OrderBy(i => i)),
        });
        // Guard against prerender redirect loops and stray no-op navigations: only push when
        // the target URL actually differs from the current one. During ServerPrerendered,
        // NavigateTo becomes a 302 — issuing it for an identical URL would loop forever.
        if (uri == Navigation.Uri) return;
        Navigation.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private void ToggleExpanded(int projectId)
    {
        if (!expanded.Add(projectId)) expanded.Remove(projectId);
        UpdateUrl();
    }

    private async Task LoadDashboard()
    {
        var projects = await BudgetService.GetProjectsAsync();
        budgetSummaries = new List<ProjectSpendingSummary>();

        // - month: just the anchor month's slice of the budget vs that month's actuals
        // - ytd:   Jan..anchor.Month on both sides — "am I on pace?"
        // - year:  full annual budget (Jan..Dec) vs actuals through anchor's year.
        //         Year mode summing through December is safe: future months have no
        //         transactions yet, so spent collapses to actuals-to-date anyway.
        var (fromMonth, toMonth) = period switch
        {
            "year" => (1, 12),
            "ytd" => (1, anchor.Month),
            _ => (anchor.Month, anchor.Month)
        };

        foreach (var project in projects)
        {
            try
            {
                var summary = await BudgetService.GetSpendingSummaryAsync(project.Id, anchor.Year, fromMonth, toMonth);
                budgetSummaries.Add(summary);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading summary for project {project.Id}: {ex.Message}");
            }
        }

        // Period-independent: linked-account balances are the same regardless of month/YTD/year.
        projectBalances = await BudgetService.GetAllProjectsBalancesAsync();

        // Period-independent: data freshness reflects the most recent upload + per-account
        // refresh state. Surfaced at the top of the page so stale numbers can't masquerade as
        // current.
        freshness = await BudgetService.GetDataFreshnessAsync();
        uncategorized = await BudgetService.GetUncategorizedTransactionSummaryAsync();
        availableSources = await BudgetService.GetAllSourcesAsync();
        sourceNamesById = availableSources.ToDictionary(s => s.Id, s => s.Name);
        if (!availableSources.Any(s => s.Id == newProjectSourceId))
        {
            newProjectSourceId = availableSources.FirstOrDefault()?.Id ?? SourceScope.LegacySourceId;
        }
    }

    private string FormatRelativeAge(TimeSpan age)
    {
        if (age.TotalSeconds < 0) return L["RelativeAge_Future"];
        if (age.TotalMinutes < 1) return L["RelativeAge_JustNow"];
        if (age.TotalHours < 1) return L["RelativeAge_MinutesAgo", (int)age.TotalMinutes];
        if (age.TotalDays < 1) return L["RelativeAge_HoursAgo", (int)age.TotalHours];
        if (age.TotalDays < 30) return L["RelativeAge_DaysAgo", (int)age.TotalDays];
        return L["RelativeAge_MonthsAgo", (int)(age.TotalDays / 30)];
    }

    private async Task SetPeriod(string value)
    {
        if (period == value) return;
        period = value;
        UpdateUrl();
        budgetSummaries = null;
        await LoadDashboard();
    }

    private string MaxMonthValue
    {
        get
        {
            var now = DateTime.Now;
            return $"{now.Year:D4}-{now.Month:D2}";
        }
    }

    private DateTime AnchorMonthValue
    {
        get => new DateTime(anchor.Year, anchor.Month, 1);
        set
        {
            var now = DateTime.Now;
            var max = new DateTime(now.Year, now.Month, 1);
            var dt = value > max ? max : new DateTime(value.Year, value.Month, 1);
            anchor = (dt.Year, dt.Month);
        }
    }

    private bool IsAtMaxAnchor
    {
        get
        {
            var now = DateTime.Now;
            if (period == "year") return anchor.Year >= now.Year;
            return anchor.Year > now.Year || (anchor.Year == now.Year && anchor.Month >= now.Month);
        }
    }

    private bool IsTodayAnchor
    {
        get
        {
            var now = DateTime.Now;
            return anchor.Year == now.Year && anchor.Month == now.Month;
        }
    }

    private async Task StepAnchor(int direction)
    {
        var dt = new DateTime(anchor.Year, anchor.Month, 1);
        dt = period == "year" ? dt.AddYears(direction) : dt.AddMonths(direction);
        var now = DateTime.Now;
        var max = new DateTime(now.Year, now.Month, 1);
        if (dt > max) dt = max;
        if (dt.Year < 1900) return;
        if (dt.Year == anchor.Year && dt.Month == anchor.Month) return;
        anchor = (dt.Year, dt.Month);
        UpdateUrl();
        budgetSummaries = null;
        await LoadDashboard();
    }

    private async Task GoToToday()
    {
        var now = DateTime.Now;
        if (anchor.Year == now.Year && anchor.Month == now.Month) return;
        anchor = (now.Year, now.Month);
        UpdateUrl();
        budgetSummaries = null;
        await LoadDashboard();
    }

    private async Task OpenMonthPicker()
    {
        await JS.InvokeVoidAsync("showPickerOn", monthInputRef);
    }

    private async Task OnAnchorPicked()
    {
        UpdateUrl();
        budgetSummaries = null;
        await LoadDashboard();
    }

    private async Task OnHeadingKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            await OpenMonthPicker();
        }
    }

    private async Task MoveProject(int projectId, int direction)
    {
        await BudgetService.MoveProjectAsync(projectId, direction);
        await LoadDashboard();
    }

    private void ShowCreateDialog()
    {
        newProjectName = "";
        newProjectDescription = "";
        showCreateDialog = true;
    }

    private void HideCreateDialog()
    {
        showCreateDialog = false;
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName))
            return;

        var sourceId = availableSources.Any(s => s.Id == newProjectSourceId)
            ? newProjectSourceId
            : (availableSources.FirstOrDefault()?.Id ?? SourceScope.LegacySourceId);
        await BudgetService.CreateProjectAsync(newProjectName, sourceId, newProjectDescription);
        showCreateDialog = false;
        await LoadDashboard();
    }
}
