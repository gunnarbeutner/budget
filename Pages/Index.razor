@page "/"
@using OpenBudget.Services
@using OpenBudget.Models
@inject BudgetService BudgetService
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="row mb-4 align-items-center">
    <div class="col">
        <h3 class="mb-0">
            @(period switch
            {
                "year" => $"Year {DateTime.Now.Year}",
                "ytd" => $"YTD {DateTime.Now.Year}",
                _ => DateTime.Now.ToString("MMMM yyyy")
            })
        </h3>
    </div>
    <div class="col-auto">
        <div class="btn-group btn-group-sm" role="group" aria-label="Period">
            <button type="button"
                    class="btn @(period == "month" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("month")'>Month</button>
            <button type="button"
                    class="btn @(period == "ytd" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("ytd")'>YTD</button>
            <button type="button"
                    class="btn @(period == "year" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SetPeriod("year")'>Year</button>
        </div>
    </div>
</div>

@if (budgetSummaries == null)
{
    <p><em>Loading project data...</em></p>
}
else if (!budgetSummaries.Any())
{
    <div class="alert alert-info">
        <h4>Welcome to MoneyMoney Budget Tracker!</h4>
        <p>You don't have any projects yet. Click "New Project" below to get started.</p>
    </div>
}
else
{
    <div class="row">
        @for (int i = 0; i < budgetSummaries.Count; i++)
        {
            var summary = budgetSummaries[i];
            var isFirst = i == 0;
            var isLast = i == budgetSummaries.Count - 1;
            var overallPercent = summary.TotalBudget > 0 ? (summary.TotalSpent / summary.TotalBudget * 100) : 0;
            string statusClass;
            if (summary.HasBudget)
            {
                statusClass = overallPercent > 100 ? "danger" : overallPercent > 80 ? "warning" : "success";
            }
            else
            {
                statusClass = summary.MonthNet >= 0 ? "success" : "danger";
            }
            var projectId = summary.ProjectId;

            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-@statusClass text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@summary.ProjectName</h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-link text-white p-0"
                                    title="Move up" aria-label="Move up"
                                    disabled="@isFirst"
                                    @onclick="() => MoveProject(projectId, -1)">
                                <span class="oi oi-chevron-top" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="btn btn-link text-white p-0"
                                    title="Move down" aria-label="Move down"
                                    disabled="@isLast"
                                    @onclick="() => MoveProject(projectId, 1)">
                                <span class="oi oi-chevron-bottom" aria-hidden="true"></span>
                            </button>
                            <a href="/projects/@projectId" class="text-white text-decoration-none" title="Project settings" aria-label="Project settings">
                                <span class="oi oi-cog" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (summary.HasBudget)
                        {
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="text-muted small">Budget</div>
                                    <div class="h5">€@summary.TotalBudget.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Spent</div>
                                    <div class="h5 text-@statusClass">€@summary.TotalSpent.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Remaining</div>
                                    <div class="h5 text-@statusClass">€@summary.TotalRemaining.ToString("N2")</div>
                                </div>
                            </div>

                            <div class="progress mb-3" style="height: 25px;">
                                <div class="progress-bar bg-@statusClass"
                                     role="progressbar"
                                     style="width: @Math.Min(overallPercent, 100)%"
                                     aria-valuenow="@overallPercent"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @overallPercent.ToString("F0")%
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="text-muted small">Income</div>
                                    <div class="h5 text-success">€@summary.MonthIncome.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Expenses</div>
                                    <div class="h5 text-danger">€@summary.MonthExpenses.ToString("N2")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Net</div>
                                    <div class="h5 text-@statusClass">€@summary.MonthNet.ToString("N2")</div>
                                </div>
                            </div>
                            <p class="small text-muted mb-3">
                                No budget for @summary.Year — showing @(summary.IsSingleMonth ? "this month's" : "year-to-date") actuals.
                            </p>
                        }

                        @{
                            var topCategories = summary.CategorySpending
                                .Where(c => !c.IsIncome)
                                .OrderByDescending(c => c.Spent)
                                .Take(3)
                                .ToList();
                        }
                        @if (topCategories.Any())
                        {
                            <div class="mt-3">
                                <h6 class="text-muted">Top Categories:</h6>
                                @foreach (var cat in topCategories)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small">@cat.CategoryName</span>
                                        @if (summary.HasBudget)
                                        {
                                            <span class="badge bg-@(cat.PercentUsed > 100 ? "danger" : cat.PercentUsed > 80 ? "warning" : "secondary")">
                                                €@cat.Spent.ToString("N2") / €@cat.Budget.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">€@cat.Spent.ToString("N2")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-3 d-flex gap-2">
                            <a href="/analysis?projectId=@summary.ProjectId" class="btn btn-sm btn-outline-primary flex-fill">Analysis</a>
                            <a href="/cashflow?projectId=@summary.ProjectId" class="btn btn-sm btn-outline-primary flex-fill">Cashflow</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <button class="btn btn-primary" @onclick="ShowCreateDialog">New Project</button>
</div>

@if (showCreateDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Project</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="projectName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="projectName" @bind="newProjectName" />
                    </div>
                    <div class="mb-3">
                        <label for="projectDescription" class="form-label">Description (optional)</label>
                        <textarea class="form-control" id="projectDescription" @bind="newProjectDescription" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateProject" disabled="@string.IsNullOrWhiteSpace(newProjectName)">Create</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<ProjectSpendingSummary>? budgetSummaries;
    private bool showCreateDialog = false;
    private string newProjectName = "";
    private string newProjectDescription = "";

    // "month" = current month, "ytd" = Jan..currentMonth (year-to-date budget vs YTD actuals),
    // "year" = full annual budget vs YTD actuals. Default is "month".
    private string period = "month";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        var projects = await BudgetService.GetProjectsAsync();
        budgetSummaries = new List<ProjectSpendingSummary>();

        var now = DateTime.UtcNow;
        // - month: just this month's slice of the budget vs this month's actuals
        // - ytd:   Jan..currentMonth on both sides — "am I on pace?"
        // - year:  full annual budget (Jan..Dec) vs YTD actuals — "how much remains?"
        //         Year mode summing through December is safe: future months have no
        //         transactions yet, so spent collapses to YTD anyway.
        var (fromMonth, toMonth) = period switch
        {
            "year" => (1, 12),
            "ytd" => (1, now.Month),
            _ => (now.Month, now.Month)
        };

        foreach (var project in projects)
        {
            try
            {
                var summary = await BudgetService.GetSpendingSummaryAsync(project.Id, now.Year, fromMonth, toMonth);
                budgetSummaries.Add(summary);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading summary for project {project.Id}: {ex.Message}");
            }
        }
    }

    private async Task SetPeriod(string value)
    {
        if (period == value) return;
        period = value;
        budgetSummaries = null;
        await LoadDashboard();
    }

    private async Task MoveProject(int projectId, int direction)
    {
        await BudgetService.MoveProjectAsync(projectId, direction);
        await LoadDashboard();
    }

    private void ShowCreateDialog()
    {
        newProjectName = "";
        newProjectDescription = "";
        showCreateDialog = true;
    }

    private void HideCreateDialog()
    {
        showCreateDialog = false;
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName))
            return;

        await BudgetService.CreateProjectAsync(newProjectName, newProjectDescription);
        showCreateDialog = false;
        await LoadDashboard();
    }
}
