@page "/budgets/{BudgetId:int}/edit"
@using OpenBudget.Services
@using OpenBudget.Models
@inject BudgetService BudgetService
@inject NavigationManager Navigation
@inject IStringLocalizer<BudgetEdit> L

<PageTitle>@(budget != null ? L["PageTitle_WithName", budget.Project?.Name ?? "", budget.Name ?? ""] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <h1>@L["NotFound_Heading"]</h1>
    <p class="text-muted">@L["NotFound_Body_Before", BudgetId] <a href="/">@L["NotFound_BackLink"]</a>.</p>
    return;
}

@if (budget == null)
{
    <p><em>@L["Status_Loading"]</em></p>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@L["Header_Title"] @budget.Project?.Name <small class="text-muted">@budget.Name</small></h1>
        @if (budget.LastModifiedAt.HasValue)
        {
            <small class="text-muted">@L["Header_LastModified", budget.LastModifiedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")]</small>
        }
    </div>
    <a href="/budgets?projectId=@budget.ProjectId" class="btn btn-secondary">@L["Button_BackToBudgets"]</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">@L["Form_NameLabel"]</label>
                <input type="text" class="form-control" maxlength="200" @bind="budget.Name" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Form_YearLabel"]</label>
                <input type="number" class="form-control" min="2000" max="2100" @bind="budget.Year" />
            </div>
            <div class="col-md-5">
                <label class="form-label">@L["Form_NotesLabel"]</label>
                <input type="text" class="form-control" @bind="budget.Notes" />
            </div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="budget-active" @bind="budget.IsActive" />
            <label class="form-check-label" for="budget-active">
                @L["Form_ActiveLabel", budget.Year]
            </label>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@L["Section_MonthlyAmounts"]</h5>
        <div class="d-flex gap-2">
            @if (availableToAdd.Any())
            {
                <select class="form-select form-select-sm" @bind="addSelection" style="min-width: 280px;">
                    <option value="">@L["Picker_AddTrackedItem"]</option>
                    @foreach (var key in availableToAdd.OrderBy(k => addCandidateNames.GetValueOrDefault(k, "")))
                    {
                        <option value="@SerializeKey(key)">@addCandidateNames.GetValueOrDefault(key, L["Picker_Unknown"])</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddSelected" disabled="@string.IsNullOrEmpty(addSelection)">@L["Button_Add"]</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="ShowRepredictDialog" disabled="@(editingEntries.Count == 0)">@L["Button_Repredict"]</button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (editingEntries.Count == 0)
        {
            <p class="text-muted m-3">@L["Empty_NoRows"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@L["Table_Category"]</th>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <th class="text-end">@(new DateTime(2000, m, 1).ToString("MMM"))</th>
                            }
                            <th class="text-end">@L["Table_Total"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (key, amounts) in editingEntries.OrderBy(e => categoryNames.GetValueOrDefault(e.Key, "")))
                        {
                            <tr>
                                <td>@categoryNames.GetValueOrDefault(key, L["Picker_Unknown"])</td>
                                @for (int m = 0; m < 12; m++)
                                {
                                    var idx = m;
                                    <td class="text-end">
                                        <input type="number" class="form-control form-control-sm"
                                               style="width: 80px; text-align: right;"
                                               step="0.01"
                                               @bind="amounts[idx]" />
                                    </td>
                                }
                                <td class="text-end"><strong>€@amounts.Sum().ToString("N2")</strong></td>
                                <td>
                                    <button class="btn btn-sm btn-link text-danger p-0"
                                            title="@L["Button_RemoveRow"]"
                                            @onclick="() => RemoveRow(key)">×</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-primary">
                            <th>@L["Table_Total"]</th>
                            @for (int m = 0; m < 12; m++)
                            {
                                var idx = m;
                                <th class="text-end">€@editingEntries.Values.Sum(a => a[idx]).ToString("N2")</th>
                            }
                            <th class="text-end">€@editingEntries.Values.Sum(a => a.Sum()).ToString("N2")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">@(isSaving ? L["Button_Saving"] : L["Button_Save"])</button>
    <a href="/budgets?projectId=@budget.ProjectId" class="btn btn-secondary">@L["Button_Cancel"]</a>
</div>

@if (showRepredictDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Modal_RepredictTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="HideRepredictDialog"></button>
                </div>
                <div class="modal-body">
                    <p>@L["Modal_RepredictBody"]</p>
                    <p class="text-muted small mb-0">@L["Modal_RepredictHint"]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="HideRepredictDialog">@L["Button_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="Repredict">@L["Button_Repredict"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Parameter] public int BudgetId { get; set; }

    private Budget? budget;
    private bool notFound = false;
    private bool isSaving = false;
    private bool showRepredictDialog = false;

    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]> editingEntries = new();
    private Dictionary<(long Id, CategoryItemType ItemType), string> categoryNames = new();
    private List<(long Id, CategoryItemType ItemType)> availableToAdd = new();
    private Dictionary<(long Id, CategoryItemType ItemType), string> addCandidateNames = new();
    private string addSelection = "";

    // Cached lookups so Re-predict / Add doesn't rehit the DB for naming.
    private Dictionary<long, CategoryGroup> groupById = new();
    private Dictionary<long, Category> categoryById = new();

    protected override async Task OnInitializedAsync()
    {
        budget = await BudgetService.GetBudgetAsync(BudgetId);
        if (budget == null)
        {
            notFound = true;
            return;
        }

        await LoadHierarchyLookups();

        editingEntries = budget.MonthlyEntries.ToDictionary(
            e => (e.CategoryId, e.ItemType),
            e => new[]
            {
                e.Month1, e.Month2, e.Month3, e.Month4, e.Month5, e.Month6,
                e.Month7, e.Month8, e.Month9, e.Month10, e.Month11, e.Month12
            });

        await RefreshNamesAndCandidates();
    }

    private async Task LoadHierarchyLookups()
    {
        var sourceId = budget?.Project?.SourceId ?? SourceScope.LegacySourceId;
        var hierarchy = await BudgetService.GetAllCategoriesWithChildCountsAsync(sourceId);
        groupById = hierarchy
            .Where(c => c.ItemType == CategoryItemType.Group)
            .ToDictionary(c => c.Id, c => c.CategoryGroup);

        var categories = await BudgetService.GetAllCategoriesAsync(sourceId);
        categoryById = categories.ToDictionary(c => c.Id, c => c);
    }

    private async Task RefreshNamesAndCandidates()
    {
        if (budget == null) return;

        // Compute labels for the rows currently in the editor and prefix parent names
        // only when base names collide (mirrors BudgetWizard).
        var labels = new List<((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName)>();
        foreach (var key in editingEntries.Keys)
        {
            labels.Add(BuildLabel(key));
        }

        var nameCounts = labels
            .GroupBy(l => l.BaseName)
            .ToDictionary(g => g.Key, g => g.Count());

        categoryNames = labels.ToDictionary(
            l => l.Key,
            l => nameCounts[l.BaseName] > 1 && !string.IsNullOrEmpty(l.ParentName)
                ? $"{l.ParentName} › {l.BaseName}"
                : l.BaseName);

        // Build the "Add tracked item" list — project tracking items that aren't already in the editor.
        var trackingItems = await BudgetService.GetProjectTrackingItemsAsync(budget.ProjectId);
        availableToAdd.Clear();
        addCandidateNames.Clear();

        foreach (var ti in trackingItems)
        {
            (long Id, CategoryItemType ItemType)? candidate = null;
            if (ti.CategoryGroupId.HasValue)
                candidate = (ti.CategoryGroupId.Value, CategoryItemType.Group);
            else if (ti.CategoryId.HasValue)
                candidate = (ti.CategoryId.Value, CategoryItemType.Category);
            if (candidate == null) continue;
            if (editingEntries.ContainsKey(candidate.Value)) continue;

            availableToAdd.Add(candidate.Value);
        }

        // Apply the same collision logic to the candidates so the picker labels stay consistent.
        var candidateLabels = availableToAdd.Select(BuildLabel).ToList();
        var candidateCounts = candidateLabels
            .GroupBy(l => l.BaseName)
            .ToDictionary(g => g.Key, g => g.Count());
        addCandidateNames = candidateLabels.ToDictionary(
            l => l.Key,
            l => candidateCounts[l.BaseName] > 1 && !string.IsNullOrEmpty(l.ParentName)
                ? $"{l.ParentName} › {l.BaseName}"
                : l.BaseName);
    }

    private ((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName) BuildLabel(
        (long Id, CategoryItemType ItemType) key)
    {
        if (key.ItemType == CategoryItemType.Group)
        {
            if (groupById.TryGetValue(key.Id, out var g))
            {
                var parentName = g.ParentGroupId.HasValue
                    && groupById.TryGetValue(g.ParentGroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                return (key, g.Name ?? L["Picker_Unknown"], parentName);
            }
        }
        else if (categoryById.TryGetValue(key.Id, out var cat))
        {
            var parentName = cat.GroupId.HasValue
                && groupById.TryGetValue(cat.GroupId.Value, out var parent)
                ? parent.Name
                : null;
            return (key, cat.Name ?? L["Picker_Unknown"], parentName);
        }
        return (key, L["Picker_Unknown"], null);
    }

    private void RemoveRow((long Id, CategoryItemType ItemType) key)
    {
        editingEntries.Remove(key);
        _ = RefreshNamesAndCandidates();
    }

    private async Task AddSelected()
    {
        if (string.IsNullOrEmpty(addSelection)) return;
        if (!TryDeserializeKey(addSelection, out var key)) return;
        if (editingEntries.ContainsKey(key)) return;

        editingEntries[key] = new decimal[12];
        addSelection = "";
        await RefreshNamesAndCandidates();
    }

    private void ShowRepredictDialog() => showRepredictDialog = true;
    private void HideRepredictDialog() => showRepredictDialog = false;

    private async Task Repredict()
    {
        if (budget == null) { showRepredictDialog = false; return; }

        var sourceId = budget.Project?.SourceId ?? SourceScope.LegacySourceId;
        foreach (var key in editingEntries.Keys.ToList())
        {
            var predicted = key.ItemType == CategoryItemType.Group
                ? await BudgetService.PredictMonthlySpendingForCategoryAsync(key.Id, budget.Year, sourceId)
                : await BudgetService.PredictMonthlySpendingForLeafCategoryAsync(key.Id, budget.Year, sourceId);
            editingEntries[key] = predicted.Select(p => Math.Round(p, 2)).ToArray();
        }
        showRepredictDialog = false;
    }

    private async Task Save()
    {
        if (budget == null) return;
        isSaving = true;
        try
        {
            await BudgetService.UpdateBudgetAsync(budget);
            var entries = editingEntries
                .Select(kvp => (kvp.Key.Id, kvp.Key.ItemType, kvp.Value))
                .ToList();
            await BudgetService.SaveBudgetEntriesAsync(BudgetId, entries);
            Navigation.NavigateTo($"/budgets?projectId={budget.ProjectId}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string SerializeKey((long Id, CategoryItemType ItemType) key)
        => $"{(int)key.ItemType}:{key.Id}";

    private static bool TryDeserializeKey(string s, out (long Id, CategoryItemType ItemType) key)
    {
        key = default;
        var parts = s.Split(':');
        if (parts.Length != 2) return false;
        if (!int.TryParse(parts[0], out var typeInt)) return false;
        if (!long.TryParse(parts[1], out var id)) return false;
        key = (id, (CategoryItemType)typeInt);
        return true;
    }
}
