@page "/budgets/{BudgetId:int}/edit"
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.JSInterop
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject BudgetEntryService BudgetEntryService
@inject BudgetPredictionService BudgetPredictionService
@inject CategoryHierarchyService CategoryHierarchyService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<BudgetEdit> L

<PageTitle>@(budget != null ? L["PageTitle_WithName", budget.Project?.Name ?? "", budget.Name ?? ""] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <h1>@L["NotFound_Heading"]</h1>
    <p class="text-muted">@L["NotFound_Body_Before", BudgetId] <a href="/">@L["NotFound_BackLink"]</a>.</p>
    return;
}

@if (budget == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line-lg mb-3" style="width: 40%;"></div>
        <div class="card mb-3">
            <div class="card-body">
                <div class="skeleton skeleton-line mb-2" style="width: 60%;"></div>
                <div class="skeleton skeleton-line" style="width: 30%;"></div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">@L["Header_Title"] @budget.Project?.Name <small class="text-muted">@budget.Name</small></h1>
        @if (budget.LastModifiedAt.HasValue)
        {
            <small class="text-muted">@L["Header_LastModified", budget.LastModifiedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")]</small>
        }
    </div>
    <a href="/budgets?projectId=@budget.ProjectId" class="btn btn-secondary">@L["Button_BackToBudgets"]</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">@L["Form_NameLabel"]</label>
                <input type="text" class="form-control" maxlength="200" @bind="budget.Name" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Form_YearLabel"]</label>
                <input type="number" class="form-control" min="2000" max="2100" @bind="budget.Year" />
            </div>
            <div class="col-md-5">
                <label class="form-label">@L["Form_NotesLabel"]</label>
                <input type="text" class="form-control" @bind="budget.Notes" />
            </div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="budget-active" @bind="budget.IsActive" />
            <label class="form-check-label" for="budget-active">
                @L["Form_ActiveLabel", budget.Year]
            </label>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@L["Section_MonthlyAmounts"]</h5>
        <div class="d-flex gap-2">
            @if (availableToAdd.Any())
            {
                <select class="form-select form-select-sm" @bind="addSelection" style="min-width: 280px;">
                    <option value="">@L["Picker_AddTrackedItem"]</option>
                    @foreach (var key in availableToAdd.OrderBy(k => addCandidateNames.GetValueOrDefault(k, "")))
                    {
                        <option value="@SerializeKey(key)">@addCandidateNames.GetValueOrDefault(key, L["Picker_Unknown"])</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="AddSelected" disabled="@string.IsNullOrEmpty(addSelection)">@L["Button_Add"]</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="ShowRepredictDialog" disabled="@(editingEntries.Count == 0)">@L["Button_Repredict"]</button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (editingEntries.Count == 0)
        {
            <p class="text-muted m-3">@L["Empty_NoRows"]</p>
        }
        else
        {
            // Effective amounts already reflect the auto-summed group totals; sum at level-0
            // rows in each section avoids double-counting once descendants roll into their group.
            decimal SectionMonth(List<TrackedRowNode> nodes, int idx) =>
                nodes.Where(n => n.Level == 0).Sum(n => GetEffective(n.Key)[idx]);
            decimal SectionYear(List<TrackedRowNode> nodes) =>
                nodes.Where(n => n.Level == 0).Sum(n => GetEffective(n.Key).Sum());

            var incomeYear = SectionYear(incomeTree);
            var expenseYear = SectionYear(expenseTree);

            RenderFragment<TrackedRowNode> RowTr = node =>
                @<tr class="@(IsShadow(node.Key) ? "table-light" : "")">
                    <td title="@categoryFullPaths.GetValueOrDefault(node.Key, "")"
                        style="@($"padding-left: {0.5 + node.Level * 1.25}rem; white-space: nowrap;")">
                        @if (node.HasChildren)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 me-1"
                                    style="text-decoration: none;"
                                    @onclick="() => ToggleExpand(node.Key)"
                                    title="@(expandedKeys.Contains(node.Key) ? L["Button_Collapse"] : L["Button_Expand"])">
                                @(expandedKeys.Contains(node.Key) ? "▾" : "▸")
                            </button>
                        }
                        <span class="@(IsAutoSummed(node.Key) ? "text-muted" : "") @(IsShadow(node.Key) ? "fst-italic text-muted" : "")">
                            @categoryNames.GetValueOrDefault(node.Key, L["Picker_Unknown"])
                        </span>
                    </td>
                    @{
                        var isShadowRow = IsShadow(node.Key);
                        var isVirtualRow = IsVirtual(node.Key);
                        var monthsForDisplay = IsAutoSummed(node.Key)
                            ? GetEffective(node.Key)
                            : (isShadowRow ? shadowEntries[node.Key] : editingEntries[node.Key]);
                        // Virtual rows are auto-summed parent groups; their inputs are always read-only.
                        var readOnly = IsAutoSummed(node.Key) || isVirtualRow;
                    }
                    @for (int m = 0; m < 12; m++)
                    {
                        var idx = m;
                        <td class="text-end">
                            @if (readOnly)
                            {
                                <input type="number" class="form-control form-control-sm text-muted"
                                       style="min-width: 80px; text-align: right;"
                                       step="0.01"
                                       readonly
                                       value="@monthsForDisplay[idx].ToString("0.##")" />
                            }
                            else if (isShadowRow)
                            {
                                <input type="number" class="form-control form-control-sm"
                                       style="min-width: 80px; text-align: right;"
                                       step="0.01"
                                       placeholder="0"
                                       @bind="shadowEntries[node.Key][idx]"
                                       @bind:after="() => OnShadowMonthsChanged(node.Key)" />
                            }
                            else
                            {
                                <input type="number" class="form-control form-control-sm"
                                       style="min-width: 80px; text-align: right;"
                                       step="0.01"
                                       @bind="editingEntries[node.Key][idx]"
                                       @bind:after="OnMonthsChanged" />
                            }
                        </td>
                    }
                    <td class="text-end"><strong>€@monthsForDisplay.Sum().ToString("N2")</strong></td>
                    <td>
                        @if (!isShadowRow && !isVirtualRow)
                        {
                            <button class="btn btn-sm btn-link text-danger p-0"
                                    title="@L["Button_RemoveRow"]"
                                    @onclick="() => RemoveRow(node.Key)">×</button>
                        }
                    </td>
                </tr>;

            <div class="budget-table-wrap">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@L["Table_Category"]</th>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <th class="text-center">@(new DateTime(2000, m, 1).ToString("MMM"))</th>
                            }
                            <th class="text-end">@L["Table_Total"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    @if (incomeTree.Any())
                    {
                        <tbody>
                            <tr class="table-secondary">
                                <th colspan="15">@L["Section_Income"]</th>
                            </tr>
                            @foreach (var node in incomeTree.Where(IsRowVisible))
                            {
                                @RowTr(node)
                            }
                            <tr class="table-primary">
                                <th>@L["Subtotal_Income"]</th>
                                @for (int m = 0; m < 12; m++)
                                {
                                    <th class="text-end">€@SectionMonth(incomeTree, m).ToString("N2")</th>
                                }
                                <th class="text-end">€@incomeYear.ToString("N2")</th>
                                <th></th>
                            </tr>
                        </tbody>
                    }
                    @if (expenseTree.Any())
                    {
                        <tbody>
                            <tr class="table-secondary">
                                <th colspan="15">@L["Section_Expenses"]</th>
                            </tr>
                            @foreach (var node in expenseTree.Where(IsRowVisible))
                            {
                                @RowTr(node)
                            }
                            <tr class="table-primary">
                                <th>@L["Subtotal_Expenses"]</th>
                                @for (int m = 0; m < 12; m++)
                                {
                                    <th class="text-end">€@SectionMonth(expenseTree, m).ToString("N2")</th>
                                }
                                <th class="text-end">€@expenseYear.ToString("N2")</th>
                                <th></th>
                            </tr>
                        </tbody>
                    }
                    @if (incomeTree.Any() && expenseTree.Any())
                    {
                        var netYear = incomeYear - expenseYear;
                        var netClass = netYear >= 0 ? "text-success" : "text-danger";
                        <tfoot>
                            <tr>
                                <th>@L["Net"]</th>
                                @for (int m = 0; m < 12; m++)
                                {
                                    var net = SectionMonth(incomeTree, m) - SectionMonth(expenseTree, m);
                                    var cls = net >= 0 ? "text-success" : "text-danger";
                                    <th class="text-end @cls">€@net.ToString("N2")</th>
                                }
                                <th class="text-end @netClass">€@netYear.ToString("N2")</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">@(isSaving ? L["Button_Saving"] : L["Button_Save"])</button>
    <a href="/budgets?projectId=@budget.ProjectId" class="btn btn-secondary">@L["Button_Cancel"]</a>
</div>

@if (showRepredictDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Modal_RepredictTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="HideRepredictDialog"></button>
                </div>
                <div class="modal-body">
                    <p>@L["Modal_RepredictBody"]</p>
                    <p class="text-muted small mb-0">@L["Modal_RepredictHint"]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="HideRepredictDialog">@L["Button_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="Repredict">@L["Button_Repredict"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Parameter] public int BudgetId { get; set; }

    private Budget? budget;
    private bool notFound = false;
    private bool isSaving = false;
    private bool showRepredictDialog = false;

    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]> editingEntries = new();
    // Shadow rows: leaf sub-cats under a tracked group that have transactions in the budget's
    // year but no budget row of their own. Rendered under their group with empty inputs;
    // typing a non-zero value promotes them into editingEntries (and into project tracking
    // on save) so the user can budget at the leaf level without a separate tracking step.
    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]> shadowEntries = new();
    // Virtual parent rows: tracked groups (from the project) whose budget rows live only on
    // their descendants. Rendered auto-summed so the hierarchy stays visible even when the
    // group itself has no MonthlyBudgetEntry. Never persisted — Save() ignores them.
    private HashSet<(long Id, CategoryItemType ItemType)> virtualGroupKeys = new();
    private HashSet<(long Id, CategoryItemType ItemType)> trackedItemKeys = new();
    private Dictionary<(long Id, CategoryItemType ItemType), string> categoryNames = new();
    private Dictionary<(long Id, CategoryItemType ItemType), string> categoryFullPaths = new();
    private List<(long Id, CategoryItemType ItemType)> availableToAdd = new();
    private Dictionary<(long Id, CategoryItemType ItemType), string> addCandidateNames = new();
    private HashSet<(long Id, CategoryItemType ItemType)> incomeKeys = new();
    private string addSelection = "";

    // Cached lookups so Re-predict / Add doesn't rehit the DB for naming.
    private Dictionary<long, CategoryGroup> groupById = new();
    private Dictionary<long, Category> categoryById = new();
    private List<CategoryGroupWithChildCount> hierarchy = new();

    // Tree projection + effective amounts. Recomputed whenever the edit set changes (add/remove)
    // or when a row's months are edited (live, so an auto-summed group reflects descendants).
    private List<TrackedRowNode> incomeTree = new();
    private List<TrackedRowNode> expenseTree = new();
    private BudgetEffectiveAmounts effective = new();
    private HashSet<(long Id, CategoryItemType ItemType)> expandedKeys = new();
    private string ExpandScope => $"budget-edit:{BudgetId}";

    protected override async Task OnInitializedAsync()
    {
        budget = await BudgetEntryService.GetBudgetAsync(BudgetId);
        if (budget == null)
        {
            notFound = true;
            return;
        }

        await LoadHierarchyLookups();
        incomeKeys = await BudgetService.GetIncomeItemsForProjectAsync(budget.ProjectId);

        editingEntries = budget.MonthlyEntries.ToDictionary(
            e => (e.CategoryId, e.ItemType),
            e => new[]
            {
                e.Month1, e.Month2, e.Month3, e.Month4, e.Month5, e.Month6,
                e.Month7, e.Month8, e.Month9, e.Month10, e.Month11, e.Month12
            });

        await LoadShadowsAsync();
        await RefreshNamesAndCandidates();
        RebuildTrees();
    }

    private async Task LoadShadowsAsync()
    {
        if (budget == null) return;
        var sourceId = budget.Project?.SourceId ?? SourceScope.LegacySourceId;

        // Tracked groups for shadow leaf expansion = editor groups + project-tracked groups.
        // Project-tracked groups not in the editor become "virtual" parent rows further down.
        var trackingItems = await ProjectService.GetProjectTrackingItemsAsync(budget.ProjectId);
        trackedItemKeys = trackingItems.ToTrackedKeys().ToHashSet();
        var trackedGroupIds = trackedItemKeys
            .Where(k => k.ItemType == CategoryItemType.Group)
            .Select(k => k.Id)
            .Union(editingEntries.Keys.Where(k => k.ItemType == CategoryItemType.Group).Select(k => k.Id))
            .Distinct()
            .ToList();
        if (trackedGroupIds.Count == 0)
        {
            shadowEntries.Clear();
            virtualGroupKeys.Clear();
            return;
        }

        var leafIds = await BudgetService.GetLeafCategoriesWithRecentTransactionsAsync(
            trackedGroupIds, sourceId);

        // Drop leaves that already have their own budget row.
        foreach (var existing in editingEntries.Keys.Where(k => k.ItemType == CategoryItemType.Category))
            leafIds.Remove(existing.Id);

        // Reset shadows: keep only shadow keys that are still candidates; new ones default to zero.
        var newShadows = new Dictionary<(long Id, CategoryItemType ItemType), decimal[]>();
        foreach (var leafId in leafIds)
        {
            var key = (leafId, CategoryItemType.Category);
            newShadows[key] = shadowEntries.TryGetValue(key, out var existing) ? existing : new decimal[12];
        }
        shadowEntries = newShadows;

        // Virtual groups: project-tracked groups that have any descendant present in the
        // editor (real entry or shadow). Shown as auto-summed parent rows so the hierarchy
        // stays visible even when the group itself isn't a budget row.
        virtualGroupKeys.Clear();
        var allDescendantKeys = editingEntries.Keys.Concat(shadowEntries.Keys).ToHashSet();
        foreach (var trackedGroup in trackedItemKeys.Where(k => k.ItemType == CategoryItemType.Group))
        {
            if (editingEntries.ContainsKey(trackedGroup)) continue;
            var descendants = CategoryGroupWithChildCount.CollectDescendants(
                trackedGroup.Id, hierarchy, includeLeafCategories: true);
            if (descendants.Any(d => allDescendantKeys.Contains((d.Id, d.ItemType))))
                virtualGroupKeys.Add(trackedGroup);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || budget == null) return;
        try
        {
            var keys = await JS.InvokeAsync<string[]>("expandState.get", ExpandScope);
            if (keys.Length > 0)
            {
                expandedKeys.Clear();
                foreach (var s in keys)
                {
                    if (TryDeserializeKey(s, out var k)) expandedKeys.Add(k);
                }
            }
            else
            {
                // No stored preference: default to expanded for any auto-summed group, so the
                // user sees the sub-cat breakdown immediately rather than just the roll-up.
                expandedKeys.Clear();
                foreach (var k in effective.AutoSummed) expandedKeys.Add(k);
            }
            StateHasChanged();
        }
        catch
        {
            // localStorage unavailable — fall back to auto-expand defaults.
            expandedKeys.Clear();
            foreach (var k in effective.AutoSummed) expandedKeys.Add(k);
            StateHasChanged();
        }
    }

    private async Task LoadHierarchyLookups()
    {
        var sourceId = budget?.Project?.SourceId ?? SourceScope.LegacySourceId;
        hierarchy = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(sourceId);
        groupById = hierarchy
            .Where(c => c.ItemType == CategoryItemType.Group)
            .ToDictionary(c => c.Id, c => c.CategoryGroup);

        var categories = await CategoryHierarchyService.GetAllCategoriesAsync(sourceId);
        categoryById = categories.ToDictionary(c => c.Id, c => c);
    }

    private void RebuildTrees()
    {
        // Effective amounts: groups with descendant amounts auto-sum and become read-only.
        // Shadow rows have zero amounts so they don't affect auto-summing until promoted.
        // Virtual group rows are seeded with zero so ComputeEffectiveAmounts auto-sums them
        // from their tracked descendants — same display path as a real but emptied group row.
        var storedForEffective = new Dictionary<(long Id, CategoryItemType ItemType), decimal[]>(editingEntries);
        foreach (var virtKey in virtualGroupKeys)
            if (!storedForEffective.ContainsKey(virtKey))
                storedForEffective[virtKey] = new decimal[12];
        effective = BudgetEntryService.ComputeEffectiveAmounts(storedForEffective, hierarchy);

        // Tree includes real rows, shadow rows, and virtual parent groups so the user can
        // drill into tracked groups and see their in-year leaf categories without leaving
        // the editor — and so a sub-cat-only budget still shows the parent for context.
        var allKeys = editingEntries.Keys.Concat(shadowEntries.Keys).Concat(virtualGroupKeys);
        var incomeItems = allKeys.Where(k => incomeKeys.Contains(k));
        var expenseItems = allKeys.Where(k => !incomeKeys.Contains(k));
        incomeTree = TrackedRowTree.Build(incomeItems, hierarchy, k => categoryNames.GetValueOrDefault(k, ""));
        expenseTree = TrackedRowTree.Build(expenseItems, hierarchy, k => categoryNames.GetValueOrDefault(k, ""));
    }

    private decimal[] GetEffective((long Id, CategoryItemType ItemType) key) =>
        effective.Effective.TryGetValue(key, out var m) ? m : new decimal[12];

    private bool IsAutoSummed((long Id, CategoryItemType ItemType) key) =>
        effective.AutoSummed.Contains(key);

    private bool IsRowVisible(TrackedRowNode node)
    {
        var p = node.ParentKey;
        while (p.HasValue)
        {
            if (!expandedKeys.Contains(p.Value)) return false;
            // Walk up via the tree's parent chain. Find this parent's own ParentKey.
            var parentNode = (incomeTree.Concat(expenseTree)).FirstOrDefault(n => n.Key.Equals(p.Value));
            p = parentNode?.ParentKey;
        }
        return true;
    }

    private async Task ToggleExpand((long Id, CategoryItemType ItemType) key)
    {
        if (!expandedKeys.Add(key)) expandedKeys.Remove(key);
        try
        {
            await JS.InvokeVoidAsync("expandState.set", ExpandScope,
                expandedKeys.Select(SerializeKey).ToArray());
        }
        catch { /* localStorage unavailable */ }
    }

    private void OnMonthsChanged() => RebuildTrees();

    private bool IsShadow((long Id, CategoryItemType ItemType) key) => shadowEntries.ContainsKey(key);
    private bool IsVirtual((long Id, CategoryItemType ItemType) key) => virtualGroupKeys.Contains(key);

    /// <summary>
    /// Called when a shadow row's input changes. If any month became non-zero, promote the
    /// row from shadow state to a real budget entry — its parent group then auto-sums it.
    /// Returns to shadow state if the user clears everything back to zero.
    /// </summary>
    private async Task OnShadowMonthsChanged((long Id, CategoryItemType ItemType) key)
    {
        if (!shadowEntries.TryGetValue(key, out var months)) return;
        if (months.Any(m => m != 0m))
        {
            editingEntries[key] = months;
            shadowEntries.Remove(key);
            await RefreshAfterEditAsync();
        }
        else
        {
            RebuildTrees();
        }
    }

    private async Task RefreshNamesAndCandidates()
    {
        if (budget == null) return;

        // Compute labels for the rows currently in the editor + shadow rows + virtual parent
        // groups. Prefix the parent group name when the base name collides with another row's,
        // OR when this row's parent group is also tracked — the second case keeps a "Food"
        // group row visually distinct from a "Food › Groceries" sub-cat row when both coexist.
        var allRowKeys = editingEntries.Keys.Concat(shadowEntries.Keys).Concat(virtualGroupKeys);
        var labels = new List<((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName, long? ParentGroupId)>();
        foreach (var key in allRowKeys)
        {
            labels.Add(BuildLabel(key));
        }

        var trackedGroupIds = editingEntries.Keys
            .Where(k => k.ItemType == CategoryItemType.Group)
            .Select(k => k.Id)
            .ToHashSet();

        categoryNames = BuildDisplayNames(labels, trackedGroupIds);
        categoryFullPaths = allRowKeys.ToDictionary(k => k, BuildFullPath);

        // Build the "Add tracked item" list — project tracking items that aren't already in the editor.
        var trackingItems = await ProjectService.GetProjectTrackingItemsAsync(budget.ProjectId);
        availableToAdd.Clear();
        addCandidateNames.Clear();

        foreach (var ti in trackingItems)
        {
            (long Id, CategoryItemType ItemType)? candidate = null;
            if (ti.CategoryGroupId.HasValue)
                candidate = (ti.CategoryGroupId.Value, CategoryItemType.Group);
            else if (ti.CategoryId.HasValue)
                candidate = (ti.CategoryId.Value, CategoryItemType.Category);
            if (candidate == null) continue;
            if (editingEntries.ContainsKey(candidate.Value)) continue;

            availableToAdd.Add(candidate.Value);
        }

        // Picker candidates are prefixed against the editor's tracked group set too — that way
        // a candidate "Groceries" reads as "Food › Groceries" when Food is already a row.
        var candidateLabels = availableToAdd.Select(BuildLabel).ToList();
        addCandidateNames = BuildDisplayNames(candidateLabels, trackedGroupIds);
    }

    private Dictionary<(long Id, CategoryItemType ItemType), string> BuildDisplayNames(
        List<((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName, long? ParentGroupId)> labels,
        HashSet<long> trackedGroupIds)
    {
        var nameCounts = labels
            .GroupBy(l => l.BaseName)
            .ToDictionary(g => g.Key, g => g.Count());

        return labels.ToDictionary(
            l => l.Key,
            l => !string.IsNullOrEmpty(l.ParentName)
                && (nameCounts[l.BaseName] > 1
                    || (l.ParentGroupId.HasValue && trackedGroupIds.Contains(l.ParentGroupId.Value)))
                ? $"{l.ParentName} › {l.BaseName}"
                : l.BaseName);
    }

    private string BuildFullPath((long Id, CategoryItemType ItemType) key)
    {
        var parts = new List<string>();
        long? walker;
        if (key.ItemType == CategoryItemType.Group)
        {
            if (!groupById.TryGetValue(key.Id, out var g)) return L["Picker_Unknown"];
            parts.Add(g.Name ?? L["Picker_Unknown"]);
            walker = g.ParentGroupId;
        }
        else
        {
            if (!categoryById.TryGetValue(key.Id, out var c)) return L["Picker_Unknown"];
            parts.Add(c.Name ?? L["Picker_Unknown"]);
            walker = c.GroupId;
        }
        while (walker.HasValue && groupById.TryGetValue(walker.Value, out var ancestor))
        {
            parts.Add(ancestor.Name ?? L["Picker_Unknown"]);
            walker = ancestor.ParentGroupId;
        }
        parts.Reverse();
        return string.Join(" › ", parts);
    }

    private ((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName, long? ParentGroupId) BuildLabel(
        (long Id, CategoryItemType ItemType) key)
    {
        if (key.ItemType == CategoryItemType.Group)
        {
            if (groupById.TryGetValue(key.Id, out var g))
            {
                var parentName = g.ParentGroupId.HasValue
                    && groupById.TryGetValue(g.ParentGroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                return (key, g.Name ?? L["Picker_Unknown"], parentName, g.ParentGroupId);
            }
        }
        else if (categoryById.TryGetValue(key.Id, out var cat))
        {
            var parentName = cat.GroupId.HasValue
                && groupById.TryGetValue(cat.GroupId.Value, out var parent)
                ? parent.Name
                : null;
            return (key, cat.Name ?? L["Picker_Unknown"], parentName, cat.GroupId);
        }
        return (key, L["Picker_Unknown"], null, null);
    }

    private void RemoveRow((long Id, CategoryItemType ItemType) key)
    {
        editingEntries.Remove(key);
        _ = RefreshAfterEditAsync();
    }

    private async Task AddSelected()
    {
        if (string.IsNullOrEmpty(addSelection)) return;
        if (!TryDeserializeKey(addSelection, out var key)) return;
        if (editingEntries.ContainsKey(key)) return;

        editingEntries[key] = new decimal[12];
        addSelection = "";
        await RefreshAfterEditAsync();
    }

    private async Task RefreshAfterEditAsync()
    {
        await LoadShadowsAsync();
        await RefreshNamesAndCandidates();
        RebuildTrees();
    }

    private void ShowRepredictDialog() => showRepredictDialog = true;
    private void HideRepredictDialog() => showRepredictDialog = false;

    private async Task Repredict()
    {
        if (budget == null) { showRepredictDialog = false; return; }

        var sourceId = budget.Project?.SourceId ?? SourceScope.LegacySourceId;
        foreach (var key in editingEntries.Keys.ToList())
        {
            var isIncome = incomeKeys.Contains(key);
            var predicted = key.ItemType == CategoryItemType.Group
                ? await BudgetPredictionService.PredictMonthlySpendingForCategoryAsync(key.Id, budget.Year, sourceId, isIncome)
                : await BudgetPredictionService.PredictMonthlySpendingForLeafCategoryAsync(key.Id, budget.Year, sourceId, isIncome);
            editingEntries[key] = predicted.Select(p => Math.Round(p, 2)).ToArray();
        }
        showRepredictDialog = false;
    }

    private async Task Save()
    {
        if (budget == null) return;
        isSaving = true;
        try
        {
            await BudgetEntryService.UpdateBudgetAsync(budget);
            var entries = editingEntries
                .Select(kvp => (kvp.Key.Id, kvp.Key.ItemType, kvp.Value))
                .ToList();
            await BudgetEntryService.SaveBudgetEntriesAsync(BudgetId, entries);
            Navigation.NavigateTo($"/budgets?projectId={budget.ProjectId}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string SerializeKey((long Id, CategoryItemType ItemType) key)
        => $"{(int)key.ItemType}:{key.Id}";

    private static bool TryDeserializeKey(string s, out (long Id, CategoryItemType ItemType) key)
    {
        key = default;
        var parts = s.Split(':');
        if (parts.Length != 2) return false;
        if (!int.TryParse(parts[0], out var typeInt)) return false;
        if (!long.TryParse(parts[1], out var id)) return false;
        key = (id, (CategoryItemType)typeInt);
        return true;
    }
}
