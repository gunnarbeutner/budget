@page "/analysis"
@using OpenBudget.Services
@using OpenBudget.Models
@using System.Text.Json
@inject BudgetService BudgetService
@inject IJSRuntime JS

<PageTitle>Spending Analysis</PageTitle>

<h1>Spending Analysis</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Select Project</label>
                        <select class="form-select" value="@selectedBudgetId" @onchange="OnBudgetChanged">
                            @if (budgets != null)
                            {
                                foreach (var budget in budgets)
                                {
                                    <option value="@budget.Id">@budget.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Compare with Budget</label>
                        <select class="form-select" value="@selectedCompareBudgetId" @onchange="OnCompareBudgetChanged">
                            <option value="0">-- No Budget Comparison --</option>
                            @if (availableBudgets != null)
                            {
                                foreach (var bud in availableBudgets)
                                {
                                    <option value="@bud.Id">@bud.Year (@bud.Notes)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date Range</label>
                        <select class="form-select" value="@selectedDateRange" @onchange="OnDateRangeChanged">
                            <option value="12">Last 12 Months</option>
                            <option value="6">Last 6 Months</option>
                            <option value="3">Last 3 Months</option>
                            <option value="current-year">Current Year</option>
                            <option value="last-year">Last Year</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Categories</h5>
            </div>
            <div class="card-body">
                <div style="max-height: calc(100vh - 250px); overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
                    @if (allAvailableCategories != null && allActualCategories != null)
                    {
                        @foreach (var rootCat in allAvailableCategories.Where(c => c.IsRootCategory).OrderBy(c => c.CategoryGroup.Name))
                        {
                            <CategoryTree
                                CategoryGroup="@rootCat"
                                Level="0"
                                RenderMode="CategoryTreeRenderMode.Checkbox"
                                ParentSelected="false"
                                SelectedCategoryGroupIds="@selectedCategoryGroupIds"
                                SelectedCategoryIds="@selectedActualCategoryIds"
                                OnCategoryGroupToggle="@HandleCategoryGroupToggle"
                                OnCategoryToggle="@HandleCategoryToggle"
                                AllCategories="@allAvailableCategories"
                                ActualCategories="@allActualCategories" />
                        }
                    }
                </div>
                <small class="form-text text-muted mt-2 d-block">
                    <strong>How to use:</strong><br/>
                    • Categories shown are based on project tracking settings<br/>
                    • Income categories are excluded — configure types in the project details page<br/>
                    • Selected categories appear as stacked bars showing trends over time
                </small>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Category Trends</h5>
            </div>
            <div class="card-body">
                @if (selectedCompareBudgetId > 0 && categoryTrends != null && budgetTrends != null)
                {
                    <div class="alert alert-info mb-3">
                        <strong>Budget Comparison Active:</strong> Budget lines shown on chart. Variance summary below chart.
                    </div>
                }

                @if (categoryTrends == null)
                {
                    <p><em>Loading trends...</em></p>
                }
                else if (!categoryTrends.Any())
                {
                    <p class="text-muted">No trend data available for selected categories.</p>
                }
                else
                {
                    <div style="position: relative; height: 400px; max-height: 600px;">
                        <canvas id="trendStackedBarChart"></canvas>
                    </div>

                    @if (selectedCompareBudgetId > 0 && varianceSummary != null && varianceSummary.Any())
                    {
                        <div class="mt-4">
                            <h6>Budget vs Actual Variance</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th class="text-end">Budget</th>
                                            <th class="text-end">Actual</th>
                                            <th class="text-end">Variance</th>
                                            <th class="text-end">% of Budget</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in varianceSummary.OrderByDescending(v => Math.Abs(v.Variance)))
                                        {
                                            var percentOfBudget = item.BudgetAmount > 0 ? (item.ActualAmount / item.BudgetAmount * 100) : 0;
                                            var rowClass = percentOfBudget > 110 ? "table-danger" : percentOfBudget > 90 ? "table-warning" : "table-success";
                                            <tr class="@rowClass">
                                                <td>@item.CategoryName</td>
                                                <td class="text-end">€@item.BudgetAmount.ToString("N2")</td>
                                                <td class="text-end">€@item.ActualAmount.ToString("N2")</td>
                                                <td class="text-end">€@item.Variance.ToString("N2")</td>
                                                <td class="text-end">@percentOfBudget.ToString("N1")%</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-primary">
                                            <th>Total</th>
                                            <th class="text-end">€@varianceSummary.Sum(v => v.BudgetAmount).ToString("N2")</th>
                                            <th class="text-end">€@varianceSummary.Sum(v => v.ActualAmount).ToString("N2")</th>
                                            <th class="text-end">€@varianceSummary.Sum(v => v.Variance).ToString("N2")</th>
                                            <th class="text-end">
                                                @{
                                                    var totalPercent = varianceSummary.Sum(v => v.BudgetAmount) > 0
                                                        ? (varianceSummary.Sum(v => v.ActualAmount) / varianceSummary.Sum(v => v.BudgetAmount) * 100)
                                                        : 0;
                                                }
                                                @totalPercent.ToString("N1")%
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<CategoryGroupWithChildCount>? allCategories;
    private List<CategoryGroupWithChildCount>? filteredCategories;
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private HashSet<long> selectedCategoryGroupIds = new();
    private HashSet<long> selectedActualCategoryIds = new();
    private HashSet<(long Id, CategoryItemType ItemType)> incomeItems = new();
    private List<Category>? allActualCategories;
    private Dictionary<string, List<MonthlySpending>>? categoryTrends;
    private Dictionary<string, List<MonthlySpending>>? budgetTrends;
    private List<VarianceSummary>? varianceSummary;
    private List<Project>? budgets;
    private List<Budget>? availableBudgets;
    private int selectedBudgetId = 0;
    private int selectedCompareBudgetId = 0;
    private string selectedDateRange = "12";

    protected override async Task OnInitializedAsync()
    {
        budgets = await BudgetService.GetProjectsAsync();

        // Load all category groups (including sub-categories), not just root ones
        var allCategoryGroups = await BudgetService.GetAllCategoriesWithChildCountsAsync();

        // Filter out the hidden root category (id=1) and organize hierarchically
        allCategories = allCategoryGroups
            .Where(c => c.CategoryGroup.Id != 1)
            .OrderBy(c => c.CategoryGroup.Name)
            .ToList();

        // Load all actual categories
        allActualCategories = await BudgetService.GetAllCategoriesAsync();

        // A project is always required; default to the first one
        if (budgets.Any())
        {
            selectedBudgetId = budgets.First().Id;
            await LoadProjectContext();
            await LoadCategoryTrends();
        }
    }

    private async Task LoadProjectContext()
    {
        if (selectedBudgetId <= 0 || allCategories == null) return;

        incomeItems = await BudgetService.GetIncomeItemsForProjectAsync(selectedBudgetId);
        availableBudgets = await BudgetService.GetBudgetsForProjectAsync(selectedBudgetId);

        await FilterCategoriesByBudget();
        allAvailableCategories = filteredCategories;

        var trackingItems = await BudgetService.GetProjectTrackingItemsAsync(selectedBudgetId);

        selectedCategoryGroupIds.Clear();
        selectedActualCategoryIds.Clear();

        foreach (var item in trackingItems)
        {
            if (item.CategoryGroupId.HasValue)
            {
                if (incomeItems.Contains((item.CategoryGroupId.Value, CategoryItemType.Group)))
                    continue;
                selectedCategoryGroupIds.Add(item.CategoryGroupId.Value);
            }
            else if (item.CategoryId.HasValue)
            {
                if (incomeItems.Contains((item.CategoryId.Value, CategoryItemType.Category)))
                    continue;
                selectedActualCategoryIds.Add(item.CategoryId.Value);
            }
        }
    }

    private async Task OnBudgetChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var budgetId) && budgetId > 0)
        {
            selectedBudgetId = budgetId;
            selectedCompareBudgetId = 0;
            await LoadProjectContext();
            await LoadCategoryTrends();
        }
    }

    private async Task FilterCategoriesByBudget()
    {
        var budget = await BudgetService.GetProjectAsync(selectedBudgetId);
        if (budget == null || allCategories == null)
        {
            filteredCategories = new List<CategoryGroupWithChildCount>();
            return;
        }

        // Get all category items that are in the budget (including descendants)
        // Use HashSet of actual items to avoid ID collision
        var budgetCategoryItems = new HashSet<CategoryGroupWithChildCount>();

        foreach (var assignment in budget.CategoryAssignments)
        {
            // Find the assigned category group - filter by ItemType to avoid ID collision
            var assignedGroup = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == assignment.CategoryId);
            if (assignedGroup != null)
            {
                budgetCategoryItems.Add(assignedGroup);

                // Add all descendants using shared helper
                var descendants = CategoryGroupWithChildCount.CollectDescendants(assignment.CategoryId, allCategories);
                foreach (var descendant in descendants)
                {
                    budgetCategoryItems.Add(descendant);
                }
            }
        }

        // Exclude items resolved as income for this project
        filteredCategories = budgetCategoryItems
            .Where(item => !incomeItems.Contains((item.Id, item.ItemType)))
            .ToList();
    }

    private void GetAllSubGroupIds(long categoryGroupId, HashSet<long> result)
    {
        if (allCategories == null) return;

        // Use shared helper method from CategoryGroupWithChildCount
        // Only collect CategoryGroups, not leaf categories
        CategoryGroupWithChildCount.CollectDescendantIds(categoryGroupId, allCategories, result, includeLeafCategories: false);
    }

    private async Task HandleCategoryGroupToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            // Add the category group
            selectedCategoryGroupIds.Add(args.Id);

            // Remove all descendant category groups and categories
            RemoveDescendantsFromSelection(args.Id);
        }
        else
        {
            // Remove the category group
            selectedCategoryGroupIds.Remove(args.Id);

            // Auto-select immediate children (category groups or categories)
            SelectImmediateChildren(args.Id);
        }

        // Refresh the chart
        await LoadCategoryTrends();
    }

    private async Task HandleCategoryToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedActualCategoryIds.Add(args.Id);
        }
        else
        {
            selectedActualCategoryIds.Remove(args.Id);
        }

        // Refresh the chart
        await LoadCategoryTrends();
    }


    private void RemoveDescendantsFromSelection(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Use shared helper to get all descendants
        var descendants = CategoryGroupWithChildCount.CollectDescendants(parentCategoryGroupId, allAvailableCategories);

        foreach (var descendant in descendants)
        {
            if (descendant.ItemType == CategoryItemType.Group)
            {
                selectedCategoryGroupIds.Remove(descendant.Id);
            }
            else if (descendant.ItemType == CategoryItemType.Category)
            {
                selectedActualCategoryIds.Remove(descendant.Id);
            }
        }
    }

    private void SelectImmediateChildren(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Find immediate children - filter properly to avoid ID collision
        var childGroups = allAvailableCategories
            .Where(c => c.ParentCategoryGroupId == parentCategoryGroupId && c.ItemType == CategoryItemType.Group)
            .ToList();

        var childCategories = allAvailableCategories
            .Where(c => c.ParentCategoryGroupId == parentCategoryGroupId && c.ItemType == CategoryItemType.Category)
            .ToList();

        if (childGroups.Any())
        {
            // Has child groups - select them
            foreach (var child in childGroups)
            {
                selectedCategoryGroupIds.Add(child.Id);
            }
        }

        if (childCategories.Any())
        {
            // Select child categories
            foreach (var child in childCategories)
            {
                selectedActualCategoryIds.Add(child.Id);
            }
        }
    }

    private bool needsTrendChartRender = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsTrendChartRender && categoryTrends != null && categoryTrends.Any())
        {
            needsTrendChartRender = false;
            await RenderStackedBarChart();
        }
    }

    private async Task OnDateRangeChanged(ChangeEventArgs e)
    {
        selectedDateRange = e.Value?.ToString() ?? "12";
        await LoadCategoryTrends();
    }

    private async Task OnCompareBudgetChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var budgetId))
        {
            selectedCompareBudgetId = budgetId;
            await LoadCategoryTrends();
        }
    }

    private async Task LoadCategoryTrends()
    {
        categoryTrends = new Dictionary<string, List<MonthlySpending>>();

        int months;
        int? filterYear = null;

        if (selectedDateRange == "current-year")
        {
            // Get current year data: from Jan to current month
            var now = DateTime.UtcNow;
            months = now.Month + 12; // Get extra months to ensure we have full year if needed
            filterYear = now.Year;
        }
        else if (selectedDateRange == "last-year")
        {
            // Get last year data: all 12 months of previous year
            var now = DateTime.UtcNow;
            months = now.Month + 12; // Get enough months to cover last full year
            filterYear = now.Year - 1;
        }
        else
        {
            months = int.Parse(selectedDateRange);
        }

        // Load trends for all selected category groups
        foreach (var groupId in selectedCategoryGroupIds)
        {
            var group = allAvailableCategories?.FirstOrDefault(c => c.CategoryGroup.Id == groupId);
            if (group != null)
            {
                var trend = await BudgetService.GetMonthlySpendingAsync(groupId, months);

                // Filter by year if needed
                if (filterYear.HasValue && trend.Any())
                {
                    trend = trend.Where(m => m.Year == filterYear.Value).ToList();
                }

                if (trend.Any())
                {
                    categoryTrends[group.CategoryGroup.Name ?? "Unknown"] = trend;
                }
            }
        }

        // Load trends for all selected individual categories
        foreach (var categoryId in selectedActualCategoryIds)
        {
            var category = allActualCategories?.FirstOrDefault(c => c.Id == categoryId);
            if (category != null)
            {
                var trend = await BudgetService.GetMonthlySpendingForCategoryAsync(categoryId, months);

                // Filter by year if needed
                if (filterYear.HasValue && trend.Any())
                {
                    trend = trend.Where(m => m.Year == filterYear.Value).ToList();
                }

                if (trend.Any())
                {
                    categoryTrends[category.Name ?? "Unknown"] = trend;
                }
            }
        }

        // Load budget data if comparison is active
        budgetTrends = null;
        varianceSummary = null;

        if (selectedCompareBudgetId > 0 && categoryTrends.Any())
        {
            budgetTrends = new Dictionary<string, List<MonthlySpending>>();
            varianceSummary = new List<VarianceSummary>();

            // Collect all months being displayed across all categories
            var allDisplayedMonths = categoryTrends.Values
                .SelectMany(trend => trend.Select(m => (m.Year, m.Month)))
                .Distinct()
                .ToHashSet();

            // Load budget data for selected category groups
            foreach (var groupId in selectedCategoryGroupIds)
            {
                var group = allAvailableCategories?.FirstOrDefault(c => c.CategoryGroup.Id == groupId);
                if (group != null)
                {
                    var budgetTrend = await BudgetService.GetBudgetTrendAsync(groupId, selectedCompareBudgetId);
                    if (budgetTrend.Any())
                    {
                        var categoryName = group.CategoryGroup.Name ?? "Unknown";
                        var actualTrend = categoryTrends.GetValueOrDefault(categoryName);

                        // Filter budget to only months being displayed on the chart
                        var filteredBudget = budgetTrend.Where(b => allDisplayedMonths.Contains((b.Year, b.Month))).ToList();

                        if (filteredBudget.Any())
                        {
                            budgetTrends[categoryName] = filteredBudget;

                            // Calculate variance
                            var budgetTotal = filteredBudget.Sum(m => m.Amount);
                            var actualTotal = actualTrend?.Sum(m => m.Amount) ?? 0;
                            varianceSummary.Add(new VarianceSummary
                            {
                                CategoryName = categoryName,
                                BudgetAmount = budgetTotal,
                                ActualAmount = actualTotal,
                                Variance = actualTotal - budgetTotal
                            });
                        }
                    }
                }
            }

            // Load budget data for selected individual categories
            foreach (var categoryId in selectedActualCategoryIds)
            {
                var category = allActualCategories?.FirstOrDefault(c => c.Id == categoryId);
                if (category != null)
                {
                    var budgetTrend = await BudgetService.GetBudgetTrendAsync(categoryId, selectedCompareBudgetId);
                    if (budgetTrend.Any())
                    {
                        var categoryName = category.Name ?? "Unknown";
                        var actualTrend = categoryTrends.GetValueOrDefault(categoryName);

                        // Filter budget to only months being displayed on the chart
                        var filteredBudget = budgetTrend.Where(b => allDisplayedMonths.Contains((b.Year, b.Month))).ToList();

                        if (filteredBudget.Any())
                        {
                            budgetTrends[categoryName] = filteredBudget;

                            // Calculate variance
                            var budgetTotal = filteredBudget.Sum(m => m.Amount);
                            var actualTotal = actualTrend?.Sum(m => m.Amount) ?? 0;
                            varianceSummary.Add(new VarianceSummary
                            {
                                CategoryName = categoryName,
                                BudgetAmount = budgetTotal,
                                ActualAmount = actualTotal,
                                Variance = actualTotal - budgetTotal
                            });
                        }
                    }
                }
            }
        }

        if (categoryTrends.Any())
        {
            needsTrendChartRender = true;
            StateHasChanged();
        }
    }

    private async Task RenderStackedBarChart()
    {
        if (categoryTrends == null || !categoryTrends.Any())
            return;

        // Get all unique month labels from the first category's trend
        var firstTrend = categoryTrends.Values.First();
        var labels = firstTrend.Select(m => m.MonthName).ToArray();

        // Sort categories by average amount (descending - largest at bottom of stack)
        var sortedCategories = categoryTrends
            .OrderByDescending(kvp => kvp.Value.Average(m => m.Amount))
            .ToList();

        // Create datasets for each category
        var datasets = new List<object>();
        var colors = GenerateColors(sortedCategories.Count);
        int colorIndex = 0;

        foreach (var kvp in sortedCategories)
        {
            var categoryName = kvp.Key;
            var trend = kvp.Value;
            var data = trend.Select(m => m.Amount).ToArray();

            datasets.Add(new
            {
                label = categoryName,
                data = data,
                backgroundColor = colors[colorIndex++],
                type = "bar",
                stack = "actual" // Separate stack for actual spending
            });
        }

        // Add budget bars if budget comparison is active
        if (budgetTrends != null && budgetTrends.Any())
        {
            // Create a lookup of budget data by (Year, Month) for proper alignment
            var budgetLookup = new Dictionary<string, Dictionary<(int Year, int Month), decimal>>();
            foreach (var kvp in budgetTrends)
            {
                var categoryName = kvp.Key;
                var trend = kvp.Value;
                budgetLookup[categoryName] = trend.ToDictionary(m => (m.Year, m.Month), m => m.Amount);
            }

            // Sort budget categories to match actual spending order
            var sortedBudgetCategories = budgetTrends.OrderBy(kvp => kvp.Key).ToList();

            // Reset color index to match actual spending colors
            var budgetColorIndex = 0;

            foreach (var kvp in sortedBudgetCategories)
            {
                var categoryName = kvp.Key;
                var budgetData = budgetLookup[categoryName];

                // Align budget data with chart labels by matching (Year, Month)
                var data = firstTrend.Select(m =>
                    budgetData.ContainsKey((m.Year, m.Month)) ? (decimal?)budgetData[(m.Year, m.Month)] : null
                ).ToArray();

                // Use same color as actual spending but with transparency
                var baseColor = colors[budgetColorIndex++ % colors.Length];
                var budgetColor = baseColor.Replace("0.7)", "0.3)"); // Make budget bars more transparent

                datasets.Insert(0, new
                {
                    label = $"{categoryName} (Budget)",
                    data = data,
                    backgroundColor = budgetColor,
                    borderColor = baseColor.Replace("0.7)", "1)"),
                    borderWidth = 1,
                    stack = "budget" // Separate stack for budget
                });
            }
        }

        var chartData = new
        {
            type = "bar",
            data = new
            {
                labels = labels,
                datasets = datasets.ToArray()
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new
                    {
                        position = "bottom"
                    },
                    tooltip = new
                    {
                        mode = "index",
                        intersect = false,
                        callbacks = new
                        {
                            label = "function(context) { return context.dataset.label + ': €' + context.parsed.y.toFixed(2); }"
                        }
                    }
                },
                scales = new
                {
                    x = new
                    {
                        stacked = true // Required for grouped stacked bars
                    },
                    y = new
                    {
                        stacked = true, // Stack categories within actual spending
                        beginAtZero = true,
                        title = new
                        {
                            display = true,
                            text = "Amount (€)"
                        },
                        ticks = new
                        {
                            callback = "function(value) { return '€' + value.toFixed(2); }"
                        }
                    }
                }
            }
        };

        await Task.Delay(100); // Give the DOM time to render

        try
        {
            await JS.InvokeVoidAsync("renderStackedBarChart", "trendStackedBarChart", chartData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering stacked bar chart: {ex.Message}");
        }
    }

    private string[] GenerateColors(int count)
    {
        var colors = new[]
        {
            "rgba(255, 99, 132, 0.8)",
            "rgba(54, 162, 235, 0.8)",
            "rgba(255, 206, 86, 0.8)",
            "rgba(75, 192, 192, 0.8)",
            "rgba(153, 102, 255, 0.8)",
            "rgba(255, 159, 64, 0.8)",
            "rgba(199, 199, 199, 0.8)",
            "rgba(83, 102, 255, 0.8)",
            "rgba(255, 99, 255, 0.8)",
            "rgba(99, 255, 132, 0.8)"
        };

        var result = new string[count];
        for (int i = 0; i < count; i++)
        {
            result[i] = colors[i % colors.Length];
        }
        return result;
    }
}
