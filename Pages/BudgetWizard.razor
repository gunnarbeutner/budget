@page "/budgets/wizard"
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject NavigationManager Navigation
@inject IStringLocalizer<BudgetWizard> L

<PageTitle>@L["PageTitle"]</PageTitle>

@if (notFound)
{
    <h1>@L["NotFound_Heading"]</h1>
    <p class="text-muted">@L["NotFound_Before"]<a href="/">@L["NotFound_LinkText"]</a>@L["NotFound_After"]</p>
    return;
}

<h1>@L["Header_Title"]</h1>

@if (step == 1)
{
    <div class="card">
        <div class="card-header">
            <h5>@L["Step_One_Title"]</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@L["Form_ProjectLabel"]</label>
                <input type="text" class="form-control" value="@(projects?.FirstOrDefault(p => p.Id == selectedProjectId)?.Name)" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Form_BudgetYearLabel"]</label>
                <input type="number" class="form-control" @bind="selectedYear" min="2020" max="2030" />
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Form_NameLabel"]</label>
                <input type="text" class="form-control" @bind="budgetName" placeholder="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                <small class="form-text text-muted">@L["Form_NameHelp"]</small>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Form_NotesLabel"]</label>
                <textarea class="form-control" @bind="notes" rows="3"></textarea>
            </div>

            <button class="btn btn-primary" @onclick="GeneratePredictions">
                @L["Button_NextGenerate"]
            </button>
            <a href="/budgets?projectId=@selectedProjectId" class="btn btn-secondary">@L["Button_Cancel"]</a>
        </div>
    </div>
}
else if (step == 2)
{
    <div class="card">
        <div class="card-header">
            <h5>@L["Step_Two_Title"]</h5>
        </div>
        <div class="card-body">
            @if (isGenerating)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">@L["Status_GeneratingShort"]</span>
                    </div>
                    <p>@L["Status_GeneratingLong"]</p>
                </div>
            }
            else if (predictions != null && categoryNames != null)
            {
                <p class="text-muted">
                    @L["Predictions_Intro"]
                </p>

                var sortedPredictions = predictions
                    .OrderBy(p => categoryNames.GetValueOrDefault(p.Key, L["Category_Unknown"]))
                    .ToList();
                var wizIncomeRows = sortedPredictions.Where(p => incomeKeys.Contains(p.Key)).ToList();
                var wizExpenseRows = sortedPredictions.Where(p => !incomeKeys.Contains(p.Key)).ToList();
                decimal wizIncomeMonth(int idx) => wizIncomeRows.Sum(p => p.Value[idx]);
                decimal wizExpenseMonth(int idx) => wizExpenseRows.Sum(p => p.Value[idx]);
                var wizIncomeYear = wizIncomeRows.Sum(p => p.Value.Sum());
                var wizExpenseYear = wizExpenseRows.Sum(p => p.Value.Sum());
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@L["Table_Category"]</th>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <th class="text-end">@(new DateTime(2000, m, 1).ToString("MMM"))</th>
                                }
                                <th class="text-end">@L["Table_Total"]</th>
                            </tr>
                        </thead>
                        @if (wizIncomeRows.Any())
                        {
                            <tbody>
                                <tr class="table-secondary">
                                    <th colspan="14">@L["Section_Income"]</th>
                                </tr>
                                @foreach (var (key, amounts) in wizIncomeRows)
                                {
                                    <tr>
                                        <td>@categoryNames.GetValueOrDefault(key, L["Category_Unknown"])</td>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            var idx = m;
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm"
                                                       style="min-width: 80px; text-align: right;"
                                                       step="0.01"
                                                       @bind="amounts[idx]" />
                                            </td>
                                        }
                                        <td class="text-end"><strong>€@amounts.Sum().ToString("N2")</strong></td>
                                    </tr>
                                }
                                <tr class="table-primary">
                                    <th>@L["Subtotal_Income"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        <th class="text-end">€@wizIncomeMonth(m).ToString("N2")</th>
                                    }
                                    <th class="text-end">€@wizIncomeYear.ToString("N2")</th>
                                </tr>
                            </tbody>
                        }
                        @if (wizExpenseRows.Any())
                        {
                            <tbody>
                                <tr class="table-secondary">
                                    <th colspan="14">@L["Section_Expenses"]</th>
                                </tr>
                                @foreach (var (key, amounts) in wizExpenseRows)
                                {
                                    <tr>
                                        <td>@categoryNames.GetValueOrDefault(key, L["Category_Unknown"])</td>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            var idx = m;
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm"
                                                       style="min-width: 80px; text-align: right;"
                                                       step="0.01"
                                                       @bind="amounts[idx]" />
                                            </td>
                                        }
                                        <td class="text-end"><strong>€@amounts.Sum().ToString("N2")</strong></td>
                                    </tr>
                                }
                                <tr class="table-primary">
                                    <th>@L["Subtotal_Expenses"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        <th class="text-end">€@wizExpenseMonth(m).ToString("N2")</th>
                                    }
                                    <th class="text-end">€@wizExpenseYear.ToString("N2")</th>
                                </tr>
                            </tbody>
                        }
                        @if (wizIncomeRows.Any() && wizExpenseRows.Any())
                        {
                            var netYear = wizIncomeYear - wizExpenseYear;
                            var netClass = netYear >= 0 ? "text-success" : "text-danger";
                            <tfoot>
                                <tr>
                                    <th>@L["Net"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        var net = wizIncomeMonth(m) - wizExpenseMonth(m);
                                        var cls = net >= 0 ? "text-success" : "text-danger";
                                        <th class="text-end @cls">€@net.ToString("N2")</th>
                                    }
                                    <th class="text-end @netClass">€@netYear.ToString("N2")</th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="SaveBudget">@L["Button_SaveBudget"]</button>
                    <button class="btn btn-secondary" @onclick="() => step = 1">@L["Button_Back"]</button>
                </div>
            }
        </div>
    </div>
}
else if (step == 3)
{
    <div class="alert alert-success">
        <h4>@L["Success_Heading"]</h4>
        <p>@L["Success_Body", selectedYear]</p>
        <a href="/budgets?projectId=@selectedProjectId" class="btn btn-primary">@L["Button_ViewBudgets"]</a>
        <a href="/budgets/wizard?projectId=@selectedProjectId" class="btn btn-secondary" @onclick="Reset">@L["Button_CreateAnother"]</a>
    </div>
}

@code {
    private List<Project>? projects;
    private int selectedProjectId;
    private int selectedYear = DateTime.UtcNow.Year;
    private string budgetName = "";
    private string notes = "";
    private int step = 1;
    private bool isGenerating = false;
    private bool notFound = false;

    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]>? predictions;
    private Dictionary<(long Id, CategoryItemType ItemType), string>? categoryNames;
    private HashSet<(long Id, CategoryItemType ItemType)> incomeKeys = new();

    // Category selection
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private List<Category>? allActualCategories;
    private HashSet<long> selectedCategoryGroupIds = new();
    private HashSet<long> selectedActualCategoryIds = new();

    protected override async Task OnInitializedAsync()
    {
        // The wizard is project-scoped via ?projectId=<id>; mirroring Analysis and Cashflow.
        // No project (or an unknown one) renders a Not Found view rather than offering a
        // free-floating project picker.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (!QueryHelpers.ParseQuery(uri.Query).TryGetValue("projectId", out var v)
            || !int.TryParse(v, out var pid))
        {
            notFound = true;
            return;
        }

        projects = await BudgetService.GetProjectsAsync();
        if (!projects.Any(p => p.Id == pid))
        {
            notFound = true;
            return;
        }

        selectedProjectId = pid;
    }

    private async Task LoadCategories()
    {
        var project = await BudgetService.GetProjectAsync(selectedProjectId);
        if (project == null)
            return;

        // Load all category groups/categories for the project
        var allCategoryGroups = await BudgetService.GetAllCategoriesWithChildCountsAsync(project.SourceId);
        allActualCategories = await BudgetService.GetAllCategoriesAsync(project.SourceId);

        // Get all category group IDs that are in the project
        var projectCategoryGroupIds = new HashSet<long>();
        foreach (var assignment in project.CategoryAssignments)
        {
            projectCategoryGroupIds.Add(assignment.CategoryId);
            GetAllSubGroupIds(assignment.CategoryId, projectCategoryGroupIds, allCategoryGroups);
        }

        // Filter to only categories in the project
        var sentinelRoot = SourceScope.SentinelRoot(project.SourceId);
        allAvailableCategories = allCategoryGroups
            .Where(c => c.CategoryGroup.Id != sentinelRoot && projectCategoryGroupIds.Contains(c.CategoryGroup.Id))
            .ToList();

        // Initialize with top-level assignments selected
        selectedCategoryGroupIds = project.CategoryAssignments
            .Select(a => a.CategoryId)
            .ToHashSet();
        selectedActualCategoryIds.Clear();

        step = 2;
    }

    private void GetAllSubGroupIds(long categoryGroupId, HashSet<long> result, List<CategoryGroupWithChildCount> allCategories)
    {
        var children = allCategories.Where(c => c.ParentCategoryGroupId == categoryGroupId).ToList();
        foreach (var child in children)
        {
            result.Add(child.CategoryGroup.Id);
            GetAllSubGroupIds(child.CategoryGroup.Id, result, allCategories);
        }
    }

    private async Task GeneratePredictions()
    {
        step = 2;
        isGenerating = true;
        StateHasChanged();

        await Task.Delay(100); // Allow UI to update

        // Load tracking items from the project
        var trackingItems = await BudgetService.GetProjectTrackingItemsAsync(selectedProjectId);
        var sourceIdForPredict = await BudgetService.GetSourceIdForProjectAsync(selectedProjectId);
        incomeKeys = await BudgetService.GetIncomeItemsForProjectAsync(selectedProjectId);

        // Load the hierarchy once so we can look up parent names without per-item DB calls.
        var allCategoryItems = await BudgetService.GetAllCategoriesWithChildCountsAsync(sourceIdForPredict);
        var groupById = allCategoryItems
            .Where(c => c.ItemType == CategoryItemType.Group)
            .ToDictionary(c => c.Id, c => c.CategoryGroup);
        var categoryById = (await BudgetService.GetAllCategoriesAsync(sourceIdForPredict))
            .ToDictionary(c => c.Id, c => c);

        predictions = new Dictionary<(long Id, CategoryItemType ItemType), decimal[]>();
        categoryNames = new Dictionary<(long Id, CategoryItemType ItemType), string>();

        // First pass: gather predictions and remember each row's base name + parent group name.
        var labels = new List<((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName)>();
        foreach (var item in trackingItems)
        {
            if (item.CategoryGroupId.HasValue)
            {
                if (!groupById.TryGetValue(item.CategoryGroupId.Value, out var cg)) continue;
                var parentName = cg.ParentGroupId.HasValue
                    && groupById.TryGetValue(cg.ParentGroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                var key = (item.CategoryGroupId.Value, CategoryItemType.Group);
                labels.Add((key, cg.Name ?? L["Category_Unknown"], parentName));

                var isIncome = incomeKeys.Contains(key);
                var monthlyPredictions = await BudgetService.PredictMonthlySpendingForCategoryAsync(item.CategoryGroupId.Value, selectedYear, sourceIdForPredict, isIncome);
                predictions[key] = monthlyPredictions.Select(p => Math.Round(p, 2)).ToArray();
            }
            else if (item.CategoryId.HasValue)
            {
                if (!categoryById.TryGetValue(item.CategoryId.Value, out var cat)) continue;
                var parentName = cat.GroupId.HasValue
                    && groupById.TryGetValue(cat.GroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                var key = (item.CategoryId.Value, CategoryItemType.Category);
                labels.Add((key, cat.Name ?? L["Category_Unknown"], parentName));

                var isIncome = incomeKeys.Contains(key);
                var monthlyPredictions = await BudgetService.PredictMonthlySpendingForLeafCategoryAsync(item.CategoryId.Value, selectedYear, sourceIdForPredict, isIncome);
                predictions[key] = monthlyPredictions.Select(p => Math.Round(p, 2)).ToArray();
            }
        }

        // Second pass: only prefix the parent when the base name collides with another row's.
        var nameCounts = labels
            .GroupBy(l => l.BaseName)
            .ToDictionary(g => g.Key, g => g.Count());

        foreach (var (key, baseName, parentName) in labels)
        {
            categoryNames[key] = nameCounts[baseName] > 1 && !string.IsNullOrEmpty(parentName)
                ? $"{parentName} › {baseName}"
                : baseName;
        }

        isGenerating = false;
    }

    private async Task HandleCategoryGroupToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedCategoryGroupIds.Add(args.Id);
            RemoveDescendantsFromSelection(args.Id);
        }
        else
        {
            selectedCategoryGroupIds.Remove(args.Id);
            SelectImmediateChildren(args.Id);
        }
        await Task.CompletedTask;
    }

    private async Task HandleCategoryToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedActualCategoryIds.Add(args.Id);
        }
        else
        {
            selectedActualCategoryIds.Remove(args.Id);
        }
        await Task.CompletedTask;
    }

    private void RemoveDescendantsFromSelection(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        var childGroups = allAvailableCategories
            .Where(c => c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        foreach (var child in childGroups)
        {
            selectedCategoryGroupIds.Remove(child.CategoryGroup.Id);
            RemoveDescendantsFromSelection(child.CategoryGroup.Id);
        }

        if (allActualCategories != null)
        {
            var categoriesToRemove = allActualCategories
                .Where(c => c.GroupId == parentCategoryGroupId)
                .Select(c => c.Id)
                .ToList();

            foreach (var catId in categoriesToRemove)
            {
                selectedActualCategoryIds.Remove(catId);
            }
        }
    }

    private void SelectImmediateChildren(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        var childGroups = allAvailableCategories
            .Where(c => c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        if (childGroups.Any())
        {
            foreach (var child in childGroups)
            {
                selectedCategoryGroupIds.Add(child.CategoryGroup.Id);
            }
        }
        else if (allActualCategories != null)
        {
            var categories = allActualCategories
                .Where(c => c.GroupId == parentCategoryGroupId)
                .ToList();

            foreach (var cat in categories)
            {
                selectedActualCategoryIds.Add(cat.Id);
            }
        }
    }

    private async Task SaveBudget()
    {
        if (predictions == null)
            return;

        var budget = await BudgetService.CreateBudgetAsync(selectedProjectId, selectedYear, budgetName, notes);
        var entries = predictions
            .Select(kvp => (kvp.Key.Id, kvp.Key.ItemType, kvp.Value))
            .ToList();
        await BudgetService.SaveBudgetEntriesAsync(budget.Id, entries);

        step = 3;
    }

    private void Reset()
    {
        step = 1;
        selectedProjectId = 0;
        selectedYear = DateTime.UtcNow.Year;
        budgetName = "";
        notes = "";
        predictions = null;
        categoryNames = null;
        allAvailableCategories = null;
        allActualCategories = null;
        selectedCategoryGroupIds.Clear();
        selectedActualCategoryIds.Clear();
    }
}
