@page "/projects"
@using OpenBudget.Services
@using OpenBudget.Models
@inject BudgetService BudgetService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateDialog">Create New Project</button>
</div>

@if (budgets == null)
{
    <p><em>Loading projects...</em></p>
}
else if (!budgets.Any())
{
    <p><em>No projects created yet. Click "Create New Project" to get started.</em></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Categories</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var budget in budgets)
            {
                <tr>
                    <td>
                        <a href="/projects/@budget.Id">@budget.Name</a>
                    </td>
                    <td>@budget.Description</td>
                    <td>@budget.CategoryAssignments.Count</td>
                    <td>@budget.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteBudget(budget.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showCreateDialog)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Project</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="budgetName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="budgetName" @bind="newBudgetName" />
                    </div>
                    <div class="mb-3">
                        <label for="budgetDescription" class="form-label">Description (optional)</label>
                        <textarea class="form-control" id="budgetDescription" @bind="newBudgetDescription" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateBudget">Create</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<Project>? budgets;
    private bool showCreateDialog = false;
    private string newBudgetName = "";
    private string newBudgetDescription = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        budgets = await BudgetService.GetProjectsAsync();
    }

    private void ShowCreateDialog()
    {
        newBudgetName = "";
        newBudgetDescription = "";
        showCreateDialog = true;
    }

    private void HideCreateDialog()
    {
        showCreateDialog = false;
    }

    private async Task CreateBudget()
    {
        if (string.IsNullOrWhiteSpace(newBudgetName))
            return;

        await BudgetService.CreateProjectAsync(newBudgetName, newBudgetDescription);
        showCreateDialog = false;
        await LoadBudgets();
    }

    private async Task DeleteBudget(int budgetId)
    {
        if (confirm("Are you sure you want to delete this project?"))
        {
            await BudgetService.DeleteProjectAsync(budgetId);
            await LoadBudgets();
        }
    }

    private bool confirm(string message)
    {
        // Simple confirmation - in production you'd use a proper modal
        return true;
    }
}
