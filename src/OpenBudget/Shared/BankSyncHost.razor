@inherits DataChangeAwareComponent
@using OpenBudget.Connectors
@using OpenBudget.Connectors.Sync
@using OpenBudget.Services
@inject BankLoginService Bank
@inject NavigationManager Navigation
@inject IStringLocalizer<BankSyncHost> L

@* Header-area host for bank syncs of the signed-in user, available on every page: starts what is due
   when a page loads, shows a small "syncing" marker, and presents the open challenge (code, method choice,
   image, app approval) in a dialog the moment a sync asks for one. All state comes from the owner-scoped
   BankLoginService, so nothing here ever shows another user's logins. *@

@* Top-bar sync status: a spinner while syncs run, otherwise the time of the last successful sync ("Synced 07:58");
   clicking it syncs all of the user's bank logins. Next to it, a warning sign opens the connections that need the user (a
   background sync waiting for them, rejected credentials, a failed last sync), with a link to Connections. Nothing when bank logins are disabled or there are none. *@
@if (statuses.Any(s => s.Phase != SyncPhase.Finished))
{
    <span class="app-sync d-print-none" data-testid="bank-sync-chip">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span class="app-sync-label">@{ var running = statuses.Where(s => s.Phase != SyncPhase.Finished).ToList(); var syncing = running.Count; }@L[syncing == 1 ? "Syncing_One" : "Syncing", syncing]@if (syncing == 1 && running[0].Message is { Length: > 0 } progress && progress.StartsWith("Fetching documents", StringComparison.Ordinal)) {<span class="text-body-secondary" data-testid="bank-sync-progress"> · @progress</span>}</span>
    </span>
}
else if (lastSync is { } last)
{
    <button type="button" class="app-sync d-print-none" data-testid="bank-sync-status" title="@L["SyncAllTitle"]"
            disabled="@syncAllStarting" @onclick="SyncAllAsync">
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
        <span class="app-sync-label">@L["SyncedAt", FormatLastSync(last)]</span>
    </button>
}
@if (problems.Count > 0 && !statuses.Any(s => s.Phase != SyncPhase.Finished))
{
    @* A dropdown like the project switcher: uiBehaviors.js closes it on click-away, on Escape and when its link is followed. *@
    <details class="app-menu sync-problems d-print-none" data-testid="bank-sync-attention">
        <summary class="app-sync-attention" title="@L["Attention"]" aria-label="@L["Attention"]">
            <i class="bi bi-exclamation" aria-hidden="true"></i>
        </summary>
        <div class="dropdown-menu dropdown-menu-end show sync-problems-menu">
            <div class="project-switcher-head">@L["Problems_Heading"]</div>
            <ul class="sync-problems-list">
                @foreach (var (loginId, name, message) in problems)
                {
                    var id = loginId;
                    <li data-testid="sync-problem">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        <div class="sync-problem-text"><div class="fw-semibold">@name</div>@foreach (var line in message.Split('\n'))
                        {
                            <div class="small text-body-secondary">@line</div>
                        }</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary sync-problem-sync" data-testid="sync-problem-sync"
                                disabled="@(syncingProblem == id)" @onclick="() => SyncProblemAsync(id)">@L["Problems_Sync"]</button>
                    </li>
                }
            </ul>
            <div class="project-switcher-foot">
                <a class="dropdown-item" href="/connections" data-testid="sync-problems-connections">
                    <i class="bi bi-bank me-2" aria-hidden="true"></i>@L["Problems_Open"]
                </a>
            </div>
        </div>
    </details>
}

<Modal Show="@(challenge != null && NeedsUser(challenge))"
       Title="@(challenge != null ? L[challenge.Challenge?.Kind == ChallengeKind.WebLogin ? "TitleSignIn" : "Title", LoginName(challenge.LoginId)].Value : "")"
       SizeClass="@(challenge?.Challenge?.Kind == ChallengeKind.WebLogin && (challenge.WebLoginMode == OpenBudget.Browser.WebLoginMode.Interactive || showBrowser) ? "modal-xl" : "")"
       ShowCloseButton="false" CloseOnBackdropClick="false" OnTop="true" OnClose="@(() => Task.CompletedTask)">
    <ChildContent>
        @if (challenge?.Challenge is { } c)
        {
            <div data-testid="bank-challenge" data-kind="@c.Kind">
                @if (c.Kind != ChallengeKind.WebLogin)
                {
                    <p>@c.Message</p>
                }
                @switch (c.Kind)
                {
                    case ChallengeKind.Choice:
                        <div class="list-group mb-2">
                            @foreach (var o in c.Options)
                            {
                                <label class="list-group-item">
                                    <input class="form-check-input me-2" type="radio" name="bank-choice" value="@o.Id"
                                           checked="@(selectedOption == o.Id)" @onchange="() => selectedOption = o.Id" />
                                    @o.Label
                                </label>
                            }
                        </div>
                        break;
                    case ChallengeKind.WebLogin:
                        @if (challenge.WebLoginMode == OpenBudget.Browser.WebLoginMode.Interactive || showBrowser)
                        {
                            <p class="small text-body-secondary">@L["WebLoginHint"]</p>
                            <RemoteBrowser SessionId="@(challenge.WebLoginSessionId ?? "")" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 text-body-secondary mb-3" data-testid="web-login-status" data-mode="@challenge.WebLoginMode">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                @(ShowApprovalHint(challenge)
                                    ? L["WaitingApprovalBank", LoginName(challenge.LoginId)].Value
                                    : L["SigningIn"].Value)
                            </div>
                            <button type="button" class="btn btn-link btn-sm p-0" data-testid="web-login-show" @onclick="() => showBrowser = true">@L["ShowBrowser"]</button>
                        }
                        break;
                    case ChallengeKind.Approval:
                        <div class="d-flex align-items-center gap-2 text-body-secondary">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @L["WaitingApproval"]
                        </div>
                        break;
                    case ChallengeKind.Image:
                        <img alt="@L["ImageAlt"]" class="img-fluid border mb-2" style="image-rendering: pixelated; min-width: 64px;"
                             src="@($"data:{c.ImageContentType};base64,{Convert.ToBase64String(c.Image ?? [])}")" />
                        <input id="bank-challenge-input" class="form-control" autocomplete="off" inputmode="@(c.Numeric ? "numeric" : "text")"
                               maxlength="@(c.Length ?? 64)" @bind="answerText" @bind:event="oninput" @onkeydown="OnKeyDown" />
                        break;
                    case ChallengeKind.Code:
                        @* A form around the field (Enter submits it) is what lets Safari offer the code from Messages. *@
                        <form id="bank-challenge-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                            <input id="bank-challenge-input" name="one-time-code" type="text" class="form-control" autocomplete="one-time-code"
                                   inputmode="@(c.Numeric ? "numeric" : "text")" maxlength="@(c.Length ?? 64)"
                                   @bind="answerText" @bind:event="oninput" />
                        </form>
                        break;
                    default:
                        break;
                }
                @if (challenge.ChallengeExpiresAt is { } expires)
                {
                    <div class="small text-body-secondary mt-2">@L["ExpiresAt", FormatTime(expires)]</div>
                }
                @if (!string.IsNullOrEmpty(error)) { <div class="text-danger small mt-2" role="alert">@error</div> }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" id="bank-challenge-cancel" @onclick="CancelAsync">@L["CancelSync"]</button>
        @if (challenge?.Challenge is { Kind: not (ChallengeKind.Approval or ChallengeKind.WebLogin) })
        {
            <button type="button" class="btn btn-primary" id="bank-challenge-submit" @onclick="SubmitAsync">@L["Submit"]</button>
        }
    </Footer>
</Modal>

@code {
    /// <summary>
    /// Whether the dialog shows: always for a question to the user; for a web login only once the page needs the user
    /// or the user asked to see it. Whether the page needs the user (interactive, or the bank waiting for a confirmation
    /// long enough for the approval hint) is the job's phase, which the Bank logins card shows as well. A sign-in that
    /// runs by itself stays in the top bar's sync status.
    /// </summary>
    private bool NeedsUser(BankSyncStatus c) =>
        c.Challenge?.Kind != ChallengeKind.WebLogin
        || c.Phase == SyncPhase.WaitingForInput
        || showBrowser;

    [Inject] private ClockService ClockSvc { get; set; } = default!;

    private IReadOnlyList<BankSyncStatus> statuses = [];
    // connections that need the user: a background sync waiting for them, rejected credentials or a failed last sync
    private List<(int LoginId, string Name, string Message)> problems = [];
    private int? syncingProblem;

    /// <summary>Syncs one connection from the problems list; its dialog (a code, an app approval) opens like any sync's.</summary>
    private async Task SyncProblemAsync(int loginId)
    {
        syncingProblem = loginId;
        try { await Bank.SyncNowAsync(loginId); }
        catch (Exception ex) when (ex is InvalidOperationException or AccessDeniedException) { /* gone or not allowed: the list refreshes */ }
        finally { syncingProblem = null; }
        await RefreshAsync();
    }
    private Dictionary<int, string> names = new();
    private BankSyncStatus? challenge;
    private Guid shownChallengeId;
    private bool showBrowser;
    private string answerText = "";
    private string? selectedOption;
    private string? error;
    private bool subscribed;
    private bool enabled;

    private DateTime? lastSync;
    private bool syncAllStarting;

    private string FormatTime(DateTime utc) => ClockSvc.ToLocal(utc).ToString("HH:mm");

    // Today: just the time; otherwise the date as well.
    private string FormatLastSync(DateTime utc)
    {
        var local = ClockSvc.ToLocal(utc);
        return local.Date == ClockSvc.NowLocal.Date ? local.ToString("HH:mm") : local.ToString("dd.MM. HH:mm");
    }

    private async Task SyncAllAsync()
    {
        syncAllStarting = true;
        try { await Bank.SyncAllAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or AccessDeniedException) { /* not signed in / disabled */ }
        finally { syncAllStarting = false; }
        await RefreshAsync();
    }

    private string LoginName(int id) => names.GetValueOrDefault(id, "");

    protected override bool IsRelevantChange(DataChange change) => change.Area == DataArea.BankSync;

    protected override Task ReloadAfterChangeAsync() => RefreshAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Interactive only (not during prerender): the page-load trigger for this circuit.
        if (!firstRender) return;
        enabled = Bank.IsEnabled;
        if (!enabled) return;
        Navigation.LocationChanged += OnLocationChanged;
        subscribed = true;
        await StartDueSafeAsync();
        await RefreshAsync();
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await StartDueSafeAsync();
            await RefreshAsync();
            StateHasChanged();
        });

    private async Task StartDueSafeAsync()
    {
        try { await Bank.StartDueAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or AccessDeniedException) { /* not signed in / disabled */ }
    }

    private async Task RefreshAsync()
    {
        if (!enabled) return;
        statuses = await Bank.GetStatusesAsync();
        var logins = await Bank.GetLoginsAsync();
        names = logins.ToDictionary(l => l.Id, l => l.DisplayName);
        lastSync = logins.Where(l => l.LastSyncAt != null).Select(l => l.LastSyncAt).Max();
        // the bank's own error first (it says what went wrong), then why a background sync waits for the user
        problems = logins
            .Select(l => (l.Id, l.DisplayName, Message: string.Join("\n", new[]
            {
                l.CredentialsInvalid ? L["Problem_Credentials"].Value : l.LastError,
                l.NeedsManualSync,
            }.Where(m => !string.IsNullOrEmpty(m)))))
            .Where(p => p.Message.Length > 0)
            .ToList();

        var open = statuses.FirstOrDefault(s => s.Challenge != null && s.Phase != SyncPhase.Finished);
        if (open?.ChallengeId != shownChallengeId)
        {
            shownChallengeId = open?.ChallengeId ?? Guid.Empty;
            showBrowser = false;
            answerText = "";
            selectedOption = open?.Challenge?.Options.FirstOrDefault()?.Id;
            error = null;
        }
        challenge = open;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (challenge?.Challenge is not { } c) return;
        var value = c.Kind == ChallengeKind.Choice ? selectedOption : answerText.Trim();
        var ok = await Bank.SubmitAnswerAsync(challenge.LoginId, challenge.ChallengeId, value);
        error = ok ? null : L["Rejected"].Value;
        await RefreshAsync();
    }

    private async Task CancelAsync()
    {
        if (challenge == null) return;
        await Bank.CancelSyncAsync(challenge.LoginId);
        await RefreshAsync();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing && subscribed) Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose(disposing);
    }

    /// <summary>The bank waits for a confirmation in its app: the job waits for the user without the page needing them.</summary>
    private static bool ShowApprovalHint(BankSyncStatus status) =>
        status.WebLoginMode == OpenBudget.Browser.WebLoginMode.Waiting && status.Phase == SyncPhase.WaitingForInput;

}
