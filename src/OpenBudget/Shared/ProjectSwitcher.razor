@using OpenBudget.Models
@using OpenBudget.Services
@inherits DataChangeAwareComponent
@inject CurrentProjectState Current
@inject ProjectService ProjectService
@inject BudgetService BudgetService
@inject PortfolioService PortfolioService
@inject OpenBudget.Auth.UserDirectory Users
@inject ClockService Clock
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ProjectSwitcher> Logger
@inject IStringLocalizer<ProjectSwitcher> L

@* The project switcher in the top bar — it replaced the start page. Lists every project the user can see with
   the numbers the start page used to show: balance and number of accounts, this month's spending against the
   budget (bar + percentage), the default-for-new-accounts badge and who shared it. Then "New project". The
   numbers load when the menu opens, so it costs nothing until used.
   An editor's rows end in a gear that opens the project's settings. A row's context menu (right-click, touch long-press, Shift+F10 / the context-menu key) offers Settings…
   (the project's settings page), Move up / Move down and Delete (DeleteProjectDialog); rows also reorder by dragging.
   The order is each user's own, so everyone reorders every project they see; Settings… needs an editor, Delete the
   owner. Other sessions' changes reload the list. *@

<details class="project-selector app-menu" data-testid="project-selector" @key="Current.ProjectId">
    <summary class="project-selector-toggle" @onclick="LoadAsync" aria-label="@L["Aria_Switcher"]">
        <span class="project-selector-name">@(Current.ProjectName ?? L["Label_Projects"])</span>
        <i class="bi bi-chevron-down ms-1 project-selector-caret d-print-none" aria-hidden="true"></i>
    </summary>
    <div class="dropdown-menu show project-switcher-menu">
        <div class="project-switcher-head">@L["Heading_Projects", MonthName]</div>
        @if (rows == null)
        {
            <div class="px-3 py-2 small text-body-secondary" aria-busy="true">@L["Loading"]</div>
        }
        else if (rows.Count == 0)
        {
            <div class="px-3 py-2 small text-body-secondary">@L["Empty"]</div>
        }
        else
        {
            <ul class="project-switcher-list" data-testid="switcher-projects">
                @foreach (var r in rows)
                {
                    var current = r.Id == Current.ProjectId;
                    var row = r;
                    var hasMenu = MenuFor(r).Count > 0;
                    <li>
                        <a class="project-switcher-row @(current ? "current" : "") @(r.Id == dragOverId && dragId != null && dragId != r.Id ? "drag-over" : "") @(r.Id == dragId ? "dragging" : "")"
                           href="@TargetUrl(r)" aria-current="@(current ? "true" : null)" data-testid="switcher-project"
                           data-project-id="@r.Id"
                           aria-haspopup="@(hasMenu ? "menu" : null)"
                           data-ob-longpress="@(hasMenu ? "" : null)"
                           @oncontextmenu="e => OpenMenu(row, e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="@hasMenu"
                           @onkeydown="e => MenuKeyAsync(row, e)"
                           draggable="true"
                           @ondragstart="() => dragId = row.Id"
                           @ondragenter="() => dragOverId = row.Id"
                           @ondragover:preventDefault="true"
                           @ondrop="() => DropAsync(row)" @ondrop:preventDefault="true"
                           @ondragend="() => dragId = dragOverId = null">
                            <span class="project-switcher-id">
                                <span class="project-switcher-name">
                                    <span class="text-truncate">@r.Name</span>
                                    @if (r.IsDefault)
                                    {
                                        <span class="ob-chip" data-testid="switcher-default-badge" title="@L["Badge_Default_Title"]">@L["Badge_Default"]</span>
                                    }
                                    @if (r.SharedBy != null)
                                    {
                                        <span class="ob-chip" title="@r.SharedBy">@L["Badge_Shared"]</span>
                                    }
                                </span>
                                <span class="project-switcher-sub" data-testid="switcher-balance">
                                    @if (r.Balance is { } b)
                                    {
                                        <span class="@(b.Balance < 0 ? "money-neg" : "")">@Formatting.FormatMoneyDe(b.Balance)</span>
                                        <span> · @L[b.AccountCount == 1 ? "Accounts_One" : "Accounts_Other", b.AccountCount]</span>
                                    }
                                </span>
                            </span>
                            @if (r.Summary is { HasBudget: true } s)
                            {
                                var pct = ProjectStatus.OverallPercent(s);
                                var status = ProjectStatus.StatusClass(s);
                                <span class="project-switcher-budget" data-testid="switcher-budget">
                                    <span class="project-switcher-spent">
                                        @Formatting.FormatMoneyDe(s.TotalSpent) / @Formatting.FormatMoneyDe(s.TotalBudget)
                                        <span class="fw-semibold status-@status">@pct.ToString("F0", CultureInfo.CurrentCulture) %</span>
                                    </span>
                                    <span class="project-switcher-bar"><span class="status-bg-@status" style="width: @(Math.Min(pct, 100).ToString("F0", CultureInfo.InvariantCulture))%"></span></span>
                                </span>
                            }
                            else if (r.Summary is { } n)
                            {
                                <span class="project-switcher-budget">
                                    <span class="project-switcher-spent">@L["Label_Net"] <span class="fw-semibold @(n.MonthNet < 0 ? "money-neg" : "")">@Formatting.FormatMoneyDe(n.MonthNet)</span></span>
                                </span>
                            }
                        </a>
                        @if (r.Role >= ProjectRole.Editor)
                        {
                            <a class="project-switcher-gear" href="@($"/projects/{r.Id}/settings")" data-testid="switcher-project-settings"
                               title="@L["Menu_Settings"]" aria-label="@L["Aria_ProjectSettings", r.Name]">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                            </a>
                        }
                    </li>
                }
            </ul>
        }
        <div class="project-switcher-foot">
            <button type="button" class="dropdown-item" data-testid="switcher-new-project" @onclick="OpenNewProject">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>@L["Item_NewProject"]
            </button>
        </div>
        @if (menuRow != null)
        {
            @* Inside the <details>, so picking an entry doesn't count as a click outside that closes the switcher. *@
            <ContextMenu Items="menuItems" X="menuX" Y="menuY" OnPick="PickAsync" OnClose="() => menuRow = null" />
        }
    </div>
</details>

<DeleteProjectDialog Target="deleteTarget" OnClose="() => deleteTarget = null" OnDeleted="OnDeletedAsync" />
<NewProjectDialog Show="showNewProject" OnClose="() => showNewProject = false" />

@code {
    private sealed record Row(int Id, string Name, ProjectRole Role, bool IsDefault, string? SharedBy, ProjectBalanceSummary? Balance, ProjectSpendingSummary? Summary, bool HasPortfolio)
    {
        public bool IsOwner => Role == ProjectRole.Owner;
    }

    /// <summary>Switching keeps the view: Budget → Budget, Cashflow → Cashflow, Portfolio → Portfolio when the
    /// target has depots, everything else → Transactions (without the selection).</summary>
    private string TargetUrl(Row r)
    {
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;
        var view = System.Text.RegularExpressions.Regex.Match(path, @"^/projects/\d+/(budgets|cashflow|portfolio|documents)(/|$)") is { Success: true } m
            ? m.Groups[1].Value : null;
        return view switch
        {
            "budgets" or "cashflow" or "documents" => $"/projects/{r.Id}/{view}",
            "portfolio" when r.HasPortfolio => $"/projects/{r.Id}/portfolio",
            _ => $"/projects/{r.Id}/browse",
        };
    }

    private List<Row>? rows;

    // Context menu
    private Row? menuRow;
    private IReadOnlyList<ContextMenuItem> menuItems = [];
    private double menuX;
    private double menuY;

    // Dialogs
    private (int Id, string Name)? deleteTarget;
    private bool showNewProject;

    // Drag and drop (owners, among their own projects)
    private int? dragId;
    private int? dragOverId;

    private string MonthName => Clock.NowLocal.ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Current.Changed += OnProjectChanged;
    }

    private void OnProjectChanged() => _ = InvokeAsync(StateHasChanged);

    // Another session added, renamed, reordered, shared or deleted a project: refresh the list if it was loaded and
    // the name in the top bar.
    protected override bool ListensToProjectOrder => true;

    protected override bool IsRelevantChange(DataChange change) => change.Area is DataArea.Projects or DataArea.ProjectOrder;

    protected override async Task ReloadAfterChangeAsync()
    {
        if (Current.ProjectId is { } id && (await ProjectService.GetProjectAsync(id)) is { } p) Current.Set(id, p.Name);
        if (rows != null) await LoadAsync();
    }

    /// <summary>Loads (or refreshes) the list when the menu is opened.</summary>
    private async Task LoadAsync()
    {
        var scope = await Access.GetAsync();
        var projects = await ProjectService.GetProjectsAsync();
        var balances = await ProjectService.GetAllProjectsBalancesAsync();
        var owners = await Users.GetNamesAsync(projects.Where(p => p.OwnerUserId != null).Select(p => p.OwnerUserId!));
        var now = Clock.NowLocal;
        var list = new List<Row>();
        foreach (var p in projects)
        {
            ProjectSpendingSummary? summary = null;
            try
            {
                summary = await BudgetService.GetSpendingSummaryAsync(p.Id, now.Year, now.Month, now.Month);
            }
            catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
            {
                Logger.LogError(ex, "Error loading spending summary for project {ProjectId}.", p.Id);
            }
            var role = scope.RoleFor(p.Id);
            string? sharedBy = null;
            if (role != ProjectRole.Owner)
            {
                var ownerName = p.OwnerUserId is { } oid ? owners.GetValueOrDefault(oid, "?") : "?";
                sharedBy = L[role == ProjectRole.Editor ? "Shared_Editor" : "Shared_Viewer", ownerName];
            }
            var hasPortfolio = (await PortfolioService.GetProjectDepotIdsAsync(p.Id)).Count > 0;
            list.Add(new Row(p.Id, p.Name, role, role == ProjectRole.Owner && p.IsDefaultForNewAccounts, sharedBy, balances.GetValueOrDefault(p.Id), summary, hasPortfolio));
        }
        rows = list;
    }

    // ---- Context menu ----

    /// <summary>Entries of a row's menu. Everyone may move a row within their own list; Settings… needs an editor
    /// (viewers don't see it), Delete is the owner's (disabled with the reason otherwise).</summary>
    private IReadOnlyList<ContextMenuItem> MenuFor(Row r)
    {
        var all = rows ?? [];
        var at = all.FindIndex(x => x.Id == r.Id);
        var items = new List<ContextMenuItem>();
        if (r.Role >= ProjectRole.Editor)
        {
            items.Add(new("settings", L["Menu_Settings"], "bi-gear"));
            items.Add(ContextMenuItem.Divider());
        }
        items.Add(new("up", L["Menu_MoveUp"], "bi-arrow-up", Disabled: at <= 0));
        items.Add(new("down", L["Menu_MoveDown"], "bi-arrow-down", Disabled: at < 0 || at >= all.Count - 1));
        if (r.Role >= ProjectRole.Editor)
        {
            items.Add(ContextMenuItem.Divider());
            items.Add(new("delete", L["Menu_Delete"], "bi-trash", Disabled: !r.IsOwner, Tooltip: r.IsOwner ? null : L["Reason_OwnerOnly"].Value, Danger: true));
        }
        return items;
    }

    private void OpenMenu(Row r, double x, double y)
    {
        var items = MenuFor(r);
        if (items.Count == 0) return;
        (menuRow, menuItems, menuX, menuY) = (r, items, x, y);
    }

    // Shift+F10 or the context-menu key on a focused row opens its menu below the row.
    private async Task MenuKeyAsync(Row r, KeyboardEventArgs e)
    {
        if (!(e.Key == "ContextMenu" || (e.Key == "F10" && e.ShiftKey))) return;
        double x = 200, y = 200;
        try
        {
            if (await JS.InvokeAsync<double[]?>("obFocusAnchor") is { Length: 2 } xy) (x, y) = (xy[0], xy[1]);
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        OpenMenu(r, x, y);
    }

    private async Task PickAsync(string key)
    {
        var r = menuRow;
        menuRow = null;
        if (r == null) return;
        switch (key)
        {
            case "settings":
                await CloseSwitcherAsync();
                Navigation.NavigateTo(OpenBudget.Pages.ProjectDetail.Url(r.Id));
                break;
            case "delete":
                await CloseSwitcherAsync();
                deleteTarget = (r.Id, r.Name);
                break;
            case "up":
            case "down":
                await RunAsync(() => ProjectService.MoveProjectAsync(r.Id, key == "up" ? -1 : 1));
                break;
        }
    }

    private async Task DropAsync(Row target)
    {
        var dragged = dragId;
        dragId = dragOverId = null;
        if (dragged is not { } id || id == target.Id) return;
        await RunAsync(() => ProjectService.MoveProjectToAsync(id, target.Id));
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (AccessDeniedException ex)
        {
            Logger.LogWarning(ex, "Project reorder refused.");
        }
        await LoadAsync();
    }

    private async Task CloseSwitcherAsync()
    {
        try { await JS.InvokeVoidAsync("obCloseMenus"); }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    private async Task OpenNewProject()
    {
        await CloseSwitcherAsync();
        showNewProject = true;
    }

    private async Task OnDeletedAsync(int id)
    {
        deleteTarget = null;
        if (id == Current.ProjectId)
        {
            // The open project is gone: "/" picks the next one (or shows the welcome).
            Navigation.NavigateTo("/");
            return;
        }
        if (rows != null) await LoadAsync();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing) Current.Changed -= OnProjectChanged;
        base.Dispose(disposing);
    }
}
