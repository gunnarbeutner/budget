@using System.Globalization
@using OpenBudget.Connectors.Receipts
@using OpenBudget.Models
@using OpenBudget.Services
@inject ReceiptService Service
@inject IStringLocalizer<ReceiptPanel> L

@* A receipt in a dialog: its lines as a till receipt (item, quantity, price, category), grouped by the parts the
   receipt splits its booking into, with a filter per part and a search for long receipts. Deposit lines and fees fold
   into one row that opens on click; the bonus and the payment close the receipt. The owner moves an item by its
   category chip: the receipt remembers it for the product, splits the booking again, and the dialog shows the result. *@

<Modal Show="ReceiptId != null" Title="@(view?.Title ?? L["Title"])" SizeClass="modal-lg ob-fullscreen-phone" OnClose="CloseAsync">
    @if (view == null)
    {
        <div class="skeleton skeleton-line" style="width: 50%;"></div>
    }
    else
    {
        <div data-testid="receipt-panel">
            <div class="small text-body-secondary mb-2">
                <span title="@view.InvoiceNumber">@(view.DeliveryDate?.ToAppDate())</span>
                · @(view.ItemCount == 1 ? L["ItemsOne", view.ItemCount] : L["Items", view.ItemCount])
                @if (view.PaidInInstalments)
                {
                    <span data-testid="receipt-panel-instalments"> · @(view.Plan is { } p ? L["InstalmentCount", p.Count] : L["Plan_Title"])</span>
                }
                else if (view.TransactionId == null)
                {
                    <span> · @L["NoBooking"]</span>
                }
                @if (view.ShopUrls() is { Count: > 1 } orders)
                {
                    @foreach (var (number, url) in orders)
                    {
                        <span> · </span><a href="@url" target="_blank" rel="noopener" data-testid="receipt-panel-shop-link"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@L["OpenOrderAtShop", number]</a>
                    }
                }
                else if (view.ShopUrl is { } shopUrl)
                {
                    <span> · </span><a href="@shopUrl" target="_blank" rel="noopener" data-testid="receipt-panel-shop-link"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@L["OpenAtShop"]</a>
                }
            </div>
            @* Without a booking nothing is split, so the receipt shows no categories. *@
            @{ var categorized = view.TransactionId != null; var cols = categorized ? 4 : 3; }
            @if (categorized)
            {
            <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="@L["Parts"]">
                <button type="button" class="btn btn-sm @(part == null ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => part = null">@L["AllParts"]</button>
                @for (var i = 0; i < view.Groups.Count; i++)
                {
                    var index = i;
                    var g = view.Groups[i];
                    <button type="button" class="btn btn-sm d-inline-flex align-items-center gap-1 @(part == index ? "btn-secondary" : "btn-outline-secondary")" data-testid="receipt-panel-part"
                            @onclick="() => part = index"><CategoryPill CategoryId="g.CategoryId" PickerData="PickerData" FallbackName="@BookingCategoryName" /> @Formatting.FormatMoneyDe(g.AmountCents / 100m) (@g.Lines.Count)</button>
                }
            </div>
            }
            @if (view.ItemCount > 8)
            {
                <input type="search" class="form-control form-control-sm mb-2" placeholder="@L["Search"]" aria-label="@L["Search"]"
                       data-testid="receipt-panel-search" @bind="search" @bind:event="oninput" />
            }
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-2 receipt-panel-table">
                    <thead>
                        <tr>
                            <th>@L["Item"]</th>
                            <th class="text-end text-nowrap">@L["Quantity"]</th>
                            <th class="text-end text-nowrap">@L["Price"]</th>
                            @if (categorized)
                            {
                                <th class="text-nowrap">@L["Category"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (g, index) in view.Groups.Select((g, i) => (g, i)).Where(x => part == null || part == x.i))
                        {
                            var products = g.Lines.Where(l => l.Kind == ReceiptItemKind.Product && Matches(l)).ToList();
                            var extras = g.Lines.Where(l => l.Kind != ReceiptItemKind.Product).ToList();
                            @if (view.Groups.Count > 1 && part == null)
                            {
                                <tr class="table-light"><th colspan="@cols" class="small">@CategoryName(g.CategoryId) · @Formatting.FormatMoneyDe(g.AmountCents / 100m)</th></tr>
                            }
                            @foreach (var line in products)
                            {
                                <tr data-testid="receipt-panel-line">
                                    <td class="text-break">@line.Name</td>
                                    <td class="text-end text-nowrap">@line.Quantity</td>
                                    <td class="text-end text-nowrap">@Formatting.FormatMoneyDe(line.TotalCents / 100m)</td>
                                    @if (categorized)
                                    {
                                    <td class="text-nowrap">
                                        @if (CanEdit && PickerData != null)
                                        {
                                            <CategoryPill CategoryId="line.CategoryId" PickerData="PickerData" FallbackName="@BookingCategoryName" TestId="receipt-panel-category"
                                                          Title="@L["Move", line.Name]" OnClick="e => OpenPicker(line, e)" />
                                        }
                                        else
                                        {
                                            <CategoryPill CategoryId="line.CategoryId" PickerData="PickerData" FallbackName="@BookingCategoryName" />
                                        }
                                    </td>
                                    }
                                </tr>
                            }
                            @if (extras.Count > 0 && string.IsNullOrWhiteSpace(search))
                            {
                                var open = openExtras.Contains(index);
                                <tr class="text-body-secondary" data-testid="receipt-panel-extras">
                                    <td colspan="2">
                                        <button type="button" class="btn btn-link btn-sm p-0 text-reset" aria-expanded="@(open ? "true" : "false")"
                                                @onclick="() => { if (!openExtras.Remove(index)) openExtras.Add(index); }">
                                            <i class="bi @(open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i> @L["Extras", extras.Count]
                                        </button>
                                    </td>
                                    <td class="text-end text-nowrap">@Formatting.FormatMoneyDe(extras.Sum(l => l.TotalCents) / 100m)</td>
                                    @if (categorized)
                                    {
                                        <td><CategoryPill CategoryId="g.CategoryId" PickerData="PickerData" FallbackName="@BookingCategoryName" /></td>
                                    }
                                </tr>
                                @if (open)
                                {
                                    @foreach (var line in extras)
                                    {
                                        <tr class="small text-body-secondary">
                                            <td class="ps-4 text-break">@line.Name</td>
                                            <td class="text-end">@line.Quantity</td>
                                            <td class="text-end text-nowrap">@Formatting.FormatMoneyDe(line.TotalCents / 100m)</td>
                                            @if (categorized)
                                            {
                                                <td></td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                    <tfoot class="small">
                        <tr><td colspan="2">@L["Total"]</td><td class="text-end text-nowrap">@Formatting.FormatMoneyDe(view.TotalCents / 100m)</td>@if (categorized) { <td></td> }</tr>
                        @if (view.BonusCents != 0)
                        {
                            <tr><td colspan="2">@(view.Instalment ? L["OtherInstalments"] : view.BonusCents < 0 ? L["Bonus"] : L["Unitemised"])</td><td class="text-end text-nowrap">@Formatting.FormatMoneyDe(view.BonusCents / 100m)</td>@if (categorized) { <td></td> }</tr>
                        }
                        <tr class="fw-semibold"><td colspan="2">@L["Paid"]</td><td class="text-end text-nowrap" data-testid="receipt-panel-paid">@Formatting.FormatMoneyDe(view.PaymentCents / 100m)</td>@if (categorized) { <td></td> }</tr>
                    </tfoot>
                </table>
            </div>
            @if (view.Plan is { } plan)
            {
                @* The full price of an order paid in instalments: each instalment with its booking, then those still due. *@
                <div class="small mb-2" data-testid="receipt-panel-plan">
                    <div class="fw-semibold mb-1">@L["Plan_Title"]</div>
                    @if (plan.Cancelled)
                    {
                        <p class="text-body-secondary mb-1" data-testid="receipt-panel-plan-cancelled">@L["Plan_Cancelled"]</p>
                    }
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var (c, i) in plan.Charges.Select((c, i) => (c, i)))
                            {
                                <tr data-testid="receipt-panel-plan-charge">
                                    <td>@L["Plan_Instalment", i + 1, plan.Count]</td>
                                    <td class="text-nowrap">@c.Date?.ToAppDate()</td>
                                    <td class="text-end text-nowrap">@Formatting.FormatMoneyDe(c.Cents / 100m)</td>
                                    <td class="text-body-secondary">@(c.TransactionId != null ? L["Plan_Booked"] : L["Plan_NotBooked"])</td>
                                </tr>
                            }
                            @foreach (var d in plan.Due)
                            {
                                <tr class="text-body-secondary" data-testid="receipt-panel-plan-due">
                                    <td>@L["Plan_Instalment", d.Number, plan.Count]</td>
                                    <td class="text-nowrap">@L["Plan_Due", d.Date.ToAppDate()]</td>
                                    <td class="text-end text-nowrap">@Formatting.FormatMoneyDe(d.Cents / 100m)</td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CanEdit && view.TransactionId != null)
            {
                <p class="small text-body-secondary mb-0">@L["MoveHelp"]</p>
            }
            @if (error != null)
            {
                <div class="text-danger small" role="alert">@error</div>
            }
        </div>
    }
    @if (moving is { } m && PickerData != null)
    {
        <CategoryPicker Data="PickerData" CurrentCategoryId="m.CategoryId ?? view?.BookingCategoryId" AllowRemove="false" X="pickerX" Y="pickerY"
                        OnPick="id => MoveAsync(m.Id, id)" OnClose="() => moving = null" />
    }
</Modal>

@code {
    /// <summary>The receipt to show (null: the dialog is closed).</summary>
    [Parameter] public long? ReceiptId { get; set; }
    /// <summary>Categories for moving an item; without them items cannot be moved.</summary>
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>Whether the signed-in user may move items (the receipt's owner).</summary>
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>The name for lines in the booking's own category (null category).</summary>
    [Parameter] public string? BookingCategoryName { get; set; }
    /// <summary>The part to show first (its index), or all.</summary>
    [Parameter] public int? InitialPart { get; set; }
    /// <summary>The dialog closed; true when an item was moved.</summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    /// <summary>An item was moved and the booking split again: the page behind refreshes while the panel stays open.</summary>
    [Parameter] public EventCallback OnMoved { get; set; }

    private BookingReceiptView? view;
    private long? loadedFor;
    private int? part;
    private string? search;
    private readonly HashSet<int> openExtras = [];
    private ReceiptLineView? moving;
    private double pickerX, pickerY;
    private bool changed;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (ReceiptId == loadedFor) return;
        loadedFor = ReceiptId;
        view = null;
        changed = false;
        search = null;
        error = null;
        openExtras.Clear();
        part = InitialPart;
        if (ReceiptId is { } id) view = await Service.GetReceiptAsync(id);
        if (view != null && part is { } p && p >= view.Groups.Count) part = null;
    }

    private bool Matches(ReceiptLineView line) =>
        SearchText.Matches(line.Name, search);

    private string CategoryName(long? id) =>
        id is { } c && PickerData != null ? PickerData.PathOf(c, BookingCategoryName ?? L["NoCategory"]) : BookingCategoryName ?? L["NoCategory"];

    private void OpenPicker(ReceiptLineView line, MouseEventArgs e) => (moving, pickerX, pickerY) = (line, e.ClientX, e.ClientY);

    private async Task MoveAsync(long itemId, long? picked)
    {
        moving = null;
        error = null;
        if (picked is not { } category || ReceiptId is not { } id) return;
        try
        {
            await Service.MoveItemAsync(itemId, category);
            changed = true;
            view = await Service.GetReceiptAsync(id);
            if (view != null && part is { } p && p >= view.Groups.Count) part = null;
            await OnMoved.InvokeAsync();
        }
        catch (Exception ex) when (ex is AccessDeniedException or SplitException or InvalidOperationException)
        {
            error = ex.Message;
        }
    }

    private async Task CloseAsync()
    {
        var was = changed;
        loadedFor = null;
        view = null;
        await OnClose.InvokeAsync(was);
    }
}
