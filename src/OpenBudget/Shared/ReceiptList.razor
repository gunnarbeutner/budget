@inherits DataChangeAwareComponent
@using System.Globalization
@using OpenBudget.Connectors.Receipts
@using OpenBudget.Models
@using OpenBudget.Services
@inject ReceiptService Service
@inject CategorizationService Categorization
@inject IStringLocalizer<OpenBudget.Pages.Receipts> L

@* A project's receipt list (ReceiptService.ListProjectAsync: those on the project's bookings the user may see, and the
   receipts without a booking whose payment method or source pays from the project's accounts). Newest first, with a sticky filter bar (source, search, optional settings link, status chips with counts
   over all rows); the rows are virtualized in the page's scroll container. On phones the table renders as a two-line
   list (title and amount; date, source, a short status and the row's action) and the chips scroll sideways. A row opens the receipt panel; the user's own ambiguous, waiting or
   unmatched receipt can be assigned to a booking by hand (a dialog lists the bookings near its date) or marked as
   having no booking in the app. *@

@if (error != null)
{
    <div class="alert alert-warning py-2" role="alert">@error</div>
}

<section data-testid="receipts-list">
    <div class="receipts-filters" data-testid="receipts-filters">
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto" aria-label="@L["Filter_Source"]" data-testid="receipts-filter-source"
                    value="@(source ?? "")" @onchange="e => SourceAsync(e.Value?.ToString() is { Length: > 0 } v ? v : null)">
                <option value="">@L["Filter_AllSources"]</option>
                @foreach (var s in ReceiptSources.All)
                {
                    <option value="@s">@L["Source_" + s]</option>
                }
            </select>
            <input type="search" class="form-control form-control-sm receipts-search" placeholder="@L["Search"]" aria-label="@L["Search"]"
                   data-testid="receipts-search" @bind="search" @bind:event="oninput" />
            @if (SettingsHref != null)
            {
                <a href="@SettingsHref" class="app-icon-btn" title="@L["Settings_Link"]" aria-label="@L["Settings_Link"]" data-testid="receipts-settings-link"><i class="bi bi-sliders" aria-hidden="true"></i></a>
            }
        </div>
        <div class="receipts-chips d-flex gap-1 mt-2" role="group" aria-label="@L["Filter_State"]" data-testid="receipts-filter-state">
            @foreach (var g in Enum.GetValues<Group>())
            {
                var count = rows?.Count(r => In(g, r)) ?? 0;
                if (g != Group.All && g != Group.Review && count == 0 && group != g) continue;
                <button type="button" class="btn btn-sm rounded-pill receipts-chip @(group == g ? "active" : "")" aria-pressed="@(group == g)"
                        data-testid="receipts-chip" data-group="@g.ToString().ToLowerInvariant()" @onclick="() => group = g">
                    @L["Group_" + g] <span class="receipts-chip-count">@count</span>
                </button>
            }
        </div>
    </div>
    @if (rows == null)
    {
        <div class="skeleton skeleton-line mt-3" style="width: 40%;"></div>
    }
    else if (VisibleRows().Count == 0)
    {
        <p class="small text-body-secondary mt-3" data-testid="receipts-none">@L["List_None"]</p>
    }
    else
    {
        var visible = VisibleRows();
        <table class="table table-sm table-hover align-middle receipts-table mt-2" data-testid="receipts-table">
            <thead>
                <tr>
                    <th class="d-none d-sm-table-cell receipts-col-date">@L["List_Date"]</th>
                    <th>@L["List_Receipt"]</th>
                    <th class="d-none d-md-table-cell text-end receipts-col-items">@L["List_Items"]</th>
                    <th class="text-end receipts-col-amount">@L["List_Amount"]</th>
                    <th class="receipts-col-status">@L["List_Status"]</th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="visible" ItemSize="RowHeight" OverscanCount="10" SpacerElement="tr" Context="r">
                    <tr data-testid="receipt-row" data-state="@r.State.ToString().ToLowerInvariant()" data-source="@r.Source" @key="(r.Source, r.Id)"
                        class="receipts-row-open" @onclick="() => Open(r)">
                        <td class="d-none d-sm-table-cell text-nowrap receipts-col-date">@r.Date?.ToString("dd.MM.yy", CultureInfo.InvariantCulture)</td>
                        <td class="receipts-col-title">
                            <button type="button" class="btn btn-link btn-sm p-0 text-start text-truncate d-block mw-100 receipts-title" data-testid="receipt-open"
                                    @onclick="() => Open(r)" @onclick:stopPropagation="true">@r.Title</button>
                            <span class="d-block small text-body-secondary text-truncate"><span class="d-sm-none">@r.Date?.ToString("dd.MM.yy", CultureInfo.InvariantCulture) · </span>@L["Source_" + r.Source]@if (r.OwnerName is { } owner) {<span data-testid="receipt-owner"> · @L["OwnerReceipt", owner]</span>}<span class="d-none d-sm-inline d-md-none"> · @L["Items_Count", r.Items]</span></span>
                        </td>
                        <td class="d-none d-md-table-cell text-end receipts-col-items">@r.Items</td>
                        <td class="text-end text-nowrap receipts-col-amount">@Formatting.FormatMoneyDe(-r.PaymentCents / 100m)</td>
                        <td class="receipts-col-status" @onclick:stopPropagation="true">
                            <span class="badge rounded-pill receipts-status-full @Pill(r.State)" data-testid="receipt-status" title="@Status(r)">@Status(r)</span>
                            <span class="receipts-status-short" data-testid="receipt-status-short" title="@Status(r)"><span class="receipts-dot @Pill(r.State)" aria-hidden="true"></span>@ShortStatus(r)</span>
                            @if (r.Instalments is { Running: true } plan)
                            {
                                <span class="d-block small text-body-secondary text-nowrap receipts-instalments" data-testid="receipt-instalments">@InstalmentLine(plan)</span>
                            }
                            @if (r.IsOwn && r.State is ReceiptReviewState.Ambiguous or ReceiptReviewState.Unmatched or ReceiptReviewState.Waiting)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 d-block receipts-action" data-testid="receipt-assign" title="@L["Assign_Row"]" @onclick="() => OpenAssignAsync(r)"><i class="bi bi-link-45deg receipts-action-icon" aria-hidden="true"></i><span class="receipts-action-text">@L["Assign_Row"]</span></button>
                            }
                            else if (r.IsOwn && r.State == ReceiptReviewState.Dismissed)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 d-block receipts-action" data-testid="receipt-reset" title="@L["Reset"]" @onclick="() => RunAsync(() => Service.ResetAssignmentAsync(r.Id))"><i class="bi bi-arrow-counterclockwise receipts-action-icon" aria-hidden="true"></i><span class="receipts-action-text">@L["Reset"]</span></button>
                            }
                        </td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
        <div class="small text-body-secondary" data-testid="receipts-shown">@L["Shown", visible.Count]</div>
    }
</section>

<ReceiptPanel ReceiptId="openId" PickerData="picker" CanEdit="canEdit" OnClose="PanelClosedAsync" />

<Modal Show="assigning != null" Title="@L["Assign_Title"]" SizeClass="modal-lg" OnClose="() => assigning = null">
    <ChildContent>
    @if (assigning is { } a)
    {
        <div class="receipts-assign-receipt small mb-3" data-testid="receipt-assign-summary">
            <div class="fw-semibold text-break">@a.Title</div>
            <div class="text-body-secondary">@L["Source_" + a.Source] · @a.Date?.ToAppDate() · <b class="text-body">@Formatting.FormatMoneyDe(-a.PaymentCents / 100m)</b> · @L["Items_Count", a.Items]</div>
        </div>
        <p class="small mb-2">@L["Assign_Help"]</p>
        @if (candidates == null)
        {
            <div class="skeleton skeleton-line" style="width: 50%;"></div>
        }
        else if (candidates.Count == 0)
        {
            <p class="small text-body-secondary">@L["Assign_None"]</p>
        }
        else
        {
            <div class="list-group mb-2" data-testid="receipt-candidates">
                @foreach (var c in candidates)
                {
                    var exact = -c.AmountCents == a.PaymentCents;
                    <button type="button" class="list-group-item list-group-item-action receipts-candidate" data-testid="receipt-candidate"
                            @onclick="() => AssignAsync(a.Id, c.TransactionId)">
                        <span class="receipts-candidate-date text-nowrap small">@c.Date.ToAppDate()</span>
                        <span class="receipts-candidate-text small">
                            <span class="d-block text-truncate">@(c.Name ?? "—")</span>
                            @if (!string.IsNullOrWhiteSpace(c.Purpose))
                            {
                                <span class="d-block text-truncate text-body-secondary">@c.Purpose</span>
                            }
                        </span>
                        <span class="receipts-candidate-amount text-end text-nowrap small">
                            <b>@Formatting.FormatMoneyDe(c.AmountCents / 100m)</b>
                            @if (exact)
                            {
                                <span class="badge rounded-pill bank-pill-ok d-block mt-1">@L["Assign_SameAmount"]</span>
                            }
                        </span>
                    </button>
                }
            </div>
        }
    }
    </ChildContent>
    <Footer>
        @if (assigning is { } a)
        {
            <button type="button" class="btn btn-outline-secondary me-auto" data-testid="receipt-dismiss" @onclick="() => AssignAsync(a.Id, null)">@L["Assign_NotInApp"]</button>
            <button type="button" class="btn btn-secondary" @onclick="() => assigning = null">@L["Cancel"]</button>
        }
    </Footer>
</Modal>

@code {
    // Approximate row height in CSS pixels: Virtualize's spacer estimate (two text lines; a row with an action link is a little taller).
    private const float RowHeight = 49f;

    /// <summary>The status chips: All and one per <see cref="ReceiptReviewGroup"/>.</summary>
    private enum Group { All, Review, Waiting, Done, NoBooking }

    /// <summary>The project whose receipts are listed.</summary>
    [Parameter, EditorRequired] public int ProjectId { get; set; }

    /// <summary>Where the filter bar's settings icon leads (receipt categories and item memory); null shows none.</summary>
    [Parameter] public string? SettingsHref { get; set; }

    private Group group;
    private string? search;
    private List<ReceiptReviewRow>? rows;
    private CategoryPickerData? picker;
    private string? source;
    private string? userId;
    private string? error;
    private long? openId;
    private bool canEdit = true;
    private ReceiptReviewRow? assigning;
    private List<ReceiptCandidate>? candidates;
    private int _loadedProject = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId) return;
        _loadedProject = ProjectId;
        rows = null;
        await LoadAsync();
    }

    // Receipt changes are published for the receipt's owner and the booking's owner (ImportedData), and per user (CloudFiles).
    protected override bool IsRelevantChange(DataChange change) =>
        (change.Area == DataArea.CloudFiles && change.UserId == userId) || change.Area == DataArea.ImportedData;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var scope = await Access.GetAsync();
        userId = scope.UserId;
        if (userId == null) return;
        canEdit = scope.CanEdit(ProjectId);
        picker ??= await Categorization.GetPickerDataAsync(userId);
        try
        {
            rows = await Service.ListProjectAsync(ProjectId, source);
        }
        catch (AccessDeniedException ex)
        {
            error = ex.Message;
            rows = [];
        }
    }

    private async Task SourceAsync(string? s)
    {
        source = s;
        await LoadAsync();
    }

    private static bool In(Group g, ReceiptReviewRow r) => g == Group.All || g.ToString() == ReceiptService.GroupOf(r.State, r.PaymentCents).ToString();

    /// <summary>The rows of the chosen status chip that match the search (title, source, date or amount).</summary>
    private List<ReceiptReviewRow> VisibleRows()
    {
        if (rows == null) return [];
        var q = search?.Trim();
        return rows.Where(r => In(group, r) && (string.IsNullOrEmpty(q)
            || SearchText.Matches(r.Title, q)
            || SearchText.Matches(L["Source_" + r.Source].Value, q)
            || (r.Date?.ToAppDate().Contains(q, StringComparison.Ordinal) ?? false)
            || Formatting.FormatMoneyDe(-r.PaymentCents / 100m).Contains(q, StringComparison.Ordinal))).ToList();
    }

    private void Open(ReceiptReviewRow r) => openId = r.Id;

    private static string Pill(ReceiptReviewState s) => s switch
    {
        ReceiptReviewState.Split or ReceiptReviewState.Matched => "bank-pill-ok",
        ReceiptReviewState.Waiting or ReceiptReviewState.InstalmentsPending => "bank-pill-info",
        ReceiptReviewState.Ambiguous or ReceiptReviewState.Unmatched => "bank-pill-warn",
        ReceiptReviewState.Instalments => "bank-pill-ok",
        ReceiptReviewState.InstalmentsCancelled => "text-bg-light border text-body-secondary",
        _ => "text-bg-light border",
    };

    private string Status(ReceiptReviewRow r)
    {
        var booked = r.BookingDate?.ToAppDate() ?? "";
        return r.State switch
        {
            ReceiptReviewState.Split => L["Status_Split", booked],
            ReceiptReviewState.Matched => L["Status_Matched", booked],
            ReceiptReviewState.InstalmentsPending when r.Instalments is { } p => L["Status_InstalmentsOf", p.Charged, p.Count],
            ReceiptReviewState.Instalments when r.Instalments is { } p => L["Status_InstalmentsPaid", p.Count],
            _ => L["State_" + r.State],
        };
    }

    /// <summary>The phone list's status: a word or two, booking dates as day and month.</summary>
    private string ShortStatus(ReceiptReviewRow r)
    {
        var booked = r.BookingDate?.ToString("dd.MM.", CultureInfo.InvariantCulture) ?? "";
        return r.State switch
        {
            ReceiptReviewState.Split => L["Short_Split", booked],
            ReceiptReviewState.Matched => L["Short_Booked", booked],
            ReceiptReviewState.InstalmentsPending or ReceiptReviewState.Instalments when r.Instalments is { } p => L["Short_InstalmentsOf", p.Charged, p.Count],
            ReceiptReviewState.InstalmentsPending or ReceiptReviewState.Instalments => L["Short_Instalments"],
            _ => L["Short_" + r.State],
        };
    }

    /// <summary>"186,00 € paid · next ~02.12." under a running plan's badge.</summary>
    private string InstalmentLine(InstalmentProgress p)
    {
        var paid = L["Instalments_Paid", Formatting.FormatMoneyDe(p.PaidCents / 100m)].Value;
        return p.NextDate is { } next ? paid + " · " + L["Instalments_Next", next.ToString("dd.MM.", CultureInfo.InvariantCulture)] : paid;
    }

    private async Task OpenAssignAsync(ReceiptReviewRow r)
    {
        assigning = r;
        candidates = null;
        candidates = await Service.CandidatesAsync(r.Id);
    }

    private async Task AssignAsync(long receiptId, long? transactionId)
    {
        assigning = null;
        await RunAsync(() => Service.AssignAsync(receiptId, transactionId));
    }

    private async Task PanelClosedAsync(bool changed)
    {
        openId = null;
        if (changed) await LoadAsync();
    }

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        try
        {
            await action();
        }
        catch (AccessDeniedException ex)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }
}
