@* The compact header of a settings page, the same 48px toolbar as the project views: title and an optional
   context line on the left, optional actions on the right. Inside a .shell-page it sticks to the top.

   Usage:

       <PageHeader Title="@L["Heading"]" Subtitle="@context">
           <Actions>
               <button class="ob-btn" ...>Add</button>
           </Actions>
       </PageHeader>
*@

<div class="page-toolbar settings-toolbar" data-testid="page-header">
    <h1 class="view-title text-truncate">
        @Title
        @if (TitleSuffix != null)
        {
            <span class="view-sub">@TitleSuffix</span>
        }
    </h1>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <span class="view-sub text-truncate settings-toolbar-sub">@Subtitle</span>
    }
    <div class="flex-grow-1"></div>
    @if (Actions != null)
    {
        <div class="d-flex flex-wrap gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>Rendered next to the title in the muted style (e.g. the budget's name).</summary>
    [Parameter] public RenderFragment? TitleSuffix { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
