@using System.Globalization
@using OpenBudget.Models
@using OpenBudget.Services
@inject CategoryRuleService RuleService
@inject IStringLocalizer<RulesBar> L

@* The rules bar of a category (Transactions › right-click a category › Rules…): the categorisation rules that set
   this category, edited in place. A rule is a search expression (RuleExpression); the text field edits it directly,
   and while it has the simple shape the builder composes, the payee / purpose / account / amount inputs edit it too. Every row is its own little form: typing changes a draft (Enter saves, Esc
   reverts) and, while a row has unsaved changes, the transaction list below shows the bookings of the whole project
   the draft would match (OnPreview; null = back to the normal list). Order within the category is changed with the
   arrows; across categories the stored order decides (new rules go to the end). *@

<section class="rules-bar" data-testid="rules-bar" aria-label="@L["Aria_Bar", CategoryName]">
    <div class="rules-bar-head">
        <span class="fw-semibold"><i class="bi bi-magic me-1" aria-hidden="true"></i>@L["Heading", CategoryName]</span>
        @if (previewCount is { } count)
        {
            <span class="rules-bar-preview" role="status" data-testid="rules-preview-count">@L[count == 1 ? "Preview_One" : "Preview_Many", count]</span>
        }
        <span class="flex-grow-1"></span>
        @if (applyCount > 0)
        {
            <button type="button" class="ob-btn ob-btn-sm" data-testid="rules-apply" @onclick="ApplyAsync">
                <i class="bi bi-check2-all" aria-hidden="true"></i> @L["Apply", applyCount]
            </button>
        }
        <button type="button" class="ob-btn ob-btn-sm ob-btn-primary" data-testid="rules-add" @onclick="AddDraft">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Add"]
        </button>
        <button type="button" class="btn-close" aria-label="@L["Close"]" title="@L["Close"]" data-testid="rules-close" @onclick="CloseAsync"></button>
    </div>

    @if (!string.IsNullOrEmpty(status))
    {
        <div class="small text-success px-1" role="status" data-testid="rules-status">@status</div>
    }

    @if (rows == null)
    {
        <div class="skeleton skeleton-line" aria-busy="true"></div>
    }
    else if (rows.Count == 0)
    {
        <div class="small text-body-secondary px-1" data-testid="rules-empty">@L["Empty"]</div>
    }
    else
    {
        @for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var index = i;
            var savedCount = rows.Count(r => r.Id > 0);
            <div class="rules-row @(row.Dirty ? "dirty" : "") @(row.Draft.Enabled ? "" : "disabled")" data-testid="rule-row" @key="row.Key"
                 @onkeydown="e => OnKeyAsync(row, e)">
                <input class="form-control form-control-sm font-monospace rules-expr @(row.SyntaxError != null ? "is-invalid" : "")" data-testid="rule-expression" maxlength="4000"
                       placeholder="@L["Field_Expression"]" aria-label="@L["Field_Expression"]" title="@L["Field_ExpressionTitle"]" spellcheck="false"
                       value="@row.Draft.Expression" @oninput="e => EditExpression(row, e.Value?.ToString())" />
                @if (row.Parts is { } parts)
                {
                    <input class="form-control form-control-sm rules-text" data-testid="rule-payee" maxlength="500"
                           placeholder="@L["Field_Payee"]" aria-label="@L["Field_Payee"]"
                           value="@parts.Payee" @oninput="e => EditParts(row, p => p with { Payee = e.Value?.ToString() })" />
                    <input class="form-control form-control-sm rules-text" data-testid="rule-purpose" maxlength="500"
                           placeholder="@L["Field_Purpose"]" aria-label="@L["Field_Purpose"]"
                           value="@parts.Purpose" @oninput="e => EditParts(row, p => p with { Purpose = e.Value?.ToString() })" />
                    <label class="rules-check" title="@L["Field_RegexTitle"]">
                        <input type="checkbox" class="form-check-input" data-testid="rule-regex" checked="@parts.Regex"
                               @onchange="e => EditParts(row, p => p with { Regex = e.Value is true })" /> @L["Field_Regex"]
                    </label>
                }
                else
                {
                    <span class="rules-textonly small text-body-secondary" data-testid="rule-text-only">@L["TextOnly"]</span>
                }
                <button type="button" class="ob-btn ob-btn-sm @(row.More ? "active" : "")" data-testid="rule-more" disabled="@(row.Parts == null)"
                        aria-expanded="@row.More.ToString().ToLowerInvariant()" title="@L["More"]" @onclick="() => row.More = !row.More">
                    <i class="bi bi-sliders" aria-hidden="true"></i>@if (row.HasMoreConditions) { <span class="ob-badge">•</span> }
                </button>
                <div class="form-check form-switch m-0 rules-switch" title="@L["Enabled"]">
                    <input class="form-check-input" type="checkbox" role="switch" data-testid="rule-enabled" aria-label="@L["Enabled"]"
                           checked="@row.Draft.Enabled" @onchange="() => ToggleAsync(row)" />
                </div>
                <div class="rules-actions">
                    @if (row.Dirty)
                    {
                        <button type="button" class="ob-btn ob-btn-sm ob-btn-primary" data-testid="rule-save" @onclick="() => SaveAsync(row)">@L["Save"]</button>
                        <button type="button" class="ob-btn ob-btn-sm" data-testid="rule-cancel" @onclick="() => CancelAsync(row)">@L["Cancel"]</button>
                    }
                    else
                    {
                        <span class="rules-matches small text-body-secondary" data-testid="rule-matches" title="@L["MatchesTitle"]">@row.MatchCount</span>
                        <button type="button" class="ob-btn ob-btn-sm" title="@L["MoveUp"]" aria-label="@L["MoveUp"]" data-testid="rule-up"
                                disabled="@(index == 0 || row.Id == 0)" @onclick="() => MoveAsync(row, -1)"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                        <button type="button" class="ob-btn ob-btn-sm" title="@L["MoveDown"]" aria-label="@L["MoveDown"]" data-testid="rule-down"
                                disabled="@(index >= savedCount - 1 || row.Id == 0)" @onclick="() => MoveAsync(row, 1)"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                        @if (row.ConfirmDelete)
                        {
                            <button type="button" class="ob-btn ob-btn-sm ob-btn-danger" data-testid="rule-delete-confirm" @onclick="() => DeleteAsync(row)">@L["DeleteConfirm"]</button>
                        }
                        else
                        {
                            <button type="button" class="ob-btn ob-btn-sm" title="@L["Delete"]" aria-label="@L["Delete"]" data-testid="rule-delete"
                                    @onclick="() => row.ConfirmDelete = true"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        }
                    }
                </div>
                @if (row.More && row.Parts is { } more)
                {
                    <div class="rules-more" data-testid="rule-more-panel">
                        <select class="form-select form-select-sm" data-testid="rule-account" aria-label="@L["Field_Account"]"
                                value="@(more.AccountId?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                @onchange="e => EditParts(row, p => p with { AccountId = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var acc) ? acc : null })">
                            <option value="">@L["Field_AnyAccount"]</option>
                            @foreach (var a in accounts)
                            {
                                <option value="@a.Id.ToString(CultureInfo.InvariantCulture)">@a.Name</option>
                            }
                        </select>
                        <select class="form-select form-select-sm" data-testid="rule-sign" aria-label="@L["Field_Sign"]"
                                value="@more.Sign.ToString()"
                                @onchange="e => EditParts(row, p => p with { Sign = Enum.TryParse<RuleAmountSign>(e.Value?.ToString(), out var s) ? s : RuleAmountSign.Any })">
                            <option value="@RuleAmountSign.Any">@L["Sign_Any"]</option>
                            <option value="@RuleAmountSign.Expense">@L["Sign_Expense"]</option>
                            <option value="@RuleAmountSign.Income">@L["Sign_Income"]</option>
                        </select>
                        <input class="form-control form-control-sm rules-amount" inputmode="decimal" data-testid="rule-min"
                               placeholder="@L["Field_Min"]" aria-label="@L["Field_Min"]" value="@row.MinText"
                               @oninput="e => EditAmount(row, e.Value?.ToString(), true)" />
                        <input class="form-control form-control-sm rules-amount" inputmode="decimal" data-testid="rule-max"
                               placeholder="@L["Field_Max"]" aria-label="@L["Field_Max"]" value="@row.MaxText"
                               @oninput="e => EditAmount(row, e.Value?.ToString(), false)" />
                    </div>
                }
                @if (row.SyntaxError != null && string.IsNullOrEmpty(row.Error))
                {
                    <div class="rules-error small text-danger" data-testid="rule-syntax-error">@L["Error_Syntax", row.SyntaxError]</div>
                }
                @if (!string.IsNullOrEmpty(row.Error))
                {
                    <div class="rules-error small text-danger" role="alert" data-testid="rule-error">@row.Error</div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    [Parameter, EditorRequired] public long CategoryId { get; set; }
    [Parameter] public string CategoryName { get; set; } = "";
    /// <summary>A payee to start a new draft row with ("Create rule from this…"); a new draft is added each time <see cref="PrefillToken"/> changes.</summary>
    [Parameter] public string? PrefillPayee { get; set; }
    [Parameter] public int PrefillToken { get; set; }
    /// <summary>The ids the draft being edited matches (live preview), or null for the normal list.</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<long>?> OnPreview { get; set; }
    /// <summary>Rules were applied to existing transactions: the page reloads its list.</summary>
    [Parameter] public EventCallback OnApplied { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private sealed class RowState
    {
        public Guid Key { get; } = Guid.NewGuid();
        public int Id => Draft.Id;
        public required CategoryRule Draft { get; set; }
        public CategoryRule? Saved { get; set; }
        public string? MinText { get; set; }
        public string? MaxText { get; set; }
        public bool Dirty { get; set; }
        public bool More { get; set; }
        public bool ConfirmDelete { get; set; }
        public string? Error { get; set; }
        public int MatchCount { get; set; }
        /// <summary>The builder inputs, or null when the expression has a shape only the text field can edit.</summary>
        public RuleParts? Parts { get; set; }
        public string? SyntaxError { get; set; }
        public bool HasMoreConditions => Parts is { } p && (p.AccountId != null || p.Sign != RuleAmountSign.Any || p.Min != null || p.Max != null);
    }

    private List<RowState>? rows;
    private List<RuleAccountOption> accounts = [];
    private List<RuleAccount> ruleAccounts = [];
    private int applyCount;
    private int? previewCount;
    private string? status;
    private long previewToken;
    private (int, long) loadedKey;
    private int handledPrefill;
    private RowState? previewRow;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedKey != (ProjectId, CategoryId))
        {
            loadedKey = (ProjectId, CategoryId);
            rows = null;
            status = null;
            accounts = await RuleService.GetAccountsAsync(ProjectId);
            ruleAccounts = accounts.Select(a => new RuleAccount(a.Id, a.Iban)).ToList();
            await LoadAsync();
        }
        if (PrefillToken != handledPrefill)
        {
            handledPrefill = PrefillToken;
            if (!string.IsNullOrWhiteSpace(PrefillPayee))
            {
                var row = NewDraft();
                SetParts(row, new RuleParts { Payee = PrefillPayee.Trim() });
                row.Dirty = true;
                await SchedulePreviewAsync(row, immediate: true);
            }
        }
    }

    private async Task LoadAsync()
    {
        var views = await RuleService.GetCategoryRulesAsync(ProjectId, CategoryId);
        var drafts = rows?.Where(r => r.Id == 0).ToList() ?? [];
        rows = views.Select(v => FromRule(v.Rule, v.MatchCount)).Concat(drafts).ToList();
        applyCount = await RuleService.PreviewApplyExistingAsync(ProjectId, CategoryId);
    }

    private static CategoryRule Copy(CategoryRule r) => new()
    {
        Id = r.Id, ProjectId = r.ProjectId, Name = r.Name, Enabled = r.Enabled, Expression = r.Expression,
        CategoryId = r.CategoryId, SortOrder = r.SortOrder,
    };

    private static string? AmountText(decimal? value) => value?.ToString("0.00", CultureInfo.CurrentCulture);

    private RowState FromRule(CategoryRule rule, int matches)
    {
        var row = new RowState { Draft = Copy(rule), Saved = rule, MatchCount = matches };
        Reparse(row);
        row.More = row.HasMoreConditions;
        return row;
    }

    /// <summary>Re-derives the builder inputs and the syntax message from the draft's expression.</summary>
    private void Reparse(RowState row)
    {
        var text = row.Draft.Expression;
        row.SyntaxError = !string.IsNullOrWhiteSpace(text) && RuleExpression.TryParse(text, out var error) == null ? error : null;
        row.Parts = row.SyntaxError == null ? RuleExpressionBuilder.TryDecompose(text, ruleAccounts) : null;
        row.MinText = AmountText(row.Parts?.Min);
        row.MaxText = AmountText(row.Parts?.Max);
        if (row.Parts == null) row.More = false;
    }

    private void SetParts(RowState row, RuleParts parts)
    {
        row.Parts = parts;
        row.Draft.Expression = RuleExpressionBuilder.Compose(parts, ruleAccounts);
        row.SyntaxError = null;
    }

    private RowState NewDraft()
    {
        status = null;
        var row = new RowState { Draft = new CategoryRule { ProjectId = ProjectId, CategoryId = CategoryId, Enabled = true }, Parts = new RuleParts() };
        rows ??= [];
        rows.Add(row);
        return row;
    }

    private Task EditExpression(RowState row, string? text) => Edit(row, d =>
    {
        d.Expression = text ?? "";
        Reparse(row);
    });

    private Task EditParts(RowState row, Func<RuleParts, RuleParts> change) =>
        row.Parts is { } parts ? Edit(row, _ => SetParts(row, change(parts))) : Task.CompletedTask;

    private void AddDraft() => NewDraft();

    private Task Edit(RowState row, Action<CategoryRule> change)
    {
        change(row.Draft);
        row.Dirty = true;
        row.Error = null;
        row.ConfirmDelete = false;
        return SchedulePreviewAsync(row);
    }

    private Task EditAmount(RowState row, string? text, bool min)
    {
        if (min) row.MinText = text; else row.MaxText = text;
        if (!TryAmount(text, out var value)) return Task.CompletedTask;
        return EditParts(row, p => min ? p with { Min = value } : p with { Max = value });
    }

    // Debounced: the handler returns at once; the preview runs after a short pause in typing (token, no timer).
    private async Task SchedulePreviewAsync(RowState row, bool immediate = false)
    {
        var token = ++previewToken;
        previewRow = row;
        if (!immediate)
        {
            try { await Task.Delay(300); }
            catch (ObjectDisposedException) { return; }
            if (token != previewToken) return;
        }
        var ids = await RuleService.PreviewMatchIdsAsync(ProjectId, row.Draft);
        if (token != previewToken || previewRow != row || !row.Dirty) return;
        previewCount = ids.Count;
        await OnPreview.InvokeAsync(ids);
    }

    private async Task EndPreviewAsync()
    {
        previewToken++;
        previewRow = null;
        if (previewCount == null) return;
        previewCount = null;
        await OnPreview.InvokeAsync(null);
    }

    private async Task OnKeyAsync(RowState row, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && row.Dirty) await SaveAsync(row);
        else if (e.Key == "Escape") await CancelAsync(row);
    }

    private static bool TryAmount(string? text, out decimal? amount)
    {
        amount = null;
        if (string.IsNullOrWhiteSpace(text)) return true;
        if (!decimal.TryParse(text.Trim(), NumberStyles.Number, CultureInfo.CurrentCulture, out var value)
            && !decimal.TryParse(text.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out value)) return false;
        amount = Math.Round(Math.Abs(value), 2, MidpointRounding.AwayFromZero);
        return true;
    }

    private async Task SaveAsync(RowState row)
    {
        if (row.Parts != null && (!TryAmount(row.MinText, out var min) || !TryAmount(row.MaxText, out var max) || (min != null && max != null && min > max)))
        {
            row.Error = L["Error_InvalidAmountRange"];
            return;
        }
        row.Draft.CategoryId = CategoryId;
        try
        {
            var id = await RuleService.SaveAsync(row.Draft);
            row.Draft.Id = id;
            row.Dirty = false;
            row.Error = null;
            await EndPreviewAsync();
            rows!.Remove(row);
            await LoadAsync();
        }
        catch (RuleValidationException ex)
        {
            row.Error = L["Error_" + ex.Reason];
        }
        catch (AccessDeniedException)
        {
            row.Error = L["Error_NoPermission"];
        }
    }

    private async Task CancelAsync(RowState row)
    {
        row.Error = null;
        row.ConfirmDelete = false;
        if (row.Id == 0) rows!.Remove(row);
        else if (row.Saved != null)
        {
            row.Draft = Copy(row.Saved);
            Reparse(row);
            row.Dirty = false;
        }
        if (previewRow == row || rows!.All(r => !r.Dirty)) await EndPreviewAsync();
    }

    private async Task ToggleAsync(RowState row)
    {
        if (row.Id == 0 || row.Dirty)
        {
            await Edit(row, d => d.Enabled = !d.Enabled);
            return;
        }
        try
        {
            await RuleService.SetEnabledAsync(ProjectId, row.Id, !row.Draft.Enabled);
            await LoadAsync();
        }
        catch (AccessDeniedException)
        {
            row.Error = L["Error_NoPermission"];
        }
    }

    private async Task MoveAsync(RowState row, int delta)
    {
        await RuleService.MoveWithinCategoryAsync(ProjectId, row.Id, delta);
        await LoadAsync();
    }

    private async Task DeleteAsync(RowState row)
    {
        await RuleService.DeleteAsync(ProjectId, row.Id);
        rows!.Remove(row);
        await LoadAsync();
    }

    private async Task ApplyAsync()
    {
        var count = await RuleService.ApplyExistingAsync(ProjectId, CategoryId);
        status = L[count == 1 ? "Apply_Done_One" : "Apply_Done", count];
        await LoadAsync();
        await OnApplied.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        await EndPreviewAsync();
        await OnClose.InvokeAsync();
    }
}
