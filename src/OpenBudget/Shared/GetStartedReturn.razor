@inject NavigationManager Navigation
@inject IStringLocalizer<GetStartedReturn> L

@* On a page Get started links to: when the URL carries ?return=/get-started…, a bar leads back to that step. Only
   Get started URLs are honoured as targets. *@

@if (Target is { } target)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 py-2" data-testid="get-started-return-bar">
        <span class="flex-grow-1">@L["Hint"]</span>
        <a class="btn btn-sm btn-primary" href="@target" data-testid="get-started-return">@L["Button"]</a>
    </div>
}

@code {
    /// <summary>The Get started step to return to, or null when the page was not opened from Get started.</summary>
    public static string? TargetOf(NavigationManager navigation)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(navigation.ToAbsoluteUri(navigation.Uri).Query);
        var target = query.TryGetValue("return", out var value) ? value.ToString() : null;
        return target is not null && (target == "/get-started" || target.StartsWith("/get-started?", StringComparison.Ordinal)) ? target : null;
    }

    private string? Target => TargetOf(Navigation);
}
