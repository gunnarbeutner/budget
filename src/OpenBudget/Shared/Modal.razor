@* Bootstrap modal wrapper that handles the Esc-to-close / backdrop-click-to-close
   affordances every dialog in this app was missing. ChildContent is the modal body;
   Footer is an optional named slot for action buttons.

   Usage:

       <Modal Show="@showDialog"
              Title="@L["Modal_Title"]"
              SizeClass="modal-lg"
              OnClose="@(() => showDialog = false)">
           <p>Body content goes here.</p>
           <Footer>
               <button class="btn btn-secondary" @onclick="@(() => showDialog = false)">Cancel</button>
               <button class="btn btn-primary" @onclick="Save">Save</button>
           </Footer>
       </Modal>

   Esc-handling relies on the .modal element holding focus, so we FocusAsync the ref
   on the first render after Show flips true. *@

@implements IAsyncDisposable

@if (Show)
{
    <div class="modal show d-block @(OnTop ? "ob-modal-on-top" : "")" tabindex="-1"
         data-testid="modal-dialog"
         role="dialog" aria-modal="true"
         aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : _titleId)"
         @ref="_modalRef"
         @onkeydown="OnKeyDown"
         @onclick="OnBackdropClick">
        <div class="modal-dialog @SizeClass" @onclick:stopPropagation="true">
            <div class="modal-content">
                @if (!string.IsNullOrEmpty(Title) || ShowCloseButton)
                {
                    <div class="modal-header">
                        <h5 class="modal-title" id="@_titleId">@Title</h5>
                        @if (ShowCloseButton)
                        {
                            <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                        }
                    </div>
                }
                <div class="modal-body">
                    @ChildContent
                </div>
                @if (Footer != null)
                {
                    <div class="modal-footer">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public bool Show { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>Stacks above any other open dialog (a bank's question that arrives while a settings dialog is open).</summary>
    [Parameter] public bool OnTop { get; set; }

    /// <summary>"modal-sm", "modal-lg", "modal-xl", or empty for default width.</summary>
    [Parameter] public string SizeClass { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    /// <summary>Whether clicking the dark area outside the dialog closes it. Disable when
    /// the user is partway through a form whose accidental loss would hurt.</summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _modalRef;
    private bool _focused;
    // Stable per-instance id so aria-labelledby can point the dialog at its title.
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On open: move focus into the dialog, trap Tab within it, and remember the trigger so
        // focus returns there on close. Esc-to-close still rides the @onkeydown handler below
        // (keydown bubbles from the focused child up to the .modal element).
        if (Show && !_focused)
        {
            _focused = true;
            try { await JS.InvokeVoidAsync("modalA11y.activate", _modalRef); }
            catch (JSDisconnectedException) { /* no-op: circuit already gone */ }
            catch (InvalidOperationException) { /* no-op: JS unreachable (prerender) */ }
        }
        else if (!Show && _focused)
        {
            _focused = false;
            await DeactivateAsync();
        }
    }

    private async Task DeactivateAsync()
    {
        try { await JS.InvokeVoidAsync("modalA11y.deactivate"); }
        catch (JSDisconnectedException) { /* no-op: circuit already gone */ }
        catch (InvalidOperationException) { /* no-op: JS unreachable (prerender) */ }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

    private async Task OnBackdropClick(MouseEventArgs e)
    {
        if (CloseOnBackdropClick) await Close();
    }

    private Task Close() => OnClose.InvokeAsync();

    // If the modal is torn down while still open (e.g. navigation), release the Tab trap and
    // restore focus rather than leaving it stranded in a removed subtree.
    public async ValueTask DisposeAsync()
    {
        if (_focused) await DeactivateAsync();
    }
}
