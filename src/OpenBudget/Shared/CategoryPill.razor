@using System.Runtime.CompilerServices
@using OpenBudget.Services
@inject IStringLocalizer<CategoryPill> L

@* A category as the transaction list shows it: the category's colour and the shortest label that tells it apart from
   its namesakes ("Supermarkt › Rewe" next to "Verbrauchsartikel › REWE"), its group part shrinking first. A button
   when OnClick is set; ChildContent follows the name (an amount, a count). A category that is not one of the picker's
   (another project's, PickerData.Outside) shows as an outlined pill with its full path and the project it belongs to. *@

@if (OnClick.HasDelegate)
{
    <button type="button" class="cat-pill @OutsideClass @Class" style="@Style" title="@FullTitle" data-testid="@TestId" data-category="@CategoryId"
            data-outside="@OutsideAttr" data-suggested="@SuggestedAttr" @onclick="OnClick" @onclick:stopPropagation="true">@Text()@ChildContent</button>
}
else
{
    <span class="cat-pill @OutsideClass @Class" style="@Style" title="@FullTitle" data-testid="@TestId" data-category="@CategoryId"
          data-outside="@OutsideAttr" data-suggested="@SuggestedAttr">@Text()@ChildContent</span>
}

@code {
    [Parameter] public long? CategoryId { get; set; }
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>Shown when the category is unknown (or none): usually the booking's category name.</summary>
    [Parameter] public string? FallbackName { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The category is the AI's unconfirmed choice: the pill shows a marker and says so in its title.</summary>
    [Parameter] public bool Suggested { get; set; }

    private string FullTitle => Suggested ? $"{Title ?? Tooltip} · {L["Suggested"].Value}" : Title ?? Tooltip;

    private string? SuggestedAttr => Suggested ? "true" : null;

    // Labels are worked out once per set of options (one picker's data serves every pill of a page).
    private static readonly ConditionalWeakTable<CategoryPickerData, Dictionary<long, string>> LabelCache = new();

    private CategoryOption? Option => CategoryId is { } id ? PickerData?.Options.FirstOrDefault(o => o.Id == id) : null;

    private OutsideCategory? Outside => Option == null ? PickerData?.OutsideOf(CategoryId) : null;

    private string? OutsideClass => Outside != null ? "cat-pill-outside" : null;

    private string? OutsideAttr => Outside != null ? "true" : null;

    private string Path => Option?.Path ?? Outside?.Path ?? FallbackName ?? "";

    private string Tooltip => Outside is { } o ? OutsideTitle(L, o) : Path;

    /// <summary>"Path — Category of project X" (or "… outside this project") for a category outside the project.</summary>
    public static string OutsideTitle(IStringLocalizer l, OutsideCategory o) =>
        o.Path + " — " + (o.ProjectName is { } name ? l["Outside_OfProject", name].Value : l["Outside_NoProject"].Value);

    private string Label
    {
        get
        {
            if (Outside is { } outside) return outside.Path;
            if (Option is not { } o || PickerData == null) return Name;
            var labels = LabelCache.GetValue(PickerData, d => CategoryPickerLogic.ShortLabels(d.Options));
            return labels.TryGetValue(o.Id, out var l) ? l : o.Name;
        }
    }

    private string? Style => Option is { } o ? CategoryColors.For(o.Id, o.Color).Style : null;

    private string Name => Option?.Name ?? LastSegment(Outside?.Path ?? FallbackName ?? "");

    private RenderFragment Text() => __builder =>
    {
        var label = Label;
        var name = Name;
        if (Outside != null)
        {
            <i class="bi bi-box-arrow-up-right cat-pill-outside-icon" aria-hidden="true"></i>
        }
        if (Suggested)
        {
            <i class="bi bi-stars cat-pill-suggested-icon" aria-hidden="true"></i>
        }
        if (label.Length > name.Length && label.EndsWith(name, StringComparison.Ordinal))
        {
            <span class="cat-pill-context">@label[..^name.Length]</span><span class="cat-pill-name">@name</span>
        }
        else
        {
            @label
        }
    };

    private static string LastSegment(string path)
    {
        var at = path.LastIndexOf('›');
        return at >= 0 ? path[(at + 1)..].Trim() : path;
    }
}
