@using OpenBudget.Services
@implements IDisposable
@inject CurrentProjectState Current
@inject AccessScopeProvider AccessProvider
@inject BankLoginService Bank
@inject NavigationManager Navigation
@inject IStringLocalizer<MoreMenu> L

@* "More" in the phone bottom bar: the current project's settings, then Settings (the app-level settings pages) and
   sign-out — on wide screens these live in the project switcher and the avatar menu. A <details> dropdown like the
   project switcher: uiBehaviors.js closes it on click-away, on Escape and when one of its links is followed. *@

<details class="app-menu gear-menu gear-menu-bottom" data-testid="bottom-more" @key="Current.ProjectId">
    <summary class="app-bottom-item" aria-label="@L["Aria_Menu"]" @onclick="LoadAsync">
        <i class="bi bi-three-dots" aria-hidden="true"></i><span>@L["Bottom_More"]</span>
        @if (needsYou)
        {
            <span class="avatar-dot" aria-hidden="true"></span>
        }
    </summary>
    <ul class="dropdown-menu dropdown-menu-end show app-menu-list gear-menu-list">
        @if (Current.ProjectId is { } projectId && canEditProject)
        {
            <li>
                <a class="dropdown-item" href="@($"/projects/{projectId}/settings")" data-testid="more-project-settings">
                    <i class="bi bi-sliders2 me-2" aria-hidden="true"></i>@L["Item_ProjectSettings"]
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
        }
        <li>
            <a class="dropdown-item d-flex align-items-center" href="/Account" data-testid="more-settings"
               @onclick="@(() => Navigation.NavigateTo("/Account", forceLoad: true))" @onclick:preventDefault>
                <i class="bi bi-gear me-2" aria-hidden="true"></i>@L["Item_Settings"]
                @if (needsYou)
                {
                    <span class="avatar-dot avatar-dot-inline ms-auto" aria-hidden="true"></span>
                }
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="/Account/Logout" data-testid="more-sign-out"
               @onclick="@(() => Navigation.NavigateTo("/Account/Logout", forceLoad: true))" @onclick:preventDefault>
                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>@L["Item_SignOut"]
            </a>
        </li>
    </ul>
</details>

@code {
    private bool canEditProject;
    private bool needsYou;

    protected override async Task OnInitializedAsync()
    {
        Current.Changed += OnProjectChanged;
        await LoadAsync();
    }

    /// <summary>Refreshes the edit right and the attention dot — on load and each time the menu opens.</summary>
    private async Task LoadAsync()
    {
        var scope = await AccessProvider.GetAsync();
        canEditProject = Current.ProjectId is { } id && scope.CanEdit(id);
        needsYou = scope.IsAuthenticated && Bank.IsEnabled && await Bank.AnyNeedsManualSyncAsync();
    }

    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Current.Changed -= OnProjectChanged;
}
