@using System.Globalization
@using OpenBudget.Connectors.Receipts
@using OpenBudget.Services
@inject IStringLocalizer<TxReceipt> L

@* A booking's receipt in its details, compact: one line (shop, number, date, item count) and a chip per part the
   receipt splits the booking into (category, amount, item count), the shown part highlighted. The line or a chip
   opens the receipt panel with all items, where the owner moves items to other categories. *@

<div class="tx-details-purpose" data-testid="tx-receipt">
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline text-reset text-start" data-testid="tx-receipt-open" @onclick="() => Open(null)">
        <b class="text-body me-1">@L["Receipt"]</b>
        <span class="text-body-secondary">@Receipt.Title@(Receipt.DeliveryDate is { } d ? " · " + d.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) : "") · @L["Items", Receipt.ItemCount]</span>
    </button>
    <div class="d-flex flex-wrap gap-1 mt-1">
        @for (var i = 0; i < Receipt.Groups.Count; i++)
        {
            var index = i;
            var group = Receipt.Groups[i];
            var shown = HighlightCategoryId != null && group.CategoryId == HighlightCategoryId;
            <button type="button" class="badge rounded-pill border @(shown ? "text-bg-primary" : "text-bg-light")" data-testid="tx-receipt-group"
                    data-category="@group.CategoryId" aria-current="@(shown ? "true" : null)" @onclick="() => Open(index)">
                @ShortName(group.CategoryId) @Formatting.FormatMoneyDe(group.AmountCents / 100m) (@group.Lines.Count)
            </button>
        }
    </div>
    <ReceiptPanel ReceiptId="openId" InitialPart="openPart" PickerData="PickerData" CanEdit="CanEdit" BookingCategoryName="@BookingCategoryName" OnClose="ClosedAsync" />
</div>

@code {
    [Parameter, EditorRequired] public BookingReceiptView Receipt { get; set; } = null!;
    /// <summary>Categories for naming the parts and moving items; without them items cannot be moved.</summary>
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>Whether the signed-in user may move items (the receipt's owner).</summary>
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? BookingCategoryName { get; set; }
    /// <summary>The category of the split part shown (its chip is highlighted), or null when the whole booking is shown.</summary>
    [Parameter] public long? HighlightCategoryId { get; set; }
    /// <summary>Items were moved (the panel closed after a change): the details reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private long? openId;
    private int? openPart;

    private void Open(int? part) => (openId, openPart) = (Receipt.ReceiptId, part);

    private async Task ClosedAsync(bool changed)
    {
        openId = null;
        if (changed) await OnChanged.InvokeAsync();
    }

    private string ShortName(long? id)
    {
        var name = id is { } c && PickerData != null ? PickerData.PathOf(c, BookingCategoryName ?? L["NoCategory"]) : BookingCategoryName ?? L["NoCategory"];
        var at = name.LastIndexOf('›');
        return at >= 0 ? name[(at + 1)..].Trim() : name;
    }
}
