@using System.Globalization
@using OpenBudget.Connectors.Receipts
@using OpenBudget.Services
@inject IStringLocalizer<TxReceipt> L

@* A booking's receipt in its details, compact: one line (shop, number, date, item count) and a chip per part the
   receipt splits the booking into (category, amount, item count), the shown part highlighted. The line or a chip
   opens the receipt panel with all items, where the owner moves items to other categories. *@

<div class="tx-details-purpose" data-testid="tx-receipt">
    <b class="text-body me-1">@L["Receipt"]</b>
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline text-start" data-testid="tx-receipt-open" @onclick="OpenAsync">@Receipt.Title@(Receipt.DeliveryDate is { } d ? " · " + d.ToAppDate() : "") · @L[Receipt.ItemCount == 1 ? "Items_One" : "Items", Receipt.ItemCount]</button>
    @if (Receipt.ShopUrls() is { Count: > 1 } orders)
    {
        @foreach (var (number, url) in orders)
        {
            <a class="ms-2 small" href="@url" target="_blank" rel="noopener" data-testid="tx-receipt-shop-link"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@L["OpenOrderAtShop", number]</a>
        }
    }
    else if (Receipt.ShopUrl is { } shopUrl)
    {
        <a class="ms-2 small" href="@shopUrl" target="_blank" rel="noopener" data-testid="tx-receipt-shop-link"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>@L["OpenAtShop"]</a>
    }
    @* One part is the booking itself: a chip would only repeat its category and amount. *@
    @if (Receipt.Groups.Count > 1)
    {
    <div class="d-flex flex-wrap gap-1 mt-1">
        @for (var i = 0; i < Receipt.Groups.Count; i++)
        {
            var group = Receipt.Groups[i];
            var shown = HighlightCategoryId != null && group.CategoryId == HighlightCategoryId;
            <CategoryPill CategoryId="group.CategoryId" PickerData="PickerData" FallbackName="@(BookingCategoryName ?? L["Uncategorized"])" TestId="tx-receipt-group"
                          Class="@(shown ? "cat-pill-current" : null)" OnClick="OpenAsync">
                <span class="cat-pill-amount">@Formatting.FormatMoneyDe(group.AmountCents / 100m) (@group.Lines.Count)</span>
            </CategoryPill>
        }
    </div>
    }
    @if (!OnOpen.HasDelegate)
    {
        <ReceiptPanel ReceiptId="openId" PickerData="PickerData" CanEdit="CanEdit" BookingCategoryName="@BookingCategoryName" OnClose="Closed" OnMoved="MovedAsync" />
    }
</div>

@code {
    [Parameter, EditorRequired] public BookingReceiptView Receipt { get; set; } = null!;
    /// <summary>Categories for naming the parts and moving items; without them items cannot be moved.</summary>
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>Whether the signed-in user may move items (the receipt's owner).</summary>
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? BookingCategoryName { get; set; }
    /// <summary>The category of the split part shown (its chip is highlighted), or null when the whole booking is shown.</summary>
    [Parameter] public long? HighlightCategoryId { get; set; }
    /// <summary>Items were moved (the panel closed after a change): the details reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Opens the receipt in the page's panel instead of one of its own, so the panel stays open when a move takes the
    /// booking out of the list (a split booking leaves "Uncategorized").
    /// </summary>
    [Parameter] public EventCallback<ReceiptOpenRequest> OnOpen { get; set; }

    private long? openId;

    // The receipt opens on all its items, each with its category, so every wrong one can be fixed in one place.
    private async Task OpenAsync()
    {
        if (OnOpen.HasDelegate) await OnOpen.InvokeAsync(new ReceiptOpenRequest(Receipt.ReceiptId, CanEdit, BookingCategoryName));
        else openId = Receipt.ReceiptId;
    }

    // Each move already refreshed the page behind (OnMoved), so closing only hides the panel.
    private void Closed(bool _) => openId = null;

    private Task MovedAsync() => OnChanged.InvokeAsync();

}
