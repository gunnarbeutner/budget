@using System.Globalization
@using OpenBudget.Services
@implements IAsyncDisposable
@inject TransactionQueryService TransactionQueries
@inject IJSRuntime JS
@inject IStringLocalizer<PortfolioValueChart> L

@* The Positions section's value chart: the total value of the project's portfolio (its depots, with their stored
   daily history carried forward and today their current value, plus their settlement accounts' end-of-day balances)
   over the selected period above the money invested (the start value plus the net flows into the portfolio, see
   TransactionQueryService.GetPortfolioFlowsAsync). The headline is the gain (the change less the net flows) with its time-weighted
   return; the change and the net flows follow as secondary text. Hidden while no depot has stored history or every
   value is zero. *@

@if (series is { Points.Count: > 1 } s)
{
    <div class="card mb-2 portfolio-value-card" data-testid="portfolio-value-chart"
         data-start="@s.Points[0].Day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-points="@s.Points.Count">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h6 class="mb-0">@L["Title"]</h6>
                <span class="small fw-semibold @(s.Gain < 0 ? "text-danger" : "text-success")" data-testid="portfolio-value-change">
                    @FormatSigned(s.Gain)@(s.TimeWeightedReturn is { } f ? $" ({FormatPercent(f)})" : "")
                </span>
                <span class="small text-muted" data-testid="portfolio-value-details">
                    @SinceText(s)@L["Value_Change", FormatSigned(s.Change)] · @L["Net_Flows", FormatSigned(s.NetFlows)]
                </span>
                <div class="flex-grow-1"></div>
                <div class="segmented segmented-sm" role="group" aria-label="@L["Aria_Period"]">
                    @foreach (var (p, key, label) in Periods)
                    {
                        <button type="button" class="btn @(period == p ? "active" : "")" aria-pressed="@(period == p ? "true" : "false")"
                                data-testid="@($"portfolio-period-{key}")" @onclick="() => SelectPeriodAsync(p)">@label</button>
                    }
                </div>
            </div>
            <div style="position:relative;height:220px;">
                <canvas id="@CanvasId"></canvas>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string OwnerUserId { get; set; }
    [Parameter, EditorRequired] public List<long> DepotIds { get; set; } = [];
    /// <summary>The depots' settlement accounts, valued and counted for flows together with the depots.</summary>
    [Parameter] public List<long> CashAccountIds { get; set; } = [];
    /// <summary>The depots' current total value (without the settlement accounts).</summary>
    [Parameter] public decimal CurrentTotal { get; set; }

    private const string CanvasId = "portfolioValueChart";
    private PortfolioValuePeriod period = PortfolioValuePeriod.OneYear;
    private Dictionary<long, List<(DateTime Day, decimal Value)>> history = new();
    private Dictionary<DateTime, decimal> flows = new();
    private PortfolioValueSeries? series;
    private List<long>? loadedDepots;
    private decimal loadedTotal;
    private List<long>? loadedCash;
    private decimal currentCash;
    private bool renderPending;

    private static readonly (PortfolioValuePeriod, string, string)[] PeriodKeys =
    [
        (PortfolioValuePeriod.OneDay, "1d", "Period_1D"),
        (PortfolioValuePeriod.OneWeek, "1w", "Period_1W"),
        (PortfolioValuePeriod.OneMonth, "1m", "Period_1M"),
        (PortfolioValuePeriod.YearToDate, "ytd", "Period_YTD"),
        (PortfolioValuePeriod.OneYear, "1y", "Period_1Y"),
        (PortfolioValuePeriod.ThreeYears, "3y", "Period_3Y"),
        (PortfolioValuePeriod.Max, "max", "Period_Max"),
    ];

    private IEnumerable<(PortfolioValuePeriod, string, string)> Periods =>
        PeriodKeys.Select(p => (p.Item1, p.Item2, L[p.Item3].Value));

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(loadedDepots, DepotIds) && ReferenceEquals(loadedCash, CashAccountIds) && loadedTotal == CurrentTotal) return;
        loadedDepots = DepotIds;
        loadedCash = CashAccountIds;
        loadedTotal = CurrentTotal;
        history = DepotIds.Count == 0 ? new() : await TransactionQueries.GetDepotValueHistoryAsync(OwnerUserId, DepotIds);
        var cash = DepotIds.Count == 0 ? (new(), 0m) : await TransactionQueries.GetAccountBalanceHistoryAsync(OwnerUserId, CashAccountIds);
        foreach (var (id, points) in cash.History) history[id] = points;
        currentCash = cash.Current;
        flows = DepotIds.Count == 0 ? new() : await TransactionQueries.GetPortfolioFlowsAsync(OwnerUserId, DepotIds, CashAccountIds);
        Rebuild();
    }

    private void Rebuild()
    {
        var today = DateTime.Today;
        // Without any value ever (all stored history and the current total zero) there is nothing to chart.
        var total = CurrentTotal + currentCash;
        var anyValue = total != 0m || history.Values.Any(h => h.Any(p => p.Value != 0m));
        series = !anyValue ? null
            : PortfolioValueHistory.Build(history, total, today,
                PortfolioValueHistory.PeriodStart(period, today, PortfolioValueHistory.LastStoredDayBefore(history, today)), flows);
        renderPending = true;
    }

    private Task SelectPeriodAsync(PortfolioValuePeriod p)
    {
        if (p == period) return Task.CompletedTask;
        period = p;
        Rebuild();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!renderPending) return;
        renderPending = false;
        if (series is not { Points.Count: > 1 } s)
        {
            await DestroyAsync();
            return;
        }
        var labels = s.Points.Select(p => p.Day.ToAppDate()).ToArray();
        var data = s.Points.Select(p => p.Value).ToArray();
        var invested = s.Points.Select(p => p.Invested).ToArray();
        var palette = ChartPalette.Templates(2);
        var color = palette[1];
        var investedColor = palette[0];
        var label = L["Series_Label"].Value;
        var chartData = new
        {
            type = "line",
            data = new
            {
                labels,
                datasets = new object[]
                {
                    new
                    {
                        label,
                        data,
                        borderColor = ChartPalette.WithAlpha(color, 1),
                        backgroundColor = ChartPalette.WithAlpha(color, 0.15),
                        borderWidth = 2,
                        fill = true,
                        tension = 0.1,
                        pointRadius = 0,
                        pointHoverRadius = 4,
                    },
                    new
                    {
                        label = L["Series_Invested"].Value,
                        data = invested,
                        borderColor = ChartPalette.WithAlpha(investedColor, 1),
                        backgroundColor = ChartPalette.WithAlpha(investedColor, 0.1),
                        borderWidth = 1.5,
                        borderDash = new[] { 4, 3 },
                        fill = true,
                        tension = 0,
                        stepped = true,
                        pointRadius = 0,
                        pointHoverRadius = 3,
                    },
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                animation = false,
                interaction = new { mode = "index", intersect = false },
                plugins = new
                {
                    legend = new { display = false },
                    tooltip = new
                    {
                        mode = "index",
                        intersect = false,
                        callbacks = new { label = new { kind = "datasetEuroLabel" } }
                    }
                },
                scales = new
                {
                    x = new { ticks = new { autoSkip = true, maxTicksLimit = 6, maxRotation = 0 }, grid = new { display = false } },
                    y = new { ticks = new { callback = new { kind = "euroTicks", decimals = 0 } } }
                }
            }
        };
        try { await JS.InvokeVoidAsync("renderChart", CanvasId, chartData); }
        catch (JSDisconnectedException) { /* circuit already gone */ }
        catch (JSException) { /* render raced a teardown or charts.js not loaded yet */ }
        catch (InvalidOperationException) { /* JS unreachable during prerender */ }
    }

    // The 1D comparison names its day when that is not yesterday (no value was stored then).
    private string SinceText(PortfolioValueSeries s) =>
        period == PortfolioValuePeriod.OneDay && s.Points[0].Day < DateTime.Today.AddDays(-1)
            ? L["Since", s.Points[0].Day.ToAppDate()] + " · " : "";

    private static string FormatSigned(decimal v) => (v > 0 ? "+" : "") + Formatting.FormatMoneyDe(v);

    private static string FormatPercent(decimal f) =>
        (f > 0 ? "+" : f < 0 ? "−" : "") + Math.Abs(f).ToString("P1", CultureInfo.CurrentCulture);

    private async Task DestroyAsync()
    {
        try { await JS.InvokeVoidAsync("destroyChart", CanvasId); }
        catch (JSDisconnectedException) { /* circuit already gone */ }
        catch (JSException) { /* render raced a teardown or charts.js not loaded yet */ }
        catch (InvalidOperationException) { /* JS unreachable during prerender */ }
    }

    public async ValueTask DisposeAsync() => await DestroyAsync();
}
