@using OpenBudget.Connectors.Receipts
@using OpenBudget.Models
@using OpenBudget.Services
@inject ReceiptService Receipts
@inject CategorizationService Categorization
@inject IStringLocalizer<ProjectReceiptItems> L

@* A project's receipt item categories: the categories items of receipts whose booking lies on the project's accounts
   may be split into (by keywords, the item memory or the AI), each with a description of what belongs there and extra
   keywords, and per receipt source optionally only some of them. Everything else stays in the booking's category.
   Shown in the project's settings and on the receipts page (which explains them once above all projects). The
   categories line up in columns (pill, description, actions); on phones the description goes below the pill. *@

<div class="receipt-source-categories" id="receipt-items" data-testid="project-receipt-items" data-project="@ProjectId">
    @if (ShowHeading)
    {
        <h6 class="bank-accounts-heading">@L["Heading"]</h6>
    }
    @if (settings == null || picker == null)
    {
        <div class="skeleton skeleton-line mb-2" style="width: 40%;"></div>
    }
    else
    {
        @if (ShowExplain)
        {
            <p class="small mb-1" data-testid="source-categories-explain">@L["Explain"]</p>
            <p class="small text-body-secondary mb-2">@L["Help"]</p>
        }
        <ul class="list-unstyled small mb-2 rpi-list">
            @foreach (var r in settings.Categories)
            {
                var text = (r.Description ?? "") + (r.Keywords is { Length: > 0 } k ? $" · {L["KeywordsShort"]}: {k}" : "");
                <li class="rpi-row" data-testid="source-allowed" data-category="@r.CategoryId">
                    <span class="rpi-pill"><CategoryPill CategoryId="r.CategoryId" PickerData="picker" FallbackName="?" /></span>
                    @if (editing == r.Id)
                    {
                        <span class="rpi-text rpi-edit">
                            <input class="form-control form-control-sm" placeholder="@L["Description"]" aria-label="@L["Description"]"
                                   data-testid="source-allowed-description" @bind="editDescription" />
                            <input class="form-control form-control-sm" placeholder="@L["Keywords"]" aria-label="@L["Keywords"]"
                                   data-testid="source-allowed-keywords" @bind="editKeywords" />
                        </span>
                        <span class="rpi-actions">
                            <button type="button" class="btn btn-sm btn-primary" data-testid="source-allowed-save" @onclick="() => SaveAsync(r.Id)">@L["Save"]</button>
                            <button type="button" class="btn btn-sm btn-link" @onclick="() => editing = null">@L["Cancel"]</button>
                        </span>
                    }
                    else
                    {
                        <span class="rpi-text text-body-secondary" title="@text" data-testid="source-allowed-text">@text</span>
                        <span class="rpi-actions">
                            <button type="button" class="btn btn-sm btn-link p-0" data-testid="source-allowed-edit"
                                    @onclick="() => (editing, editDescription, editKeywords) = (r.Id, r.Description, r.Keywords)">@L["Edit"]</button>
                            <button type="button" class="btn btn-sm btn-link p-0 text-danger" data-testid="source-allowed-remove"
                                    aria-label="@L["Remove"]" @onclick="() => RemoveAsync(r.Id)"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                        </span>
                    }
                </li>
            }
        </ul>
        <button type="button" class="btn btn-sm btn-outline-primary" data-testid="source-allowed-add" @onclick="Open">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@L["Add"]
        </button>
        @if (settings.Categories.Count > 0)
        {
            <div class="mt-3" data-testid="receipt-source-narrowing">
                <p class="small text-body-secondary mb-1">@L["Narrow_Help"]</p>
                <div class="rpi-sources">
                @foreach (var source in ReceiptSources.All)
                {
                    var narrowed = settings.Narrowed.GetValueOrDefault(source);
                    <div class="rpi-source small" data-testid="receipt-source-row" data-source="@source">
                        <span class="fw-semibold">@L["Source_" + source]</span>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="@($"narrow-{ProjectId}-{source}")" checked="@(narrowed == null)"
                                   data-testid="receipt-source-all" @onchange="e => AllChangedAsync(source, e.Value is true)" />
                            <label class="form-check-label" for="@($"narrow-{ProjectId}-{source}")">@L["Narrow_All"]</label>
                        </div>
                        <div class="rpi-source-pills">
                        @if (narrowed != null)
                        {
                            @foreach (var c in settings.Categories)
                            {
                                var on = narrowed.Contains(c.CategoryId);
                                var category = c.CategoryId;
                                <CategoryPill CategoryId="category" PickerData="picker" FallbackName="?" Class="@(on ? "cat-pill-current" : "opacity-50")"
                                              TestId="receipt-source-category" Title="@(on ? L["Narrow_On"] : L["Narrow_Off"])"
                                              OnClick="() => ToggleAsync(source, category)" />
                            }
                        }
                        </div>
                    </div>
                }
                </div>
            </div>
        }
        @if (picking)
        {
            <CategoryPicker Data="picker" X="x" Y="y" OnPick="PickedAsync" OnClose="() => picking = false" />
        }
        @if (error != null)
        {
            <div class="text-danger small">@error</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }

    /// <summary>Whether the component shows its own heading (off where the surrounding card names it).</summary>
    [Parameter] public bool ShowHeading { get; set; } = true;

    /// <summary>Whether the component explains what the categories do (off where the page explains it once for all projects).</summary>
    [Parameter] public bool ShowExplain { get; set; } = true;

    private ProjectReceiptSettingsView? settings;
    private CategoryPickerData? picker;
    private bool picking;
    private double x, y;
    private long? editing;
    private string? editDescription, editKeywords;
    private string? error;

    [Inject] private AccessScopeProvider Access { get; set; } = null!;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if ((await Access.GetAsync()).UserId is not { } user) return;
        picker ??= await Categorization.GetPickerDataAsync(user);
        try
        {
            settings = await Receipts.GetProjectSettingsAsync(ProjectId);
        }
        catch (AccessDeniedException ex)
        {
            error = ex.Message;
        }
    }

    private void Open(MouseEventArgs e) => (picking, x, y) = (true, e.ClientX, e.ClientY);

    private async Task PickedAsync(long? id)
    {
        picking = false;
        if (id is { } c) await RunAsync(() => Receipts.AddProjectCategoryAsync(ProjectId, c));
    }

    private Task SaveAsync(long id) => RunAsync(async () =>
    {
        await Receipts.UpdateProjectCategoryAsync(id, editDescription, editKeywords);
        editing = null;
    });

    private Task RemoveAsync(long id) => RunAsync(() => Receipts.RemoveProjectCategoryAsync(id));

    private Task AllChangedAsync(string source, bool all) =>
        RunAsync(() => Receipts.SetSourceNarrowingAsync(ProjectId, source, all ? null : settings!.Categories.Select(c => c.CategoryId).ToList()));

    private Task ToggleAsync(string source, long categoryId)
    {
        var current = settings!.Narrowed.GetValueOrDefault(source)?.ToHashSet() ?? [];
        if (!current.Remove(categoryId)) current.Add(categoryId);
        return RunAsync(() => Receipts.SetSourceNarrowingAsync(ProjectId, source, current));
    }

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        try
        {
            await action();
        }
        catch (AccessDeniedException ex)
        {
            error = ex.Message;
        }
        await LoadAsync();
    }
}
