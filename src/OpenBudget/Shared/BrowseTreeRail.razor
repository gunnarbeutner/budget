@using Microsoft.AspNetCore.Components.Web
@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<BrowseTreeRail> L
@inject IJSRuntime JS

@* Browse left rail: the "All transactions" row, the accounts section (with show/hide for
   related accounts), and the recursive category tree. Presentational — the page owns the
   selection state and the reload pipeline; this raises OnSelectAll / OnSelectAccount /
   OnSelectCategory and reflects the current selection for highlighting. *@

<div class="browse-tree" role="tree">
    @{
        bool allSelected = SelectionKind == "all";
    }
    <div class="browse-tree-row @(allSelected ? "selected" : "")"
         role="treeitem" tabindex="0" aria-selected="@allSelected.ToString().ToLower()"
         @onclick="() => OnSelectAll.InvokeAsync()"
         @onkeydown="OnAllKeydown">
        <span class="browse-tree-name fw-semibold">
            <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@L["Tree_AllTransactions"]
        </span>
    </div>

    @if (Tree.UncategorizedCount > 0 || SelectionKind == "uncategorized")
    {
        bool uncatSelected = SelectionKind == "uncategorized";
        <div class="browse-tree-row @(uncatSelected ? "selected" : "")"
             role="treeitem" tabindex="0" aria-selected="@uncatSelected.ToString().ToLower()"
             @onclick="() => OnSelectUncategorized.InvokeAsync()"
             @onkeydown="OnUncategorizedKeydown">
            <span class="browse-tree-name fw-semibold">
                <i class="bi bi-question-circle me-1" aria-hidden="true"></i>@L["Tree_Uncategorized"]
            </span>
            <span class="browse-tree-amount text-body-secondary">@Tree.UncategorizedCount</span>
        </div>
    }

    @if (Tree.Accounts.Count > 0)
    {
        var visibleAccounts = ShowRelatedAccounts
            ? (IEnumerable<BrowseAccountNode>)Tree.Accounts
            : Tree.Accounts.Where(a => a.IsAssigned);
        var hiddenRelatedCount = Tree.Accounts.Count(a => !a.IsAssigned);
        <div class="browse-tree-section">@L["Tree_Section_Accounts"]</div>
        @if (Tree.Accounts.Count(a => a.IsPortfolio) >= 2)
        {
            bool portfolioSel = SelectionKind == "portfolio";
            <div class="browse-tree-row @(portfolioSel ? "selected" : "")"
                 role="treeitem" tabindex="0" aria-selected="@portfolioSel.ToString().ToLower()"
                 @onclick="() => OnSelectPortfolio.InvokeAsync()"
                 @onkeydown="OnPortfolioKeydown">
                <span class="browse-tree-name fw-semibold">
                    <i class="bi bi-collection me-1" aria-hidden="true"></i>@L["Tree_AllSecurities"]
                </span>
            </div>
        }
        @foreach (var node in AccountNodes(visibleAccounts))
        {
            @RenderAccountNode(node, 0)
        }
        @if (hiddenRelatedCount > 0)
        {
            <button type="button" class="btn btn-link btn-sm browse-tree-toggle"
                    @onclick="() => ShowRelatedAccountsChanged.InvokeAsync(!ShowRelatedAccounts)">
                @(ShowRelatedAccounts
                    ? L["Tree_HideRelatedAccounts"]
                    : L["Tree_ShowRelatedAccounts", hiddenRelatedCount])
            </button>
        }
    }

    @if (Tree.Categories.Count > 0)
    {
        <div class="browse-tree-section">@L["Tree_Section_Categories"]</div>
        @foreach (var c in Tree.Categories)
        {
            @RenderCategoryNode(c, 0)
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public BrowseTree Tree { get; set; } = default!;
    [Parameter, EditorRequired] public string SelectionKind { get; set; } = "all";
    [Parameter] public long? SelectionId { get; set; }
    /// <summary>Whether related (non-assigned) accounts are shown. Two-way: the page also sets it
    /// (auto-expand when a URL-selected related account needs revealing).</summary>
    [Parameter] public bool ShowRelatedAccounts { get; set; }
    [Parameter] public EventCallback<bool> ShowRelatedAccountsChanged { get; set; }
    [Parameter] public EventCallback OnSelectAll { get; set; }
    [Parameter] public EventCallback<long> OnSelectAccount { get; set; }
    [Parameter] public EventCallback OnSelectPortfolio { get; set; }
    [Parameter] public EventCallback OnSelectUncategorized { get; set; }
    [Parameter] public EventCallback<BrowseCategoryNode> OnSelectCategory { get; set; }

    // Collapsed account groups, persisted in localStorage via expandState (as the keys of the
    // collapsed groups: new groups default to expanded, like MoneyMoney's sidebar).
    private const string CollapseScope = "browse-accounts-collapsed";
    private readonly HashSet<string> collapsed = new(StringComparer.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var keys = await JS.InvokeAsync<string[]>("expandState.get", CollapseScope);
            if (keys.Length > 0)
            {
                collapsed.UnionWith(keys);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
    }

    private async Task ToggleGroupAsync(string key)
    {
        if (!collapsed.Remove(key)) collapsed.Add(key);
        try { await JS.InvokeVoidAsync("expandState.set", CollapseScope, collapsed.ToArray()); }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
    }

    private List<AccountTreeNode> AccountNodes(IEnumerable<BrowseAccountNode> visible) =>
        AccountTreeBuilder.Build(visible.ToList(), Tree.AccountGroups, L["Tree_OtherAccounts"]);

    private async Task OnGroupKeydown(KeyboardEventArgs e, string key)
    {
        if (e.Key == "Enter" || e.Key == " ") await ToggleGroupAsync(key);
    }

    private string SumsText(AccountTreeNode n) =>
        string.Join(" · ", n.Sums.Select(s => Formatting.FormatMoney(s.Amount, s.Currency)));

    private RenderFragment RenderAccountNode(AccountTreeNode n, int level) => __builder =>
    {
        var pad = FormattableString.Invariant($"padding-left: {0.75 + level * 1.0:0.##}rem;");
        if (n.Account is { } a)
        {
            var accountId = a.Id;
            bool isSel = SelectionKind == "account" && SelectionId == accountId;
            <div class="browse-tree-row @(isSel ? "selected" : "") @(!a.IsAssigned ? "related" : "") @(a.Closed ? "closed" : "")" style="@pad"
                 role="treeitem" tabindex="0" aria-selected="@isSel.ToString().ToLower()" data-testid="tree-account"
                 @onclick="() => OnSelectAccount.InvokeAsync(accountId)"
                 @onkeydown="e => OnAccountKeydown(e, accountId)">
                <span class="browse-tree-name"><i class="bi @(a.IsPortfolio ? "bi-graph-up-arrow" : Account.IconForType(a.Type)) me-1" aria-hidden="true"></i>@a.Name</span>
                @if (a.Balance.HasValue)
                {
                    <span class="browse-tree-amount @(a.Balance < 0 ? "text-danger" : "text-body-secondary")">
                        @Formatting.FormatMoney(a.Balance.Value, a.Currency ?? "EUR")
                    </span>
                }
            </div>
        }
        else
        {
            var key = n.Key;
            bool open = !collapsed.Contains(key);
            <div class="browse-tree-row browse-tree-group" style="@pad"
                 role="treeitem" tabindex="0" aria-expanded="@open.ToString().ToLower()" data-testid="tree-group"
                 @onclick="() => ToggleGroupAsync(key)"
                 @onkeydown="e => OnGroupKeydown(e, key)">
                <span class="browse-tree-name fw-semibold"><i class="bi @(open ? "bi-chevron-down" : "bi-chevron-right") me-1" aria-hidden="true"></i>@n.Name</span>
                <span class="browse-tree-amount fw-bold" data-testid="tree-group-sum">@SumsText(n)</span>
            </div>
            @if (open)
            {
                @foreach (var child in n.Children)
                {
                    @RenderAccountNode(child, level + 1)
                }
            }
        }
    };

    private async Task OnAllKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectAll.InvokeAsync();
    }

    private async Task OnAccountKeydown(KeyboardEventArgs e, long id)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectAccount.InvokeAsync(id);
    }

    private async Task OnUncategorizedKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectUncategorized.InvokeAsync();
    }

    private async Task OnPortfolioKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectPortfolio.InvokeAsync();
    }

    private async Task OnCategoryKeydown(KeyboardEventArgs e, BrowseCategoryNode node)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectCategory.InvokeAsync(node);
    }

    // NOTE: deliberately no builder.SetKey(...) on these nodes. The tree structure is stable
    // across the re-renders this page actually does (selection / period / search change classes
    // and values, not the node set), so positional diffing is correct here. A SetKey was tried and
    // removed because it caused a 500 (see commit "Fix Browse 500: drop SetKey on the recursive
    // category node") — don't reintroduce one without reproducing that crash first.
    private RenderFragment RenderCategoryNode(BrowseCategoryNode node, int level) => builder =>
    {
        bool isSelected = (SelectionKind == (node.ItemType == CategoryItemType.Category ? "category" : "group"))
                          && SelectionId == node.Id;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "browse-tree-row" + (isSelected ? " selected" : "") + (node.IsTracked ? " tracked" : ""));
        builder.AddAttribute(2, "role", "treeitem");
        builder.AddAttribute(3, "tabindex", "0");
        builder.AddAttribute(4, "aria-selected", isSelected ? "true" : "false");
        // FormattableString.Invariant: CSS lengths need a decimal point, but Razor's $""
        // interpolation defaults to CurrentCulture — German renders "1,5rem", which browsers
        // silently drop as invalid and the tree flattens.
        builder.AddAttribute(5, "style", FormattableString.Invariant($"padding-left: {0.5 + level * 1.0:0.##}rem;"));
        builder.AddAttribute(6, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnSelectCategory.InvokeAsync(node)));
        builder.AddAttribute(7, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnCategoryKeydown(e, node)));

        builder.OpenElement(10, "span");
        builder.AddAttribute(11, "class", "browse-tree-name");
        if (!string.IsNullOrEmpty(node.Color))
        {
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "class", "browse-color-dot");
            builder.AddAttribute(14, "style", $"background:{node.Color};");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(15, "i");
            builder.AddAttribute(16, "class", node.ItemType == CategoryItemType.Group ? "bi bi-folder me-1" : "bi bi-tag me-1");
            builder.CloseElement();
        }
        builder.AddContent(20, node.Name);
        builder.CloseElement(); // span.browse-tree-name

        builder.OpenElement(30, "span");
        builder.AddAttribute(31, "class", "browse-tree-amount");
        // Show the spent side whenever the node has any context to anchor it: either an
        // actual non-zero spent value, OR a budget pair on its right ("€0,00 | €120,00" reads
        // cleanly; a bare " | €120,00" reads as a missing value).
        bool hasBudgetContext = node.Remaining.HasValue;
        if (node.Spent != 0m || hasBudgetContext)
        {
            builder.OpenElement(32, "span");
            builder.AddAttribute(33, "class", node.IsIncome ? "text-success" : "text-danger");
            builder.AddContent(34, Formatting.FormatMoney(node.IsIncome ? node.Spent : -node.Spent));
            builder.CloseElement();
        }
        if (node.Remaining is { } rem)
        {
            builder.AddContent(35, " | ");
            builder.OpenElement(36, "span");
            builder.AddAttribute(37, "class", rem < 0 ? "text-danger" : "text-success");
            builder.AddContent(38, Formatting.FormatMoney(rem));
            builder.CloseElement();
        }
        builder.CloseElement(); // span.browse-tree-amount

        builder.CloseElement(); // div.browse-tree-row

        // Children rendered as siblings at the next indent level.
        foreach (var c in node.Children)
        {
            builder.AddContent(50, RenderCategoryNode(c, level + 1));
        }
    };
}
