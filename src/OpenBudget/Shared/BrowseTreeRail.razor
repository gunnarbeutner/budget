@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<BrowseTreeRail> L
@inject IJSRuntime JS

@* Browse left rail: the "All transactions" row, the accounts section (with show/hide for
   related accounts), and the recursive category tree. Presentational — the page owns the
   selection state and the reload pipeline; this raises OnSelectAll / OnSelectAccount /
   OnSelectCategory and reflects the current selection for highlighting. *@

<div class="browse-tree" role="tree">
    @{
        bool allSelected = SelectionKind == "all";
    }
    @if (ShowAllRow)
    {
    <div class="browse-tree-row @(allSelected ? "selected" : "")"
         role="treeitem" tabindex="0" aria-selected="@allSelected.ToString().ToLower()"
         @onclick="() => OnSelectAll.InvokeAsync()"
         @onkeydown="OnAllKeydown">
        <span class="browse-tree-name fw-semibold">
            <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@L["Tree_AllTransactions"]
        </span>
    </div>
    }

    @if (Tree.UncategorizedCount > 0 || SelectionKind == "uncategorized")
    {
        bool uncatSelected = SelectionKind == "uncategorized";
        <div class="browse-tree-row @(uncatSelected ? "selected" : "")"
             role="treeitem" tabindex="0" aria-selected="@uncatSelected.ToString().ToLower()"
             @onclick="() => OnSelectUncategorized.InvokeAsync()"
             @onkeydown="OnUncategorizedKeydown">
            <span class="browse-tree-name fw-semibold">
                <i class="bi bi-question-circle me-1" aria-hidden="true"></i>@L["Tree_Uncategorized"]
            </span>
            <span class="browse-tree-amount text-body-secondary">@Tree.UncategorizedCount</span>
        </div>
    }

    @if (Tree.Accounts.Count > 0)
    {
        var visibleAccounts = ShowRelatedAccounts
            ? (IEnumerable<BrowseAccountNode>)Tree.Accounts
            : Tree.Accounts.Where(a => a.IsAssigned);
        var hiddenRelatedCount = Tree.Accounts.Count(a => !a.IsAssigned);
        <div class="browse-tree-section">@L["Tree_Section_Accounts"]</div>
        @if (Tree.Accounts.Count(a => a.IsPortfolio) >= 2)
        {
            bool portfolioSel = SelectionKind == "portfolio";
            <div class="browse-tree-row @(portfolioSel ? "selected" : "")"
                 role="treeitem" tabindex="0" aria-selected="@portfolioSel.ToString().ToLower()"
                 @onclick="() => OnSelectPortfolio.InvokeAsync()"
                 @onkeydown="OnPortfolioKeydown">
                <span class="browse-tree-name fw-semibold">
                    <i class="bi bi-collection me-1" aria-hidden="true"></i>@L["Tree_AllSecurities"]
                </span>
            </div>
        }
        @foreach (var node in AccountNodes(visibleAccounts))
        {
            @RenderAccountNode(node, 0)
        }
        @if (hiddenRelatedCount > 0)
        {
            <button type="button" class="btn btn-link btn-sm browse-tree-toggle"
                    @onclick="() => ShowRelatedAccountsChanged.InvokeAsync(!ShowRelatedAccounts)">
                @(ShowRelatedAccounts
                    ? L["Tree_HideRelatedAccounts"]
                    : L["Tree_ShowRelatedAccounts", hiddenRelatedCount])
            </button>
        }
    }

    @if (Tree.Categories.Count > 0)
    {
        <div class="browse-tree-section">@L["Tree_Section_Categories"]</div>
        @foreach (var c in Tree.Categories)
        {
            @RenderCategoryNode(c, 0)
        }
    }
</div>

@if (menuNode != null)
{
    <ContextMenu Items="menuItems" X="menuX" Y="menuY" OnPick="PickMenuAsync" OnClose="CloseMenu" />
}

@code {
    [Parameter, EditorRequired] public BrowseTree Tree { get; set; } = default!;
    [Parameter, EditorRequired] public string SelectionKind { get; set; } = "all";
    [Parameter] public long? SelectionId { get; set; }
    /// <summary>Show the "All transactions" row (Transactions does; the other views have the Transactions link above).</summary>
    [Parameter] public bool ShowAllRow { get; set; } = true;
    /// <summary>Whether related (non-assigned) accounts are shown. Two-way: the page also sets it
    /// (auto-expand when a URL-selected related account needs revealing).</summary>
    [Parameter] public bool ShowRelatedAccounts { get; set; }
    [Parameter] public EventCallback<bool> ShowRelatedAccountsChanged { get; set; }
    [Parameter] public EventCallback OnSelectAll { get; set; }
    [Parameter] public EventCallback<long> OnSelectAccount { get; set; }
    /// <summary>Raised with the id of the account group whose name was picked.</summary>
    [Parameter] public EventCallback<long> OnSelectAccountGroup { get; set; }
    [Parameter] public EventCallback OnSelectPortfolio { get; set; }
    [Parameter] public EventCallback OnSelectUncategorized { get; set; }
    [Parameter] public EventCallback<BrowseCategoryNode> OnSelectCategory { get; set; }
    /// <summary>The context-menu items of a row (see <see cref="SidebarNode"/>); null or empty = no menu.</summary>
    [Parameter] public Func<SidebarNode, IReadOnlyList<ContextMenuItem>>? NodeMenu { get; set; }
    /// <summary>A context-menu item was picked: the row and the item's key.</summary>
    [Parameter] public EventCallback<(SidebarNode Node, string Key)> OnNodeMenuPick { get; set; }
    /// <summary>The row being renamed inline (an input replaces its label), or null.</summary>
    [Parameter] public SidebarNode? RenamingNode { get; set; }
    /// <summary>Inline rename finished: the new name (Enter / leaving the field) or null (Esc).</summary>
    [Parameter] public EventCallback<string?> OnRename { get; set; }
    /// <summary>Whether a row can be dragged onto another (structure editing); null = no drag and drop.</summary>
    [Parameter] public Func<SidebarNode, bool>? CanDrag { get; set; }
    /// <summary>A row was dropped on another: before the target row, or (<c>Into</c>) into the target group.</summary>
    [Parameter] public EventCallback<(SidebarNode Dragged, SidebarNode Target, bool Into)> OnDrop { get; set; }

    /// <summary>Where the last context menu opened (viewport px), so a follow-up popover can appear there.</summary>
    public (double X, double Y) MenuPosition => (menuX, menuY);

    private SidebarNode? dragNode;
    private SidebarNode? dropTarget;
    private ElementReference renameInput;
    private SidebarNode? focusedRename;
    private string? renameValue;

    private bool Draggable(SidebarNode? node) => node != null && CanDrag != null && RenamingNode == null && CanDrag(node);

    private static bool IsGroup(SidebarNode n) => n.Kind is SidebarNodeKind.CategoryGroup or SidebarNodeKind.AccountGroup;

    private static bool SameTree(SidebarNode a, SidebarNode b) =>
        (a.Kind is SidebarNodeKind.Category or SidebarNodeKind.CategoryGroup) == (b.Kind is SidebarNodeKind.Category or SidebarNodeKind.CategoryGroup);

    private void DragStart(SidebarNode node) => (dragNode, dropTarget) = (node, null);

    private void DragEnter(SidebarNode? target)
    {
        if (dragNode != null && target != null && SameTree(dragNode, target) && dragNode != target) dropTarget = target;
    }

    private void DragEnd() => (dragNode, dropTarget) = (null, null);

    // Dropped on a group: into it (at the end); on any other row: right before it.
    private async Task DropOn(SidebarNode? target)
    {
        var dragged = dragNode;
        DragEnd();
        if (dragged == null || target == null || dragged == target || !SameTree(dragged, target)) return;
        await OnDrop.InvokeAsync((dragged, target, IsGroup(target)));
    }

    private string DropClass(SidebarNode? node) =>
        node != null && dropTarget == node ? (IsGroup(node) ? " drop-into" : " drop-before") : "";

    private bool IsRenaming(SidebarNode? node) =>
        node != null && RenamingNode != null && RenamingNode.Kind == node.Kind && RenamingNode.Id == node.Id;

    private async Task RenameCommitAsync()
    {
        if (RenamingNode == null) return;
        await OnRename.InvokeAsync(renameValue ?? RenamingNode.Name);
    }

    private async Task OnRenameKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RenameCommitAsync();
        else if (e.Key == "Escape") await OnRename.InvokeAsync(null);
    }

    private RenderFragment RenameField(SidebarNode node) => __builder =>
    {
        <input class="form-control form-control-sm browse-tree-rename" value="@node.Name" data-testid="tree-rename"
               aria-label="@L["Tree_RenameLabel"]" @ref="renameInput"
               @oninput="e => renameValue = e.Value?.ToString()"
               @onkeydown="OnRenameKeyAsync" @onkeydown:stopPropagation="true"
               @onclick:stopPropagation="true" @onblur="RenameCommitAsync" />
    };

    // Alt+Arrow Up / Down move the focused row (the keyboard alternative to drag and drop).
    private async Task<bool> MoveKeyAsync(SidebarNode? node, KeyboardEventArgs e)
    {
        if (node == null || !e.AltKey || e.Key is not ("ArrowUp" or "ArrowDown")) return false;
        var key = e.Key == "ArrowUp" ? SidebarMenus.MoveUp : SidebarMenus.MoveDown;
        if (!ItemsFor(node).Any(i => i.Key == key && !i.Disabled)) return false;
        await OnNodeMenuPick.InvokeAsync((node, key));
        return true;
    }

    private SidebarNode? menuNode;
    private IReadOnlyList<ContextMenuItem> menuItems = [];
    private double menuX;
    private double menuY;

    private static SidebarNode SidebarNodeOf(BrowseCategoryNode n) =>
        new(n.ItemType == CategoryItemType.Category ? SidebarNodeKind.Category : SidebarNodeKind.CategoryGroup, n.Id, n.Name, n.Children.Count > 0);

    private IReadOnlyList<ContextMenuItem> ItemsFor(SidebarNode? node) =>
        node != null && NodeMenu != null ? NodeMenu(node) ?? [] : [];

    private bool HasMenu(SidebarNode? node) => ItemsFor(node).Count > 0;

    private string? LongPress(SidebarNode? node) => HasMenu(node) ? "" : null;

    private void OpenMenu(SidebarNode? node, MouseEventArgs e) => OpenMenuAt(node, e.ClientX, e.ClientY);

    private void OpenMenuAt(SidebarNode? node, double x, double y)
    {
        var items = ItemsFor(node);
        if (items.Count == 0) return;
        (menuNode, menuItems, menuX, menuY) = (node, items, x, y);
    }

    // Shift+F10 or the context-menu key on a focused row opens its menu below the row.
    private async Task<bool> MenuKeyAsync(SidebarNode? node, KeyboardEventArgs e)
    {
        if (!(e.Key == "ContextMenu" || (e.Key == "F10" && e.ShiftKey)) || !HasMenu(node)) return false;
        double x = 200, y = 200;
        try
        {
            if (await JS.InvokeAsync<double[]?>("obFocusAnchor") is { Length: 2 } xy) (x, y) = (xy[0], xy[1]);
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        OpenMenuAt(node, x, y);
        return true;
    }

    private void CloseMenu() => menuNode = null;

    private async Task PickMenuAsync(string key)
    {
        var node = menuNode;
        menuNode = null;
        if (node != null) await OnNodeMenuPick.InvokeAsync((node, key));
    }

    // Collapsed account groups, persisted in localStorage via expandState (as the keys of the
    // collapsed groups: new groups default to expanded, like MoneyMoney's sidebar).
    private const string CollapseScope = "browse-accounts-collapsed";
    private readonly HashSet<string> collapsed = new(StringComparer.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (RenamingNode == null)
        {
            focusedRename = null;
        }
        else if (focusedRename != RenamingNode)
        {
            focusedRename = RenamingNode;
            renameValue = null;
            try { await JS.InvokeVoidAsync("obFocusSelect", renameInput); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
        }
        if (!firstRender) return;
        try
        {
            var keys = await JS.InvokeAsync<string[]>("expandState.get", CollapseScope);
            if (keys.Length > 0)
            {
                collapsed.UnionWith(keys);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
    }

    private async Task ToggleGroupAsync(string key)
    {
        if (!collapsed.Remove(key)) collapsed.Add(key);
        try { await JS.InvokeVoidAsync("expandState.set", CollapseScope, collapsed.ToArray()); }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
    }

    private List<AccountTreeNode> AccountNodes(IEnumerable<BrowseAccountNode> visible) =>
        AccountTreeBuilder.Build(visible.ToList(), Tree.AccountGroups, L["Tree_OtherAccounts"]);

    private Task OnGroupClickAsync(long? groupId, string key) =>
        groupId is { } id ? OnSelectAccountGroup.InvokeAsync(id) : ToggleGroupAsync(key);

    // Enter / Space select the group, ArrowRight / ArrowLeft unfold / fold it.
    private async Task OnGroupKeydown(KeyboardEventArgs e, long? groupId, string key, SidebarNode? node)
    {
        if (await MenuKeyAsync(node, e) || await MoveKeyAsync(node, e)) return;
        var open = !collapsed.Contains(key);
        switch (e.Key)
        {
            case "Enter" or " ": await OnGroupClickAsync(groupId, key); break;
            case "ArrowRight" when !open: await ToggleGroupAsync(key); break;
            case "ArrowLeft" when open: await ToggleGroupAsync(key); break;
        }
    }

    private string SumsText(AccountTreeNode n) =>
        string.Join(" · ", n.Sums.Select(s => Formatting.FormatMoneyDe(s.Amount, s.Currency)));

    private RenderFragment RenderAccountNode(AccountTreeNode n, int level) => __builder =>
    {
        var pad = FormattableString.Invariant($"padding-left: {0.75 + level * 1.0:0.##}rem;");
        if (n.Account is { } a)
        {
            var accountId = a.Id;
            var accountNode = new SidebarNode(SidebarNodeKind.Account, a.Id, a.Name ?? "");
            bool isSel = SelectionKind == "account" && SelectionId == accountId;
            <div class="browse-tree-row @(isSel ? "selected" : "") @(!a.IsAssigned ? "related" : "") @(a.Closed ? "closed" : "") @(DropClass(accountNode))" style="@pad"
                 role="treeitem" tabindex="0" aria-selected="@isSel.ToString().ToLower()" data-testid="tree-account"
                 data-ob-longpress="@LongPress(accountNode)"
                 draggable="@(Draggable(accountNode) ? "true" : null)" data-ob-drag="@(Draggable(accountNode) ? "" : null)"
                 @ondragstart="() => DragStart(accountNode)" @ondragenter="() => DragEnter(accountNode)" @ondragend="DragEnd"
                 @ondragover:preventDefault="@(CanDrag != null)" @ondrop="() => DropOn(accountNode)" @ondrop:preventDefault="true"
                 @onclick="() => OnSelectAccount.InvokeAsync(accountId)"
                 @oncontextmenu="e => OpenMenu(accountNode, e)" @oncontextmenu:preventDefault="@HasMenu(accountNode)"
                 @onkeydown="e => OnAccountKeydown(e, accountNode)">
                <span class="browse-tree-name"><i class="bi @(a.IsPortfolio ? "bi-graph-up-arrow" : Account.IconForType(a.Type)) me-1" aria-hidden="true"></i>@if (IsRenaming(accountNode)) { @RenameField(accountNode) } else { <span class="browse-tree-label" title="@a.Name">@a.Name</span> }</span>
                @if (a.Balance.HasValue)
                {
                    <span class="browse-tree-amount @(a.Balance < 0 ? "text-danger" : "text-body-secondary")">
                        @Formatting.FormatMoneyDe(a.Balance.Value, a.Currency ?? "EUR")
                    </span>
                }
            </div>
        }
        else
        {
            var key = n.Key;
            bool open = !collapsed.Contains(key);
            long? groupId = key.StartsWith("g:", StringComparison.Ordinal) && long.TryParse(key[2..], NumberStyles.Integer, CultureInfo.InvariantCulture, out var gid) ? gid : null;
            bool isSel = groupId != null && SelectionKind == "accountgroup" && SelectionId == groupId;
            SidebarNode? groupNode = groupId is { } realGroup ? new SidebarNode(SidebarNodeKind.AccountGroup, realGroup, n.Name) : null;
            @* The name selects the group (all its accounts' bookings); the chevron only folds it. "Other accounts"
               is no real group, so there the whole row folds. *@
            <div class="browse-tree-row browse-tree-group @(isSel ? "selected" : "") @(DropClass(groupNode))" style="@pad"
                 role="treeitem" tabindex="0" aria-expanded="@open.ToString().ToLower()" aria-selected="@isSel.ToString().ToLower()" data-testid="tree-group"
                 data-ob-longpress="@LongPress(groupNode)"
                 draggable="@(Draggable(groupNode) ? "true" : null)" data-ob-drag="@(Draggable(groupNode) ? "" : null)"
                 @ondragstart="() => { if (groupNode != null) DragStart(groupNode); }" @ondragenter="() => DragEnter(groupNode)" @ondragend="DragEnd"
                 @ondragover:preventDefault="@(CanDrag != null)" @ondrop="() => DropOn(groupNode)" @ondrop:preventDefault="true"
                 @onclick="() => OnGroupClickAsync(groupId, key)"
                 @oncontextmenu="e => OpenMenu(groupNode, e)" @oncontextmenu:preventDefault="@HasMenu(groupNode)"
                 @onkeydown="e => OnGroupKeydown(e, groupId, key, groupNode)">
                <span class="browse-tree-name fw-semibold">
                    <button type="button" class="browse-tree-chevron" tabindex="-1" data-testid="tree-group-toggle"
                            aria-label="@(open ? L["Tree_Collapse"] : L["Tree_Expand"])"
                            @onclick="() => ToggleGroupAsync(key)" @onclick:stopPropagation="true">
                        <i class="bi @(open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                    </button>@if (groupNode != null && IsRenaming(groupNode)) { @RenameField(groupNode) } else { <span class="browse-tree-label" title="@n.Name">@n.Name</span> }
                </span>
                <span class="browse-tree-amount fw-bold" data-testid="tree-group-sum">@SumsText(n)</span>
            </div>
            @if (open)
            {
                @foreach (var child in n.Children)
                {
                    @RenderAccountNode(child, level + 1)
                }
            }
        }
    };

    private async Task OnAllKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectAll.InvokeAsync();
    }

    private async Task OnAccountKeydown(KeyboardEventArgs e, SidebarNode node)
    {
        if (await MenuKeyAsync(node, e) || await MoveKeyAsync(node, e)) return;
        if (e.Key == "Enter" || e.Key == " ") await OnSelectAccount.InvokeAsync(node.Id);
    }

    private async Task OnUncategorizedKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectUncategorized.InvokeAsync();
    }

    private async Task OnPortfolioKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ") await OnSelectPortfolio.InvokeAsync();
    }

    private async Task OnCategoryKeydown(KeyboardEventArgs e, BrowseCategoryNode node)
    {
        if (await MenuKeyAsync(SidebarNodeOf(node), e) || await MoveKeyAsync(SidebarNodeOf(node), e)) return;
        if (e.Key == "Enter" || e.Key == " ") await OnSelectCategory.InvokeAsync(node);
    }

    // NOTE: deliberately no builder.SetKey(...) on these nodes. The tree structure is stable
    // across the re-renders this page actually does (selection / period / search change classes
    // and values, not the node set), so positional diffing is correct here. A SetKey was tried and
    // removed because it caused a 500 (see commit "Fix Browse 500: drop SetKey on the recursive
    // category node") — don't reintroduce one without reproducing that crash first.
    private RenderFragment RenderCategoryNode(BrowseCategoryNode node, int level) => builder =>
    {
        bool isSelected = (SelectionKind == (node.ItemType == CategoryItemType.Category ? "category" : "group"))
                          && SelectionId == node.Id;

        builder.OpenElement(0, "div");
        var sidebarNode = SidebarNodeOf(node);
        builder.AddAttribute(1, "class", "browse-tree-row" + (isSelected ? " selected" : "") + (node.IsTracked ? " tracked" : "") + DropClass(sidebarNode));
        builder.AddAttribute(2, "role", "treeitem");
        builder.AddAttribute(3, "tabindex", "0");
        builder.AddAttribute(4, "aria-selected", isSelected ? "true" : "false");
        // FormattableString.Invariant: CSS lengths need a decimal point, but Razor's $""
        // interpolation defaults to CurrentCulture — German renders "1,5rem", which browsers
        // silently drop as invalid and the tree flattens.
        builder.AddAttribute(5, "style", FormattableString.Invariant($"padding-left: {0.5 + level * 1.0:0.##}rem;"));
        builder.AddAttribute(6, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnSelectCategory.InvokeAsync(node)));
        builder.AddAttribute(7, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnCategoryKeydown(e, node)));
        if (Draggable(sidebarNode))
        {
            builder.AddAttribute(70, "draggable", "true");
            builder.AddAttribute(71, "data-ob-drag", "");
            builder.AddAttribute(72, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => DragStart(sidebarNode)));
            builder.AddAttribute(73, "ondragenter", EventCallback.Factory.Create<DragEventArgs>(this, () => DragEnter(sidebarNode)));
            builder.AddAttribute(74, "ondragend", EventCallback.Factory.Create<DragEventArgs>(this, DragEnd));
        }
        if (CanDrag != null)
        {
            builder.AddEventPreventDefaultAttribute(75, "ondragover", true);
            builder.AddAttribute(76, "ondrop", EventCallback.Factory.Create<DragEventArgs>(this, () => DropOn(sidebarNode)));
            builder.AddEventPreventDefaultAttribute(77, "ondrop", true);
        }
        if (HasMenu(sidebarNode))
        {
            builder.AddAttribute(8, "data-ob-longpress", "");
            builder.AddAttribute(9, "data-testid", "tree-category");
            builder.AddAttribute(25, "oncontextmenu", EventCallback.Factory.Create<MouseEventArgs>(this, e => OpenMenu(sidebarNode, e)));
            builder.AddEventPreventDefaultAttribute(26, "oncontextmenu", true);
        }
        else
        {
            builder.AddAttribute(27, "data-testid", "tree-category");
        }

        builder.OpenElement(10, "span");
        builder.AddAttribute(11, "class", "browse-tree-name");
        if (CategoryColors.ToCss(node.Color) is { } dotColor)
        {
            // the same ribbon as the category picker, in the category's colour (a parsed hex value, safe to inline)
            builder.AddMarkupContent(12, $"<svg class=\"browse-color-dot browse-ribbon\" viewBox=\"0 0 12 16\" aria-hidden=\"true\" style=\"fill:{dotColor};\"><path d=\"M1 1h10v14l-5-3.6L1 15z\"/></svg>");
        }
        else
        {
            builder.OpenElement(15, "i");
            builder.AddAttribute(16, "class", node.ItemType == CategoryItemType.Group ? "bi bi-folder me-1" : "bi bi-tag me-1");
            builder.CloseElement();
        }
        if (IsRenaming(sidebarNode))
        {
            builder.AddContent(19, RenameField(sidebarNode));
        }
        else
        {
            builder.OpenElement(20, "span");
            builder.AddAttribute(21, "class", "browse-tree-label");
            builder.AddAttribute(22, "title", node.Name);
            builder.AddContent(23, node.Name);
            builder.CloseElement();
        }
        builder.CloseElement(); // span.browse-tree-name

        builder.OpenElement(30, "span");
        builder.AddAttribute(31, "class", "browse-tree-amount");
        if (node.Remaining is { } remTitle)
            builder.AddAttribute(32, "title", Formatting.FormatMoneyDe(node.IsIncome ? node.Spent : -node.Spent) + " | " + Formatting.FormatMoneyDe(remTitle));
        // Show the spent side whenever the node has any context to anchor it: either an
        // actual non-zero spent value, OR a budget pair on its right ("€0,00 | €120,00" reads
        // cleanly; a bare " | €120,00" reads as a missing value).
        bool hasBudgetContext = node.Remaining.HasValue;
        if (node.Spent != 0m || hasBudgetContext)
        {
            builder.OpenElement(42, "span");
            builder.AddAttribute(43, "class", node.IsIncome ? "text-success" : "text-danger");
            builder.AddContent(44, Formatting.FormatMoneyDe(node.IsIncome ? node.Spent : -node.Spent));
            builder.CloseElement();
        }
        if (node.Remaining is { } rem)
        {
            builder.AddContent(45, " | ");
            builder.OpenElement(46, "span");
            builder.AddAttribute(47, "class", rem < 0 ? "text-danger" : "text-success");
            builder.AddContent(48, Formatting.FormatMoneyDe(rem));
            builder.CloseElement();
        }
        builder.CloseElement(); // span.browse-tree-amount

        builder.CloseElement(); // div.browse-tree-row

        // Children rendered as siblings at the next indent level.
        foreach (var c in node.Children)
        {
            builder.AddContent(50, RenderCategoryNode(c, level + 1));
        }
    };
}
