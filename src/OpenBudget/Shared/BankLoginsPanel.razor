@inherits DataChangeAwareComponent
@using OpenBudget.Connectors
@using OpenBudget.Connectors.Sync
@using OpenBudget.Models
@using OpenBudget.Services
@inject BankLoginService Bank
@inject AccountSwitchService Switcher
@inject IStringLocalizer<OpenBudget.Pages.BankLogins> L
@inject ClockService Clock

@* The bank logins of the signed-in user: the list with each login's accounts, adding a login (with its sign-in,
   TAN or app-approval dialogs and the first sync), editing and deleting. Shown by the bank logins page and inline
   in Get started's first step. *@


@if (!Bank.IsEnabled)
{
    <div class="alert alert-warning" role="alert" id="secrets-disabled">
        <strong>@L["Disabled_Title"]</strong>
        @L["Disabled_Body_Before"]<code>OPENBUDGET_SECRETS_KEY</code>@L["Disabled_Body_After"]
        <div class="small text-body-secondary mt-1">@Bank.DisabledReason</div>
    </div>
    return;
}

@if (ShowIntro)
{
    <p class="text-body-secondary">@L["Intro"]</p>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info py-2" role="status" id="bank-message">@message</div>
}

<div class="mb-3">
    <button type="button" class="btn btn-primary" data-testid="add-login-open" @onclick="OpenAdd">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Button_AddOpen"]
    </button>
</div>

@if (logins == null)
{
    <div aria-busy="true"><div class="skeleton skeleton-line mb-2" style="width: 60%;"></div></div>
}
else if (logins.Count == 0)
{
    <div class="alert alert-secondary">@L["Empty"]</div>
}
else
{
    <div class="bank-login-list">
    @foreach (var login in logins)
    {
        var status = statuses.GetValueOrDefault(login.Id);
        var running = status is { Phase: not SyncPhase.Finished };
        var accounts = accountsByLogin.GetValueOrDefault(login.Id) ?? [];
        <div class="card bank-login-card" data-bank-login="@login.DisplayName" @key="login.Id">
            <div class="card-header bank-login-header">
                <div class="bank-login-title">
                    <h5 class="mb-1 text-break">@login.DisplayName</h5>
                    <div class="bank-login-meta small text-body-secondary">
                        <span>@login.ConnectorName</span>
                        <span aria-hidden="true">·</span>
                        <span>@L["Label_LastSync"]: <span data-testid="last-sync">@(login.LastSyncAt is { } at ? Clock.ToLocal(at).ToString("yyyy-MM-dd HH:mm") : L["Never"].Value)</span></span>
                        @if (running)
                        {
                            <span class="badge rounded-pill @(status!.Phase == SyncPhase.Running ? "bank-pill-info" : "bank-pill-warn")" data-testid="login-status">
                                @(status.Phase == SyncPhase.Running ? L["Status_Syncing"] : status.Phase == SyncPhase.WaitingForApproval ? L["Status_WaitingApproval"] : L["Status_WaitingInput"])
                            </span>
                        }
                        else if (login.CredentialsInvalid)
                        {
                            <span class="badge rounded-pill bank-pill-error" data-testid="login-status">@L["Status_ReenterCredentials"]</span>
                        }
                        else if (!string.IsNullOrEmpty(login.LastError))
                        {
                            <span class="badge rounded-pill bank-pill-error" data-testid="login-pill">@L["Pill_Error"]</span>
                        }
                        else if (!login.ConnectorAvailable)
                        {
                            <span class="badge rounded-pill bank-pill-warn" data-testid="login-pill">@L["Pill_Attention"]</span>
                        }
                        else if (login.LastSyncAt != null)
                        {
                            <span class="badge rounded-pill bank-pill-ok" data-testid="login-pill">@L["Pill_Ok"]</span>
                        }
                    </div>
                </div>
                <div class="bank-login-actions">
                    <button class="btn btn-sm btn-primary" data-action="sync-now" disabled="@running" @onclick="() => SyncNowAsync(login.Id)">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> @L["Button_SyncNow"]
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-action="edit" @onclick="() => OpenEdit(login)">@L["Button_Edit"]</button>
                    <button class="btn btn-sm btn-outline-danger" data-action="delete" @onclick="() => pendingDelete = login">@L["Button_Delete"]</button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3 small align-items-end">
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1" for="@($"interval-{login.Id}")">@L["Field_Interval"]</label>
                        <select id="@($"interval-{login.Id}")" class="form-select form-select-sm" value="@login.RefreshInterval"
                                @onchange="e => SetIntervalAsync(login, e.Value?.ToString())">
                            @foreach (var i in Enum.GetValues<RefreshInterval>())
                            {
                                <option value="@i" selected="@(i == login.RefreshInterval)">@IntervalLabel(i)</option>
                            }
                        </select>
                    </div>
                    @if (running)
                    {
                        <div class="col-sm-6 col-md-8">
                            @if (!string.IsNullOrEmpty(status!.Message))
                            {
                                <div class="text-body-secondary">@status.Message…</div>
                            }
                            @if (status is { Phase: SyncPhase.WaitingForInput or SyncPhase.WaitingForApproval })
                            {
                                <div class="text-primary">@L["Hint_Challenge"]</div>
                            }
                        </div>
                    }
                </div>

                @if (!running && !string.IsNullOrEmpty(login.LastError))
                {
                    <div class="alert alert-danger py-2" role="alert" data-testid="login-error">
                        @(login.CredentialsInvalid ? L["Error_Credentials"].Value + " " : "")@login.LastError
                    </div>
                }
                @if (!login.ConnectorAvailable)
                {
                    <div class="alert alert-warning py-2">@L["Error_ConnectorMissing", login.ConnectorType]</div>
                }

                <h6 class="bank-accounts-heading">@L["Accounts_Heading"]</h6>
                @if (accounts.Count == 0)
                {
                    <p class="text-body-secondary small">@L["Accounts_Empty"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 bank-accounts-table">
                            <thead>
                                <tr>
                                    <th>@L["Table_Account"]</th>
                                    <th>@L["Table_Link"]</th>
                                    <th>@L["Table_Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in accounts)
                                {
                                    <tr data-bank-account="@a.RemoteId" @key="a.Id">
                                        <td>
                                            <strong>@a.Name</strong>
                                            @if (a.Closed) { <span class="badge text-bg-secondary ms-1">@L["Badge_Closed"]</span> }
                                            <div class="small text-body-secondary">@TypeLabel(a.Type) @(string.IsNullOrEmpty(a.Iban) ? "" : "· " + a.Iban)</div>
                                        </td>
                                        <td>
                                            @if (a.LinkedAccountId != null)
                                            {
                                                <span data-testid="linked-to"><i class="bi bi-link-45deg" aria-hidden="true"></i> @(a.LinkedAccountName ?? "?")</span>
                                                <button class="btn btn-sm btn-outline-secondary ms-2" data-action="unlink" @onclick="() => UnlinkAsync(a.Id)">@L["Button_Unlink"]</button>
                                            }
                                            else if (!a.Closed)
                                            {
                                                var candidates = candidatesByAccount.GetValueOrDefault(a.Id) ?? [];
                                                <div class="d-flex flex-wrap gap-1">
                                                    <select class="form-select form-select-sm w-auto" aria-label="@L["Link_Choose"]"
                                                            @onchange="e => SetChoice(a.Id, e.Value)">
                                                        <option value="">@L["Link_Choose"]</option>
                                                        @foreach (var c in candidates)
                                                        {
                                                            <option value="@c.AccountId" selected="@(ChosenCandidate(a.Id, candidates) == c.AccountId.ToString())">@c.Name@(c.SuggestedFor ? " ★" : "")</option>
                                                        }
                                                    </select>
                                                    <button class="btn btn-sm btn-outline-primary" data-action="link"
                                                            disabled="@string.IsNullOrEmpty(ChosenCandidate(a.Id, candidates))"
                                                            @onclick="() => LinkAsync(a.Id, ChosenCandidate(a.Id, candidates))">@L["Button_Link"]</button>
                                                    <button class="btn btn-sm btn-outline-success" data-action="create" @onclick="() => CreateAccountAsync(a.Id)">@L["Button_CreateAccount"]</button>
                                                </div>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (a.LastSuccessAt is { } ok)
                                            {
                                                <div class="text-body-secondary">@L["Label_LastSync"]: @Clock.ToLocal(ok).ToString("yyyy-MM-dd HH:mm")</div>
                                            }
                                            @if (!string.IsNullOrEmpty(a.LastError))
                                            {
                                                <div class="text-danger">@a.LastError</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    }
    </div>
}

<Modal Show="@adding" Title="@L["Add_Heading"]" SizeClass="modal-lg" OnClose="@(() => adding = false)">
    <ChildContent>
        <form class="row g-2" id="new-login-form" @onsubmit="AddLoginAsync" @onsubmit:preventDefault>
                <div class="col-sm-6">
                    <label class="form-label" for="new-login-connector">@L["Field_Connector"]</label>
                    <select id="new-login-connector" class="form-select" @bind="newConnector">
                        @foreach (var c in connectors)
                        {
                            <option value="@c.ConnectorType">@c.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="new-login-name">@L["Field_Name"]</label>
                    <input id="new-login-name" class="form-control" @bind="newName" maxlength="200" />
                </div>
                @if (NeedsCredentials(SelectedConnector))
                {
                <div class="col-sm-6">
                    <label class="form-label" for="new-login-username">@L["Field_Username"]</label>
                    <input id="new-login-username" class="form-control" @bind="newUsername" @bind:event="oninput" autocomplete="off" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="new-login-pin">@L["Field_Pin"]</label>
                    <input id="new-login-pin" type="password" class="form-control" @bind="newPin" @bind:event="oninput" autocomplete="new-password" />
                </div>
                @foreach (var field in SelectedConnector?.ExtraCredentials ?? [])
                {
                <div class="col-sm-6">
                    <label class="form-label" for="@("new-login-extra-" + field.Key)">@ExtraLabel(SelectedConnector!, field)</label>
                    <input id="@("new-login-extra-" + field.Key)" type="password" class="form-control" autocomplete="off"
                           value="@newExtra.GetValueOrDefault(field.Key)" @oninput="e => newExtra[field.Key] = e.Value?.ToString() ?? string.Empty" />
                </div>
                }
                }
                <div class="col-sm-6">
                    <label class="form-label" for="new-login-interval">@L["Field_Interval"]</label>
                    <select id="new-login-interval" class="form-select" @bind="newInterval">
                        @foreach (var i in Enum.GetValues<RefreshInterval>())
                        {
                            <option value="@i">@IntervalLabel(i)</option>
                        }
                    </select>
                </div>
                @if (SelectedConnector is { } sel)
                {
                    <div class="col-12 small text-body-secondary">@ConnectorDescription(sel)</div>
                }
                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="col-12 text-danger small" role="alert">@addError</div>
                }
            </form>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => adding = false">@L["Button_Cancel"]</button>
        <button type="submit" form="new-login-form" class="btn btn-primary text-nowrap" id="new-login-add"
                disabled="@(NeedsCredentials(SelectedConnector) && (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrEmpty(newPin)))">@L["Button_Add"]</button>
    </Footer>
</Modal>


<Modal Show="@(editing != null)" Title="@L["Edit_Title"]" OnClose="@(() => editing = null)">
    <ChildContent>
        @if (editing != null)
        {
            <div class="mb-2">
                <label class="form-label" for="edit-name">@L["Field_Name"]</label>
                <input id="edit-name" class="form-control" @bind="editName" maxlength="200" />
            </div>
            @if (NeedsCredentials(connectors.FirstOrDefault(c => c.ConnectorType == editing.ConnectorType)))
            {
                <div class="mb-2">
                    <label class="form-label" for="edit-username">@L["Field_Username"]</label>
                    <input id="edit-username" class="form-control" @bind="editUsername" autocomplete="off" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="edit-pin">@L["Field_PinKeep"]</label>
                    <input id="edit-pin" type="password" class="form-control" @bind="editPin" autocomplete="new-password" />
                </div>
                @foreach (var field in EditingConnector?.ExtraCredentials ?? [])
                {
                    var stored = editing.StoredExtraCredentials?.Contains(field.Key) == true;
                    <div class="mb-2">
                        <label class="form-label" for="@("edit-extra-" + field.Key)">@ExtraLabel(EditingConnector!, field)@(stored ? " " + L["Field_ExtraKeep"].Value : "")</label>
                        <input id="@("edit-extra-" + field.Key)" type="password" class="form-control" autocomplete="off"
                               disabled="@editExtraRemove.Contains(field.Key)"
                               value="@editExtra.GetValueOrDefault(field.Key)" @oninput="e => editExtra[field.Key] = e.Value?.ToString() ?? string.Empty" />
                        @if (stored)
                        {
                            <div class="form-check mt-1">
                                <input id="@("edit-extra-remove-" + field.Key)" type="checkbox" class="form-check-input" checked="@editExtraRemove.Contains(field.Key)"
                                       @onchange="e => ToggleExtraRemove(field.Key, e.Value is true)" />
                                <label class="form-check-label small" for="@("edit-extra-remove-" + field.Key)">@L["Field_ExtraRemove"]</label>
                            </div>
                        }
                    </div>
                }
            }
            <div class="mb-2">
                <label class="form-label" for="edit-interval">@L["Field_Interval"]</label>
                <select id="edit-interval" class="form-select" @bind="editInterval">
                    @foreach (var i in Enum.GetValues<RefreshInterval>())
                    {
                        <option value="@i">@IntervalLabel(i)</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(editError)) { <div class="text-danger small">@editError</div> }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => editing = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" id="edit-save" @onclick="SaveEditAsync">@L["Button_Save"]</button>
    </Footer>
</Modal>

<Modal Show="@(pendingDelete != null)" Title="@(pendingDelete != null ? L["Delete_Title", pendingDelete.DisplayName].Value : "")"
       OnClose="@(() => pendingDelete = null)">
    <ChildContent>
        <p>@L["Delete_Body"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingDelete = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" id="delete-confirm" @onclick="DeleteConfirmedAsync">@L["Button_Delete"]</button>
    </Footer>
</Modal>


@code {
    /// <summary>Whether the intro sentence shows (Get started has its own line instead).</summary>
    [Parameter] public bool ShowIntro { get; set; } = true;

    private List<BankLoginView>? logins;
    private IReadOnlyList<ConnectorRegistration> connectors = [];
    private readonly Dictionary<int, List<BankLoginAccountView>> accountsByLogin = new();
    private readonly Dictionary<int, List<LinkCandidate>> candidatesByAccount = new();
    private readonly Dictionary<int, string> linkChoice = new();
    private Dictionary<int, BankSyncStatus> statuses = new();

    private string newConnector = "";
    private string newName = "";
    private string newUsername = "";
    private string newPin = "";
    private Dictionary<string, string> newExtra = new(StringComparer.Ordinal);
    private Dictionary<string, string> editExtra = new(StringComparer.Ordinal);
    private HashSet<string> editExtraRemove = new(StringComparer.Ordinal);
    private RefreshInterval newInterval = RefreshInterval.EveryTwoHours;
    private string? addError;
    private bool adding;
    private string? message;

    private BankLoginView? editing;
    private string editName = "";
    private string editUsername = "";
    private string editPin = "";
    private RefreshInterval editInterval;
    private string? editError;
    private BankLoginView? pendingDelete;

    private static bool NeedsCredentials(ConnectorRegistration? c) => c == null || c.Credentials != CredentialRequirement.None;

    private ConnectorRegistration? EditingConnector => editing == null ? null : connectors.FirstOrDefault(c => c.ConnectorType == editing.ConnectorType);

    private void ToggleExtraRemove(string key, bool remove)
    {
        if (remove) editExtraRemove.Add(key);
        else editExtraRemove.Remove(key);
    }

    /// <summary>An extra credential field's label in the UI language when translated (CredentialField_&lt;type&gt;_&lt;key&gt;).</summary>
    private string ExtraLabel(ConnectorRegistration c, CredentialField field) =>
        L["CredentialField_" + c.ConnectorType + "_" + field.Key] is { ResourceNotFound: false } s ? s.Value : field.Label;

    /// <summary>The connector's description in the UI language when translated (ConnectorDescription_&lt;type&gt;), else its built-in English text.</summary>
    private string ConnectorDescription(ConnectorRegistration c) =>
        L["ConnectorDescription_" + c.ConnectorType] is { ResourceNotFound: false } s ? s.Value : c.Description;

    private ConnectorRegistration? SelectedConnector => connectors.FirstOrDefault(c => c.ConnectorType == newConnector);

    /// <summary>?edit={loginId}: opens that login's edit dialog once the list is loaded.</summary>
    [SupplyParameterFromQuery(Name = "edit")] public int? EditLoginId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        connectors = Bank.GetConnectors();
        newConnector = connectors.FirstOrDefault()?.ConnectorType ?? "";
        await LoadAsync();
        if (EditLoginId is { } editId && logins?.FirstOrDefault(l => l.Id == editId) is { } toEdit) OpenEdit(toEdit);
    }

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.BankSync or DataArea.ImportState or DataArea.ImportedData;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (!Bank.IsEnabled) return;
        logins = await Bank.GetLoginsAsync();
        statuses = (await Bank.GetStatusesAsync()).ToDictionary(s => s.LoginId);
        accountsByLogin.Clear();
        candidatesByAccount.Clear();
        foreach (var login in logins)
        {
            var accounts = await Bank.GetAccountsAsync(login.Id);
            accountsByLogin[login.Id] = accounts;
            foreach (var a in accounts.Where(a => a.LinkedAccountId == null && !a.Closed))
                candidatesByAccount[a.Id] = await Bank.GetLinkCandidatesAsync(a.Id);
        }
    }

    private string? ChosenCandidate(int loginAccountId, List<LinkCandidate> candidates)
    {
        if (linkChoice.TryGetValue(loginAccountId, out var chosen)) return string.IsNullOrEmpty(chosen) ? null : chosen;
        return candidates.FirstOrDefault(c => c.SuggestedFor)?.AccountId.ToString();
    }

    private void SetChoice(int loginAccountId, object? value) => linkChoice[loginAccountId] = value?.ToString() ?? "";

    private string IntervalLabel(RefreshInterval i) => L[$"Interval_{i}"].Value;
    private string TypeLabel(RemoteAccountType t) => L[$"Type_{t}"].Value;

    private async Task<bool> RunAsync(Func<Task> action)
    {
        message = null;
        try
        {
            await action();
            return true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or AccessDeniedException)
        {
            message = ex.Message;
            return false;
        }
        finally
        {
            await LoadAsync();
        }
    }

    private void OpenAdd()
    {
        addError = null;
        adding = true;
    }

    private async Task AddLoginAsync()
    {
        addError = null;
        try
        {
            var created = await Bank.CreateLoginAsync(newConnector, newName, newUsername, newPin, newInterval, newExtra);
            newName = "";
            newUsername = "";
            newPin = "";
            newExtra = new(StringComparer.Ordinal);
            adding = false;
            // Start a first sync right away so the bank's accounts get listed (and any challenge shows up).
            await Bank.SyncNowAsync(created.Id);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or AccessDeniedException)
        {
            addError = ex.Message;
        }
        await LoadAsync();
    }

    private async Task SyncNowAsync(int id)
    {
        var result = await Bank.SyncNowAsync(id);
        if (result == StartResult.AlreadyRunning) message = L["Message_AlreadyRunning"].Value;
        await LoadAsync();
    }


    private Task SetIntervalAsync(BankLoginView login, string? value) =>
        RunAsync(() => Enum.TryParse<RefreshInterval>(value, out var i)
            ? Bank.UpdateLoginAsync(login.Id, login.DisplayName, i)
            : Task.CompletedTask);

    private void OpenEdit(BankLoginView login)
    {
        editing = login;
        editName = login.DisplayName;
        editUsername = login.Username ?? "";
        editPin = "";
        editExtra = new(StringComparer.Ordinal);
        editExtraRemove = new(StringComparer.Ordinal);
        editInterval = login.RefreshInterval;
        editError = null;
    }

    private async Task SaveEditAsync()
    {
        if (editing == null) return;
        editError = null;
        try
        {
            // only entered values and removals travel: an untouched field keeps what is stored
            var extra = editExtra.Where(e => !string.IsNullOrWhiteSpace(e.Value) && !editExtraRemove.Contains(e.Key))
                .Concat(editExtraRemove.Select(k => KeyValuePair.Create(k, "")))
                .ToDictionary(StringComparer.Ordinal);
            await Bank.UpdateLoginAsync(editing.Id, editName, editInterval, editUsername, editPin, extra);
            editing = null;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or AccessDeniedException)
        {
            editError = ex.Message;
        }
        await LoadAsync();
    }

    private async Task DeleteConfirmedAsync()
    {
        if (pendingDelete == null) return;
        var id = pendingDelete.Id;
        pendingDelete = null;
        await RunAsync(() => Bank.DeleteLoginAsync(id));
    }

    private Task LinkAsync(int loginAccountId, string? accountId) =>
        RunAsync(() => long.TryParse(accountId, out var id) ? Bank.LinkAsync(loginAccountId, id) : Task.CompletedTask);

    private Task CreateAccountAsync(int loginAccountId) => RunAsync(() => Bank.CreateAccountAsync(loginAccountId));

    private Task UnlinkAsync(int loginAccountId) => RunAsync(() => Bank.UnlinkAsync(loginAccountId));
}
