@using OpenBudget.Services
@inject CurrentProjectState Current
@inject BankLoginService BankLogins
@inject OpenBudget.Assist.AssistSettingsService Assist
@inject ProjectService Projects
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SettingsNav> L

@* The left list of the app-level settings pages (account, connections, Portfolio Performance, documents, Assist,
   about), headed by the way
   back to the project the user came from. Rendered by SettingsShell on the Blazor pages and statically by the
   account page's layout, so it uses plain links only. Without a known project the back link opens "/", which
   picks the last project. *@

<nav class="settings-nav" aria-label="@L["Aria_Nav"]" data-testid="settings-nav">
    <a class="settings-nav-back" href="@BackHref" data-testid="settings-back">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span class="text-truncate">@BackLabel</span>
    </a>
    <div class="settings-nav-heading">@L["Heading"]</div>
    @Item("account", "/Account", "bi-person", L["Item_Account"], forceLoad: true)
    @Item("connections", "/connections", "bi-bank", L["Item_BankLogins"], badge: needsYou ? L["Badge_NeedsYou"].Value : null)
    @Item("portfolio-performance", "/portfolio-performance", "bi-pie-chart", L["Item_PortfolioPerformance"])
    @Item("documents", "/documents/assign", "bi-folder-symlink", L["Item_Documents"])
    @Item("receipts", "/receipts", "bi-receipt", L["Item_Receipts"])
    @if (Assist.Available)
    {
        @Item("assist", "/assist", "bi-stars", L["Item_Assist"])
    }
    @Item("about", "/about", "bi-info-circle", L["Item_About"])
</nav>

@code {
    /// <summary>The highlighted section: "account", "connections", "portfolio-performance", "documents", "receipts", "assist" or "about".</summary>
    [Parameter] public string? Active { get; set; }

    private bool needsYou;
    // the project to go back to when the page was opened by a full page load (the account page, a fresh tab):
    // the last one the user had open (the ob.lastProject cookie)
    private (int Id, string Name)? lastProject;

    protected override async Task OnInitializedAsync()
    {
        needsYou = BankLogins.IsEnabled && await BankLogins.AnyNeedsManualSyncAsync();
        if (Current.ProjectId == null
            && HttpContextAccessor.HttpContext?.Request.Cookies["ob.lastProject"] is { } raw
            && int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)
            && await Projects.GetProjectAsync(id) is { } project)
            lastProject = (project.Id, project.Name);
    }

    private string BackHref => (Current.ProjectId ?? lastProject?.Id) is { } id ? $"/projects/{id}/browse" : "/";
    private string BackLabel => (Current.ProjectName ?? lastProject?.Name) is { Length: > 0 } name ? L["Back_Project", name] : L["Back_Projects"];

    private RenderFragment Item(string key, string href, string icon, string label, bool forceLoad = false, string? badge = null) => __builder =>
    {
        var active = Active == key;
        <a class="shell-view @(active ? "active" : "")" href="@href" aria-current="@(active ? "page" : null)"
           data-testid="@($"settings-nav-{key}")" target="@(forceLoad ? "_top" : null)">
            <i class="bi @icon" aria-hidden="true"></i>
            <span class="shell-view-label">@label</span>
            @if (badge != null)
            {
                <span class="badge rounded-pill text-bg-warning ms-auto" title="@badge" data-testid="banklogins-needs-you"><i class="bi bi-exclamation" aria-hidden="true"></i><span class="visually-hidden">@badge</span></span>
            }
        </a>
    };
}
