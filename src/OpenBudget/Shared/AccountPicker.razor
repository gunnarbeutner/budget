@inject IJSRuntime JS
@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<AccountPicker> L

@* Dropdown picker for one of the user's accounts: a button naming the current choice opens a searchable TreePicker
   with the suggested accounts first, then the accounts in their groups as the sidebar orders them, then the open
   accounts of other users shared with this one, then the closed accounts in their own section. With AllowNone, a "none" entry (NoneLabel) picks null. *@

<div class="account-picker" @attributes="AdditionalAttributes">
    <button type="button" @ref="toggle" class="form-select form-select-sm text-start account-picker-toggle" aria-label="@AriaLabel"
            aria-expanded="@(open ? "true" : "false")" data-testid="account-picker-toggle" @onclick="Toggle">
        @CurrentLabel()
    </button>
    @if (open)
    {
        <div class="account-picker-backdrop" @onclick="Close"></div>
        <div class="account-picker-panel" @ref="panel" style="visibility: hidden" role="dialog" aria-label="@AriaLabel" data-testid="account-picker" @onkeydown="OnKeyDown">
            <input type="search" class="form-control form-control-sm mb-2" autocomplete="off" @ref="search"
                   placeholder="@L["Search_Placeholder"]" aria-label="@L["Search_Placeholder"]" data-testid="account-picker-search"
                   value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" />
            @{ var nodes = BuildNodes(); }
            @if (nodes.All(n => !n.Selectable))
            {
                <div class="text-body-secondary small px-1" data-testid="account-picker-empty">@L["NoMatch"]</div>
            }
            else
            {
                <TreePicker TId="long" Nodes="@nodes" SelectedId="@(SelectedId ?? NoneId)" SelectedIdChanged="PickAsync" />
            }
        </div>
    }
</div>

@code {
    /// <summary>An account that can be picked.</summary>
    public sealed record Option(long Id, string Name, long? GroupId, long? Sort, string? Icon, bool Suggested, bool Closed, bool Shared = false);

    [Parameter, EditorRequired] public IReadOnlyList<Option> Options { get; set; } = [];
    [Parameter] public IReadOnlyList<AccountGroupInfo> Groups { get; set; } = [];
    [Parameter] public long? SelectedId { get; set; }
    [Parameter] public EventCallback<long?> OnPick { get; set; }
    [Parameter] public bool AllowNone { get; set; } = true;
    [Parameter] public string? NoneLabel { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // TreePicker ids: accounts are positive; 0 is "none"; headers count down from -1 (never selectable).
    private const long NoneId = 0;
    private bool open;
    private bool focusPending;
    private ElementReference search, toggle, panel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!open) return;
        // Fixed in the window under the button (like the category picker), its list scrolling inside.
        await JS.TryInvokeVoidAsync("obPlacePickerUnder", panel, toggle);
        if (!focusPending) return;
        focusPending = false;
        await JS.TryInvokeVoidAsync("obFocus", search);
    }
    private string query = "";

    private string NoneText => NoneLabel ?? L["None"];

    private string CurrentLabel()
    {
        if (SelectedId is not { } id) return NoneText;
        var o = Options.FirstOrDefault(o => o.Id == id);
        return o == null ? NoneText : o.Closed ? $"{o.Name} {L["ClosedSuffix"]}" : o.Name;
    }

    private void Toggle()
    {
        open = !open;
        focusPending = open;
        query = "";
    }

    private void Close() => open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private async Task PickAsync(long id)
    {
        open = false;
        await OnPick.InvokeAsync(id == NoneId ? null : id);
    }

    private List<TreePickerNode<long>> BuildNodes()
    {
        var nodes = new List<TreePickerNode<long>>();
        long header = 0;
        void Header(int level, string label, string? icon = null) => nodes.Add(new TreePickerNode<long>(--header, level, false, label, icon));
        void Leaf(Option o, int level) => nodes.Add(new TreePickerNode<long>(o.Id, level, true, o.Name, o.Icon ?? "bi-bank"));

        var q = query.Trim();
        var hits = q.Length == 0 ? Options : Options.Where(o => SearchText.Matches(o.Name, q)).ToList();

        if (q.Length == 0)
        {
            var suggested = hits.Where(o => o.Suggested).ToList();
            if (suggested.Count > 0)
            {
                Header(0, L["Suggested"], "bi-star-fill");
                foreach (var o in suggested) Leaf(o, 1);
            }
            if (AllowNone) nodes.Add(new TreePickerNode<long>(NoneId, 0, true, NoneText, "bi-dash-circle"));
        }

        var byId = hits.ToDictionary(o => o.Id);
        var openAccounts = hits.Where(o => !o.Closed && !o.Shared)
            .Select(o => new BrowseAccountNode { Id = o.Id, Name = o.Name, GroupId = o.GroupId, Sort = o.Sort }).ToList();
        void Walk(IEnumerable<AccountTreeNode> tree, int level)
        {
            foreach (var n in tree)
            {
                if (n.Account is { } a) Leaf(byId[a.Id], level);
                else
                {
                    Header(level, n.Name, n.GroupIcon);
                    Walk(n.Children, level + 1);
                }
            }
        }
        Walk(AccountTreeBuilder.Build(openAccounts, Groups, L["OtherAccounts"]), 0);

        var shared = hits.Where(o => o.Shared && !o.Closed).OrderBy(o => o.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (shared.Count > 0)
        {
            Header(0, L["SharedAccounts"], "bi-people");
            foreach (var o in shared) Leaf(o, 1);
        }

        var closed = hits.Where(o => o.Closed).OrderBy(o => o.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (closed.Count > 0)
        {
            Header(0, L["ClosedAccounts"], "bi-archive");
            foreach (var o in closed) Leaf(o, 1);
        }
        return nodes;
    }
}
