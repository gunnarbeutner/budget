@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L

<PageTitle>OpenBudget</PageTitle>

@* App chrome: one 44px top bar for every page — wordmark, the project switcher (which replaced the start page),
   the bank-sync status, the gear (project settings and data sources) and the account menu. There are no tabs:
   a project's views live in its sidebar (ProjectShell). Page toolbars (period navigation, filters) follow in the body. *@
<header class="app-topbar d-print-none" data-testid="app-topbar">
    <a href="/" class="app-wordmark" title="@L["Home"]">OpenBudget</a>
    <ProjectSwitcher />
    <div class="flex-grow-1"></div>
    <BankSyncHost />
    <GearMenu />
    <UserMenu />
</header>

<div class="page-horizontal">
    <main class="main-content">
        <article class="content px-3">
            @Body
        </article>
    </main>
</div>
