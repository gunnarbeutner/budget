@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> L
@inject IJSRuntime JS
@inject OpenBudget.Services.GetStartedGate GetStarted

<PageTitle>OpenBudget</PageTitle>

@* App chrome: one 44px top bar for every page — wordmark, the project switcher (which replaced the start page),
   the period selector of the views that have one (PeriodNav renders into the outlet; on phones it takes a second
   row), the search field of the views with a transaction list (rendered into its outlet), the bank-sync status and the account menu (settings, sign-out). There are no tabs:
   a project's views live in its sidebar (ProjectShell). Page toolbars (filters, actions) follow in the body. While
   the user is held in Get started (GetStartedGate) only the wordmark, the sync status and the account menu show. *@
<header class="app-topbar d-print-none" data-testid="app-topbar">
    <a href="/" class="app-wordmark">OpenBudget</a>
    @if (!GetStarted.Captive)
    {
        <ProjectSwitcher />
    }
    <div class="app-topbar-period" data-testid="topbar-period">
        <SectionOutlet SectionName="@PeriodNav.SectionName" />
    </div>
    <div class="flex-grow-1"></div>
    <div class="app-topbar-search" data-testid="topbar-search">
        <SectionOutlet SectionName="@SearchSectionName" />
    </div>
    <BankSyncHost />
    <CloudFileSyncHost />
    <UserMenu />
</header>

<div class="page-horizontal">
    <main class="main-content">
        <article class="content px-3">
            @Body
        </article>
    </main>
</div>

@code {
    /// <summary>The top bar's search slot: views with a transaction list render their search field into it.</summary>
    public const string SearchSectionName = "topbar-search";

    // Marks the document once the circuit has rendered interactively (OnAfterRender never runs while
    // prerendering). Until then the page is the static prerender, which the first interactive render replaces:
    // input typed or a <details> opened before that is lost. The E2E tests wait for this mark after a page load.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("obNav.markInteractive"); }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }
}
