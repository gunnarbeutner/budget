@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<ProjectAccountsCard> L
@inject ClockService Clock

@* Project-settings panel: imported accounts funding this project, whether each counts in the
   cashflow, which bookings count (Shared = project categories, Exclusive = all), refresh
   freshness, and an Add dialog backed by a grouped TreePicker.
   Presentational — the page owns the data (Assignments/AllAccounts/AllAccountGroups) and the
   service calls; this raises OnAdd / OnRemove / OnScopeChange / OnInCashflowChange. *@

<div class="row mt-4">
    <div class="col-12">
        <div class="card" data-testid="accounts-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@L["Accounts_Heading"]</h5>
                <button class="btn btn-sm btn-primary" @onclick="OpenDialog">@L["Button_AddAccount"]</button>
            </div>
            <div class="card-body">
                <p class="text-body-secondary small mb-3">@L["Accounts_Intro"]</p>
                @if (Assignments == null || AllAccounts == null)
                {
                    <p class="text-body-secondary mb-0"><em>@L["Status_LoadingEllipsis"]</em></p>
                }
                else if (!Assignments.Any())
                {
                    <p class="text-body-secondary mb-0">@L["Accounts_Empty"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 text-nowrap align-middle">
                            <thead>
                                <tr>
                                    <th>@L["Table_Account"]</th>
                                    <th>@L["Table_Kind"]</th>
                                    <th class="text-end">@L["Table_CurrentBalance"]</th>
                                    <th>@L["Table_LastRefresh"]</th>
                                    <th>@L["Table_InCashflow"]</th>
                                    <th>@L["Table_Scope"]</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Closed accounts follow the open ones. *@
                                @foreach (var assignment in Assignments.OrderBy(a => AllAccounts.FirstOrDefault(x => x.Id == a.AccountId)?.Closed == true))
                                {
                                    var account = AllAccounts.FirstOrDefault(a => a.Id == assignment.AccountId);
                                    var name = account?.Name ?? L["Account_MissingName", assignment.AccountId].Value;
                                    var kind = account?.KindLabel ?? L["Dash"].Value;
                                    var balance = account?.CurrentBalance;
                                    var currency = account?.Currency ?? "";
                                    var lastRefresh = account?.LastRefreshUtc;
                                    var refreshAge = lastRefresh.HasValue ? DateTime.UtcNow - lastRefresh.Value : (TimeSpan?)null;
                                    var refreshError = account?.Error;
                                    <tr @key="assignment.AccountId">
                                        <td>
                                            @name
                                            @if (account != null && account.Provider != AccountProviders.MoneyMoney)
                                            {
                                                <a href="@($"/accounts/{account.Id}/statements")" class="small ms-2" title="@L["Statements_Link"]"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @L["Statements_Link"]</a>
                                            }
                                        </td>
                                        <td><span class="badge bg-secondary">@kind</span></td>
                                        <td class="text-end">@(balance.HasValue ? Formatting.FormatMoneyDe(balance.Value, currency) : L["Dash"].Value)</td>
                                        <td>
                                            @if (refreshAge.HasValue)
                                            {
                                                var refreshClass = refreshAge.Value.TotalDays > 7 ? "text-danger fw-semibold"
                                                    : refreshAge.Value.TotalHours > 36 ? "text-warning fw-semibold"
                                                    : "text-body-secondary";
                                                <span class="small @refreshClass" title="@(Clock.ToLocal(lastRefresh!.Value).ToString("yyyy-MM-dd HH:mm"))">@Formatting.FormatRelativeAge(refreshAge.Value, L)</span>
                                            }
                                            else
                                            {
                                                <span class="small text-body-secondary">@L["Refresh_Manual"]</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(refreshError))
                                            {
                                                <span class="badge bg-danger ms-1" title="@refreshError">@L["Refresh_Error"]</span>
                                            }
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input" data-testid="in-cashflow"
                                                   aria-label="@L["Table_InCashflow"]" title="@L["InCashflow_Help"]"
                                                   checked="@assignment.InCashflow"
                                                   @onchange="e => OnInCashflowChange.InvokeAsync((assignment.AccountId, e.Value is true))" />
                                        </td>
                                        <td>
                                            <div class="segmented" role="group" title="@L["Scope_Help"]">
                                                <button type="button"
                                                        class="btn @(assignment.Scope == AccountScope.Shared ? "active" : "")"
                                                        @onclick="() => OnScopeChange.InvokeAsync((assignment.AccountId, AccountScope.Shared))">
                                                    @L["Scope_Shared"]
                                                </button>
                                                <button type="button"
                                                        class="btn @(assignment.Scope == AccountScope.Exclusive ? "active" : "")"
                                                        @onclick="() => OnScopeChange.InvokeAsync((assignment.AccountId, AccountScope.Exclusive))">
                                                    @L["Scope_Exclusive"]
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            @if (pendingRemove == assignment.AccountId)
                                            {
                                                <span class="small me-1">@L["Remove_Confirm"]</span>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 me-2" data-testid="account-remove-confirm"
                                                        @onclick="() => RemoveAsync(assignment.AccountId)">@L["Button_Remove"]</button>
                                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => pendingRemove = null">@L["Button_Cancel"]</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-body-secondary p-0" data-testid="account-remove"
                                                        title="@L["Button_Remove"]" aria-label="@L["Button_Remove"]" @onclick="() => pendingRemove = assignment.AccountId">
                                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<Modal Show="@_showDialog" Title="@L["Modal_AddAccount_Title"]" SizeClass="modal-lg" OnClose="CloseDialog">
    <ChildContent>
        @if (AllAccounts == null || Assignments == null || AllAccountGroups == null)
        {
            <p><em>@L["Status_LoadingAccounts"]</em></p>
        }
        else
        {
            var assignedIds = Assignments.Select(a => a.AccountId).ToHashSet();
            if (AllAccounts.All(a => assignedIds.Contains(a.Id)))
            {
                <p class="text-body-secondary mb-0">@L["AddAccount_AllAssigned"]</p>
            }
            else
            {
                var rows = BuildPickerRows(AllAccountGroups, AllAccounts, _filter);
                <div class="mb-3">
                    <label class="form-label" for="addAccountFilter">@L["Form_AccountsLabel"]</label>
                    <input type="search" id="addAccountFilter" class="form-control form-control-sm mb-2"
                           data-testid="add-account-filter"
                           placeholder="@L["AddAccount_FilterPlaceholder"]"
                           value="@_filter"
                           @oninput="@(e => _filter = e.Value?.ToString() ?? "")" />
                    <div class="account-picker" data-testid="add-account-picker">
                        @if (rows.Count == 0)
                        {
                            <p class="text-body-secondary small m-2">@L["AddAccount_NoMatches"]</p>
                        }
                        @foreach (var row in rows)
                        {
                            var depthRem = (0.75 + row.Level * 1.25).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                            if (row.IsGroup)
                            {
                                var selectable = row.AccountIds.Where(id => !assignedIds.Contains(id)).ToList();
                                var count = selectable.Count(_selected.Contains);
                                var state = count == 0 ? "false" : count == selectable.Count ? "true" : "mixed";
                                var icon = state == "true" ? "bi-check-square-fill" : state == "mixed" ? "bi-dash-square-fill" : "bi-square";
                                <button type="button" class="account-picker-row group" role="checkbox" aria-checked="@state"
                                        data-testid="add-account-group"
                                        style="@($"padding-left: {depthRem}rem;")"
                                        disabled="@(selectable.Count == 0)"
                                        @onclick="@(() => ToggleGroup(selectable))">
                                    <i class="bi @icon account-picker-check" aria-hidden="true"></i>
                                    <i class="bi @row.Icon account-picker-icon" style="@AccountIcons.TintStyle(row.Color)" aria-hidden="true"></i>
                                    <span class="account-picker-label">@row.Label</span>
                                </button>
                            }
                            else
                            {
                                var added = assignedIds.Contains(row.Id);
                                var isChecked = added || _selected.Contains(row.Id);
                                <button type="button" class="account-picker-row @(isChecked && !added ? "checked" : "")" role="checkbox"
                                        aria-checked="@(isChecked ? "true" : "false")"
                                        data-testid="add-account-option"
                                        style="@($"padding-left: {depthRem}rem;")"
                                        disabled="@added"
                                        @onclick="@(() => ToggleAccount(row.Id))">
                                    <i class="bi @(added ? "bi-check-square" : isChecked ? "bi-check-square-fill" : "bi-square") account-picker-check" aria-hidden="true"></i>
                                    @if (!string.IsNullOrEmpty(row.Icon))
                                    {
                                        <i class="bi @row.Icon account-picker-icon" style="@AccountIcons.TintStyle(row.Color)" aria-hidden="true"></i>
                                    }
                                    <span class="account-picker-label">@row.Label</span>
                                    @if (added)
                                    {
                                        <span class="badge text-bg-light ms-2">@L["AddAccount_AlreadyAdded"]</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Form_ScopeLabel"]</label>
                    <div class="segmented segmented-block" role="group">
                        <input type="radio" class="btn-check" name="addAccountScope" id="addAccountScopeShared"
                               checked="@(_selectedScope == AccountScope.Shared)"
                               @onchange="@(() => _selectedScope = AccountScope.Shared)" />
                        <label class="btn" for="addAccountScopeShared">@L["Scope_Shared"]</label>

                        <input type="radio" class="btn-check" name="addAccountScope" id="addAccountScopeExclusive"
                               checked="@(_selectedScope == AccountScope.Exclusive)"
                               @onchange="@(() => _selectedScope = AccountScope.Exclusive)" />
                        <label class="btn" for="addAccountScopeExclusive">@L["Scope_Exclusive"]</label>
                    </div>
                    <small class="form-text text-body-secondary">
                        @L["AddAccount_ScopeHelp"]
                    </small>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="CloseDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" data-testid="add-accounts-confirm"
                @onclick="ConfirmAddAsync"
                disabled="@(_selected.Count == 0)">@AddButtonLabel</button>
    </Footer>
</Modal>

@code {
    // The account whose removal waits for its confirmation in the row.
    private long? pendingRemove;

    private async Task RemoveAsync(long accountId)
    {
        pendingRemove = null;
        await OnRemove.InvokeAsync(accountId);
    }

    /// <summary>Accounts assigned to the project; null shows a loading note.</summary>
    [Parameter] public IReadOnlyList<ProjectAccountAssignment>? Assignments { get; set; }
    /// <summary>All accounts of the project's owner (for names/balances + the picker).</summary>
    [Parameter] public List<Account>? AllAccounts { get; set; }
    /// <summary>Account-group hierarchy for the Add picker.</summary>
    [Parameter] public List<AccountGroup>? AllAccountGroups { get; set; }
    /// <summary>Raised with the chosen account ids + one scope for all of them when the user confirms Add.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<long> AccountIds, AccountScope Scope)> OnAdd { get; set; }
    /// <summary>Raised with the account id to unassign.</summary>
    [Parameter] public EventCallback<long> OnRemove { get; set; }
    /// <summary>Raised with the account id + new scope when a row's scope toggle is clicked.</summary>
    [Parameter] public EventCallback<(long AccountId, AccountScope Scope)> OnScopeChange { get; set; }
    /// <summary>Raised with the account id + new value when a row's "In cashflow" checkbox is toggled.</summary>
    [Parameter] public EventCallback<(long AccountId, bool InCashflow)> OnInCashflowChange { get; set; }

    private bool _showDialog;
    private readonly HashSet<long> _selected = new();
    private string _filter = "";
    private AccountScope _selectedScope = AccountScope.Shared;

    private string AddButtonLabel => _selected.Count switch
    {
        0 => L["Button_AddAccounts_None"],
        1 => L["Button_AddAccounts_One"],
        var n => L["Button_AddAccounts_Many", n],
    };

    private void OpenDialog()
    {
        _selected.Clear();
        _filter = "";
        _selectedScope = AccountScope.Shared;
        _showDialog = true;
    }

    private void CloseDialog() => _showDialog = false;

    private void ToggleAccount(long id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    /// <summary>Group click: select every not-yet-added visible account below it, or clear them when all are selected.</summary>
    private void ToggleGroup(List<long> selectable)
    {
        if (selectable.All(_selected.Contains)) _selected.ExceptWith(selectable);
        else _selected.UnionWith(selectable);
    }

    private async Task ConfirmAddAsync()
    {
        if (_selected.Count == 0) return;
        var ids = _selected.ToList();
        _showDialog = false;
        _selected.Clear();
        await OnAdd.InvokeAsync((ids, _selectedScope));
    }

    /// <summary>One picker row: a group header (carrying every visible account id in its subtree) or an account.</summary>
    private sealed record PickerRow(bool IsGroup, long Id, int Level, string Label, string? Icon, List<long> AccountIds, string? Color = null);

    /// <summary>
    /// Walk the source's account_groups hierarchy and produce a flat, depth-first list of rows:
    /// each group emits a header followed by its sub-groups (recursively) and then its accounts.
    /// Sorting at every level matches the source's <c>sort</c> field. Already-added accounts stay
    /// in the list (the markup renders them disabled). The filter matches an account's label or
    /// any ancestor group's name; groups with nothing visible below them are pruned. Accounts whose
    /// group doesn't resolve are bucketed under "Other" at the bottom.
    /// </summary>
    private List<PickerRow> BuildPickerRows(List<AccountGroup> groups, List<Account> accounts, string filter)
    {
        filter = filter.Trim();
        bool Matches(string? text) => filter.Length == 0 || (text?.Contains(filter, StringComparison.CurrentCultureIgnoreCase) ?? false);

        var groupById = groups.ToDictionary(g => g.Id);
        bool IsRoot(AccountGroup g) =>
            !g.ParentGroupId.HasValue || !groupById.ContainsKey(g.ParentGroupId.Value);

        var childGroupsByParent = groups
            .Where(g => !IsRoot(g))
            .GroupBy(g => g.ParentGroupId!.Value)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(x => x.Sort ?? long.MaxValue)
                .ThenBy(x => x.Name)
                .ToList());
        var rootGroups = groups
            .Where(IsRoot)
            .OrderBy(g => g.Sort ?? long.MaxValue)
            .ThenBy(g => g.Name)
            .ToList();
        var accountsByGroup = accounts
            .Where(a => a.GroupId.HasValue && groupById.ContainsKey(a.GroupId.Value))
            .GroupBy(a => a.GroupId!.Value)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(a => a.Sort ?? long.MaxValue)
                .ThenBy(a => a.Name)
                .ToList());
        var orphans = accounts
            .Where(a => !a.GroupId.HasValue || !groupById.ContainsKey(a.GroupId!.Value))
            .OrderBy(a => a.Sort ?? long.MaxValue)
            .ThenBy(a => a.Name)
            .ToList();

        string AccountLabel(Account account)
        {
            var balance = account.CurrentBalance;
            return $"{account.Name} ({account.KindLabel})"
                + (balance.HasValue ? $" — {Formatting.FormatMoneyDe(balance.Value, account.Currency ?? "")}" : "");
        }

        var rows = new List<PickerRow>();

        // Emits the group's rows if anything below it is visible; returns the visible account ids.
        List<long> Walk(long id, string label, List<AccountGroup> subGroups, List<Account> own, int level, bool ancestorMatched)
        {
            var matched = ancestorMatched || Matches(label);
            var group = groupById.GetValueOrDefault(id);
            var header = new PickerRow(true, id, level, label, AccountIcons.ForGroup(group?.Icon), new List<long>(), group?.Color);
            var at = rows.Count;
            rows.Add(header);
            foreach (var sub in subGroups)
                header.AccountIds.AddRange(Walk(sub.Id, sub.Name ?? "—",
                    childGroupsByParent.GetValueOrDefault(sub.Id) ?? new(),
                    accountsByGroup.GetValueOrDefault(sub.Id) ?? new(), level + 1, matched));
            foreach (var a in own)
            {
                var text = AccountLabel(a);
                if (!matched && !Matches(text)) continue;
                rows.Add(new PickerRow(false, a.Id, level + 1, text, AccountIcons.ForAccount(a.Icon, a.Type, a.Portfolio == 1), new List<long>(), a.Color));
                header.AccountIds.Add(a.Id);
            }
            if (header.AccountIds.Count == 0) rows.RemoveRange(at, rows.Count - at);
            return header.AccountIds;
        }

        foreach (var root in rootGroups)
            Walk(root.Id, root.Name ?? "—", childGroupsByParent.GetValueOrDefault(root.Id) ?? new(),
                accountsByGroup.GetValueOrDefault(root.Id) ?? new(), 0, false);
        if (orphans.Any())
            Walk(0, L["AddAccount_OtherGroup"], new(), orphans, 0, false);

        return rows;
    }
}
