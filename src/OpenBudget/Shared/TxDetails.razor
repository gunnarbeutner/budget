@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<TxDetails> L
@inject ClockService Clock

@* The in-place expansion of a selected transaction: the bank's details as a flowing "Label value" list (empty ones
   skipped), the full purpose, then the note and the actions. Bank fields are plain text (never editable); category,
   note and check mark are edited here when the row is editable. *@

<div class="tx-details" data-testid="tx-details" @onclick:stopPropagation="true">
    <div class="tx-details-facts">
        @if (!string.IsNullOrEmpty(Row.BookingText))
        {
            <span><b>@L["BookingText"]</b>@Row.BookingText</span>
        }
        <span><b>@L["BookingDate"]</b>@Clock.ToLocal(Row.Date).ToString("dd.MM.yyyy")@(Row.IsPending ? " · " + L["Pending"] : "")</span>
        @if (Row.ValueDate is { } valueDate)
        {
            <span><b>@L["ValueDate"]</b>@valueDate.ToString("dd.MM.yyyy")</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyIban))
        {
            <span><b>@L["Iban"]</b>@AccountDisplay.FormatIban(Row.CounterpartyIban)</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyBic))
        {
            <span><b>@L["Bic"]</b>@Row.CounterpartyBic</span>
        }
        @if (!string.IsNullOrEmpty(Row.BankReference))
        {
            <span><b>@L["BankReference"]</b>@Row.BankReference</span>
        }
        @if (ShowAccount && !string.IsNullOrEmpty(Row.AccountName))
        {
            <span><b>@L["Account"]</b>@Row.AccountName</span>
        }
        <span data-testid="tx-details-category">
            <b>@L["Category"]</b>@(string.IsNullOrEmpty(Row.CategoryName) ? L["NoCategory"] : Row.CategoryName)
            @if (!string.IsNullOrEmpty(SetByText))
            {
                <span class="ms-1" data-testid="tx-details-category-source">(@SetByText)</span>
            }
        </span>
        @if (!Row.CanEdit && !string.IsNullOrEmpty(Row.Note))
        {
            <span><b>@L["Note"]</b>@Row.Note</span>
        }
        @if (Statement is { } statement)
        {
            <span><b>@L["Statement"]</b><a href="@($"/statements/{statement.Id}")" target="_blank" rel="noopener" data-testid="tx-details-statement"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @statement.Name</a></span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Row.Purpose))
    {
        <div class="tx-details-purpose"><b class="text-body">@L["Purpose"]</b> @Row.Purpose</div>
    }

    <div class="tx-details-actions">
        @if (Row.CanEdit)
        {
            <input type="text" class="form-control form-control-sm" data-testid="tx-details-note" maxlength="500" aria-label="@L["Note"]"
                   placeholder="@L["Note_Placeholder"]" value="@Row.Note" @onchange="OnNoteChanged" />
            <button type="button" class="ob-btn" data-testid="tx-details-category-button" @onclick="OnPickCategory">
                <i class="bi bi-tag" aria-hidden="true"></i> @L["Action_Category"]
            </button>
            <button type="button" class="ob-btn @(Row.IsChecked ? "active" : "")" data-testid="tx-details-checked"
                    aria-pressed="@Row.IsChecked.ToString().ToLowerInvariant()" @onclick="() => OnToggleChecked.InvokeAsync()">
                <i class="bi @(Row.IsChecked ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i> @(Row.IsChecked ? L["Checked_Yes"] : L["Checked_No"])
            </button>
        }
        <button type="button" class="ob-btn" disabled title="@L["ComingSoon"]">@L["Action_Split"]</button>
        <button type="button" class="ob-btn" disabled title="@L["ComingSoon"]">@L["Action_Rule"]</button>
        <button type="button" class="ob-btn" data-testid="tx-details-similar" disabled="@string.IsNullOrWhiteSpace(Row.Name)"
                @onclick="() => OnShowSimilar.InvokeAsync()">@L["Action_Similar"]</button>
    </div>

    @if (!Row.CanEdit)
    {
        <div class="tx-details-readonly" data-testid="tx-details-readonly">
            <i class="bi bi-lock" aria-hidden="true"></i> @LockText
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TransactionRow Row { get; set; } = null!;
    [Parameter] public (long Id, string Name)? Statement { get; set; }
    /// <summary>Whether to list the account (the list spans several accounts).</summary>
    [Parameter] public bool ShowAccount { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnPickCategory { get; set; }
    [Parameter] public EventCallback<string> OnNoteSave { get; set; }
    [Parameter] public EventCallback OnToggleChecked { get; set; }
    [Parameter] public EventCallback OnShowSimilar { get; set; }

    private string SetByText => Row.CategoryId == null && Row.CategorySetBy == TransactionCategorySource.Import
        ? ""
        : Row.CategorySetBy switch
        {
            TransactionCategorySource.Manual => L["SetBy_Manual"],
            TransactionCategorySource.Rule => Row.RuleId is { } rule ? L["SetBy_Rule", rule] : L["SetBy_RuleUnknown"],
            _ => L["SetBy_Import"],
        };

    private string LockText => Row.EditBlock == EditBlock.MoneyMoney ? L["Lock_MoneyMoney"] : L["Lock_NoPermission"];

    private Task OnNoteChanged(ChangeEventArgs e) => OnNoteSave.InvokeAsync(e.Value?.ToString() ?? "");
}
