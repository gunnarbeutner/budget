@using Microsoft.EntityFrameworkCore
@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<TxDetails> L
@inject ClockService Clock
@inject OpenBudget.Connectors.Receipts.ReceiptService ReceiptInfo
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject OpenBudget.Assist.CategorySuggestionService Suggestions
@inject TransferPairService Transfers

@* The in-place expansion of a selected transaction: the bank's details as a flowing "Label value" list (empty ones
   skipped), the full purpose, then the note and the actions. Bank fields are plain text (never editable); category,
   note and check mark are edited here when the row is editable. *@

<div class="tx-details" data-testid="tx-details" @onclick:stopPropagation="true">
    @if (ShowAccount && !string.IsNullOrEmpty(Row.AccountName))
    {
        <div class="tx-details-account" data-testid="tx-details-account"><i class="bi @(Account?.DisplayIcon ?? AccountIcons.ForAccount(null, null, false)) me-1" style="@AccountIcons.TintStyle(Account?.Color)" aria-hidden="true"></i><b>@Row.AccountName</b></div>
    }
    <div class="tx-details-facts">
        @if (!string.IsNullOrEmpty(Row.BookingText))
        {
            <span><b>@L["BookingText"]</b>@Row.BookingText</span>
        }
        <span><b>@L["BookingDate"]</b>@Clock.ToLocal(Row.Date).ToAppDate()@(Row.IsPending ? " · " + L["Pending"] : "")</span>
        @if (Row.ValueDate is { } valueDate)
        {
            <span><b>@L["ValueDate"]</b>@valueDate.ToAppDate()</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyIban))
        {
            <span><b>@L["Iban"]</b>@AccountDisplay.FormatIban(Row.CounterpartyIban)</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyBic))
        {
            <span><b>@L["Bic"]</b>@Row.CounterpartyBic</span>
        }
        @if (!string.IsNullOrEmpty(Row.BankReference))
        {
            <span><b>@L["BankReference"]</b>@Row.BankReference</span>
        }
        @foreach (var (key, value) in SepaFacts)
        {
            <span data-testid="@("tx-details-" + key)"><b>@L[key]</b>@value</span>
        }
        @if (ShowCategory || mainName != null)
        {
            <span data-testid="tx-details-category">
                <b>@L["Category"]</b>@if (PickerData?.OutsideOf(Row.CategoryId) != null && !string.IsNullOrEmpty(Row.CategoryName))
                {
                    <CategoryPill CategoryId="Row.CategoryId" PickerData="PickerData" FallbackName="@Row.CategoryName" TestId="tx-details-outside" />
                }
                else
                {
                    @(string.IsNullOrEmpty(Row.CategoryName) ? L["NoCategory"] : Row.CategoryName)
                }
                @if (mainName != null)
                {
                    <span class="ms-1 text-body-secondary" data-testid="tx-details-follows">@L["Follows", mainName]</span>
                }
            </span>
        }
        @if (_transfer is { } peer)
        {
            <span data-testid="tx-details-transfer">
                <b>@L["Transfer"]</b><i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>@if (OnShowBooking.HasDelegate)
                {
                    <a href="" data-testid="tx-details-transfer-link" @onclick:preventDefault="true" @onclick="() => OnShowBooking.InvokeAsync(peer)">@PeerText(peer)</a>
                }
                else
                {
                    @PeerText(peer)
                }
                @if (Row.CanEdit)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-testid="tx-details-unpair" disabled="@_pairing" @onclick="UnpairAsync">@L["Action_Unpair"]</button>
                }
            </span>
        }
        @if (IsSuggested)
        {
            @* Shown also where the list names the category: the details say where it came from and confirm it. *@
            <span data-testid="tx-details-suggested">
                <b>@L["Suggested"]</b><i class="bi bi-stars" aria-hidden="true"></i> @(reason is { } r ? L["Suggested_By", SourceName(r.Source)] : Row.CategoryName)@if (reason?.Rationale is { Length: > 0 } why) { <span>: @why</span> }
                @if (Row.CanEdit)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-testid="tx-details-confirm" disabled="@confirming" @onclick="ConfirmAsync">@L["Action_Confirm"]</button>
                }
            </span>
        }
        @if (!Row.CanEdit && !string.IsNullOrEmpty(Row.Note))
        {
            <span><b>@L["Note"]</b>@Row.Note</span>
        }
        @if (Statement is { } statement)
        {
            <span><b>@L["Statement"]</b><a href="@($"/statements/{statement.Id}")" target="_blank" rel="noopener" data-testid="tx-details-statement"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @statement.Name</a></span>
        }
    </div>

    @* The row shows the cleaned purpose; the details add the bank's text only when cleaning changed it. *@
    @if (!string.IsNullOrWhiteSpace(Row.Purpose) && PurposeText.Clean(Row.Purpose) != Row.Purpose.Trim())
    {
        <div class="tx-details-purpose"><b class="text-body">@L["Purpose"]</b> @Row.Purpose</div>
    }

    @if (receipt != null)
    {
        <TxReceipt Receipt="receipt" PickerData="PickerData" CanEdit="Row.CanEdit" HighlightCategoryId="receiptShownCategory" OnChanged="ReceiptChangedAsync" OnOpen="OnOpenReceipt" />
    }
    else if (!string.IsNullOrWhiteSpace(Row.OrderItems))
    {
        <div class="tx-details-purpose" data-testid="tx-details-order">
            <b class="text-body me-1">@L["Order"]</b>
            <span data-testid="tx-details-order-items">@Row.OrderItems</span>
        </div>
    }

    <div class="tx-details-actions">
        @if (Row.CanEdit)
        {
            <input type="text" class="form-control form-control-sm" data-testid="tx-details-note" maxlength="500" aria-label="@L["Note"]"
                   placeholder="@L["Note_Placeholder"]" value="@Row.Note" @onchange="OnNoteChanged" />
        }
        @if (Row.CanEdit && Row.Amount == 0 && string.IsNullOrEmpty(Row.CategoryName) && OnPickCategory.HasDelegate)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-pick-category" @onclick="e => OnPickCategory.InvokeAsync(e)">
                <i class="bi bi-tag" aria-hidden="true"></i> @L["Action_PickCategory"]
            </button>
        }
        @if (Row.CanEdit && Row.Amount != 0 && string.IsNullOrEmpty(Row.CategoryName) && !HasSuggestion && OnSuggest.HasDelegate)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-suggest" disabled="@suggesting" @onclick="SuggestAsync">
                <i class="bi bi-lightbulb" aria-hidden="true"></i> @L["Action_Suggest"]
            </button>
        }
        @if (Row.CanEdit && PickerData != null && !Row.IsSplitRemainder)
        {
            <button type="button" class="ob-btn @(panel == Panel.Split ? "active" : "")" data-testid="tx-details-split" @onclick="() => Toggle(Panel.Split)">
                <i class="bi bi-scissors" aria-hidden="true"></i> @(Row.IsSplitChild ? L["Action_EditSplit"] : L["Action_Split"])
            </button>
        }
        @if (OffsetTargets.Count > 0 && OnCreateOffset.HasDelegate)
        {
            <button type="button" class="ob-btn @(panel == Panel.Offset ? "active" : "")" data-testid="tx-details-offset"
                    aria-expanded="@((panel == Panel.Offset).ToString().ToLowerInvariant())" @onclick="() => Toggle(Panel.Offset)">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> @L["Action_Offset"]
            </button>
        }
        @if (CanPair)
        {
            <button type="button" class="ob-btn @(panel == Panel.Transfer ? "active" : "")" data-testid="tx-details-pair"
                    aria-expanded="@((panel == Panel.Transfer).ToString().ToLowerInvariant())" @onclick="TogglePairAsync">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> @L["Action_Pair"]
            </button>
        }
        @if (Row.CanEdit && OnCreateRule.HasDelegate)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-create-rule" disabled="@string.IsNullOrWhiteSpace(Row.Name)"
                    @onclick="e => OnCreateRule.InvokeAsync(e)">
                <i class="bi bi-magic" aria-hidden="true"></i> @L["Action_Rule"]
            </button>
        }
        @if (Row.CanEditBooking && OnEditBooking.HasDelegate)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-edit-booking" @onclick="() => OnEditBooking.InvokeAsync()">@L["Action_EditBooking"]</button>
        }
        <button type="button" class="ob-btn" data-testid="tx-details-similar" disabled="@string.IsNullOrWhiteSpace(Row.Name)"
                @onclick="() => OnShowSimilar.InvokeAsync()">@L["Action_Similar"]</button>
    </div>

    @if (panel == Panel.Split && PickerData != null)
    {
        <TxSplitEditor Row="Row" PickerData="PickerData" OnDone="OnPanelDone" />
    }
    else if (panel == Panel.Offset)
    {
        <div class="tx-details-offset" data-testid="tx-details-offset-targets">
            <AccountPicker data-testid="tx-details-offset-picker" AllowNone="false" AriaLabel="@L["Action_Offset"]" NoneLabel="@L["Offset_Choose"]"
                           Options="@(OffsetTargets.Select(t => new AccountPicker.Option(t.AccountId, t.Name, null, null, t.Icon, false, false)).ToList())"
                           OnPick="id => id is { } a ? OffsetAsync(a) : Task.CompletedTask" />
        </div>
    }
    else if (panel == Panel.Transfer)
    {
        <div class="tx-details-offset" data-testid="tx-details-transfer-candidates">
            @if (_candidates == null)
            {
                <span class="text-body-secondary small">@L["Transfer_Loading"]</span>
            }
            else if (_candidates.Count == 0)
            {
                <span class="text-body-secondary small" data-testid="tx-details-transfer-none">@L["Transfer_NoCandidates", TransferPairService.ManualWindowDays]</span>
            }
            else
            {
                <div class="small text-body-secondary mb-1">@L["Transfer_Choose"]</div>
                @foreach (var c in _candidates)
                {
                    <button type="button" class="ob-btn me-1 mb-1" data-testid="tx-details-transfer-candidate" disabled="@_pairing" @onclick="() => PairWithAsync(c.Id)">
                        @PeerText(c) · @Formatting.FormatMoneyDe(c.Amount, c.Currency)@if (!string.IsNullOrWhiteSpace(c.Name)) { <span> · @c.Name</span> }
                    </button>
                }
            }
        </div>
    }
    @if (error != null)
    {
        <div class="text-danger small mt-1">@error</div>
    }

    @if (!Row.CanEdit)
    {
        <div class="tx-details-readonly" data-testid="tx-details-readonly">
            <i class="bi bi-lock" aria-hidden="true"></i> @L["Lock_NoPermission"]
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TransactionRow Row { get; set; } = null!;
    [Parameter] public (long Id, string Name)? Statement { get; set; }
    /// <summary>Whether to list the account (the list spans several accounts).</summary>
    [Parameter] public bool ShowAccount { get; set; }

    /// <summary>The sidebar's node for the booking's account (its icon and colour), or null for the type default.</summary>
    [Parameter] public BrowseAccountNode? Account { get; set; }
    [Parameter] public EventCallback<string> OnNoteSave { get; set; }
    [Parameter] public EventCallback OnShowSimilar { get; set; }
    /// <summary>Asks for a category suggestion for this booking (shown as a chip on the row).</summary>
    [Parameter] public EventCallback OnSuggest { get; set; }

    /// <summary>The booking already has a suggestion (they are cached, asking again would show the same one).</summary>
    [Parameter] public bool HasSuggestion { get; set; }
    /// <summary>Opens the category picker; offered for zero-amount bookings, which show no category pill.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnPickCategory { get; set; }

    private bool suggesting;

    private async Task SuggestAsync()
    {
        suggesting = true;
        try
        {
            await OnSuggest.InvokeAsync();
        }
        finally
        {
            suggesting = false;
        }
    }
    /// <summary>Opens the full edit form (bookings of manual accounts the user owns).</summary>
    [Parameter] public EventCallback OnEditBooking { get; set; }
    /// <summary>"Create rule from this…": opens the rules bar of the category with a draft for the payee (the page asks for a category when there is none).</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnCreateRule { get; set; }

    /// <summary>Categories for the split editor; without them splitting is not offered.</summary>
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>The project whose manual accounts are offered for an offsetting entry (0 = none).</summary>
    [Parameter] public int ProjectId { get; set; }
    /// <summary>Manual accounts an offsetting entry for this booking can be created on (empty = not offered).</summary>
    [Parameter] public IReadOnlyList<OffsetTarget> OffsetTargets { get; set; } = [];
    /// <summary>Creates the offsetting entry on the chosen account.</summary>
    [Parameter] public EventCallback<long> OnCreateOffset { get; set; }
    /// <summary>A split or an offsetting entry was created: the page reloads its data.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Opens the booking's receipt in the page's panel (see <see cref="TxReceipt.OnOpen"/>); without it the receipt has its own.</summary>
    [Parameter] public EventCallback<ReceiptOpenRequest> OnOpenReceipt { get; set; }
    /// <summary>Raised by the page after its receipt panel moved items: the receipt chips reload.</summary>
    [Parameter] public int ReceiptVersion { get; set; }

    /// <summary>Whether the details name the category: only when the list shows it nowhere else for this row.</summary>
    [Parameter] public bool ShowCategory { get; set; } = true;

    /// <summary>Opens the account of the other side of a transfer and shows that booking there.</summary>
    [Parameter] public EventCallback<TransferCounterpart> OnShowBooking { get; set; }

    private enum Panel { None, Split, Offset, Transfer }

    private TransferCounterpart? _transfer;
    private (long Id, long? Peer) _transferFor;
    private IReadOnlyList<TransferCounterpart>? _candidates;
    private bool _pairing;

    /// <summary>A booked, whole booking without a pair may be paired by hand.</summary>
    private bool CanPair => Row.CanEdit && Row.TransferPeerId == null && !Row.IsPending && Row.Amount != 0
        && !Row.IsSplitChild && !Row.IsSplitRemainder && Row.AccountId != null;

    private string PeerText(TransferCounterpart peer) => L["Transfer_Peer", peer.AccountName, Clock.ToLocal(peer.Date).ToAppDate()];

    private async Task TogglePairAsync()
    {
        Toggle(Panel.Transfer);
        if (panel != Panel.Transfer) return;
        _candidates = null;
        _candidates = await Transfers.GetCandidatesAsync(Row.Id);
    }

    private async Task PairWithAsync(long peerId)
    {
        await ChangePairAsync(() => Transfers.PairAsync(Row.Id, peerId));
        panel = Panel.None;
    }

    private Task UnpairAsync() => ChangePairAsync(() => Transfers.UnpairAsync(Row.Id));

    private async Task ChangePairAsync(Func<Task> change)
    {
        _pairing = true;
        error = null;
        try
        {
            await change();
            _transferFor = default;
            await OnChanged.InvokeAsync();
        }
        catch (AccessDeniedException)
        {
            error = L["Lock_NoPermission"];
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            _pairing = false;
        }
    }

    private Panel panel;
    private string? error;
    private long shownRowId;

    protected override void OnParametersSet()
    {
        // A different row (or the same row after a reload turned it into a part) starts without an open panel.
        if (shownRowId != Row.Id) panel = Panel.None;
        shownRowId = Row.Id;
    }

    private long ordersFor;
    private int receiptVersion;
    private OpenBudget.Connectors.Receipts.BookingReceiptView? receipt;
    private long? receiptShownCategory;

    private string? mainName;
    private long mainFor;

    /// <summary>The category is an unconfirmed suggestion: shown with its reason and a confirm action.</summary>
    private bool IsSuggested => Row.CategorySetBy == TransactionCategorySource.Suggested && Row.CategoryId != null;

    private (string Source, string? Rationale)? reason;
    private long reasonFor;
    private bool confirming;

    private string SourceName(string source) => source == "ai" ? L["Source_Ai"] : L["Source_Similar"];

    /// <summary>Keeps the suggested category as the owner's own choice.</summary>
    private async Task ConfirmAsync()
    {
        if (Row.CategoryId is not { } category) return;
        confirming = true;
        try
        {
            await Suggestions.AcceptAsync([Row.Id], category);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            confirming = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_transferFor != (Row.Id, Row.TransferPeerId))
        {
            _transferFor = (Row.Id, Row.TransferPeerId);
            _transfer = Row.TransferPeerId == null ? null : await Transfers.GetCounterpartAsync(Row.Id);
        }
        if (!IsSuggested) (reason, reasonFor) = (null, 0);
        else if (reasonFor != Row.Id)
        {
            reasonFor = Row.Id;
            reason = await Suggestions.ReasonAsync(Row.Id);
        }
        if (Row.Amount == 0 && mainFor != Row.Id)
        {
            mainFor = Row.Id;
            await using var db = await DbFactory.CreateDbContextAsync();
            var main = await ZeroCompanions.FindMainAsync(db, Row.Id, CancellationToken.None);
            mainName = main == null ? null : main.Name ?? "";
        }
        else if (Row.Amount != 0) mainName = null;
        if (string.IsNullOrWhiteSpace(Row.OrderItems) || (ordersFor == Row.Id && receiptVersion == ReceiptVersion)) return;
        ordersFor = Row.Id;
        receiptVersion = ReceiptVersion;
        await LoadReceiptAsync();
    }

    private async Task LoadReceiptAsync()
    {
        receipt = await ReceiptInfo.GetForBookingAsync(Row.Id);
        receiptShownCategory = null;
        if (receipt == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        // a split part shows its own part highlighted
        receiptShownCategory = Row.Id != receipt.TransactionId
            ? await db.Transactions.AsNoTracking().Where(t => t.Id == Row.Id).Select(t => t.CategoryId).FirstOrDefaultAsync()
            : null;
    }

    private async Task ReceiptChangedAsync()
    {
        await LoadReceiptAsync();
        await OnChanged.InvokeAsync();
    }

    private void Toggle(Panel p)
    {
        error = null;
        panel = panel == p ? Panel.None : p;
    }

    private async Task OnPanelDone(bool changed)
    {
        panel = Panel.None;
        if (changed) await OnChanged.InvokeAsync();
    }

    private async Task OffsetAsync(long accountId)
    {
        panel = Panel.None;
        await OnCreateOffset.InvokeAsync(accountId);
    }

    /// <summary>The SEPA / bank detail fields the row has, in display order (label key, value).</summary>
    private IEnumerable<(string Key, string Value)> SepaFacts =>
        new (string Key, string? Value)[]
        {
            ("EndToEndReference", Row.EndToEndReference),
            ("MandateReference", Row.MandateReference),
            ("CreditorId", Row.CreditorId),
            ("TransactionCode", Row.TransactionCode),
            ("Primanota", Row.Primanota),
            ("ReturnReason", Row.ReturnReason),
        }.Where(f => !string.IsNullOrWhiteSpace(f.Value)).Select(f => (f.Key, f.Value!));


    private Task OnNoteChanged(ChangeEventArgs e) => OnNoteSave.InvokeAsync(e.Value?.ToString() ?? "");
}
