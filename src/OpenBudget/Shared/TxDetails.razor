@using OpenBudget.Models
@using OpenBudget.Services
@inject IStringLocalizer<TxDetails> L
@inject ClockService Clock
@inject SplitTransferService SplitTransfers

@* The in-place expansion of a selected transaction: the bank's details as a flowing "Label value" list (empty ones
   skipped), the full purpose, then the note and the actions. Bank fields are plain text (never editable); category,
   note and check mark are edited here when the row is editable. *@

<div class="tx-details" data-testid="tx-details" @onclick:stopPropagation="true">
    <div class="tx-details-facts">
        @if (!string.IsNullOrEmpty(Row.BookingText))
        {
            <span><b>@L["BookingText"]</b>@Row.BookingText</span>
        }
        <span><b>@L["BookingDate"]</b>@Clock.ToLocal(Row.Date).ToString("dd.MM.yyyy")@(Row.IsPending ? " · " + L["Pending"] : "")</span>
        @if (Row.ValueDate is { } valueDate)
        {
            <span><b>@L["ValueDate"]</b>@valueDate.ToString("dd.MM.yyyy")</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyIban))
        {
            <span><b>@L["Iban"]</b>@AccountDisplay.FormatIban(Row.CounterpartyIban)</span>
        }
        @if (!string.IsNullOrEmpty(Row.CounterpartyBic))
        {
            <span><b>@L["Bic"]</b>@Row.CounterpartyBic</span>
        }
        @if (!string.IsNullOrEmpty(Row.BankReference))
        {
            <span><b>@L["BankReference"]</b>@Row.BankReference</span>
        }
        @foreach (var (key, value) in SepaFacts)
        {
            <span data-testid="@("tx-details-" + key)"><b>@L[key]</b>@value</span>
        }
        @if (ShowAccount && !string.IsNullOrEmpty(Row.AccountName))
        {
            <span><b>@L["Account"]</b>@Row.AccountName</span>
        }
        <span data-testid="tx-details-category">
            <b>@L["Category"]</b>@(string.IsNullOrEmpty(Row.CategoryName) ? L["NoCategory"] : Row.CategoryName)
            @if (!string.IsNullOrEmpty(SetByText))
            {
                <span class="ms-1" data-testid="tx-details-category-source">(@SetByText)</span>
            }
        </span>
        @if (!Row.CanEdit && !string.IsNullOrEmpty(Row.Note))
        {
            <span><b>@L["Note"]</b>@Row.Note</span>
        }
        @if (Row.IsSplitChild)
        {
            <span data-testid="tx-details-split-part"><b>@L["SplitPart"]</b>@L["SplitPart_Text"]</span>
        }
        @if (Row.IsTransfer)
        {
            <span data-testid="tx-details-transfer"><b>@L["Transfer"]</b>@(Row.TransferPeerAccountName is { } peer ? L["Transfer_To", peer] : L["Transfer_OneSided"])</span>
        }
        @if (Statement is { } statement)
        {
            <span><b>@L["Statement"]</b><a href="@($"/statements/{statement.Id}")" target="_blank" rel="noopener" data-testid="tx-details-statement"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> @statement.Name</a></span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Row.Purpose))
    {
        <div class="tx-details-purpose"><b class="text-body">@L["Purpose"]</b> @Row.Purpose</div>
    }

    <div class="tx-details-actions">
        @if (Row.CanEdit)
        {
            <input type="text" class="form-control form-control-sm" data-testid="tx-details-note" maxlength="500" aria-label="@L["Note"]"
                   placeholder="@L["Note_Placeholder"]" value="@Row.Note" @onchange="OnNoteChanged" />
            <button type="button" class="ob-btn" data-testid="tx-details-category-button" @onclick="OnPickCategory">
                <i class="bi bi-tag" aria-hidden="true"></i> @L["Action_Category"]
            </button>
            <button type="button" class="ob-btn @(Row.IsChecked ? "active" : "")" data-testid="tx-details-checked"
                    aria-pressed="@Row.IsChecked.ToString().ToLowerInvariant()" @onclick="() => OnToggleChecked.InvokeAsync()">
                <i class="bi @(Row.IsChecked ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i> @(Row.IsChecked ? L["Checked_Yes"] : L["Checked_No"])
            </button>
        }
        @if (Row.CanEdit && PickerData != null && !Row.IsTransfer && !Row.IsSplitRemainder)
        {
            <button type="button" class="ob-btn @(panel == Panel.Split ? "active" : "")" data-testid="tx-details-split"
                    disabled="@Row.IsPending" title="@(Row.IsPending ? L["Pending_NotYet"].Value : null)" @onclick="() => Toggle(Panel.Split)">
                <i class="bi bi-scissors" aria-hidden="true"></i> @(Row.IsSplitChild ? L["Action_EditSplit"] : L["Action_Split"])
            </button>
        }
        @if (Row.CanEdit && Row.IsTransfer)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-unlink-transfer" @onclick="UnlinkAsync">
                <i class="bi bi-link-45deg" aria-hidden="true"></i> @L["Action_Unlink"]
            </button>
        }
        else if (Row.CanEdit && ProjectId > 0 && !Row.IsSplitChild && !Row.IsSplitRemainder)
        {
            <button type="button" class="ob-btn @(panel == Panel.Transfer ? "active" : "")" data-testid="tx-details-transfer-button"
                    disabled="@Row.IsPending" title="@(Row.IsPending ? L["Pending_NotYet"].Value : null)" @onclick="() => Toggle(Panel.Transfer)">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> @L["Action_Transfer"]
            </button>
        }
        @if (Row.CanEdit && OnCreateRule.HasDelegate)
        {
            <button type="button" class="ob-btn" data-testid="tx-details-create-rule" disabled="@string.IsNullOrWhiteSpace(Row.Name)"
                    @onclick="e => OnCreateRule.InvokeAsync(e)">
                <i class="bi bi-magic" aria-hidden="true"></i> @L["Action_Rule"]
            </button>
        }
        <button type="button" class="ob-btn" data-testid="tx-details-similar" disabled="@string.IsNullOrWhiteSpace(Row.Name)"
                @onclick="() => OnShowSimilar.InvokeAsync()">@L["Action_Similar"]</button>
    </div>

    @if (panel == Panel.Split && PickerData != null)
    {
        <TxSplitEditor Row="Row" PickerData="PickerData" OnDone="OnPanelDone" />
    }
    else if (panel == Panel.Transfer)
    {
        <TxTransferPanel Row="Row" ProjectId="ProjectId" OnDone="OnPanelDone" />
    }
    @if (error != null)
    {
        <div class="text-danger small mt-1">@error</div>
    }

    @if (!Row.CanEdit)
    {
        <div class="tx-details-readonly" data-testid="tx-details-readonly">
            <i class="bi bi-lock" aria-hidden="true"></i> @LockText
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TransactionRow Row { get; set; } = null!;
    [Parameter] public (long Id, string Name)? Statement { get; set; }
    /// <summary>Whether to list the account (the list spans several accounts).</summary>
    [Parameter] public bool ShowAccount { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnPickCategory { get; set; }
    [Parameter] public EventCallback<string> OnNoteSave { get; set; }
    [Parameter] public EventCallback OnToggleChecked { get; set; }
    [Parameter] public EventCallback OnShowSimilar { get; set; }
    /// <summary>"Create rule from this…": opens the rules bar of the category with a draft for the payee (the page asks for a category when there is none).</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnCreateRule { get; set; }

    /// <summary>Categories for the split editor; without them splitting is not offered.</summary>
    [Parameter] public CategoryPickerData? PickerData { get; set; }
    /// <summary>The project whose other accounts are suggested as transfer counterparts (0 = no transfers).</summary>
    [Parameter] public int ProjectId { get; set; }
    /// <summary>A split or transfer changed: the page reloads its data.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private enum Panel { None, Split, Transfer }
    private Panel panel;
    private string? error;
    private long shownRowId;

    protected override void OnParametersSet()
    {
        // A different row (or the same row after a reload turned it into a part) starts without an open panel.
        if (shownRowId != Row.Id) panel = Panel.None;
        shownRowId = Row.Id;
    }

    private void Toggle(Panel p)
    {
        error = null;
        panel = panel == p ? Panel.None : p;
    }

    private async Task OnPanelDone(bool changed)
    {
        panel = Panel.None;
        if (changed) await OnChanged.InvokeAsync();
    }

    private async Task UnlinkAsync()
    {
        error = null;
        try
        {
            await SplitTransfers.UnlinkTransferAsync(Row.Id);
            await OnChanged.InvokeAsync();
        }
        catch (AccessDeniedException)
        {
            error = L["Error_Denied"];
        }
    }

    private string SetByText => Row.CategoryId == null && Row.CategorySetBy == TransactionCategorySource.Import
        ? ""
        : Row.CategorySetBy switch
        {
            TransactionCategorySource.Manual => L["SetBy_Manual"],
            TransactionCategorySource.Rule => L["SetBy_RuleUnknown"],
            _ => L["SetBy_Import"],
        };

    /// <summary>The SEPA / bank detail fields the row has, in display order (label key, value).</summary>
    private IEnumerable<(string Key, string Value)> SepaFacts =>
        new (string Key, string? Value)[]
        {
            ("EndToEndReference", Row.EndToEndReference),
            ("MandateReference", Row.MandateReference),
            ("CreditorId", Row.CreditorId),
            ("TransactionCode", Row.TransactionCode),
            ("Primanota", Row.Primanota),
            ("ReturnReason", Row.ReturnReason),
        }.Where(f => !string.IsNullOrWhiteSpace(f.Value)).Select(f => (f.Key, f.Value!));

    private string LockText => Row.EditBlock == EditBlock.MoneyMoney ? L["Lock_MoneyMoney"] : L["Lock_NoPermission"];

    private Task OnNoteChanged(ChangeEventArgs e) => OnNoteSave.InvokeAsync(e.Value?.ToString() ?? "");
}
