@using Microsoft.AspNetCore.Components.Web
@using OpenBudget.Models
@inject IStringLocalizer<BudgetMenu> L

@* The Budget view's budget controls in its toolbar: which budget the table and the charts compare against (a
   compact select), "Edit budget", and a "…" menu with New, Make active and Delete. Presentational — the page owns
   the budget list and the selection and does the service work; New/Edit are plain links. *@

@{
    var selectedBudget = AvailableBudgets?.FirstOrDefault(b => b.Id == SelectedBudgetId);
}
<div class="budget-menu">
    @if (selectedBudget != null && selectedBudget.Year != SelectedYear)
    {
        <i class="bi bi-exclamation-triangle-fill text-warning" role="img" data-testid="budget-year-mismatch"
           title="@L["Compare_YearMismatch", selectedBudget.Year, SelectedYear]" aria-label="@L["Compare_YearMismatch", selectedBudget.Year, SelectedYear]"></i>
    }
    <select class="form-select form-select-sm budget-select" aria-label="@L["Form_CompareWithBudgetLabel"]" data-testid="budget-select"
            value="@SelectedBudgetId" @onchange="HandleSelectChanged">
        <option value="0">@L["Form_NoBudgetComparisonOption"]</option>
        @if (AvailableBudgets != null)
        {
            foreach (var bud in AvailableBudgets)
            {
                <option value="@bud.Id">@bud.Year — @bud.Name@(bud.IsActive ? L["Form_ActiveSuffix"].Value : "")</option>
            }
        }
    </select>
    @if (CanEdit)
    {
        @if (selectedBudget != null)
        {
            <a class="ob-btn d-none d-lg-inline-flex" href="/budgets/@selectedBudget.Id/edit" data-testid="budget-edit">@L["Button_Edit"]</a>
        }
        <details class="app-menu" data-testid="budget-menu">
            <summary class="ob-btn" aria-label="@L["Aria_More"]" title="@L["Aria_More"]"><i class="bi bi-three-dots" aria-hidden="true"></i></summary>
            <div class="dropdown-menu show app-menu-list">
                <a class="dropdown-item" href="@($"/projects/{ProjectId}/budgets/new")"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>@L["Button_NewBudget"]</a>
                @if (selectedBudget != null)
                {
                    <a class="dropdown-item d-lg-none" href="/budgets/@selectedBudget.Id/edit"><i class="bi bi-pencil me-2" aria-hidden="true"></i>@L["Button_Edit"]</a>
                    @if (!selectedBudget.IsActive)
                    {
                        <button type="button" class="dropdown-item" title="@L["Title_MakeActive", selectedBudget.Year]"
                                @onclick="() => OnMakeActive.InvokeAsync(selectedBudget.Id)"><i class="bi bi-check2-circle me-2" aria-hidden="true"></i>@L["Button_MakeActive"]</button>
                    }
                    <button type="button" class="dropdown-item text-danger" @onclick="() => OnDelete.InvokeAsync(selectedBudget)">
                        <i class="bi bi-trash me-2" aria-hidden="true"></i>@L["Button_Delete"]
                    </button>
                }
            </div>
        </details>
    }
</div>

@code {
    [Parameter] public List<Budget>? AvailableBudgets { get; set; }
    [Parameter, EditorRequired] public int SelectedBudgetId { get; set; }
    [Parameter, EditorRequired] public int SelectedYear { get; set; }
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    /// <summary>Editors and owners may create/edit/activate/delete budgets; viewers only pick the comparison.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;
    /// <summary>Raised with the chosen budget id (0 = no comparison).</summary>
    [Parameter] public EventCallback<int> OnSelectedBudgetChanged { get; set; }
    /// <summary>Raised with the budget id to make active.</summary>
    [Parameter] public EventCallback<int> OnMakeActive { get; set; }
    /// <summary>Raised with the budget to delete (the page confirms + deletes).</summary>
    [Parameter] public EventCallback<Budget> OnDelete { get; set; }

    private async Task HandleSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var budgetId))
            await OnSelectedBudgetChanged.InvokeAsync(budgetId);
    }
}
