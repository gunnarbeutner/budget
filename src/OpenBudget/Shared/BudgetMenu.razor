@using Microsoft.AspNetCore.Components.Web
@using OpenBudget.Models
@inject IStringLocalizer<BudgetSelectorCard> L

@* Budgets page selector: choose the compare budget, plus New/Edit/Make-active/Delete actions.
   Presentational — the page owns the budget list + selection state and does the reload/service
   work; this raises OnSelectedBudgetChanged / OnMakeActive / OnDelete (New/Edit are plain links). *@

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label">@L["Form_CompareWithBudgetLabel"]</label>
                        @{
                            var selectedBudget = AvailableBudgets?.FirstOrDefault(b => b.Id == SelectedBudgetId);
                        }
                        <div class="d-flex flex-wrap gap-2 align-items-stretch">
                            <select class="form-select flex-grow-1" style="min-width: 14rem;"
                                    value="@SelectedBudgetId" @onchange="HandleSelectChanged">
                                <option value="0">@L["Form_NoBudgetComparisonOption"]</option>
                                @if (AvailableBudgets != null)
                                {
                                    foreach (var bud in AvailableBudgets)
                                    {
                                        <option value="@bud.Id">@bud.Year — @bud.Name@(bud.IsActive ? L["Form_ActiveSuffix"].Value : "")</option>
                                    }
                                }
                            </select>
                            @if (CanEdit)
                            {
                                <a class="btn btn-primary text-nowrap" href="@($"/projects/{ProjectId}/budgets/new")">@L["Button_NewBudget"]</a>
                            }
                            @if (selectedBudget != null && CanEdit)
                            {
                                <a class="btn btn-outline-primary text-nowrap" href="/budgets/@selectedBudget.Id/edit">@L["Button_Edit"]</a>
                                @if (!selectedBudget.IsActive)
                                {
                                    <button type="button" class="btn btn-outline-success text-nowrap"
                                            title="@L["Title_MakeActive", selectedBudget.Year]"
                                            @onclick="() => OnMakeActive.InvokeAsync(selectedBudget.Id)">@L["Button_MakeActive"]</button>
                                }
                                <button type="button" class="btn btn-outline-danger text-nowrap"
                                        @onclick="() => OnDelete.InvokeAsync(selectedBudget)">@L["Button_Delete"]</button>
                            }
                        </div>
                        @if (selectedBudget != null && selectedBudget.Year != SelectedYear)
                        {
                            <div class="small text-body-secondary mt-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i>
                                @L["Compare_YearMismatch", selectedBudget.Year, SelectedYear]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<Budget>? AvailableBudgets { get; set; }
    [Parameter, EditorRequired] public int SelectedBudgetId { get; set; }
    [Parameter, EditorRequired] public int SelectedYear { get; set; }
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    /// <summary>Editors and owners may create/edit/activate/delete budgets; viewers only pick the comparison.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;
    /// <summary>Raised with the chosen budget id (0 = no comparison).</summary>
    [Parameter] public EventCallback<int> OnSelectedBudgetChanged { get; set; }
    /// <summary>Raised with the budget id to make active.</summary>
    [Parameter] public EventCallback<int> OnMakeActive { get; set; }
    /// <summary>Raised with the budget to delete (the page confirms + deletes).</summary>
    [Parameter] public EventCallback<Budget> OnDelete { get; set; }

    private async Task HandleSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var budgetId))
            await OnSelectedBudgetChanged.InvokeAsync(budgetId);
    }
}
