@using OpenBudget.Models
@using OpenBudget.Services
@inject BrowseService BrowseService
@inject BudgetService BudgetService
@inject ProjectTimeState TimeState
@inject ClockService Clock
@inject NavigationManager Navigation
@inject DocumentService DocumentService
@inject AccessScopeProvider AccessProvider
@inject IStringLocalizer<BrowseTreeRail> RailL
@inject IStringLocalizer<ProjectShell> L
@implements IDisposable

@* The frame of every project view (Transactions, Budget, Cashflow, Scheduled, Portfolio, Documents): the left
   sidebar — the project's views on top, then the Accounts and Categories trees — and the main column, which
   the page fills with its 48px toolbar and its content. The sidebar is the only project navigation: its width
   is the shared --ob-sidebar-w (drag handle .browse-resizer, see uiBehaviors.js); below md it becomes an
   off-canvas sheet, opened from the bottom bar's "Accounts" or from a page's title.

   Transactions (Browse) owns its tree — selection, period sums, editing — and passes it in as Rail together
   with the loaded Tree. The other views get the same tree loaded here for the remembered month; picking an
   account or category there opens Transactions filtered to it. *@

<div class="browse-shell project-shell">
    @if (open)
    {
        <div class="browse-backdrop d-md-none" @onclick="CloseRailAsync" aria-hidden="true"></div>
    }
    <aside class="browse-rail @(open ? "open" : "")" aria-label="@L["Aria_Sidebar"]" data-testid="project-sidebar">
        <div class="browse-rail-header">
            <span class="fw-semibold">@L["Sheet_Heading"]</span>
            <button type="button" class="btn-close" @onclick="CloseRailAsync" aria-label="@L["Aria_Close"]"></button>
        </div>

        <nav class="shell-views" aria-label="@L["Aria_Views"]" data-testid="project-views">
            @ViewLink(ProjectTab.Browse, TransactionsUrl, "bi-list-ul", L["View_Transactions"], null, "view-transactions")
            @ViewLink(ProjectTab.Budgets, BudgetUrl, "bi-calendar3", L["View_Budget"], BudgetBadge, "view-budget")
            @ViewLink(ProjectTab.Cashflow, $"/projects/{ProjectId}/cashflow?{PeriodQuery}", "bi-graph-up", L["View_Cashflow"], null, "view-cashflow")
            @ViewLink(ProjectTab.Scheduled, $"/projects/{ProjectId}/scheduled", "bi-calendar-check", L["View_Scheduled"], null, "view-scheduled")
            @if (HasPortfolio)
            {
                @ViewLink(ProjectTab.Portfolio, $"/projects/{ProjectId}/portfolio", "bi-pie-chart", L["View_Portfolio"], null, "view-portfolio")
            }
            @ViewLink(ProjectTab.Documents, DocumentsUrl, "bi-file-earmark-text", L["View_Documents"], unreadDocs > 0 ? L["Documents_New", unreadDocs].Value : null, "view-documents")
        </nav>

        @if (Rail != null)
        {
            @Rail
        }
        else if (ownTree == null)
        {
            <div aria-busy="true" class="px-3 pt-2">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton skeleton-line" style="margin-left: @(i % 3 * 12)px;"></div>
                }
            </div>
        }
        else
        {
            <BrowseTreeRail Tree="ownTree"
                            SelectionKind="none"
                            ShowAllRow="false"
                            @bind-ShowRelatedAccounts="showRelatedAccounts"
                            OnSelectAll="@(() => OpenTransactions(null))"
                            OnSelectAccount="@(id => OpenTransactions($"acct-{id}"))"
                            OnSelectAccountGroup="@(id => OpenTransactions($"g{id}"))"
                            OnSelectUncategorized="@(() => OpenTransactions("uncategorized"))"
                            OnSelectCategory="@(n => OpenTransactions((n.ItemType == CategoryItemType.Category ? "cat-" : "grp-") + n.Id))"
                            NodeMenu="NodeMenu"
                            OnNodeMenuPick="OnNodeMenuPick"
                            RenamingNode="structure?.RenamingNode"
                            OnRename="@(n => structure?.RenameAsync(n) ?? Task.CompletedTask)"
                            CanDrag="@(n => structure?.CanDrag(n) ?? false)"
                            OnDrop="@(d => structure?.DropAsync(d) ?? Task.CompletedTask)"
                            @ref="rail" />
            <SidebarStructure @ref="structure" ProjectId="ProjectId" Tree="ownTree"
                              MenuPosition="() => rail?.MenuPosition ?? (200, 200)" OnChanged="ReloadOwnTreeAsync" />
        }
    </aside>

    <div class="browse-resizer" role="separator" aria-orientation="vertical" tabindex="0"
         aria-label="@L["Aria_ResizeSidebar"]" data-testid="sidebar-resizer"></div>

    <section class="browse-main @MainClass" data-marquee-area>
        @ChildContent
    </section>
</div>

@* Phones: the bottom bar replaces the sidebar's view list; "Accounts" opens the sidebar as a sheet. *@
<nav class="app-bottombar d-print-none" aria-label="@L["Aria_Views"]" data-testid="bottom-bar">
    <button type="button" class="app-bottom-item @(open ? "active" : "")" aria-expanded="@open.ToString().ToLowerInvariant()"
            @onclick="ToggleRailAsync" data-testid="bottom-accounts">
        <i class="bi bi-wallet2" aria-hidden="true"></i><span>@L["Bottom_Accounts"]</span>
    </button>
    @BottomLink(ProjectTab.Browse, TransactionsUrl, "bi-list-ul", L["View_Transactions"])
    @BottomLink(ProjectTab.Budgets, BudgetUrl, "bi-calendar3", L["View_Budget"])
    @BottomLink(ProjectTab.Documents, DocumentsUrl, "bi-file-earmark-text", L["View_Documents"], unreadDocs)
    <MoreMenu />
</nav>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    /// <summary>The highlighted view.</summary>
    [Parameter] public ProjectTab? Active { get; set; }
    /// <summary>Transactions' own tree rail; other views leave it null and get the tree loaded here.</summary>
    [Parameter] public RenderFragment? Rail { get; set; }
    /// <summary>The tree behind <see cref="Rail"/>, when the page already loaded it (decides whether Portfolio shows).</summary>
    [Parameter] public BrowseTree? Tree { get; set; }
    /// <summary>Clicking "Transactions" while on Transactions: the page resets to all transactions instead of navigating.</summary>
    [Parameter] public EventCallback OnTransactions { get; set; }
    /// <summary>
    /// Whether "Transactions" shows as the current entry on Transactions: only while all transactions are listed, so an
    /// account or category picked in the rail is the one highlighted.
    /// </summary>
    [Parameter] public bool TransactionsCurrent { get; set; } = true;
    [Parameter] public bool RailOpen { get; set; }
    [Parameter] public EventCallback<bool> RailOpenChanged { get; set; }
    /// <summary>Extra classes for the main column ("shell-page" for a page that scrolls as a whole).</summary>
    [Parameter] public string? MainClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool open;
    private bool showRelatedAccounts;
    private BrowseTree? ownTree;
    private string? budgetBadge;
    private int _loadedProjectId;

    private BrowseTree? EffectiveTree => Tree ?? ownTree;
    private bool HasPortfolio => EffectiveTree?.Accounts.Any(a => a.IsPortfolio && a.IsAssigned) == true || Active == ProjectTab.Portfolio;
    private string? BudgetBadge => budgetBadge;
    // The period views' links carry the shared period, so the next view's URL names it.
    private string PeriodQuery => TimeState.Current(Clock.NowLocal).ToQueryString();
    private string TransactionsUrl => $"/projects/{ProjectId}/browse?{PeriodQuery}";
    private string BudgetUrl => $"/projects/{ProjectId}/budgets?{PeriodQuery}";
    private string DocumentsUrl => $"/projects/{ProjectId}/documents";
    private int unreadDocs;

    protected override void OnInitialized() => DocumentService.ReadsChanged += OnReadsChanged;

    private void OnReadsChanged() => _ = InvokeAsync(async () =>
    {
        await LoadUnreadAsync();
        StateHasChanged();
    });

    private async Task LoadUnreadAsync()
    {
        try { unreadDocs = await DocumentService.GetUnreadCountAsync(ProjectId); }
        catch (InvalidOperationException) { unreadDocs = 0; }
    }

    public void Dispose() => DocumentService.ReadsChanged -= OnReadsChanged;

    protected override async Task OnParametersSetAsync()
    {
        open = RailOpen;
        var shared = TimeState.Current(Clock.NowLocal);
        var (year, month) = (shared.Year, shared.Month);
        var (fromMonth, toMonth) = shared.Months;
        var badgeKey = (ProjectId, year, fromMonth, toMonth);
        if (_loadedProjectId != ProjectId)
        {
            _loadedProjectId = ProjectId;
            ownTree = null;
            budgetBadge = null;
            await LoadUnreadAsync();
            canEditRules = (await AccessProvider.GetAsync()).CanEdit(ProjectId);
            if (Rail == null) ownTree = await BrowseService.GetTreeAsync(ProjectId, year, month, month);
        }
        if (_badgeKey == badgeKey) return;
        _badgeKey = badgeKey;
        // "57 %" next to Budget: spending against the budget for the period the views currently show (the
        // shared period, a custom range by the months it touches), the same number the Budget view's strip shows.
        try
        {
            var summary = await BudgetService.GetSpendingSummaryAsync(ProjectId, year, fromMonth, toMonth);
            budgetBadge = summary.HasBudget && summary.TotalBudget > 0
                ? L["Budget_Percent", ProjectStatus.OverallPercent(summary).ToString("F0", CultureInfo.CurrentCulture)].Value
                : null;
        }
        catch (InvalidOperationException)
        {
            budgetBadge = null;   // no access / project gone: the page itself reports that
        }
    }

    private (int, int, int, int)? _badgeKey;

    private async Task SetOpenAsync(bool value)
    {
        open = value;
        await RailOpenChanged.InvokeAsync(value);
    }

    private Task ToggleRailAsync() => SetOpenAsync(!open);
    private Task CloseRailAsync() => SetOpenAsync(false);

    private bool canEditRules;

    /// <summary>The sidebar's context menu on the views that do not own the tree: the same entries as on Transactions.</summary>
    private IReadOnlyList<ContextMenuItem> NodeMenu(SidebarNode node) =>
        structure?.Menu(node) ?? SidebarMenus.For(node, new SidebarMenuContext(canEditRules, _ => StructureBlock.NotOwner), RailL);

    private BrowseTreeRail? rail;
    private SidebarStructure? structure;

    private async Task OnNodeMenuPick((SidebarNode Node, string Key) pick)
    {
        if (pick.Key == SidebarMenus.Rules && pick.Node.Kind == SidebarNodeKind.Category)
            Navigation.NavigateTo($"{TransactionsUrl}&sel=cat-{pick.Node.Id}&rules=1");
        else if (structure != null)
            await structure.PickAsync(pick.Node, pick.Key);
    }

    // Structure edits from this sidebar: reload the tree for the remembered month in place.
    private async Task ReloadOwnTreeAsync(SidebarNode? deleted)
    {
        var (year, month) = (TimeState.Current(Clock.NowLocal).Year, TimeState.Current(Clock.NowLocal).Month);
        ownTree = await BrowseService.GetTreeAsync(ProjectId, year, month, month) ?? ownTree;
    }

    private void OpenTransactions(string? sel) =>
        Navigation.NavigateTo(sel == null ? TransactionsUrl : $"{TransactionsUrl}&sel={Uri.EscapeDataString(sel)}");

    private async Task OnViewClick(ProjectTab tab)
    {
        if (tab == ProjectTab.Browse && Active == ProjectTab.Browse && OnTransactions.HasDelegate)
            await OnTransactions.InvokeAsync();
        open = false;
    }

    private RenderFragment ViewLink(ProjectTab tab, string href, string icon, string label, string? badge, string testId) => __builder =>
    {
        var active = Active == tab;
        var intercept = tab == ProjectTab.Browse && active && OnTransactions.HasDelegate;
        var current = active && (tab != ProjectTab.Browse || TransactionsCurrent);
        <a class="shell-view @(current ? "active" : "")" href="@href" aria-current="@(current ? "page" : null)" data-testid="@testId"
           @onclick="() => OnViewClick(tab)" @onclick:preventDefault="intercept">
            <i class="bi @icon" aria-hidden="true"></i>
            <span class="shell-view-label">@label</span>
            @if (badge != null)
            {
                <span class="shell-view-badge">@badge</span>
            }
        </a>
    };

    private RenderFragment BottomLink(ProjectTab tab, string href, string icon, string label, int badge = 0) => __builder =>
    {
        var active = Active == tab;
        <a class="app-bottom-item @(active ? "active" : "")" href="@href" aria-current="@(active ? "page" : null)" data-testid="@($"bottom-{tab.ToString().ToLowerInvariant()}")">
            <span class="app-bottom-icon">
                <i class="bi @icon" aria-hidden="true"></i>
                @if (badge > 0)
                {
                    <span class="app-bottom-badge" data-testid="bottom-badge">@badge.ToString(CultureInfo.CurrentCulture)</span>
                }
            </span>
            <span>@label</span>
        </a>
    };
}
