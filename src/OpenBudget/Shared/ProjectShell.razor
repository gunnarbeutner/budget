@using OpenBudget.Models
@using OpenBudget.Services
@inject BrowseService BrowseService
@inject BudgetService BudgetService
@inject ProjectTimeState TimeState
@inject ClockService Clock
@inject NavigationManager Navigation
@inject IStringLocalizer<ProjectShell> L

@* The frame of every project view (Transactions, Budget, Cashflow, Portfolio): the left
   sidebar — the project's views on top, then the Accounts and Categories trees — and the main column, which
   the page fills with its 48px toolbar and its content. The sidebar is the only project navigation: its width
   is the shared --ob-sidebar-w (drag handle .browse-resizer, see uiBehaviors.js); below md it becomes an
   off-canvas sheet, opened from the bottom bar's "Accounts" or from a page's title.

   Transactions (Browse) owns its tree — selection, period sums, editing — and passes it in as Rail together
   with the loaded Tree. The other views get the same tree loaded here for the remembered month; picking an
   account or category there opens Transactions filtered to it. *@

<div class="browse-shell project-shell">
    @if (open)
    {
        <div class="browse-backdrop d-md-none" @onclick="CloseRailAsync" aria-hidden="true"></div>
    }
    <aside class="browse-rail @(open ? "open" : "")" aria-label="@L["Aria_Sidebar"]" data-testid="project-sidebar">
        <div class="browse-rail-header">
            <span class="fw-semibold">@L["Sheet_Heading"]</span>
            <button type="button" class="btn-close" @onclick="CloseRailAsync" aria-label="@L["Aria_Close"]"></button>
        </div>

        <nav class="shell-views" aria-label="@L["Aria_Views"]" data-testid="project-views">
            @ViewLink(ProjectTab.Browse, TransactionsUrl, "bi-list-ul", L["View_Transactions"], null, "view-transactions")
            @ViewLink(ProjectTab.Budgets, $"/projects/{ProjectId}/budgets", "bi-calendar3", L["View_Budget"], BudgetBadge, "view-budget")
            @ViewLink(ProjectTab.Cashflow, $"/projects/{ProjectId}/cashflow", "bi-graph-up", L["View_Cashflow"], null, "view-cashflow")
            @if (HasPortfolio)
            {
                @ViewLink(ProjectTab.Portfolio, $"/projects/{ProjectId}/portfolio", "bi-pie-chart", L["View_Portfolio"], null, "view-portfolio")
            }
        </nav>

        @if (Rail != null)
        {
            @Rail
        }
        else if (ownTree == null)
        {
            <div aria-busy="true" class="px-3 pt-2">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton skeleton-line" style="margin-left: @(i % 3 * 12)px;"></div>
                }
            </div>
        }
        else
        {
            <BrowseTreeRail Tree="ownTree"
                            SelectionKind="none"
                            ShowAllRow="false"
                            @bind-ShowRelatedAccounts="showRelatedAccounts"
                            OnSelectAll="@(() => OpenTransactions(null))"
                            OnSelectAccount="@(id => OpenTransactions($"acct-{id}"))"
                            OnSelectAccountGroup="@(id => OpenTransactions($"g{id}"))"
                            OnSelectPortfolio="@(() => OpenTransactions("securities"))"
                            OnSelectUncategorized="@(() => OpenTransactions("uncategorized"))"
                            OnSelectCategory="@(n => OpenTransactions((n.ItemType == CategoryItemType.Category ? "cat-" : "grp-") + n.Id))" />
        }
        @* Documents will join here as a third section. *@
    </aside>

    <div class="browse-resizer" role="separator" aria-orientation="vertical" tabindex="0"
         aria-label="@L["Aria_ResizeSidebar"]" data-testid="sidebar-resizer"></div>

    <section class="browse-main @MainClass">
        @ChildContent
    </section>
</div>

@* Phones: the bottom bar replaces the sidebar's view list; "Accounts" opens the sidebar as a sheet. *@
<nav class="app-bottombar d-print-none" aria-label="@L["Aria_Views"]" data-testid="bottom-bar">
    <button type="button" class="app-bottom-item @(open ? "active" : "")" aria-expanded="@open.ToString().ToLowerInvariant()"
            @onclick="ToggleRailAsync" data-testid="bottom-accounts">
        <i class="bi bi-wallet2" aria-hidden="true"></i><span>@L["Bottom_Accounts"]</span>
    </button>
    @BottomLink(ProjectTab.Browse, TransactionsUrl, "bi-list-ul", L["View_Transactions"])
    @BottomLink(ProjectTab.Budgets, $"/projects/{ProjectId}/budgets", "bi-calendar3", L["View_Budget"])
    @BottomLink(ProjectTab.Cashflow, $"/projects/{ProjectId}/cashflow", "bi-graph-up", L["View_Cashflow"])
    <GearMenu BottomBar="true" />
</nav>

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    /// <summary>The highlighted view.</summary>
    [Parameter] public ProjectTab? Active { get; set; }
    /// <summary>Transactions' own tree rail; other views leave it null and get the tree loaded here.</summary>
    [Parameter] public RenderFragment? Rail { get; set; }
    /// <summary>The tree behind <see cref="Rail"/>, when the page already loaded it (decides whether Portfolio shows).</summary>
    [Parameter] public BrowseTree? Tree { get; set; }
    /// <summary>Clicking "Transactions" while on Transactions: the page resets to all transactions instead of navigating.</summary>
    [Parameter] public EventCallback OnTransactions { get; set; }
    [Parameter] public bool RailOpen { get; set; }
    [Parameter] public EventCallback<bool> RailOpenChanged { get; set; }
    /// <summary>Extra classes for the main column ("shell-page" for a page that scrolls as a whole).</summary>
    [Parameter] public string? MainClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool open;
    private bool showRelatedAccounts;
    private BrowseTree? ownTree;
    private string? budgetBadge;
    private int _loadedProjectId;

    private BrowseTree? EffectiveTree => Tree ?? ownTree;
    private bool HasPortfolio => EffectiveTree?.Accounts.Any(a => a.IsPortfolio && a.IsAssigned) == true || Active == ProjectTab.Portfolio;
    private string? BudgetBadge => budgetBadge;
    private string TransactionsUrl => $"/projects/{ProjectId}/browse";

    protected override async Task OnParametersSetAsync()
    {
        open = RailOpen;
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        ownTree = null;
        budgetBadge = null;
        var now = Clock.NowLocal;
        if (Rail == null)
        {
            var (year, month) = (TimeState.Year ?? now.Year, TimeState.Month ?? now.Month);
            ownTree = await BrowseService.GetTreeAsync(ProjectId, year, month, month);
        }
        // "57 %" next to Budget: this month's spending against the budget, the number the switcher shows too.
        try
        {
            var summary = await BudgetService.GetSpendingSummaryAsync(ProjectId, now.Year, now.Month, now.Month);
            if (summary.HasBudget && summary.TotalBudget > 0)
                budgetBadge = L["Budget_Percent", ProjectStatus.OverallPercent(summary).ToString("F0", CultureInfo.CurrentCulture)];
        }
        catch (InvalidOperationException)
        {
            budgetBadge = null;   // no access / project gone: the page itself reports that
        }
    }

    private async Task SetOpenAsync(bool value)
    {
        open = value;
        await RailOpenChanged.InvokeAsync(value);
    }

    private Task ToggleRailAsync() => SetOpenAsync(!open);
    private Task CloseRailAsync() => SetOpenAsync(false);

    private void OpenTransactions(string? sel) =>
        Navigation.NavigateTo(sel == null ? TransactionsUrl : $"{TransactionsUrl}?sel={Uri.EscapeDataString(sel)}");

    private async Task OnViewClick(ProjectTab tab)
    {
        if (tab == ProjectTab.Browse && Active == ProjectTab.Browse && OnTransactions.HasDelegate)
            await OnTransactions.InvokeAsync();
        open = false;
    }

    private RenderFragment ViewLink(ProjectTab tab, string href, string icon, string label, string? badge, string testId) => __builder =>
    {
        var active = Active == tab;
        var intercept = tab == ProjectTab.Browse && active && OnTransactions.HasDelegate;
        <a class="shell-view @(active ? "active" : "")" href="@href" aria-current="@(active ? "page" : null)" data-testid="@testId"
           @onclick="() => OnViewClick(tab)" @onclick:preventDefault="intercept">
            <i class="bi @icon" aria-hidden="true"></i>
            <span class="shell-view-label">@label</span>
            @if (badge != null)
            {
                <span class="shell-view-badge">@badge</span>
            }
        </a>
    };

    private RenderFragment BottomLink(ProjectTab tab, string href, string icon, string label) => __builder =>
    {
        var active = Active == tab;
        <a class="app-bottom-item @(active ? "active" : "")" href="@href" aria-current="@(active ? "page" : null)">
            <i class="bi @icon" aria-hidden="true"></i><span>@label</span>
        </a>
    };
}
