@using OpenBudget.Services
@inject CurrentProjectState Current
@inject IJSRuntime JS

@* Placed on every project-scoped page: tells the app chrome which project the user is in (the switcher shows its
   name, the gear its settings) and remembers it as the project "/" opens next time. It renders nothing; the page's
   title is in its toolbar (PageHeader on the settings pages).

   Usage:

       <ProjectPageHeader ProjectId="@projectId" ProjectName="@name" />
*@

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    [Parameter, EditorRequired] public string? ProjectName { get; set; }

    private int _rememberedProjectId;

    protected override void OnParametersSet()
    {
        if (ProjectId > 0) Current.Set(ProjectId, ProjectName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ProjectId <= 0 || _rememberedProjectId == ProjectId) return;
        _rememberedProjectId = ProjectId;
        try { await JS.InvokeVoidAsync("obNav.rememberProject", ProjectId); }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* JS unreachable (prerender) */ }
    }
}
