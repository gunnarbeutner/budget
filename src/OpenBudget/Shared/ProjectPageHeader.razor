@using OpenBudget.Models
@using OpenBudget.Services
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject ProjectTimeState TimeState
@inject IStringLocalizer<ProjectPageHeader> L

@* Combined page-header for any project-scoped page: HomeLink + project selector +
   inline tab strip (Overview / Browse / Budgets / Cashflow) + settings cog. On md+
   everything sits in one row to save vertical space; on narrower screens the tabs wrap
   below the selector.

   The project name doubles as a switcher: click it and a dropdown lists the user's
   other projects, each linking to the same view but for that project. Uses
   <details>/<summary> so there's no JS dependency — clicking another link triggers
   navigation, which collapses the dropdown naturally.

   Active marks the current tab; leave it null on the settings page (/projects/{id}),
   where the cog becomes the active tab.

   Usage:

       <ProjectPageHeader ProjectId="@projectId" ProjectName="@name"
                          Active="ProjectTab.Cashflow"
                          Subtitle="@lastModified" />

       <ProjectPageHeader ProjectId="@projectId" ProjectName="@name" />   // settings page
*@

<div class="project-page-header d-flex flex-wrap align-items-center gap-2 mb-2">
    @if (ShowHomeLink)
    {
        <HomeLink />
    }
    @* @key on ProjectId so a client-side project switch recreates the element fresh (closed),
       replacing the full-reload that previously collapsed the dropdown for us. *@
    <details class="project-selector" @key="ProjectId">
        <summary class="project-selector-toggle">
            <span class="project-selector-name">@(ProjectName ?? "")</span>
            <i class="bi bi-caret-down-fill ms-1 project-selector-caret" aria-hidden="true"></i>
        </summary>
        <ul class="project-selector-menu dropdown-menu show">
            @if (otherProjects == null)
            {
                <li><span class="dropdown-item-text text-body-secondary small">@L["Selector_Loading"]</span></li>
            }
            else if (otherProjects.Count == 0)
            {
                <li><span class="dropdown-item-text text-body-secondary small">@L["Selector_NoOthers"]</span></li>
            }
            else
            {
                @foreach (var p in otherProjects)
                {
                    @* Client-side nav: the destination is usually the same page component for a
                       different {ProjectId}. Each project-scoped page reloads its data when
                       ProjectId changes via a guarded OnParametersSetAsync, so a full reload (and
                       the circuit teardown + prerender re-run it triggers) isn't needed. The
                       <details> dropdown collapses on its own via @key on ProjectId. *@
                    <li>
                        <button type="button" class="dropdown-item"
                                @onclick="@(() => SwitchTo(p.Id))">@p.Name</button>
                    </li>
                }
            }
        </ul>
    </details>
    @if (TitleSuffix != null)
    {
        <span class="project-page-header-suffix text-body-secondary">@TitleSuffix</span>
    }

    @* Flex spacer: when everything fits on one row this expands and pushes the tabs
       right. When the tabs wrap to a new line the spacer stays on row 1 (filling
       leftover space there), and the tabs sit flush left on row 2. ms-auto would
       have pushed them right even when wrapped, which felt off. *@
    <div class="flex-grow-1"></div>

    <nav class="nav nav-underline project-page-tabs" aria-label="@L["Aria_Sections"]">
        @* On narrow screens hide the tab labels — icons + aria-label keep them
           accessible and let the whole bar fit on a single row. *@
        <a class="nav-link @(Active == ProjectTab.Overview ? "active" : "")"
           href="@($"/projects/{ProjectId}/overview{MonthQuery}")" aria-label="@L["Tab_Overview"]">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
            <span class="d-none d-md-inline ms-1">@L["Tab_Overview"]</span>
        </a>
        <a class="nav-link @(Active == ProjectTab.Browse ? "active" : "")"
           href="@($"/projects/{ProjectId}/browse{MonthQuery}")" aria-label="@L["Tab_Browse"]">
            <i class="bi bi-list-ul" aria-hidden="true"></i>
            <span class="d-none d-md-inline ms-1">@L["Tab_Browse"]</span>
        </a>
        <a class="nav-link @(Active == ProjectTab.Budgets ? "active" : "")"
           href="@($"/projects/{ProjectId}/budgets")" aria-label="@L["Tab_Budgets"]">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="d-none d-md-inline ms-1">@L["Tab_Budgets"]</span>
        </a>
        <a class="nav-link @(Active == ProjectTab.Cashflow ? "active" : "")"
           href="@($"/projects/{ProjectId}/cashflow")" aria-label="@L["Tab_Cashflow"]">
            <i class="bi bi-graph-up" aria-hidden="true"></i>
            <span class="d-none d-md-inline ms-1">@L["Tab_Cashflow"]</span>
        </a>
        @* The settings cog reads as a secondary affordance on the data tabs, but on the
           settings page itself (Active == null) it's the active tab — underlined like the rest. *@
        <a class="nav-link project-page-tabs-settings @(Active == null ? "active" : "")"
           href="@($"/projects/{ProjectId}/settings")"
           title="@L["Tab_Settings_Tooltip"]" aria-label="@L["Tab_Settings_Tooltip"]">
            <i class="bi bi-gear" aria-hidden="true"></i>
        </a>
    </nav>
</div>

@if (!string.IsNullOrEmpty(Subtitle))
{
    <div class="project-page-header-subtitle text-body-secondary small mb-2">@Subtitle</div>
}

@code {
    [Parameter, EditorRequired] public int ProjectId { get; set; }
    [Parameter, EditorRequired] public string? ProjectName { get; set; }
    /// <summary>The active primary tab, or null when on the settings page itself.</summary>
    [Parameter] public ProjectTab? Active { get; set; }
    /// <summary>Current time anchor + period, forwarded to the Overview/Browse tabs so switching
    /// between the two month-model views keeps the user on the same month. Only the pages that use
    /// that model (Overview, Browse) pass these; from Budgets/Cashflow they stay null and the links
    /// fall back to the current month.</summary>
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }
    [Parameter] public string? Period { get; set; }
    /// <summary>Small grey text shown next to the project name (e.g. "· BudgetName" on BudgetEdit).</summary>
    [Parameter] public RenderFragment? TitleSuffix { get; set; }
    /// <summary>Secondary line below the header (e.g. "Last modified ...", wizard mode label).</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Set to false on pages where HomeLink doesn't apply.</summary>
    [Parameter] public bool ShowHomeLink { get; set; } = true;

    private List<Project>? otherProjects;
    private int? _loadedForProjectId;

    /// <summary>"?year=&month=&period=" suffix for the month-model tabs, or "" when no anchor is
    /// known. The Overview/Browse pages pass the anchor explicitly; from the year-only tabs
    /// (Budgets/Cashflow) the params fall back to the shared ProjectTimeState so the links still
    /// carry — and the destination URL still shows — the last month-model selection. Period is
    /// omitted when it's the "month" default to keep the URL clean.</summary>
    private string MonthQuery
    {
        get
        {
            var year = Year ?? TimeState.Year;
            var month = Month ?? TimeState.Month;
            if (year is null || month is null) return "";
            var period = Period ?? TimeState.Period;
            return $"?year={year}&month={month}" + (period is { Length: > 0 } p && p != "month" ? $"&period={p}" : "");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // The other-projects list depends only on ProjectId, but OnParametersSetAsync fires on
        // every parameter change (period nav, data-change reloads). Refetch only when the project
        // actually changes so a dropdown that's usually never opened doesn't re-query the project
        // list on every re-render. Switching projects does a forceLoad, so a fresh instance reloads.
        if (_loadedForProjectId == ProjectId) return;
        _loadedForProjectId = ProjectId;
        var all = await ProjectService.GetProjectsAsync();
        otherProjects = all.Where(p => p.Id != ProjectId).OrderBy(p => p.Name).ToList();
    }

    private void SwitchTo(int projectId)
    {
        var url = Active switch
        {
            ProjectTab.Overview => $"/projects/{projectId}/overview{MonthQuery}",
            ProjectTab.Browse => $"/projects/{projectId}/browse{MonthQuery}",
            ProjectTab.Budgets => $"/projects/{projectId}/budgets",
            ProjectTab.Cashflow => $"/projects/{projectId}/cashflow",
            // No Active = on the settings page; switching keeps you on settings for the new project.
            _ => $"/projects/{projectId}/settings",
        };
        Navigation.NavigateTo(url);
    }
}
