@using OpenBudget.Models
@using OpenBudget.Services
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IStringLocalizer<NewProjectDialog> L

@* "New project" (project switcher, first-run welcome): name and optional description; the project belongs to its
   creator. Creating opens the new project's Transactions. *@

<Modal Show="@Show" Title="@L["Title"]" OnClose="Close">
    <ChildContent>
            <div class="mb-3">
                <label for="new-project-name" class="form-label">@L["Label_Name"]</label>
                <input type="text" class="form-control" id="new-project-name" autocomplete="off"
                       value="@name" @oninput="e => name = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mb-3">
                <label for="new-project-description" class="form-label">@L["Label_Description"]</label>
                <textarea class="form-control" id="new-project-description" rows="3" @bind="description"></textarea>
            </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Close">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" data-testid="new-project-create" @onclick="CreateAsync"
                disabled="@(string.IsNullOrWhiteSpace(name) || busy)">@L["Button_Create"]</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string name = string.Empty;
    private string? description;
    private bool wasShown;
    private bool busy;

    protected override void OnParametersSet()
    {
        if (Show == wasShown) return;
        wasShown = Show;
        if (!Show) return;
        name = string.Empty;
        description = null;
        busy = false;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        busy = true;
        var created = await ProjectService.CreateProjectAsync(name.Trim(), description);
        await OnClose.InvokeAsync();
        Navigation.NavigateTo($"/projects/{created.Id}/browse");
    }
}
