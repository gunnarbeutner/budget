@using System.Globalization
@using OpenBudget.Services
@inject IJSRuntime JS
@inject IStringLocalizer<PeriodNav> L
@inject ClockService Clock

@* Shared sticky time-navigation strip: prev / next / today, with the current period as a
   heading in the middle. The single source of time-nav chrome across the app, so every view
   shares one vocabulary instead of each rolling its own.

   Two modes:
   • Full (default): a month-YTD-year segmented control + a clickable month heading. Used by
     the dashboard, project Overview, and Browse — the views that work at month granularity.
   • Year-only (YearOnly=true): no segmented control; the chevrons step through Years and the
     heading is the bare year. Used by Budgets / Cashflow, which are inherently annual.

   Controlled component: the parent owns Anchor + Period and reloads its data in OnChanged.
   We never mutate the parameters locally — every interaction reports the *next* state and
   waits for the parent to feed it back down. In year-only mode OnChanged reports
   (year, 1, "year") and only Year is meaningful.

   ShowMonthPicker turns the heading into a clickable <input type="month"> (full mode only).
   Leading / Trailing are page-specific slots (e.g. a rail toggle on the left, a Sources link
   pinned right).

   Usage:

       <PeriodNav Anchor="anchor" Period="period" ShowMonthPicker="true" OnChanged="OnPeriodChanged" />
       <PeriodNav Anchor="(selectedYear, 1)" Period="@("year")" YearOnly="true"
                  Years="availableYears" OnChanged="OnYearChanged" />
*@

@if (Inline)
{
    @Controls
}
else
{
    <div class="page-toolbar period-nav">
        @if (Leading != null)
        {
            @Leading
        }
        <div class="flex-grow-1"></div>
        @Controls
        @if (Trailing != null)
        {
            <div class="d-flex align-items-center gap-2">
                @Trailing
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public (int Year, int Month) Anchor { get; set; }
    [Parameter, EditorRequired] public string Period { get; set; } = "month";

    /// <summary>Fired with the next (year, month, period) after any interaction. The parent
    /// stores it and reloads, then feeds the new values back as parameters.</summary>
    [Parameter] public EventCallback<(int Year, int Month, string Period)> OnChanged { get; set; }

    /// <summary>Render the heading as a clickable month picker rather than a plain label (full mode only).</summary>
    [Parameter] public bool ShowMonthPicker { get; set; }

    /// <summary>Year-only mode: drop the period segmented control and step through <see cref="Years"/>.</summary>
    [Parameter] public bool YearOnly { get; set; }

    /// <summary>The selectable years in year-only mode; the chevrons step between adjacent entries.</summary>
    [Parameter] public IReadOnlyList<int>? Years { get; set; }

    /// <summary>Earliest selectable month in full mode (the first transaction's month). Stops the
    /// prev chevron / month picker from scrolling into empty months before any data. Defaults to
    /// 1900-01 when not supplied.</summary>
    [Parameter] public (int Year, int Month)? MinMonth { get; set; }

    /// <summary>Latest selectable month in full mode (the last transaction's month, which may be in
    /// the future — e.g. pending rows). Lets the next chevron / month picker reach future-dated data
    /// instead of stopping at the current month. Defaults to the current month when not supplied.</summary>
    [Parameter] public (int Year, int Month)? MaxMonth { get; set; }

    [Parameter] public RenderFragment? Leading { get; set; }

    /// <summary>Render only the controls (no toolbar of its own), for pages that place them in their own toolbar.</summary>
    [Parameter] public bool Inline { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }

    private ElementReference monthInputRef;

    private RenderFragment Controls => __builder =>
    {
        <div class="period-controls">
            <div class="period-stepper">
                <button type="button" class="period-step" @onclick="() => Step(-1)" aria-label="@L["Aria_Previous"]" disabled="@PrevDisabled">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                @if (YearOnly)
                {
                    <span class="period-nav-heading">@L["Heading_Year", Anchor.Year]</span>
                }
                else if (ShowMonthPicker)
                {
                    <span class="period-nav-heading position-relative" role="button" tabindex="0"
                          title="@L["Title_PickMonth"]" @onclick="OpenMonthPicker" @onkeydown="OnHeadingKey">
                        @HeadingText
                        <input @ref="monthInputRef" type="month" class="period-month-input"
                               min="@MinMonthValue" max="@MaxMonthValue"
                               value="@MonthValue" @onchange="OnMonthInput"
                               tabindex="-1" aria-hidden="true" />
                    </span>
                }
                else
                {
                    <span class="period-nav-heading browse-anchor-label">@HeadingText</span>
                }
                <button type="button" class="period-step" @onclick="() => Step(1)" aria-label="@L["Aria_Next"]" disabled="@NextDisabled">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
            @if (!TodayDisabled)
            {
                <button type="button" class="btn btn-sm btn-link period-today" @onclick="TodayClicked">@L["Button_Today"]</button>
            }
            @if (!YearOnly)
            {
                <div class="segmented" role="group" aria-label="@L["Aria_Period"]">
                    <button type="button" class="btn @(Period == "month" ? "active" : "")"
                            @onclick='() => SetPeriod("month")'>@L["Button_Month"]</button>
                    <button type="button" class="btn @(Period == "ytd" ? "active" : "")"
                            @onclick='() => SetPeriod("ytd")'>@L["Button_YTD"]</button>
                    <button type="button" class="btn @(Period == "year" ? "active" : "")"
                            @onclick='() => SetPeriod("year")'>@L["Button_Year"]</button>
                </div>
            }
        </div>
    };

    private List<int> GetSortedYears() => Years?.OrderBy(y => y).ToList() ?? new List<int>();

    private string HeadingText
    {
        get
        {
            var d = new DateTime(Anchor.Year, Anchor.Month, 1);
            return Period switch
            {
                "year" => L["Heading_Year", Anchor.Year].Value,
                "ytd" => L["Heading_YTD", d.ToString("MMMM yyyy")].Value,
                _ => d.ToString("MMMM yyyy")
            };
        }
    }

    private string MonthValue => $"{Anchor.Year:D4}-{Anchor.Month:D2}";

    // Full-mode navigation bounds. Default to [1900-01 .. current month] so callers that don't
    // supply a data range keep the historical "no future" behaviour.
    private (int Year, int Month) EffectiveMin => MinMonth ?? (1900, 1);
    private (int Year, int Month) EffectiveMax
    {
        get { var now = Clock.NowLocal; return MaxMonth ?? (now.Year, now.Month); }
    }
    // Where the "Today" button lands: the real current month, clamped into the data window.
    private (int Year, int Month) TodayTarget
    {
        get { var now = Clock.NowLocal; return Anchoring.Clamp((now.Year, now.Month), EffectiveMin, EffectiveMax); }
    }

    private string MinMonthValue => $"{EffectiveMin.Year:D4}-{EffectiveMin.Month:D2}";
    private string MaxMonthValue => $"{EffectiveMax.Year:D4}-{EffectiveMax.Month:D2}";

    // The adjacent selectable year in the given direction, or null at the ends / when the
    // current year isn't in the list. Year-only mode steps between list entries (not raw ±1)
    // so it never lands on a year with no data, mirroring the old <select>.
    private int? AdjacentYear(int direction)
    {
        var ys = GetSortedYears();
        var idx = ys.IndexOf(Anchor.Year);
        if (idx < 0) return null;
        var ni = idx + direction;
        return ni >= 0 && ni < ys.Count ? ys[ni] : (int?)null;
    }

    private bool PrevDisabled => YearOnly
        ? AdjacentYear(-1) is null
        : Anchoring.IsAtMin(Anchor, Period, EffectiveMin);
    private bool NextDisabled => YearOnly
        ? AdjacentYear(1) is null
        : Anchoring.IsAtMax(Anchor, Period, EffectiveMax);
    private bool TodayDisabled => YearOnly
        ? !(GetSortedYears().Contains(Clock.NowLocal.Year) && Clock.NowLocal.Year != Anchor.Year)
        : Anchor == TodayTarget;

    private async Task Step(int direction)
    {
        if (YearOnly)
        {
            if (AdjacentYear(direction) is { } yr)
                await OnChanged.InvokeAsync((yr, 1, "year"));
            return;
        }
        var next = Anchoring.Step(Anchor, Period, direction, EffectiveMin, EffectiveMax);
        if (next == Anchor) return;
        await OnChanged.InvokeAsync((next.Year, next.Month, Period));
    }

    private async Task TodayClicked()
    {
        if (YearOnly)
        {
            var now = Clock.NowLocal;
            if (GetSortedYears().Contains(now.Year) && now.Year != Anchor.Year)
                await OnChanged.InvokeAsync((now.Year, 1, "year"));
            return;
        }
        var target = TodayTarget;
        if (Anchor == target) return;
        await OnChanged.InvokeAsync((target.Year, target.Month, Period));
    }

    private async Task SetPeriod(string value)
    {
        if (value == Period) return;
        await OnChanged.InvokeAsync((Anchor.Year, Anchor.Month, value));
    }

    private async Task OnMonthInput(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM",
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
        {
            var clamped = Anchoring.Clamp((dt.Year, dt.Month), EffectiveMin, EffectiveMax);
            if (clamped == Anchor) return;
            await OnChanged.InvokeAsync((clamped.Year, clamped.Month, Period));
        }
    }

    private async Task OpenMonthPicker() => await JS.InvokeVoidAsync("showPickerOn", monthInputRef);

    private async Task OnHeadingKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar") await OpenMonthPicker();
    }
}
