@* A button for an async action: while the action runs it is disabled and shows a small spinner, so a slow click gives
   feedback and cannot run twice. Siblings that must wait too pass the same Busy state (BusyChanged reports it). *@

<button type="button" class="@Class" disabled="@(Disabled || running || Busy)" data-testid="@TestId" aria-busy="@(running ? "true" : null)"
        title="@Title" @onclick="RunAsync" @attributes="Attributes">
    @if (running)
    {
        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
    }
    @ChildContent
</button>

@code {
    [Parameter, EditorRequired] public Func<Task> OnClick { get; set; } = null!;
    [Parameter] public string Class { get; set; } = "btn btn-primary";
    [Parameter] public string? TestId { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Disables this button while a sibling's action runs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Reports when this button's action starts (true) and ends (false).</summary>
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private bool running;

    private async Task RunAsync()
    {
        if (running) return;
        running = true;
        await BusyChanged.InvokeAsync(true);
        try
        {
            await OnClick();
        }
        finally
        {
            running = false;
            await BusyChanged.InvokeAsync(false);
        }
    }
}
