@page "/sources/{SourceId:int}/tax"
@attribute [RequireSourceOwner]
@inherits DataChangeAwareComponent
@using System.Globalization
@using OpenBudget.Models
@using OpenBudget.Services
@inject SecurityTaxService TaxService
@inject ProjectService ProjectService
@inject PortfolioService PortfolioService
@inject NavigationManager Navigation
@inject IStringLocalizer<SecurityTax> L

<SettingsShell Active="sources" Bare="@Embedded">
@if (!Embedded)
{
<PageTitle>@(sourceName != null ? L["PageTitle_WithSource", sourceName] : L["PageTitle"])</PageTitle>

<PageHeader Title="@L["Heading"]" Subtitle="@sourceName">
    <Actions>
        <a class="ob-btn" href="/sources"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@L["Back"]</a>
    </Actions>
</PageHeader>
}

@if (loading)
{
    <div class="skeleton skeleton-block" aria-busy="true"></div>
}
else if (notFound)
{
    <div class="alert alert-warning">@L["NotFound"]</div>
}
else if (rows.Count == 0)
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <p class="text-body-secondary">@L["Intro"]</p>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Col_Security"]</th>
                <th style="width: 15rem;">@L["Col_Kind"]</th>
                <th style="width: 18rem;">@L["Col_Details"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rows)
            {
                <tr @key="r.Uuid">
                    <td>
                        <div class="fw-semibold">@r.Name</div>
                        <div class="text-body-secondary small">@(r.HasIsin ? r.Isin : L["NoIsin"])</div>
                    </td>
                    <td>
                        <select class="form-select form-select-sm" value="@r.Kind"
                                @onchange="e => OnKindChanged(r, e.Value)">
                            @foreach (var k in Kinds)
                            {
                                <option value="@k">@L[$"Kind_{k}"]</option>
                            }
                        </select>
                    </td>
                    <td>
                        @if (r.Kind == (int)InstrumentTaxKind.Security)
                        {
                            <select class="form-select form-select-sm" value="@r.TeilfreistellungBp"
                                    @onchange="e => OnTeilfreistellungChanged(r, e.Value)">
                                @foreach (var bp in TeilfreistellungOptions)
                                {
                                    <option value="@bp">@($"{bp / 100}%") — @L[$"Type_{bp}"]</option>
                                }
                            </select>
                        }
                        else
                        {
                            @* §23: let the user set the original acquisition date for an inherited/gifted
                               asset, where the Spekulationsfrist counts from the predecessor's purchase. *@
                            <input type="date" class="form-control form-control-sm"
                                   value="@(r.AcquiredOverride?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                                   @onchange="e => OnAcquiredChanged(r, e.Value)" />
                            <div class="text-body-secondary small">@L["Acquired_Hint"]</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

</SettingsShell>

@code {

    [Parameter] public int SourceId { get; set; }
    /// <summary>Shown inside the Portfolio view (no page title, header or back link, no redirect).</summary>
    [Parameter] public bool Embedded { get; set; }

    // The source-level page moved into the Portfolio view of a project that uses the source; it stays here only
    // when no project on the source has a depot (reached from the Sources page).
    private async Task<bool> RedirectToPortfolioAsync(string tab)
    {
        if (Embedded || await PortfolioService.FindPortfolioProjectAsync(SourceId) is not { } pid) return false;
        Navigation.NavigateTo($"/projects/{pid}/portfolio?tab={tab}", replace: true);
        return true;
    }

    private static readonly int[] Kinds = { 0, 1, 2 };                              // InstrumentTaxKind
    private static readonly int[] TeilfreistellungOptions = { 0, 1500, 3000, 6000, 8000 };

    private List<SecurityTaxRow> rows = new();
    private string? sourceName;
    private bool loading = true;
    private bool notFound;
    private int _loadedSourceId = -1;

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportedData or DataArea.Sources && (change.SourceId == null || change.SourceId == SourceId);
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSourceId == SourceId) return;
        _loadedSourceId = SourceId;
        if (await RedirectToPortfolioAsync("tax")) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var sources = await ProjectService.GetAllSourcesAsync();
        var source = sources.FirstOrDefault(s => s.Id == SourceId);
        if (source == null) { notFound = true; loading = false; return; }
        sourceName = source.Name;
        rows = await TaxService.GetSettingsAsync(SourceId);
        loading = false;
    }

    private async Task OnKindChanged(SecurityTaxRow r, object? value)
    {
        if (!int.TryParse(value?.ToString(), out var kind)) return;
        await TaxService.SetAsync(SourceId, r.Uuid, kind, r.TeilfreistellungBp, r.AcquiredOverride);
        rows = await TaxService.GetSettingsAsync(SourceId);
    }

    private async Task OnTeilfreistellungChanged(SecurityTaxRow r, object? value)
    {
        if (!int.TryParse(value?.ToString(), out var bp)) return;
        await TaxService.SetAsync(SourceId, r.Uuid, r.Kind, bp, r.AcquiredOverride);
        rows = await TaxService.GetSettingsAsync(SourceId);
    }

    private async Task OnAcquiredChanged(SecurityTaxRow r, object? value)
    {
        DateOnly? date = DateOnly.TryParse(value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;
        await TaxService.SetAsync(SourceId, r.Uuid, r.Kind, r.TeilfreistellungBp, date);
        rows = await TaxService.GetSettingsAsync(SourceId);
    }
}
