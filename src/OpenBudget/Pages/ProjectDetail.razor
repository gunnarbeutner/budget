@page "/projects/{ProjectId:int}/settings"
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject CategoryHierarchyService CategoryHierarchyService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProjectDetail> L

<PageTitle>@(budget?.Name ?? L["PageTitle_Default"])</PageTitle>

@if (budget == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line-lg mb-3" style="width: 35%;"></div>
        <div class="skeleton skeleton-line mb-4" style="width: 60%;"></div>
        <div class="card mb-3">
            <div class="card-body">
                <div class="skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
}
else
{
    <ProjectPageHeader ProjectId="@ProjectId" ProjectName="@budget.Name"
                       Subtitle="@budget.Description" />

    <DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@L["ParentProject_Heading"]</h5>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary small mb-2">@L["ParentProject_Description"]</p>
                    @if (hasOwnChildren)
                    {
                        <p class="text-body-secondary mb-0"><em>@L["ParentProject_HasChildren", childProjectNames]</em></p>
                    }
                    else
                    {
                        <div class="row g-2 align-items-center">
                            <div class="col-md-6">
                                <select class="form-select form-select-sm"
                                        value="@(budget.ParentProjectId?.ToString() ?? "")"
                                        @onchange="OnParentChanged"
                                        disabled="@(eligibleParents == null)">
                                    <option value="">@L["ParentProject_None"]</option>
                                    @if (eligibleParents != null)
                                    {
                                        foreach (var p in eligibleParents)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            @if (!string.IsNullOrEmpty(parentSaveError))
                            {
                                <div class="col-md-6">
                                    <small class="text-danger">@parentSaveError</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["CategoryAssignments_Heading"]</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddCategoryDialog">@L["Button_AddCategory"]</button>
                </div>
                <div class="card-body">
                    @if (!budget.CategoryAssignments.Any())
                    {
                        <p class="text-body-secondary">@L["CategoryAssignments_Empty"]</p>
                    }
                    else
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>@L["Table_Category"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var assignment in budget.CategoryAssignments)
                                {
                                    var categoryName = categoryNames.GetValueOrDefault(assignment.CategoryId, L["Status_Loading"].Value);

                                    <tr>
                                        <td>@categoryName</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveCategory(assignment.CategoryId)">@L["Button_Remove"]</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Accounts_Heading"]</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddAccountDialog">@L["Button_AddAccount"]</button>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary small mb-3">
                        @L["Accounts_Description_Before"]<strong>@L["Accounts_Description_Shared"]</strong>@L["Accounts_Description_Middle"]<strong>@L["Accounts_Description_Exclusive"]</strong>@L["Accounts_Description_After"]
                    </p>
                    @if (accountAssignments == null || allAccounts == null)
                    {
                        <p class="text-body-secondary mb-0"><em>@L["Status_LoadingEllipsis"]</em></p>
                    }
                    else if (!accountAssignments.Any())
                    {
                        <p class="text-body-secondary mb-0">@L["Accounts_Empty"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Table_Account"]</th>
                                        <th>@L["Table_Kind"]</th>
                                        <th class="text-end">@L["Table_CurrentBalance"]</th>
                                        <th>@L["Table_LastRefresh"]</th>
                                        <th>@L["Table_Scope"]</th>
                                        <th class="text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in accountAssignments)
                                    {
                                        var account = allAccounts.FirstOrDefault(a => a.Id == assignment.AccountId);
                                        var name = account?.Name ?? L["Account_MissingName", assignment.AccountId].Value;
                                        var kind = account?.KindLabel ?? L["Dash"].Value;
                                        var balance = account?.CurrentBalance;
                                        var currency = account?.Currency ?? "";
                                        var lastRefresh = account?.LastRefreshUtc;
                                        var refreshAge = lastRefresh.HasValue ? DateTime.UtcNow - lastRefresh.Value : (TimeSpan?)null;
                                        var refreshError = account?.Error;
                                        <tr>
                                            <td>@name</td>
                                            <td><span class="badge bg-secondary">@kind</span></td>
                                            <td class="text-end">@(balance.HasValue ? FormatMoney(balance.Value, currency) : L["Dash"].Value)</td>
                                            <td>
                                                @if (refreshAge.HasValue)
                                                {
                                                    var refreshClass = refreshAge.Value.TotalDays > 7 ? "text-danger fw-semibold"
                                                        : refreshAge.Value.TotalHours > 36 ? "text-warning fw-semibold"
                                                        : "text-body-secondary";
                                                    <span class="small @refreshClass" title="@(lastRefresh!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))">@FormatRelativeAge(refreshAge.Value)</span>
                                                }
                                                else
                                                {
                                                    <span class="small text-body-secondary">@L["Refresh_Manual"]</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(refreshError))
                                                {
                                                    <span class="badge bg-danger ms-1" title="@refreshError">@L["Refresh_Error"]</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="segmented" role="group">
                                                    <button type="button"
                                                            class="btn @(assignment.Scope == AccountScope.Shared ? "active" : "")"
                                                            @onclick="() => SetAccountScope(assignment.AccountId, AccountScope.Shared)">
                                                        @L["Scope_Shared"]
                                                    </button>
                                                    <button type="button"
                                                            class="btn @(assignment.Scope == AccountScope.Exclusive ? "active" : "")"
                                                            @onclick="() => SetAccountScope(assignment.AccountId, AccountScope.Exclusive)">
                                                        @L["Scope_Exclusive"]
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAccount(assignment.AccountId)">@L["Button_Remove"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@L["IncomeExpense_Heading"]</h5>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary">
                        @L["IncomeExpense_Description"]
                    </p>

                    @if (isLoadingCategoryTypes)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">@L["Status_Loading"]</span>
                            </div>
                        </div>
                    }
                    else if (incomeExpenseCategories.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>@L["Table_Category"]</th>
                                        <th>@L["Table_Type"]</th>
                                        <th>@L["Table_Action"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var categoryWithLevel in incomeExpenseCategories)
                                    {
                                        var typeInfo = GetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType);
                                        var isIncome = typeInfo.IsIncome;
                                        var isInherited = typeInfo.IsInherited;
                                        var isExplicit = typeInfo.IsExplicit;

                                        var displayType = isIncome ? L["Type_Income"].Value : L["Type_Expense"].Value;
                                        if (isInherited) displayType += L["Type_Inherited_Suffix"].Value;
                                        else if (!isExplicit) displayType += L["Type_Default_Suffix"].Value;

                                        var badgeClass = isIncome ? "bg-success" : "bg-danger";
                                        if (isInherited || !isExplicit) badgeClass = isIncome ? "bg-success bg-opacity-50" : "bg-danger bg-opacity-50";

                                        <tr>
                                            <td style="padding-left: @((categoryWithLevel.Level * 20))px">@categoryWithLevel.CategoryGroup.Name</td>
                                            <td><span class="badge @badgeClass">@displayType</span></td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-success"
                                                            @onclick="() => SetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType, true)"
                                                            disabled="@isInherited">
                                                        @L["Type_Income"]
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger"
                                                            @onclick="() => SetCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType, false)"
                                                            disabled="@isInherited">
                                                        @L["Type_Expense"]
                                                    </button>
                                                    @if (isExplicit)
                                                    {
                                                        <button type="button" class="btn btn-outline-secondary"
                                                                @onclick="() => ClearCategoryType(categoryWithLevel.CategoryGroup.Id, categoryWithLevel.CategoryGroup.ItemType)">
                                                            @L["Button_Clear"]
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            @L["IncomeExpense_Empty"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Tracking_Heading"]</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowTrackingDialog">@L["Button_ConfigureTracking"]</button>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary">
                        @L["Tracking_Description"]
                    </p>
                    @if (trackingItems == null || !trackingItems.Any())
                    {
                        <p class="text-body-secondary">@L["Tracking_Empty"]</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in trackingItems)
                            {
                                var name = item.CategoryGroupId.HasValue
                                    ? trackingCategoryNames.GetValueOrDefault(item.CategoryGroupId.Value, L["Status_Loading"].Value)
                                    : trackingCategoryNames.GetValueOrDefault(item.CategoryId!.Value, L["Status_Loading"].Value);
                                var type = item.CategoryGroupId.HasValue ? L["Tracking_Item_Group"].Value : L["Tracking_Item_Category"].Value;

                                <span class="badge bg-secondary">@L["Tracking_Item_Label", name, type]</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Destructive action lives at the very bottom of the page, well below the data the
       user might be configuring — far enough from the title bar that it can't be hit
       by accident. *@
    <div class="border-top pt-3 mt-4">
        <button class="btn btn-outline-danger" @onclick="ShowDeleteDialog">@L["Button_DeleteProject"]</button>
    </div>
}

<Modal Show="@showDeleteDialog" Title="@L["Modal_DeleteProject_Title"]" OnClose="@HideDeleteDialog">
    <ChildContent>
        <p>@L["Modal_DeleteProject_Body_Before"]<strong>@budget?.Name</strong>@L["Modal_DeleteProject_Body_After"]</p>
        <p class="text-body-secondary small mb-0">@L["Modal_DeleteProject_Warning"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteProject">@L["Button_Delete"]</button>
    </Footer>
</Modal>

<Modal Show="@showTrackingDialog" Title="@L["Modal_ConfigureTracking_Title"]" SizeClass="modal-xl" OnClose="@HideTrackingDialog">
    <ChildContent>
        <p class="text-body-secondary">
            @L["Modal_ConfigureTracking_Description"]
        </p>

        <div class="tracking-tree-scroll">
            @if (allAvailableCategories != null && allActualCategories != null)
            {
                // Treat any group whose parent is outside the filtered subset as a render
                // root, since IsRootCategory only matches MoneyMoney's top-level groups and
                // the project might be scoped to a sub-tree.
                var filteredGroupIds = allAvailableCategories
                    .Where(c => c.ItemType == CategoryItemType.Group)
                    .Select(c => c.Id)
                    .ToHashSet();
                @foreach (var rootCat in allAvailableCategories
                    .Where(c => c.ItemType == CategoryItemType.Group
                        && !filteredGroupIds.Contains(c.ParentCategoryGroupId ?? -1))
                    .OrderBy(c => c.CategoryGroup.Name))
                {
                    <CategoryTree
                        CategoryGroup="@rootCat"
                        Level="0"
                        RenderMode="CategoryTreeRenderMode.Checkbox"
                        ParentSelected="false"
                        SelectedCategoryGroupIds="@selectedTrackingGroupIds"
                        SelectedCategoryIds="@selectedTrackingCategoryIds"
                        OnCategoryGroupToggle="@HandleTrackingGroupToggle"
                        OnCategoryToggle="@HandleTrackingCategoryToggle"
                        AllCategories="@allAvailableCategories"
                        ActualCategories="@allActualCategories" />
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideTrackingDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" @onclick="SaveTrackingConfiguration">@L["Button_Save"]</button>
    </Footer>
</Modal>

<Modal Show="@showAddAccountDialog" Title="@L["Modal_AddAccount_Title"]" SizeClass="modal-lg" OnClose="@HideAddAccountDialog">
    <ChildContent>
        @if (allAccounts == null || accountAssignments == null || allAccountGroups == null)
        {
            <p><em>@L["Status_LoadingAccounts"]</em></p>
        }
        else
        {
            var assignedIds = accountAssignments.Select(a => a.AccountId).ToHashSet();
            var unassigned = allAccounts.Where(a => !assignedIds.Contains(a.Id)).ToList();
            if (!unassigned.Any())
            {
                <p class="text-body-secondary mb-0">@L["AddAccount_AllAssigned"]</p>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">@L["Form_AccountLabel"]</label>
                    <TreePicker TId="long"
                                Nodes="@BuildAccountPickerNodes(allAccountGroups, unassigned)"
                                SelectedId="@addAccountSelectedId"
                                SelectedIdChanged="@(id => addAccountSelectedId = id)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Form_ScopeLabel"]</label>
                    <div class="segmented segmented-block" role="group">
                        <input type="radio" class="btn-check" name="addAccountScope" id="addAccountScopeShared"
                               checked="@(addAccountSelectedScope == AccountScope.Shared)"
                               @onchange="@(() => addAccountSelectedScope = AccountScope.Shared)" />
                        <label class="btn" for="addAccountScopeShared">@L["Scope_Shared"]</label>

                        <input type="radio" class="btn-check" name="addAccountScope" id="addAccountScopeExclusive"
                               checked="@(addAccountSelectedScope == AccountScope.Exclusive)"
                               @onchange="@(() => addAccountSelectedScope = AccountScope.Exclusive)" />
                        <label class="btn" for="addAccountScopeExclusive">@L["Scope_Exclusive"]</label>
                    </div>
                    <small class="form-text text-body-secondary">
                        @L["AddAccount_ScopeHelp"]
                    </small>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideAddAccountDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary"
                @onclick="AddAccount"
                disabled="@(addAccountSelectedId == 0)">@L["Button_AddAccount"]</button>
    </Footer>
</Modal>

<Modal Show="@showAddCategoryDialog" Title="@L["Modal_AddCategory_Title"]" SizeClass="modal-lg" OnClose="@HideAddCategoryDialog">
    <ChildContent>
        @if (availableCategoriesWithCounts == null)
        {
            <p><em>@L["Status_LoadingCategories"]</em></p>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">@L["Form_SelectCategoryLabel"]</label>
                <TreePicker TId="long"
                            Nodes="@BuildCategoryPickerNodes(availableCategoriesWithCounts)"
                            SelectedId="@selectedCategoryId"
                            SelectedIdChanged="@(id => selectedCategoryId = id)" />
                <small class="form-text text-body-secondary">@L["AddCategory_Help"]</small>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideAddCategoryDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" @onclick="AddCategory" disabled="@(selectedCategoryId == 0)">@L["Button_AddCategory"]</button>
    </Footer>
</Modal>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private Project? budget;
    private Dictionary<long, string> categoryNames = new();
    private List<CategoryGroupWithChildCount>? availableCategoriesWithCounts;

    private bool showAddCategoryDialog = false;
    private long selectedCategoryId = 0;
    private bool showDeleteDialog = false;

    // Tracking configuration
    private List<ProjectTrackingItem>? trackingItems;
    private Dictionary<long, string> trackingCategoryNames = new();
    private bool showTrackingDialog = false;
    private HashSet<long> selectedTrackingGroupIds = new();
    private HashSet<long> selectedTrackingCategoryIds = new();
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private List<Category>? allActualCategories;

    // Income/Expense configuration
    private List<CategoryWithLevel> incomeExpenseCategories = new();
    private List<CategoryTypeAssignment> categoryTypeAssignments = new();
    private bool isLoadingCategoryTypes = false;

    // Account assignments
    private List<ProjectAccountAssignment>? accountAssignments;
    private List<Account>? allAccounts;
    private List<AccountGroup>? allAccountGroups;
    private bool showAddAccountDialog = false;
    private long addAccountSelectedId = 0;
    private AccountScope addAccountSelectedScope = AccountScope.Shared;

    // Parent project picker. eligibleParents = top-level projects in the same MoneyMoney
    // source (cycle-prevention; only single-level hierarchies). hasOwnChildren disables the
    // picker — projects that already act as parents can't themselves become children yet.
    private List<Project>? eligibleParents;
    private bool hasOwnChildren = false;
    private string childProjectNames = "";
    private string? parentSaveError;

    private class CategoryWithLevel
    {
        public CategoryGroupWithChildCount CategoryGroup { get; set; } = null!;
        public int Level { get; set; }
    }

    /// <summary>
    /// Walk the unified category hierarchy and produce a flat, depth-first list of rows for
    /// the Add Category picker. Every level mixes sub-groups and leaf categories sorted
    /// together by MoneyMoney's <c>sort</c> field, so the order matches what the user sees
    /// in MoneyMoney. Nodes with empty/null names are skipped — those are the source's
    /// "unsorted" sentinel rows we don't want users picking.
    /// </summary>
    private List<TreePickerNode<long>> BuildCategoryPickerNodes(List<CategoryGroupWithChildCount> items)
    {
        var groupChildrenByParent = items
            .Where(c => c.ItemType == CategoryItemType.Group && c.ParentCategoryGroupId.HasValue)
            .GroupBy(c => c.ParentCategoryGroupId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
        var categoryChildrenByParent = items
            .Where(c => c.ItemType == CategoryItemType.Category && c.ParentCategoryGroupId.HasValue)
            .GroupBy(c => c.ParentCategoryGroupId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());

        var roots = items
            .Where(c => c.ItemType == CategoryItemType.Group && c.IsRootCategory)
            .OrderBy(c => c.CategoryGroup.Sort ?? long.MaxValue)
            .ThenBy(c => c.CategoryGroup.Name)
            .ToList();

        var nodes = new List<TreePickerNode<long>>();

        long SortKey(CategoryGroupWithChildCount c) =>
            (c.ItemType == CategoryItemType.Group ? c.CategoryGroup.Sort : c.Category?.Sort) ?? long.MaxValue;

        void Walk(CategoryGroupWithChildCount item, int level)
        {
            var name = item.Name;
            if (string.IsNullOrWhiteSpace(name)) return;

            var isGroup = item.ItemType == CategoryItemType.Group;
            var label = name;
            if (isGroup && item.DirectChildCount > 0)
            {
                label += L["Form_SubCategories", item.DirectChildCount].Value;
            }
            // MoneyMoney doesn't visually distinguish category groups from leaf categories,
            // so we use the same icon for both — only the indent signals depth.
            nodes.Add(new TreePickerNode<long>(item.Id, level, Selectable: true, label, Icon: "bi-tag-fill"));

            if (!isGroup) return;

            var children = new List<CategoryGroupWithChildCount>();
            if (groupChildrenByParent.TryGetValue(item.CategoryGroup.Id, out var subGroups))
                children.AddRange(subGroups);
            if (categoryChildrenByParent.TryGetValue(item.CategoryGroup.Id, out var cats))
                children.AddRange(cats);

            foreach (var c in children.OrderBy(SortKey).ThenBy(c => c.Name))
            {
                Walk(c, level + 1);
            }
        }

        foreach (var root in roots) Walk(root, 0);
        return nodes;
    }

    /// <summary>
    /// Walk MoneyMoney's account_groups hierarchy and produce a flat, depth-first list of
    /// rows for the Add-Account picker: each visited group emits a disabled header followed
    /// by its sub-groups (recursively) and then its leaf accounts. Sorting at every level
    /// matches MoneyMoney's <c>sort</c> field. Sub-trees that contain no <paramref name="unassigned"/>
    /// account are pruned so the picker doesn't show dead branches. Accounts whose
    /// <c>group_key</c> doesn't resolve to a known group are bucketed under "Other" at the bottom.
    /// </summary>
    private List<TreePickerNode<long>> BuildAccountPickerNodes(List<AccountGroup> groups, List<Account> unassigned)
    {
        // Root = any group whose ParentGroupId doesn't point at another known group. MoneyMoney
        // stores top-level groups with group_key=0; namespacing turns that into a value that
        // doesn't resolve to a real group ID, so the "unresolved parent" check covers both
        // null and the namespaced-zero sentinel.
        var groupById = groups.ToDictionary(g => g.Id);
        bool IsRoot(AccountGroup g) =>
            !g.ParentGroupId.HasValue || !groupById.ContainsKey(g.ParentGroupId.Value);

        var childGroupsByParent = groups
            .Where(g => !IsRoot(g))
            .GroupBy(g => g.ParentGroupId!.Value)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(x => x.Sort ?? long.MaxValue)
                .ThenBy(x => x.Name)
                .ToList());
        var rootGroups = groups
            .Where(IsRoot)
            .OrderBy(g => g.Sort ?? long.MaxValue)
            .ThenBy(g => g.Name)
            .ToList();
        var accountsByGroup = unassigned
            .Where(a => a.GroupId.HasValue && groupById.ContainsKey(a.GroupId.Value))
            .GroupBy(a => a.GroupId!.Value)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(a => a.Sort ?? long.MaxValue)
                .ThenBy(a => a.Name)
                .ToList());
        var orphans = unassigned
            .Where(a => !a.GroupId.HasValue || !groupById.ContainsKey(a.GroupId!.Value))
            .OrderBy(a => a.Sort ?? long.MaxValue)
            .ThenBy(a => a.Name)
            .ToList();

        bool HasUnassignedInSubtree(AccountGroup group)
        {
            if (accountsByGroup.ContainsKey(group.Id)) return true;
            if (!childGroupsByParent.TryGetValue(group.Id, out var subs)) return false;
            foreach (var sub in subs)
                if (HasUnassignedInSubtree(sub)) return true;
            return false;
        }

        TreePickerNode<long> MakeAccountNode(Account account, int level)
        {
            var balance = account.CurrentBalance;
            var label = $"{account.Name} ({account.KindLabel})"
                + (balance.HasValue ? $" — {FormatMoney(balance.Value, account.Currency ?? "")}" : "");
            return new TreePickerNode<long>(account.Id, level, Selectable: true, label, Icon: account.KindIcon);
        }

        var nodes = new List<TreePickerNode<long>>();

        void Walk(AccountGroup group, int level)
        {
            if (!HasUnassignedInSubtree(group)) return;
            nodes.Add(new TreePickerNode<long>(group.Id, level, Selectable: false, group.Name ?? "—", Icon: "bi-folder"));
            if (childGroupsByParent.TryGetValue(group.Id, out var subs))
            {
                foreach (var sub in subs) Walk(sub, level + 1);
            }
            if (accountsByGroup.TryGetValue(group.Id, out var accounts))
            {
                foreach (var a in accounts) nodes.Add(MakeAccountNode(a, level + 1));
            }
        }

        foreach (var root in rootGroups) Walk(root, 0);

        if (orphans.Any())
        {
            nodes.Add(new TreePickerNode<long>(0, 0, Selectable: false, L["AddAccount_OtherGroup"], Icon: "bi-folder"));
            foreach (var a in orphans) nodes.Add(MakeAccountNode(a, 1));
        }

        return nodes;
    }

