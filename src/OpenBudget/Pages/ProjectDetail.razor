@page "/projects/{ProjectId:int}/settings"
@page "/projects/{ProjectId:int}/settings/{Section}"
@attribute [RequireProjectRole(OpenBudget.Models.ProjectRole.Editor)]
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject CategoryHierarchyService CategoryHierarchyService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProjectDetail> L
@inject AccessScopeProvider AccessProvider

<PageTitle>@(budget?.Name ?? L["PageTitle_Default"])</PageTitle>

@* The project's settings in four views — General (name, description, parent, default for new accounts, deleting),
   Accounts, Categories, Sharing — each at its own URL under
   /projects/{id}/settings, with the views listed on the left (a row of tabs above the view on a phone). Accounts
   and Sharing are owner-only; an editor opening them lands on General. The anchors #accounts-categories and
   #sharing on the General URL open the matching view. Every change is saved right away (name and description after a
   short pause in typing). *@

<ProjectShell ProjectId="ProjectId" MainClass="shell-page settings-page">
@if (budget == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line-lg my-3" style="width: 35%;"></div>
        <div class="skeleton skeleton-line mb-4" style="width: 60%;"></div>
        <div class="card mb-3">
            <div class="card-body">
                <div class="skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
}
else
{
    <ProjectPageHeader ProjectId="@ProjectId" ProjectName="@budget.Name" />
    <PageHeader Title="@L["Heading_Settings", budget.Name]" Subtitle="@budget.Description" />

    <DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

    <div class="project-settings">
        <nav class="project-settings-nav" aria-label="@L["Aria_SettingsNav"]" data-testid="project-settings-nav">
            @NavItem(GeneralSection, "bi-sliders2", L["Nav_General"])
            @if (isOwner)
            {
                @NavItem(AccountsSection, "bi-wallet2", L["Nav_Accounts"])
            }
            @NavItem(CategoriesSection, "bi-diagram-3", L["Nav_Categories"])
            @if (isOwner)
            {
                @NavItem(SharingSection, "bi-people", L["Nav_Sharing"])
            }
        </nav>
        <div class="project-settings-view" data-testid="@($"project-settings-view-{loadedSection}")">
            @switch (loadedSection)
            {
                case GeneralSection:
                    <div class="card" data-testid="project-general-card">
                        <div class="card-header"><h5 class="mb-0">@L["Heading_General"]</h5></div>
                        <div class="card-body">
                            @if (generalError != null)
                            {
                                <div class="alert alert-danger py-2" role="alert">@generalError</div>
                            }
                            <div class="mb-3">
                                <label for="project-name" class="form-label">@L["Label_Name"]</label>
                                <input type="text" class="form-control project-settings-field" id="project-name" autocomplete="off"
                                       value="@editName" @oninput="OnNameInput" @onchange="SaveGeneralAsync" />
                            </div>
                            <div class="mb-0">
                                <label for="project-description" class="form-label">@L["Label_Description"]</label>
                                <textarea class="form-control project-settings-field" id="project-description" rows="2"
                                          value="@editDescription" @oninput="OnDescriptionInput" @onchange="SaveGeneralAsync"></textarea>
                            </div>
                            <div class="small text-body-secondary mt-1" aria-live="polite" data-testid="project-general-saved">@(generalSaved ? L["Status_Saved"] : "")</div>
                        </div>
                    </div>
                    @if (isOwner)
                    {
                        <ProjectParentCard HasOwnChildren="hasOwnChildren"
                                           ChildProjectNames="@childProjectNames"
                                           ParentProjectId="budget.ParentProjectId"
                                           EligibleParents="eligibleParents"
                                           SaveError="@parentSaveError"
                                           OnParentChanged="OnParentChanged" />
                        <div class="card mt-3" data-testid="project-default-card">
                            <div class="card-body">
                                <ProjectDefaultClearedNotice ProjectId="ProjectId" />
                                @if (defaultState is { } d)
                                {
                                    <div class="form-check form-switch mb-1">
                                        <input class="form-check-input" type="checkbox" role="switch" id="default-project-toggle"
                                               checked="@d.IsDefault" disabled="@(d.IsShared && !d.IsDefault)" @onchange="OnDefaultChanged" />
                                        <label class="form-check-label" for="default-project-toggle">@L["Default_Toggle"]</label>
                                    </div>
                                    <p class="text-body-secondary small mb-0" id="default-project-help">
                                        @(d.IsShared ? L["Default_SharedExplanation"] : L["Default_Description"])
                                    </p>
                                }
                            </div>
                        </div>
                        @* The destructive action sits at the bottom of the view, away from the fields above. *@
                        <div class="card border-danger mt-4" data-testid="project-danger-zone">
                            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                                <span class="flex-grow-1 small text-body-secondary">@L["Delete_Hint"]</span>
                                <button class="btn btn-outline-danger" @onclick="ShowDeleteDialog">@L["Button_DeleteProject"]</button>
                            </div>
                        </div>
                    }
                    break;

                case AccountsSection:
                    <ProjectAccountsPanel ProjectId="ProjectId" />
                    break;

                case CategoriesSection:
                    <ProjectCategoryAssignmentsCard Assignments="budget.CategoryAssignments.ToList()"
                                                    CategoryNames="categoryNames"
                                                    AvailableCategories="availableCategoriesWithCounts"
                                                    OnAddDialogOpening="LoadAvailableCategoriesAsync"
                                                    OnAdd="AddCategory"
                                                    OnRemove="RemoveCategory" />

                    <ProjectIncomeExpenseCard Categories="incomeExpenseCategories"
                                              TypeAssignments="categoryTypeAssignments"
                                              IsLoading="isLoadingCategoryTypes"
                                              OnSetType="SetCategoryType"
                                              OnClearType="ClearCategoryType" />

                    <ProjectTrackingCard TrackingItems="trackingItems"
                                         TrackingCategoryNames="trackingCategoryNames"
                                         AvailableCategories="allAvailableCategories"
                                         ActualCategories="allActualCategories"
                                         OnConfigureOpening="LoadTrackingCategoriesAsync"
                                         OnSave="SaveTrackingConfiguration" />
                    break;

                case SharingSection:
                    <ProjectSharingCard ProjectId="ProjectId" />
                    break;
            }
        </div>
    </div>
}

<DeleteProjectDialog Target="@(showDeleteDialog && budget != null ? (ProjectId, budget.Name) : null)"
                     OnClose="HideDeleteDialog" OnDeleted="OnProjectDeleted" />

</ProjectShell>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    /// <summary>The settings view from the URL: "accounts", "categories" or "sharing"; empty for General.</summary>
    [Parameter]
    public string? Section { get; set; }

    private const string GeneralSection = "general";
    private const string AccountsSection = "accounts";
    private const string CategoriesSection = "categories";
    private const string SharingSection = "sharing";

    /// <summary>The URL of a project's settings view: "accounts", "categories", "sharing", or null for General.</summary>
    public static string Url(int projectId, string? section = null) =>
        section is null or GeneralSection ? $"/projects/{projectId}/settings" : $"/projects/{projectId}/settings/{section}";

    private Project? budget;
    private readonly Dictionary<long, string> categoryNames = new();
    private List<CategoryGroupWithChildCount>? availableCategoriesWithCounts;

    private bool showDeleteDialog = false;

    // Owner-only views and sections (accounts, sharing, parent, delete). The route gate already guarantees at
    // least editor access; the server enforces the owner-only rules regardless of what is rendered.
    private bool isOwner;

    // General: the name and description being edited.
    private string editName = string.Empty;
    private string? editDescription;
    private string? generalError;
    private bool generalSaved;
    private DefaultProjectState? defaultState;
    private CancellationTokenSource? typingPause;

    // Tracking configuration
    private List<ProjectTrackingItem>? trackingItems;
    private readonly Dictionary<long, string> trackingCategoryNames = new();
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private List<Category>? allActualCategories;

    // Income/Expense configuration
    private List<CategoryWithLevel> incomeExpenseCategories = new();
    private List<CategoryTypeAssignment> categoryTypeAssignments = new();
    private bool isLoadingCategoryTypes = false;


    // Parent project picker. eligibleParents = top-level projects of the same owner
    // (cycle-prevention; only single-level hierarchies). hasOwnChildren disables the
    // picker — projects that already act as parents can't themselves become children yet.
    private List<Project>? eligibleParents;
    private bool hasOwnChildren = false;
    private string childProjectNames = "";
    private string? parentSaveError;


    // The project and view whose data is loaded. The component is reused when the user switches projects in the
    // header or views in the left list, so the load runs again whenever either route parameter changes.
    private int _loadedProjectId;
    private string loadedSection = GeneralSection;

    protected override async Task OnParametersSetAsync()
    {
        var section = (Section ?? GeneralSection).ToLowerInvariant();
        if (_loadedProjectId == ProjectId && loadedSection == section && budget != null) return;
        isOwner = (await AccessProvider.GetAsync()).IsOwner(ProjectId);
        if (section is not (GeneralSection or AccountsSection or CategoriesSection or SharingSection)
            || (section is AccountsSection or SharingSection && !isOwner))
        {
            Navigation.NavigateTo(Url(ProjectId), replace: true);
            return;
        }
        _loadedProjectId = ProjectId;
        loadedSection = section;
        // Clear the budget so the skeleton shows while the view loads; the load methods below overwrite the rest
        // of the per-view state.
        budget = null;
        showDeleteDialog = false;
        parentSaveError = null;
        generalError = null;
        isLoadingCategoryTypes = false;
        await LoadBudget();
        switch (section)
        {
            case GeneralSection:
                editName = budget?.Name ?? string.Empty;
                editDescription = budget?.Description;
                generalSaved = false;
                if (isOwner)
                {
                    await LoadParentPickerAsync();
                    defaultState = await ProjectService.GetDefaultStateAsync(ProjectId);
                }
                break;
            case CategoriesSection:
                await LoadTrackingItems();
                await LoadIncomeExpenseConfiguration();
                break;
        }
    }

    // #accounts-categories and #sharing on the General URL open the matching view.
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || loadedSection != GeneralSection) return;
        var target = new Uri(Navigation.Uri).Fragment switch
        {
            "#accounts-categories" => CategoriesSection,
            "#sharing" when isOwner => SharingSection,
            _ => null,
        };
        if (target != null) Navigation.NavigateTo(Url(ProjectId, target), replace: true);
    }

    private RenderFragment NavItem(string section, string icon, string label) => __builder =>
    {
        var active = loadedSection == section;
        <a class="shell-view @(active ? "active" : "")" href="@Url(ProjectId, section)" aria-current="@(active ? "page" : null)"
           data-testid="@($"project-settings-nav-{section}")">
            <i class="bi @icon" aria-hidden="true"></i>
            <span class="shell-view-label">@label</span>
        </a>
    };

    private void OnNameInput(ChangeEventArgs e)
    {
        editName = e.Value?.ToString() ?? string.Empty;
        SaveAfterPause();
    }

    private void OnDescriptionInput(ChangeEventArgs e)
    {
        editDescription = e.Value?.ToString();
        SaveAfterPause();
    }

    // Typing saves after a short pause; leaving the field saves at once.
    private void SaveAfterPause()
    {
        typingPause?.Cancel();
        typingPause?.Dispose();
        var pause = typingPause = new CancellationTokenSource();
        _ = Task.Delay(TimeSpan.FromMilliseconds(600), pause.Token).ContinueWith(
            t => { if (!t.IsCanceled) _ = InvokeAsync(SaveGeneralAsync); }, TaskScheduler.Default);
    }

    private async Task SaveGeneralAsync()
    {
        if (typingPause != null) await typingPause.CancelAsync();
        if (budget == null || string.IsNullOrWhiteSpace(editName)) return;
        if (editName.Trim() == budget.Name && (editDescription ?? "").Trim() == (budget.Description ?? "")) return;
        generalError = null;
        try
        {
            await ProjectService.UpdateProjectAsync(ProjectId, editName, editDescription);
            budget.Name = editName.Trim();
            budget.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
            generalSaved = true;
        }
        catch (Exception ex) when (ex is AccessDeniedException or InvalidOperationException or ArgumentException)
        {
            generalError = ex.Message;
        }
        // also runs from the debounce timer, outside an event handler
        #pragma warning disable BL0012
        StateHasChanged();
        #pragma warning restore BL0012
    }

    private async Task OnDefaultChanged(ChangeEventArgs e)
    {
        generalError = null;
        try
        {
            await ProjectService.SetDefaultForNewAccountsAsync(ProjectId, e.Value is true);
        }
        catch (Exception ex) when (ex is AccessDeniedException or InvalidOperationException)
        {
            generalError = ex.Message;
        }
        defaultState = await ProjectService.GetDefaultStateAsync(ProjectId);
    }

    // Settings edits commit immediately, but dialogs may hold half-entered input — banner rather
    // than auto-reload so a concurrent change elsewhere doesn't yank an open dialog out.
    protected override bool AutoReloadOnChange => false;
    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.ImportedData or DataArea.ImportState => budget != null && change.OwnerUserId == budget.OwnerUserId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override Task ReloadAfterChangeAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task LoadParentPickerAsync()
    {
        if (budget == null) return;
        var children = await ProjectService.GetChildProjectsAsync(ProjectId);
        hasOwnChildren = children.Any();
        childProjectNames = string.Join(", ", children.Select(c => c.Name));

        if (hasOwnChildren)
        {
            eligibleParents = null;
            return;
        }

        var all = await ProjectService.GetProjectsAsync();
        eligibleParents = all
            .Where(p => p.Id != ProjectId)
            .Where(p => p.OwnerUserId == budget.OwnerUserId)
            .Where(p => AccessProvider.Last.IsOwner(p.Id))   // a parent must be one of your own projects
            .Where(p => p.ParentProjectId == null)   // only top-level parents (single-level hierarchy)
            .OrderBy(p => p.Name)
            .ToList();
    }

    private async Task OnParentChanged(int? newParentId)
    {
        if (budget == null) return;
        parentSaveError = null;
        try
        {
            await ProjectService.SetProjectParentAsync(ProjectId, newParentId);
            budget.ParentProjectId = newParentId;
        }
        catch (Exception ex)
        {
            parentSaveError = ex.Message;
        }
    }

    private async Task LoadBudget()
    {
        budget = await ProjectService.GetProjectAsync(ProjectId);

        // Category names are shown by the Categories view only.
        if (budget != null && loadedSection == CategoriesSection)
        {
            // Load category group names
            foreach (var assignment in budget.CategoryAssignments)
            {
                var categoryGroup = await CategoryHierarchyService.GetCategoryWithSubCategoriesAsync(assignment.CategoryId);
                if (categoryGroup != null)
                {
                    categoryNames[assignment.CategoryId] = categoryGroup.Name ?? L["Unknown"].Value;
                }
            }
        }
    }

    // Raised by ProjectCategoryAssignmentsCard when its Add dialog opens; load the picker data.
    private async Task LoadAvailableCategoriesAsync()
    {
        var ownerId = budget?.OwnerUserId ?? string.Empty;
        availableCategoriesWithCounts = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(ownerId);
    }

    private async Task AddCategory(long categoryId)
    {
        if (categoryId == 0)
            return;

        await ProjectService.AssignCategoryToProjectAsync(ProjectId, categoryId);
        await LoadBudget();
    }

    private async Task RemoveCategory(long categoryId)
    {
        await ProjectService.RemoveCategoryFromProjectAsync(ProjectId, categoryId);
        await LoadBudget();
    }

    private void ShowDeleteDialog() => showDeleteDialog = true;
    private void HideDeleteDialog() => showDeleteDialog = false;

    private void OnProjectDeleted(int _)
    {
        showDeleteDialog = false;
        Navigation.NavigateTo("/");
    }

    // Tracking configuration methods
    private async Task LoadTrackingItems()
    {
        var project = await ProjectService.GetProjectAsync(ProjectId);
        trackingItems = project?.TrackingItems.ToList() ?? new List<ProjectTrackingItem>();
        var ownerId = project?.OwnerUserId ?? string.Empty;

        // Load names for tracking items. Fetch the leaf-category list at most once instead of
        // re-querying the whole list per leaf-category tracking item (was an N+1).
        List<Category>? leafCategories = null;
        foreach (var item in trackingItems)
        {
            if (item.CategoryGroupId.HasValue)
            {
                var categoryGroup = await CategoryHierarchyService.GetCategoryWithSubCategoriesAsync(item.CategoryGroupId.Value);
                if (categoryGroup != null)
                {
                    trackingCategoryNames[item.CategoryGroupId.Value] = categoryGroup.Name ?? L["Unknown"].Value;
                }
            }
            else if (item.CategoryId.HasValue)
            {
                leafCategories ??= await CategoryHierarchyService.GetAllCategoriesAsync(ownerId);
                var category = leafCategories.FirstOrDefault(c => c.Id == item.CategoryId.Value);
                if (category != null)
                {
                    trackingCategoryNames[item.CategoryId.Value] = category.Name ?? L["Unknown"].Value;
                }
            }
        }
    }

    // Raised when ProjectTrackingCard's dialog opens: load the project-scoped category set the
    // tree renders (filtered to the project's assigned groups + their descendants).
    private async Task LoadTrackingCategoriesAsync()
    {
        var ownerId = budget?.OwnerUserId ?? string.Empty;
        var allCategoryGroups = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(ownerId);
        allActualCategories = await CategoryHierarchyService.GetAllCategoriesAsync(ownerId);
        var sentinelRootOfOwner = await BudgetService.GetSentinelRootAsync(ownerId);

        if (budget != null)
        {
            var projectCategoryGroupIds = new HashSet<long>();
            foreach (var assignment in budget.CategoryAssignments)
            {
                projectCategoryGroupIds.Add(assignment.CategoryId);
                CategoryGroupWithChildCount.CollectDescendantIds(assignment.CategoryId, allCategoryGroups, projectCategoryGroupIds, includeLeafCategories: false);
            }

            allAvailableCategories = allCategoryGroups
                .Where(c => c.CategoryGroup.Id != sentinelRootOfOwner && projectCategoryGroupIds.Contains(c.CategoryGroup.Id))
                .ToList();
        }
    }

    private async Task SaveTrackingConfiguration((HashSet<long> GroupIds, HashSet<long> CategoryIds) sel)
    {
        await ProjectService.UpdateProjectTrackingItemsAsync(ProjectId, sel.GroupIds, sel.CategoryIds);
        await LoadTrackingItems();
    }

    // Income/Expense configuration methods
    private async Task LoadIncomeExpenseConfiguration()
    {
        if (budget == null)
            return;

        isLoadingCategoryTypes = true;
        StateHasChanged();

        // Get category IDs assigned to this project
        var assignedCategoryIds = budget.CategoryAssignments.Select(ca => ca.CategoryId).ToHashSet();

        // Load all categories
        var allCategories = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(budget.OwnerUserId);

        // Build complete set: assigned categories + their ancestors + all descendants
        // Use HashSet of actual items to avoid ID collision issues
        var projectCategoryItems = new HashSet<CategoryGroupWithChildCount>();
        foreach (var assignedId in assignedCategoryIds)
        {
            // Assigned IDs should be CategoryGroups only - filter by ItemType to avoid ID collision
            var category = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == assignedId);
            if (category == null)
                continue; // Skip if not found as a CategoryGroup

            projectCategoryItems.Add(category);

            // Add all ancestors (for hierarchy display)
            var current = category;
            while (current != null && current.ParentCategoryGroupId.HasValue)
            {
                var parent = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == current.ParentCategoryGroupId.Value);
                if (parent != null)
                {
                    projectCategoryItems.Add(parent);
                    current = parent;
                }
                else
                {
                    break;
                }
            }

            // Add all descendants (sub-groups and sub-categories) using shared helper
            var descendants = CategoryGroupWithChildCount.CollectDescendants(assignedId, allCategories);
            foreach (var descendant in descendants)
            {
                projectCategoryItems.Add(descendant);
            }
        }

        var sentinelRoot = await BudgetService.GetSentinelRootAsync(budget.OwnerUserId);
        var filteredCategories = projectCategoryItems
            .Where(c => c.Id != sentinelRoot)
            .ToList();

        // Build hierarchy with levels
        incomeExpenseCategories = BuildHierarchy(filteredCategories);

        // Load category type assignments
        categoryTypeAssignments = await BudgetService.GetCategoryTypeAssignmentsAsync(ProjectId);

        isLoadingCategoryTypes = false;
        // No trailing StateHasChanged needed: this method is always awaited (from
        // OnInitializedAsync or an event handler), both of which re-render on completion. The
        // StateHasChanged above is required — it shows the spinner before the awaits.
    }

    private List<CategoryWithLevel> BuildHierarchy(List<CategoryGroupWithChildCount> categories)
    {
        var result = new List<CategoryWithLevel>();
        // Only check CategoryGroups for parent existence to avoid ID collision with Categories
        var roots = categories.Where(c => c.IsRootCategory || !categories.Any(x => x.ItemType == CategoryItemType.Group && x.Id == c.ParentCategoryGroupId)).ToList();

        foreach (var root in roots.OrderBy(c => c.Name))
        {
            AddCategoryWithChildren(root, 0, categories, result);
        }

        return result;
    }

    private void AddCategoryWithChildren(CategoryGroupWithChildCount category, int level, List<CategoryGroupWithChildCount> allCategories, List<CategoryWithLevel> result)
    {
        result.Add(new CategoryWithLevel { CategoryGroup = category, Level = level });

        // Only CategoryGroups can have children; Categories are leaf nodes
        // This prevents ID collision issues between Categories and CategoryGroups
        if (category.ItemType == CategoryItemType.Group)
        {
            var children = allCategories
                .Where(c => c.ParentCategoryGroupId == category.Id)
                .OrderBy(c => c.Name)
                .ToList();

            foreach (var child in children)
            {
                AddCategoryWithChildren(child, level + 1, allCategories, result);
            }
        }
    }

    private List<(long Id, CategoryItemType ItemType)> GetAllDescendantItems(long categoryId, CategoryItemType itemType)
    {
        var result = new List<(long Id, CategoryItemType ItemType)>();

        // Only CategoryGroups can have children (Categories are leaf nodes)
        if (itemType != CategoryItemType.Group)
            return result;

        var allCats = incomeExpenseCategories.Select(c => c.CategoryGroup).ToList();
        var children = allCats.Where(c => c.ParentCategoryGroupId == categoryId).ToList();

        foreach (var child in children)
        {
            result.Add((child.Id, child.ItemType));

            // Only recurse for CategoryGroups (Categories are leaf nodes)
            if (child.ItemType == CategoryItemType.Group)
            {
                result.AddRange(GetAllDescendantItems(child.Id, child.ItemType));
            }
        }
        return result;
    }

    private async Task SetCategoryType((long Id, CategoryItemType ItemType, bool IsIncome) req)
    {
        // Set for this item
        await BudgetService.SetCategoryTypeAsync(ProjectId, req.Id, req.ItemType, req.IsIncome);

        // Clear explicit assignments for all descendants so they inherit
        var descendantItems = GetAllDescendantItems(req.Id, req.ItemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(ProjectId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }

    private async Task ClearCategoryType((long Id, CategoryItemType ItemType) req)
    {
        // Clear for this item
        await BudgetService.DeleteCategoryTypeAsync(ProjectId, req.Id, req.ItemType);

        // Also clear for all descendants
        var descendantItems = GetAllDescendantItems(req.Id, req.ItemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(ProjectId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }
}
