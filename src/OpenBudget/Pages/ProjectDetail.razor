@page "/projects/{ProjectId:int}/settings"
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject CategoryHierarchyService CategoryHierarchyService
@inject NavigationManager Navigation
@inject IStringLocalizer<ProjectDetail> L

<PageTitle>@(budget?.Name ?? L["PageTitle_Default"])</PageTitle>

@if (budget == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line-lg mb-3" style="width: 35%;"></div>
        <div class="skeleton skeleton-line mb-4" style="width: 60%;"></div>
        <div class="card mb-3">
            <div class="card-body">
                <div class="skeleton skeleton-block"></div>
            </div>
        </div>
    </div>
}
else
{
    <ProjectPageHeader ProjectId="@ProjectId" ProjectName="@budget.Name"
                       Subtitle="@budget.Description" />

    <DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

    <ProjectParentCard HasOwnChildren="hasOwnChildren"
                       ChildProjectNames="childProjectNames"
                       ParentProjectId="budget.ParentProjectId"
                       EligibleParents="eligibleParents"
                       SaveError="parentSaveError"
                       OnParentChanged="OnParentChanged" />

    <ProjectCategoryAssignmentsCard Assignments="budget.CategoryAssignments.ToList()"
                                    CategoryNames="categoryNames"
                                    AvailableCategories="availableCategoriesWithCounts"
                                    OnAddDialogOpening="LoadAvailableCategoriesAsync"
                                    OnAdd="AddCategory"
                                    OnRemove="RemoveCategory" />

    <ProjectAccountsCard Assignments="accountAssignments"
                         AllAccounts="allAccounts"
                         AllAccountGroups="allAccountGroups"
                         OnAdd="AddAccount"
                         OnRemove="RemoveAccount"
                         OnScopeChange="OnScopeChange" />

    <ProjectIncomeExpenseCard Categories="incomeExpenseCategories"
                              TypeAssignments="categoryTypeAssignments"
                              IsLoading="isLoadingCategoryTypes"
                              OnSetType="SetCategoryType"
                              OnClearType="ClearCategoryType" />

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Tracking_Heading"]</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowTrackingDialog">@L["Button_ConfigureTracking"]</button>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary">
                        @L["Tracking_Description"]
                    </p>
                    @if (trackingItems == null || !trackingItems.Any())
                    {
                        <p class="text-body-secondary">@L["Tracking_Empty"]</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var item in trackingItems)
                            {
                                var name = item.CategoryGroupId.HasValue
                                    ? trackingCategoryNames.GetValueOrDefault(item.CategoryGroupId.Value, L["Status_Loading"].Value)
                                    : trackingCategoryNames.GetValueOrDefault(item.CategoryId!.Value, L["Status_Loading"].Value);
                                var type = item.CategoryGroupId.HasValue ? L["Tracking_Item_Group"].Value : L["Tracking_Item_Category"].Value;

                                <span @key="item.Id" class="badge bg-secondary">@L["Tracking_Item_Label", name, type]</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Destructive action lives at the very bottom of the page, well below the data the
       user might be configuring — far enough from the title bar that it can't be hit
       by accident. *@
    <div class="border-top pt-3 mt-4">
        <button class="btn btn-outline-danger" @onclick="ShowDeleteDialog">@L["Button_DeleteProject"]</button>
    </div>
}

<Modal Show="@showDeleteDialog" Title="@L["Modal_DeleteProject_Title"]" OnClose="@HideDeleteDialog">
    <ChildContent>
        <p>@L["Modal_DeleteProject_Body_Before"]<strong>@budget?.Name</strong>@L["Modal_DeleteProject_Body_After"]</p>
        <p class="text-body-secondary small mb-0">@L["Modal_DeleteProject_Warning"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteProject">@L["Button_Delete"]</button>
    </Footer>
</Modal>

<Modal Show="@showTrackingDialog" Title="@L["Modal_ConfigureTracking_Title"]" SizeClass="modal-xl" OnClose="@HideTrackingDialog">
    <ChildContent>
        <p class="text-body-secondary">
            @L["Modal_ConfigureTracking_Description"]
        </p>

        <div class="tracking-tree-scroll">
            @if (allAvailableCategories != null && allActualCategories != null)
            {
                // Treat any group whose parent is outside the filtered subset as a render
                // root, since IsRootCategory only matches MoneyMoney's top-level groups and
                // the project might be scoped to a sub-tree.
                var filteredGroupIds = allAvailableCategories
                    .Where(c => c.ItemType == CategoryItemType.Group)
                    .Select(c => c.Id)
                    .ToHashSet();
                @foreach (var rootCat in allAvailableCategories
                    .Where(c => c.ItemType == CategoryItemType.Group
                        && !filteredGroupIds.Contains(c.ParentCategoryGroupId ?? -1))
                    .OrderBy(c => c.CategoryGroup.Name))
                {
                    <CategoryTree
                        @key="rootCat.CategoryGroup.Id"
                        CategoryGroup="@rootCat"
                        Level="0"
                        RenderMode="CategoryTreeRenderMode.Checkbox"
                        ParentSelected="false"
                        SelectedCategoryGroupIds="@selectedTrackingGroupIds"
                        SelectedCategoryIds="@selectedTrackingCategoryIds"
                        OnCategoryGroupToggle="@HandleTrackingGroupToggle"
                        OnCategoryToggle="@HandleTrackingCategoryToggle"
                        AllCategories="@allAvailableCategories"
                        ActualCategories="@allActualCategories" />
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideTrackingDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" @onclick="SaveTrackingConfiguration">@L["Button_Save"]</button>
    </Footer>
</Modal>



@code {
    [Parameter]
    public int ProjectId { get; set; }

    private Project? budget;
    private Dictionary<long, string> categoryNames = new();
    private List<CategoryGroupWithChildCount>? availableCategoriesWithCounts;

    private bool showDeleteDialog = false;

    // Tracking configuration
    private List<ProjectTrackingItem>? trackingItems;
    private Dictionary<long, string> trackingCategoryNames = new();
    private bool showTrackingDialog = false;
    private HashSet<long> selectedTrackingGroupIds = new();
    private HashSet<long> selectedTrackingCategoryIds = new();
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private List<Category>? allActualCategories;

    // Income/Expense configuration
    private List<CategoryWithLevel> incomeExpenseCategories = new();
    private List<CategoryTypeAssignment> categoryTypeAssignments = new();
    private bool isLoadingCategoryTypes = false;

    // Account assignments
    private List<ProjectAccountAssignment>? accountAssignments;
    private List<Account>? allAccounts;
    private List<AccountGroup>? allAccountGroups;

    // Parent project picker. eligibleParents = top-level projects in the same MoneyMoney
    // source (cycle-prevention; only single-level hierarchies). hasOwnChildren disables the
    // picker — projects that already act as parents can't themselves become children yet.
    private List<Project>? eligibleParents;
    private bool hasOwnChildren = false;
    private string childProjectNames = "";
    private string? parentSaveError;


    protected override async Task OnInitializedAsync()
    {
        await LoadBudget();
        await LoadTrackingItems();
        await LoadIncomeExpenseConfiguration();
        await LoadAccountAssignments();
        await LoadParentPickerAsync();
    }

    // Settings edits commit immediately, but dialogs may hold half-entered input — banner rather
    // than auto-reload so a concurrent change elsewhere doesn't yank an open dialog out.
    protected override bool AutoReloadOnChange => false;
    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.MoneyMoneyData or DataArea.Sources => budget != null && change.SourceId == budget.SourceId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override Task ReloadAfterChangeAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task LoadParentPickerAsync()
    {
        if (budget == null) return;
        var children = await ProjectService.GetChildProjectsAsync(ProjectId);
        hasOwnChildren = children.Any();
        childProjectNames = string.Join(", ", children.Select(c => c.Name));

        if (hasOwnChildren)
        {
            eligibleParents = null;
            return;
        }

        var all = await ProjectService.GetProjectsAsync();
        eligibleParents = all
            .Where(p => p.Id != ProjectId)
            .Where(p => p.SourceId == budget.SourceId)
            .Where(p => p.ParentProjectId == null)   // only top-level parents (single-level hierarchy)
            .OrderBy(p => p.Name)
            .ToList();
    }

    private async Task OnParentChanged(int? newParentId)
    {
        if (budget == null) return;
        parentSaveError = null;
        try
        {
            await ProjectService.SetProjectParentAsync(ProjectId, newParentId);
            budget.ParentProjectId = newParentId;
        }
        catch (Exception ex)
        {
            parentSaveError = ex.Message;
        }
    }

    private async Task LoadAccountAssignments()
    {
        accountAssignments = await BudgetService.GetProjectAccountAssignmentsAsync(ProjectId);
        if (allAccounts == null && budget != null)
        {
            allAccounts = await BudgetService.GetAllAccountsAsync(budget.SourceId);
        }
        if (allAccountGroups == null && budget != null)
        {
            allAccountGroups = await BudgetService.GetAllAccountGroupsAsync(budget.SourceId);
        }
    }

    private async Task AddAccount((long AccountId, AccountScope Scope) req)
    {
        if (req.AccountId == 0) return;
        await BudgetService.AssignAccountToProjectAsync(ProjectId, req.AccountId, req.Scope);
        await LoadAccountAssignments();
    }

    private async Task OnScopeChange((long AccountId, AccountScope Scope) req)
    {
        await BudgetService.SetAccountScopeAsync(ProjectId, req.AccountId, req.Scope);
        await LoadAccountAssignments();
    }

    private async Task RemoveAccount(long accountId)
    {
        await BudgetService.RemoveAccountFromProjectAsync(ProjectId, accountId);
        await LoadAccountAssignments();
    }

    private async Task LoadBudget()
    {
        budget = await ProjectService.GetProjectAsync(ProjectId);

        if (budget != null)
        {
            // Load category group names
            foreach (var assignment in budget.CategoryAssignments)
            {
                var categoryGroup = await CategoryHierarchyService.GetCategoryWithSubCategoriesAsync(assignment.CategoryId);
                if (categoryGroup != null)
                {
                    categoryNames[assignment.CategoryId] = categoryGroup.Name ?? L["Unknown"].Value;
                }
            }
        }
    }

    // Raised by ProjectCategoryAssignmentsCard when its Add dialog opens; load the picker data.
    private async Task LoadAvailableCategoriesAsync()
    {
        var sourceId = budget?.SourceId ?? SourceScope.LegacySourceId;
        availableCategoriesWithCounts = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(sourceId);
    }

    private async Task AddCategory(long categoryId)
    {
        if (categoryId == 0)
            return;

        await ProjectService.AssignCategoryToProjectAsync(ProjectId, categoryId);
        await LoadBudget();
    }

    private async Task RemoveCategory(long categoryId)
    {
        await ProjectService.RemoveCategoryFromProjectAsync(ProjectId, categoryId);
        await LoadBudget();
    }

    private void ShowDeleteDialog() => showDeleteDialog = true;
    private void HideDeleteDialog() => showDeleteDialog = false;

    private async Task DeleteProject()
    {
        await ProjectService.DeleteProjectAsync(ProjectId);
        showDeleteDialog = false;
        Navigation.NavigateTo("/");
    }

    // Tracking configuration methods
    private async Task LoadTrackingItems()
    {
        var project = await ProjectService.GetProjectAsync(ProjectId);
        trackingItems = project?.TrackingItems.ToList() ?? new List<ProjectTrackingItem>();
        var sourceId = project?.SourceId ?? SourceScope.LegacySourceId;

        // Load names for tracking items. Fetch the leaf-category list at most once instead of
        // re-querying the whole list per leaf-category tracking item (was an N+1).
        List<Category>? leafCategories = null;
        foreach (var item in trackingItems)
        {
            if (item.CategoryGroupId.HasValue)
            {
                var categoryGroup = await CategoryHierarchyService.GetCategoryWithSubCategoriesAsync(item.CategoryGroupId.Value);
                if (categoryGroup != null)
                {
                    trackingCategoryNames[item.CategoryGroupId.Value] = categoryGroup.Name ?? L["Unknown"].Value;
                }
            }
            else if (item.CategoryId.HasValue)
            {
                leafCategories ??= await CategoryHierarchyService.GetAllCategoriesAsync(sourceId);
                var category = leafCategories.FirstOrDefault(c => c.Id == item.CategoryId.Value);
                if (category != null)
                {
                    trackingCategoryNames[item.CategoryId.Value] = category.Name ?? L["Unknown"].Value;
                }
            }
        }
    }

    private async Task ShowTrackingDialog()
    {
        // Show dialog immediately
        showTrackingDialog = true;
        StateHasChanged();

        var sourceId = budget?.SourceId ?? SourceScope.LegacySourceId;
        // Load all categories
        var allCategoryGroups = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(sourceId);
        allActualCategories = await CategoryHierarchyService.GetAllCategoriesAsync(sourceId);

        // Get all category group IDs that are in the project
        if (budget != null)
        {
            var projectCategoryGroupIds = new HashSet<long>();
            foreach (var assignment in budget.CategoryAssignments)
            {
                projectCategoryGroupIds.Add(assignment.CategoryId);
                CategoryGroupWithChildCount.CollectDescendantIds(assignment.CategoryId, allCategoryGroups, projectCategoryGroupIds, includeLeafCategories: false);
            }

            // Filter to only categories in the project
            allAvailableCategories = allCategoryGroups
                .Where(c => c.CategoryGroup.Id != SourceScope.SentinelRoot(sourceId) && projectCategoryGroupIds.Contains(c.CategoryGroup.Id))
                .ToList();
        }

        // Load current tracking configuration
        selectedTrackingGroupIds.Clear();
        selectedTrackingCategoryIds.Clear();

        if (trackingItems != null)
        {
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    selectedTrackingGroupIds.Add(item.CategoryGroupId.Value);
                }
                else if (item.CategoryId.HasValue)
                {
                    selectedTrackingCategoryIds.Add(item.CategoryId.Value);
                }
            }
        }
        // No StateHasChanged needed here: this is the tail of an async event handler, so the
        // framework re-renders automatically once it returns. (The one above is required because
        // it reveals the dialog before the await.)
    }

    private void HideTrackingDialog()
    {
        showTrackingDialog = false;
    }

    private async Task SaveTrackingConfiguration()
    {
        await ProjectService.UpdateProjectTrackingItemsAsync(ProjectId, selectedTrackingGroupIds, selectedTrackingCategoryIds);
        showTrackingDialog = false;
        await LoadTrackingItems();
    }

    private async Task HandleTrackingGroupToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedTrackingGroupIds.Add(args.Id);
            RemoveTrackingDescendantsFromSelection(args.Id);
        }
        else
        {
            selectedTrackingGroupIds.Remove(args.Id);
            SelectTrackingImmediateChildren(args.Id);
        }
        await Task.CompletedTask;
    }

    private async Task HandleTrackingCategoryToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedTrackingCategoryIds.Add(args.Id);
        }
        else
        {
            selectedTrackingCategoryIds.Remove(args.Id);
        }
        await Task.CompletedTask;
    }

    private void RemoveTrackingDescendantsFromSelection(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Use the shared helper, which handles ID-collision between Groups and Categories
        // correctly (Category items have a placeholder CategoryGroup.Id pointing at their
        // parent group; recursing on that value caused a stack overflow).
        var descendants = CategoryGroupWithChildCount.CollectDescendants(
            parentCategoryGroupId, allAvailableCategories, includeLeafCategories: true);

        foreach (var descendant in descendants)
        {
            if (descendant.ItemType == CategoryItemType.Group)
            {
                selectedTrackingGroupIds.Remove(descendant.Id);
            }
            else
            {
                selectedTrackingCategoryIds.Remove(descendant.Id);
            }
        }
    }

    private void SelectTrackingImmediateChildren(long parentCategoryGroupId)
    {
        if (allAvailableCategories == null) return;

        // Filter children by ItemType so a Category item (whose ParentCategoryGroupId would
        // also match) doesn't get treated as a sub-Group.
        var childGroups = allAvailableCategories
            .Where(c => c.ItemType == CategoryItemType.Group && c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        var childCategories = allAvailableCategories
            .Where(c => c.ItemType == CategoryItemType.Category && c.ParentCategoryGroupId == parentCategoryGroupId)
            .ToList();

        foreach (var child in childGroups)
        {
            selectedTrackingGroupIds.Add(child.Id);
        }

        foreach (var child in childCategories)
        {
            selectedTrackingCategoryIds.Add(child.Id);
        }
    }

    // Income/Expense configuration methods
    private async Task LoadIncomeExpenseConfiguration()
    {
        if (budget == null)
            return;

        isLoadingCategoryTypes = true;
        StateHasChanged();

        // Get category IDs assigned to this project
        var assignedCategoryIds = budget.CategoryAssignments.Select(ca => ca.CategoryId).ToHashSet();

        // Load all categories
        var allCategories = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(budget.SourceId);

        // Build complete set: assigned categories + their ancestors + all descendants
        // Use HashSet of actual items to avoid ID collision issues
        var projectCategoryItems = new HashSet<CategoryGroupWithChildCount>();
        foreach (var assignedId in assignedCategoryIds)
        {
            // Assigned IDs should be CategoryGroups only - filter by ItemType to avoid ID collision
            var category = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == assignedId);
            if (category == null)
                continue; // Skip if not found as a CategoryGroup

            projectCategoryItems.Add(category);

            // Add all ancestors (for hierarchy display)
            var current = category;
            while (current != null && current.ParentCategoryGroupId.HasValue)
            {
                var parent = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == current.ParentCategoryGroupId.Value);
                if (parent != null)
                {
                    projectCategoryItems.Add(parent);
                    current = parent;
                }
                else
                {
                    break;
                }
            }

            // Add all descendants (sub-groups and sub-categories) using shared helper
            var descendants = CategoryGroupWithChildCount.CollectDescendants(assignedId, allCategories);
            foreach (var descendant in descendants)
            {
                projectCategoryItems.Add(descendant);
            }
        }

        var sentinelRoot = SourceScope.SentinelRoot(budget.SourceId);
        var filteredCategories = projectCategoryItems
            .Where(c => c.Id != sentinelRoot)
            .ToList();

        // Build hierarchy with levels
        incomeExpenseCategories = BuildHierarchy(filteredCategories);

        // Load category type assignments
        categoryTypeAssignments = await BudgetService.GetCategoryTypeAssignmentsAsync(ProjectId);

        isLoadingCategoryTypes = false;
        // No trailing StateHasChanged needed: this method is always awaited (from
        // OnInitializedAsync or an event handler), both of which re-render on completion. The
        // StateHasChanged above is required — it shows the spinner before the awaits.
    }

    private List<CategoryWithLevel> BuildHierarchy(List<CategoryGroupWithChildCount> categories)
    {
        var result = new List<CategoryWithLevel>();
        // Only check CategoryGroups for parent existence to avoid ID collision with Categories
        var roots = categories.Where(c => c.IsRootCategory || !categories.Any(x => x.ItemType == CategoryItemType.Group && x.Id == c.ParentCategoryGroupId)).ToList();

        foreach (var root in roots.OrderBy(c => c.Name))
        {
            AddCategoryWithChildren(root, 0, categories, result);
        }

        return result;
    }

    private void AddCategoryWithChildren(CategoryGroupWithChildCount category, int level, List<CategoryGroupWithChildCount> allCategories, List<CategoryWithLevel> result)
    {
        result.Add(new CategoryWithLevel { CategoryGroup = category, Level = level });

        // Only CategoryGroups can have children; Categories are leaf nodes
        // This prevents ID collision issues between Categories and CategoryGroups
        if (category.ItemType == CategoryItemType.Group)
        {
            var children = allCategories
                .Where(c => c.ParentCategoryGroupId == category.Id)
                .OrderBy(c => c.Name)
                .ToList();

            foreach (var child in children)
            {
                AddCategoryWithChildren(child, level + 1, allCategories, result);
            }
        }
    }

    private List<(long Id, CategoryItemType ItemType)> GetAllDescendantItems(long categoryId, CategoryItemType itemType)
    {
        var result = new List<(long Id, CategoryItemType ItemType)>();

        // Only CategoryGroups can have children (Categories are leaf nodes)
        if (itemType != CategoryItemType.Group)
            return result;

        var allCats = incomeExpenseCategories.Select(c => c.CategoryGroup).ToList();
        var children = allCats.Where(c => c.ParentCategoryGroupId == categoryId).ToList();

        foreach (var child in children)
        {
            result.Add((child.Id, child.ItemType));

            // Only recurse for CategoryGroups (Categories are leaf nodes)
            if (child.ItemType == CategoryItemType.Group)
            {
                result.AddRange(GetAllDescendantItems(child.Id, child.ItemType));
            }
        }
        return result;
    }

    private async Task SetCategoryType((long Id, CategoryItemType ItemType, bool IsIncome) req)
    {
        // Set for this item
        await BudgetService.SetCategoryTypeAsync(ProjectId, req.Id, req.ItemType, req.IsIncome);

        // Clear explicit assignments for all descendants so they inherit
        var descendantItems = GetAllDescendantItems(req.Id, req.ItemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(ProjectId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }

    private async Task ClearCategoryType((long Id, CategoryItemType ItemType) req)
    {
        // Clear for this item
        await BudgetService.DeleteCategoryTypeAsync(ProjectId, req.Id, req.ItemType);

        // Also clear for all descendants
        var descendantItems = GetAllDescendantItems(req.Id, req.ItemType);
        foreach (var (id, type) in descendantItems)
        {
            await BudgetService.DeleteCategoryTypeAsync(ProjectId, id, type);
        }

        await LoadIncomeExpenseConfiguration();
    }
}
