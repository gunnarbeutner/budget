    // Tracking configuration methods
    private async Task LoadTrackingItems()
    {
        var project = await ProjectService.GetProjectAsync(ProjectId);
        trackingItems = project?.TrackingItems.ToList() ?? new List<ProjectTrackingItem>();
        var sourceId = project?.SourceId ?? SourceScope.LegacySourceId;

        // Load names for tracking items
        if (trackingItems != null)
        {
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    var categoryGroup = await CategoryHierarchyService.GetCategoryWithSubCategoriesAsync(item.CategoryGroupId.Value);
                    if (categoryGroup != null)
                    {
                        trackingCategoryNames[item.CategoryGroupId.Value] = categoryGroup.Name ?? L["Unknown"].Value;
                    }
                }
                else if (item.CategoryId.HasValue)
                {
                    var categories = await CategoryHierarchyService.GetAllCategoriesAsync(sourceId);
                    var category = categories.FirstOrDefault(c => c.Id == item.CategoryId.Value);
                    if (category != null)
                    {
                        trackingCategoryNames[item.CategoryId.Value] = category.Name ?? L["Unknown"].Value;
                    }
                }
            }
        }
    }

    private async Task ShowTrackingDialog()
    {
        // Show dialog immediately
        showTrackingDialog = true;
        StateHasChanged();

        var sourceId = budget?.SourceId ?? SourceScope.LegacySourceId;
        // Load all categories
        var allCategoryGroups = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(sourceId);
        allActualCategories = await CategoryHierarchyService.GetAllCategoriesAsync(sourceId);

        // Get all category group IDs that are in the project
        if (budget != null)
        {
            var projectCategoryGroupIds = new HashSet<long>();
            foreach (var assignment in budget.CategoryAssignments)
            {
                projectCategoryGroupIds.Add(assignment.CategoryId);
                CategoryGroupWithChildCount.CollectDescendantIds(assignment.CategoryId, allCategoryGroups, projectCategoryGroupIds, includeLeafCategories: false);
            }

            // Filter to only categories in the project
            allAvailableCategories = allCategoryGroups
                .Where(c => c.CategoryGroup.Id != SourceScope.SentinelRoot(sourceId) && projectCategoryGroupIds.Contains(c.CategoryGroup.Id))
                .ToList();
        }

        // Load current tracking configuration
        selectedTrackingGroupIds.Clear();
        selectedTrackingCategoryIds.Clear();

        if (trackingItems != null)
        {
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId.HasValue)
                {
                    selectedTrackingGroupIds.Add(item.CategoryGroupId.Value);
                }
                else if (item.CategoryId.HasValue)
                {
                    selectedTrackingCategoryIds.Add(item.CategoryId.Value);
                }
            }
        }

        StateHasChanged();
    }

