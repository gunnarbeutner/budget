@page "/sources"
@page "/sources/{SourceId:int}/portfolios"
@page "/sources/{SourceId:int}/depots"
@page "/sources/{SourceId:int}/instruments"
@page "/sources/{SourceId:int}/tax"
@inject NavigationManager Navigation

@* Old links: the import page is Get started now, and a source's Portfolio Performance pages live under
   /portfolio-performance. *@

@code {
    [Parameter] public int? SourceId { get; set; }

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (SourceId is not { } id)
        {
            Navigation.NavigateTo($"/get-started{uri.Query}{uri.Fragment}", replace: true);
            return;
        }
        var section = uri.AbsolutePath[(uri.AbsolutePath.LastIndexOf('/') + 1)..];
        Navigation.NavigateTo($"/portfolio-performance/{id}/{section}{uri.Query}", replace: true);
    }
}
