@page "/assist"
@using OpenBudget.Assist
@using OpenBudget.Services
@inject AssistSettingsService Assist
@inject IStringLocalizer<AssistSettings> L

@* The per-user "Use AI suggestions" setting, with what is sent for the user's newest booking in plain words.
   Only reachable when the server has an AI service configured. *@

<PageTitle>@L["PageTitle"]</PageTitle>

<SettingsShell Active="assist">
<PageHeader Title="@L["Heading"]" />

@if (!Assist.Available)
{
    <p class="text-body-secondary" data-testid="assist-unavailable">@L["Unavailable"]</p>
}
else
{
    <p class="text-body-secondary">@L["Intro"]</p>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="assist-optin" data-testid="assist-optin"
               checked="@optIn" @onchange="ToggleAsync" />
        <label class="form-check-label" for="assist-optin">@L["Toggle"]</label>
    </div>
    <details data-testid="assist-sent">
        <summary>@L["Sent_Summary"]</summary>
        @if (preview == null)
        {
            <p class="small text-body-secondary mt-2">@L["Preview_None"]</p>
        }
        else
        {
            <table class="table table-sm small mt-2 mb-2 w-auto" data-testid="assist-preview">
                <tbody>
                    <tr><th scope="row">@L["Field_Date"]</th><td>@(DateOnly.TryParseExact(preview.Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day) ? day.ToString("dd.MM.yyyy") : preview.Date)</td></tr>
                    <tr><th scope="row">@L["Field_Amount"]</th><td>@Formatting.FormatMoneyDe(preview.Amount, preview.Currency)</td></tr>
                    <tr><th scope="row">@L["Field_Payee"]</th><td>@preview.Payee</td></tr>
                    <tr><th scope="row">@L["Field_Purpose"]</th><td>@preview.Purpose</td></tr>
                </tbody>
            </table>
        }
        <p class="small text-body-secondary">@L["NotSent"]</p>
    </details>
}
</SettingsShell>

@code {
    private bool optIn;
    private AssistBooking? preview;

    protected override async Task OnInitializedAsync()
    {
        if (!Assist.Available) return;
        optIn = await Assist.GetOptInAsync();
        preview = await Assist.PreviewAsync();
    }

    private async Task ToggleAsync(ChangeEventArgs e)
    {
        optIn = e.Value is true;
        await Assist.SetOptInAsync(optIn);
    }
}
