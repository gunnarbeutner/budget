@page "/projects/{ProjectId:int}/prices"
@inherits DataChangeAwareComponent
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using OpenBudget.Connectors.Receipts
@using OpenBudget.Models
@using OpenBudget.Services
@inject ProjectService ProjectService
@inject PriceHistoryService Service
@inject NavigationManager Navigation
@inject IStringLocalizer<Prices> L

@* The Prices view of a project (PriceHistoryService, PriceAnalysis): what the products on the project's receipts cost
   over time. ?period=6m|12m (default)|3y|all drives the whole page: four figures (the basket index's change, the
   grocery spend per month, the regulars, the biggest price rise), the basket index chart, the products list (search,
   sort) beside the selected product's detail (?product=<shop|key>, else the list's first) with its price chart and
   purchases, and the regulars below. Charts are SVG lines with HTML labels and dots on top, so text and dots keep
   their size at any width. Price rises are orange, falls blue, always with a sign. *@

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <NotFoundMessage />
    return;
}

<ProjectPageHeader ProjectId="ProjectId" ProjectName="@(project?.Name ?? "")" />

<ProjectShell ProjectId="ProjectId" Active="ProjectTab.Prices" MainClass="shell-page">
    <div class="prices-page">
    <div class="page-toolbar position-static flex-wrap" data-testid="prices-toolbar">
        <h1 class="view-title">@L["View_Title"]</h1>
        <div class="flex-grow-1"></div>
        <div class="segmented segmented-sm" role="group" aria-label="@L["Period"]" data-testid="prices-period">
            @foreach (var (value, p) in Periods)
            {
                <button type="button" class="btn @(period == p ? "active" : "")" aria-pressed="@((period == p).ToString().ToLowerInvariant())"
                        data-testid="@($"prices-period-{value}")" @onclick="() => SetPeriod(p)">@L["Period_" + value]</button>
            }
        </div>
    </div>
    <p class="text-body-secondary small mb-3">@L["Intro"]</p>

    @if (error != null)
    {
        <div class="alert alert-warning py-2" role="alert">@error</div>
    }

    @if (view == null || summary == null)
    {
        <div aria-busy="true">
            @for (int i = 0; i < 4; i++)
            {
                <div class="skeleton skeleton-line"></div>
            }
        </div>
    }
    else if (view.Products.Count == 0)
    {
        <div class="text-body-secondary py-5 text-center" data-testid="prices-none">
            <i class="bi bi-tags" style="font-size: 1.8rem;" aria-hidden="true"></i>
            <div class="mt-2">@L["None"]</div>
            <a class="small" href="@($"/projects/{ProjectId}/receipts")">@L["None_Link"]</a>
        </div>
    }
    else
    {
        var s = summary;
        var overall = s.Overall;
        <div class="prices-stats" data-testid="prices-stats">
            <div class="prices-stat" data-testid="prices-stat-inflation">
                <div class="prices-stat-label">@L["Stat_Inflation"]</div>
                @if (overall != null)
                {
                    var change = overall.Latest / 100m - 1m;
                    <div class="prices-stat-value @ChangeClass(change)" data-testid="prices-stat-value">@Percent(change)</div>
                    <div class="prices-stat-sub">@L["Stat_Inflation_Sub", Month(s.Start)]</div>
                }
                else
                {
                    <div class="prices-stat-value" data-testid="prices-stat-value">–</div>
                    <div class="prices-stat-sub">@L["Stat_Inflation_None"]</div>
                }
            </div>
            <div class="prices-stat" data-testid="prices-stat-grocery">
                <div class="prices-stat-label">@L["Stat_Grocery"]</div>
                <div class="prices-stat-value" data-testid="prices-stat-value">@(s.GroceryMonthlyCents is { } g ? L["PerMonth", Money(g)].Value : "–")</div>
                <div class="prices-stat-sub">@L["Stat_Grocery_Sub"]</div>
            </div>
            <div class="prices-stat" data-testid="prices-stat-regulars">
                <div class="prices-stat-label">@L["Stat_Regulars"]</div>
                <div class="prices-stat-value" data-testid="prices-stat-value">@L["Stat_Regulars_Value", s.Regulars.Count]</div>
                <div class="prices-stat-sub">@L["Stat_Regulars_Sub"]</div>
            </div>
            <div class="prices-stat" data-testid="prices-stat-jump">
                <div class="prices-stat-label">@L["Stat_Jump"]</div>
                @if (s.BiggestJump is { } jump)
                {
                    <a class="prices-stat-value prices-stat-link text-truncate d-block" href="@ProductHref(jump.Product.Id)" data-testid="prices-stat-value">@jump.Product.Name</a>
                    <div class="prices-stat-sub"><span class="@ChangeClass(jump.Detail.Change ?? 0)">@Percent(jump.Detail.Change ?? 0)</span> @L["Stat_Jump_Since", Month(s.Start)]</div>
                }
                else
                {
                    <div class="prices-stat-value" data-testid="prices-stat-value">–</div>
                    <div class="prices-stat-sub">@L["Stat_Jump_None"]</div>
                }
            </div>
        </div>

        <section class="prices-card" aria-labelledby="prices-index-heading">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h2 class="h6 mb-0" id="prices-index-heading">@L["Index_Heading"]</h2>
                <div class="flex-grow-1"></div>
                @if (overall != null)
                {
                    <div class="prices-legend" aria-hidden="true">
                        @foreach (var (line, i) in s.Index.Select((l, i) => (l, i)))
                        {
                            <span><svg viewBox="0 0 24 8" class="prices-legend-line"><line x1="0" y1="4" x2="24" y2="4" class="@LineClass(i)" /></svg>@(line.Shop == null ? L["AllShops"].Value : ShopName(line.Shop))</span>
                        }
                    </div>
                }
            </div>
            @if (overall == null)
            {
                <p class="small text-body-secondary mb-0" data-testid="prices-index-none">@L["Index_None", PriceAnalysis.IndexMinPurchases]</p>
            }
            else
            {
                <p class="small text-body-secondary">@L["Index_Help", Month(s.Start), PriceAnalysis.IndexMinPurchases, overall.Products]</p>
                @IndexChart(s)
            }
        </section>

        <div class="prices-columns">
            <section class="prices-card" aria-labelledby="prices-products-heading">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h2 class="h6 mb-0" id="prices-products-heading">@L["Products_Heading"]</h2>
                    <div class="flex-grow-1"></div>
                    <label class="visually-hidden" for="prices-search">@L["Search"]</label>
                    <input id="prices-search" type="search" class="form-control form-control-sm prices-search" placeholder="@L["Search"]"
                           data-testid="prices-search" @bind="search" @bind:event="oninput" />
                </div>
                <div class="segmented segmented-sm mb-2" role="group" aria-label="@L["Sort"]" data-testid="prices-sort">
                    @foreach (var o in Enum.GetValues<SortOrder>())
                    {
                        <button type="button" class="btn @(sort == o ? "active" : "")" aria-pressed="@((sort == o).ToString().ToLowerInvariant())"
                                data-testid="@($"prices-sort-{o.ToString().ToLowerInvariant()}")" @onclick="() => sort = o">@L["Sort_" + o]</button>
                    }
                </div>
                @{ var list = ListRows(s); }
                @if (s.Rows.Count == 0)
                {
                    <p class="small text-body-secondary" data-testid="prices-period-empty">@L["Period_Empty"]</p>
                }
                else if (list.Count == 0)
                {
                    <p class="small text-body-secondary">@L["Search_None"]</p>
                }
                else
                {
                    <ul class="prices-list list-unstyled mb-0" aria-label="@L["Products_Heading"]" data-testid="prices-list">
                        <Virtualize Items="list" ItemSize="58" OverscanCount="10" SpacerElement="li" Context="r">
                            @{ var current = selected?.Product.Id == r.Product.Id; }
                            <li @key="r.Product.Id">
                                <a class="prices-row @(current ? "active" : "")" href="@ProductHref(r.Product.Id)" aria-current="@(current ? "true" : null)"
                                   data-testid="price-row" data-product="@r.Product.Id">
                                    <span class="prices-row-main">
                                        <span class="prices-row-name">@r.Product.Name</span>
                                        <span class="prices-row-meta">@RowMeta(r)</span>
                                    </span>
                                    @Spark(r, s)
                                    <span class="prices-row-price">@Price(r.Detail.Now, r.Product.Weighed ? PriceUnit.Kg : PriceUnit.Piece)</span>
                                    <span class="prices-row-change @ChangeClass(r.Detail.Change ?? 0)" data-testid="price-row-change">@(r.Detail.Change is { } c ? Percent(c) : "–")</span>
                                </a>
                            </li>
                        </Virtualize>
                    </ul>
                }
            </section>

            <section class="prices-card" aria-labelledby="prices-detail-heading">
                @if (selected is { } row && Detail(row, s) is { } d)
                {
                    var p = row.Product;
                    var unit = perBase && p.HasBase ? p.BaseUnit : p.Weighed ? PriceUnit.Kg : PriceUnit.Piece;
                    <div data-testid="price-detail" data-product="@p.Id">
                        <div class="d-flex flex-wrap align-items-start gap-2 mb-2">
                            <div class="min-w-0 flex-grow-1">
                                <h2 class="h6 mb-0 text-break" id="prices-detail-heading" data-testid="price-detail-name">@p.Name</h2>
                                <div class="small text-body-secondary">@L["Detail_Sub", ShopName(p.Shop), p.TimesBought, p.First.Date.Year]</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-expanded="@mergeOpen.ToString().ToLowerInvariant()"
                                    data-testid="price-merge-open" @onclick="() => mergeOpen = !mergeOpen">@L["Merge_Open"]</button>
                            @if (p.HasBase)
                            {
                                <div class="segmented segmented-sm" role="group" aria-label="@L["Unit"]">
                                    <button type="button" class="btn @(!perBase ? "active" : "")" aria-pressed="@((!perBase).ToString().ToLowerInvariant())"
                                            data-testid="price-unit-piece" @onclick="() => perBase = false">@L["Unit_Piece"]</button>
                                    <button type="button" class="btn @(perBase ? "active" : "")" aria-pressed="@perBase.ToString().ToLowerInvariant()"
                                            data-testid="price-unit-base" @onclick="() => perBase = true">@(p.BaseUnit == PriceUnit.Litre ? L["Unit_Litre"] : L["Unit_Kg"])</button>
                                </div>
                            }
                        </div>

                        @if (mergeOpen)
                        {
                            <div class="prices-merge mb-3" data-testid="price-merge">
                                <p class="small text-body-secondary mb-2">@L["Merge_Help"]</p>
                                @if (p.MergedKeys.Count > 1)
                                {
                                    <ul class="list-unstyled small mb-2" data-testid="price-merged">
                                        @foreach (var k in p.MergedKeys.Where(k => k != p.Id))
                                        {
                                            <li class="d-flex align-items-center gap-2">
                                                <span class="text-break">@k[(p.Shop.Length + 1)..]</span>
                                                <button type="button" class="btn btn-sm btn-link p-0" data-testid="price-unmerge" @onclick="() => RunAsync(() => Service.UnmergeAsync(k))">@L["Unmerge"]</button>
                                            </li>
                                        }
                                    </ul>
                                }
                                <label class="visually-hidden" for="price-merge-search">@L["Merge_Search"]</label>
                                <input id="price-merge-search" type="search" class="form-control form-control-sm mb-2 prices-search" placeholder="@L["Merge_Search"]"
                                       data-testid="price-merge-search" @bind="mergeSearch" @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(mergeSearch))
                                {
                                    <ul class="list-unstyled small mb-0">
                                        @foreach (var o in view.Products.Where(o => o.Shop == p.Shop && o.Id != p.Id && SearchText.Matches(PriceAnalysis.SearchKey(o), mergeSearch)).Take(8))
                                        {
                                            <li class="d-flex align-items-center gap-2 mb-1" data-testid="price-merge-candidate">
                                                <span class="text-break">@o.Name</span>
                                                <span class="text-body-secondary">(@o.TimesBought×)</span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-testid="price-merge-into" @onclick="() => MergeAsync(p, o)">@L["Merge_Into"]</button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }

                        <dl class="prices-facts" data-testid="price-facts">
                            <div><dt>@L["Fact_Now"]</dt><dd data-testid="price-now">@Price(d.Now, unit)</dd></div>
                            <div><dt>@L["Fact_Then_" + PeriodValue(period)]</dt><dd>@Price(d.Base, unit)</dd></div>
                            <div><dt>@L["Fact_Cheapest"]</dt><dd>@Price(d.Cheapest.Price, unit)</dd>
                                <dd class="prices-fact-sub">@(d.Cheapest.Offer ? L["Fact_Offer", Month(d.Cheapest.Date)].Value : Month(d.Cheapest.Date))</dd></div>
                            <div><dt>@L["Fact_Spend"]</dt><dd>@Money(d.MonthlyCents)</dd><dd class="prices-fact-sub">@L["Fact_PerMonth"]</dd></div>
                        </dl>

                        @DetailChart(d, s, unit)
                        <div class="prices-legend mb-3" aria-hidden="true">
                            <span><span class="prices-key-dot"></span>@L["Legend_Purchase"]</span>
                            <span><span class="prices-key-dot offer"></span>@L["Legend_Offer"]</span>
                            <span><span class="prices-key-rise"></span>@L["Legend_Rise"]</span>
                            <span><svg viewBox="0 0 24 8" class="prices-legend-line"><line x1="0" y1="4" x2="24" y2="4" class="pchart-avg" /></svg>@L["Legend_Average"]</span>
                        </div>

                        <h3 class="h6">@L["Purchases_Heading"]</h3>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" data-testid="price-purchases">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Col_Date"]</th>
                                        <th scope="col">@L["Col_Shop"]</th>
                                        <th scope="col" class="text-end">@L["Col_Quantity"]</th>
                                        <th scope="col" class="text-end">@L["Col_Price"]</th>
                                        <th scope="col"><span class="visually-hidden">@L["Col_Receipt"]</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var x in d.Points.Reverse())
                                    {
                                        <tr data-testid="price-purchase">
                                            <td class="text-nowrap">@Date(x.Date)</td>
                                            <td>@ShopName(p.Shop)</td>
                                            <td class="text-end text-nowrap">@Quantity(x.Purchase)</td>
                                            <td class="text-end text-nowrap">@Price(x.Price, unit)@if (x.Offer)
                                                {
                                                    <span class="badge prices-offer-badge ms-1">@L["Offer"]</span>
                                                }</td>
                                            <td class="text-end"><button type="button" class="btn btn-link btn-sm p-0" data-testid="price-purchase-receipt"
                                                                         aria-label="@L["OpenReceipt_Aria", Date(x.Date)]" @onclick="() => openReceipt = x.Purchase.ReceiptId">@L["OpenReceipt"]</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <h2 class="visually-hidden" id="prices-detail-heading">@L["Detail_Heading"]</h2>
                    <p class="small text-body-secondary mb-0">@L["Detail_None"]</p>
                }
            </section>
        </div>

        <section class="prices-card" aria-labelledby="prices-regulars-heading">
            <h2 class="h6" id="prices-regulars-heading">@L["Regulars_Heading"]</h2>
            <p class="small text-body-secondary">@L["Regulars_Help"]</p>
            @if (s.Regulars.Count == 0)
            {
                <p class="small text-body-secondary mb-0" data-testid="price-regulars-none">@L["Regulars_None"]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" data-testid="price-regulars">
                        <thead>
                            <tr>
                                <th scope="col">@L["Col_Product"]</th>
                                <th scope="col" class="d-none d-md-table-cell">@L["Col_Shop"]</th>
                                <th scope="col">@L["Col_Interval"]</th>
                                <th scope="col" class="text-end">@L["Col_Monthly"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in s.Regulars)
                            {
                                <tr data-testid="price-regular">
                                    <td class="text-break"><a href="@ProductHref(r.ProductId)">@r.Name</a></td>
                                    <td class="d-none d-md-table-cell">@ShopName(r.Shop)</td>
                                    <td class="small text-nowrap">@Every(r.IntervalDays)</td>
                                    <td class="text-end text-nowrap">@Money(r.MonthlyCents)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <th scope="row" colspan="2" class="d-none d-md-table-cell">@L["Regulars_Total"]</th>
                                <th scope="row" class="d-md-none">@L["Regulars_Total"]</th>
                                <td></td>
                                <td class="text-end text-nowrap" data-testid="price-regulars-total">@Money(s.Regulars.Sum(r => r.MonthlyCents))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </section>
    }
    </div>
</ProjectShell>

<ReceiptPanel ReceiptId="openReceipt" OnClose="_ => openReceipt = null" />

@code {
    [Parameter] public int ProjectId { get; set; }

    private enum SortOrder { Change, Bought, Spent }

    private static readonly (string Value, PricePeriod Period)[] Periods =
        [("6m", PricePeriod.SixMonths), ("12m", PricePeriod.TwelveMonths), ("3y", PricePeriod.ThreeYears), ("all", PricePeriod.All)];

    private Project? project;
    private bool notFound;
    private int _loadedProjectId;
    private PriceHistoryView? view;
    private readonly Dictionary<PricePeriod, PriceSummary> summaries = [];
    private PriceSummary? summary;
    private PricePeriod period = PricePeriod.TwelveMonths;
    private string? productParam;
    private ProductRow? selected;
    private SortOrder sort;
    private string? search;
    private bool perBase;
    private bool mergeOpen;
    private string? mergeSearch;
    private long? openReceipt;
    private string? userId;
    private string? error;

    private static string PeriodValue(PricePeriod p) => Periods.First(x => x.Period == p).Value;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    // Period and product only change the query string, which does not set parameters again.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        await OnParametersSetAsync();
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        period = query.TryGetValue("period", out var pv) && Periods.FirstOrDefault(x => x.Value == pv.ToString()) is { Value: not null } match
            ? match.Period : PricePeriod.TwelveMonths;
        var product = query.TryGetValue("product", out var pr) ? pr.ToString() : null;
        if (product != productParam)
        {
            productParam = product;
            mergeOpen = false;
            mergeSearch = null;
        }
        if (_loadedProjectId != ProjectId)
        {
            _loadedProjectId = ProjectId;
            await LoadAsync();
        }
        else Refresh();
    }

    protected override bool IsRelevantChange(DataChange change) =>
        (change.Area == DataArea.CloudFiles && change.UserId == userId) || change.Area is DataArea.ImportedData or DataArea.Projects;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        notFound = false;
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) { notFound = true; return; }
        userId = (await Access.GetAsync()).UserId;
        try { view = await Service.GetAsync(ProjectId); }
        catch (AccessDeniedException) { notFound = true; return; }
        summaries.Clear();
        Refresh();
    }

    /// <summary>Picks the period's figures and the selected product.</summary>
    private void Refresh()
    {
        if (view == null) return;
        if (!summaries.TryGetValue(period, out var s)) summaries[period] = s = view.Summarise(period);
        summary = s;
        selected = productParam == null ? null : s.Rows.FirstOrDefault(r => r.Product.Id == productParam || r.Product.MergedKeys.Contains(productParam));
        selected ??= ListRows(s).FirstOrDefault();
        if (selected is { Product.HasBase: false }) perBase = false;
    }

    private List<ProductRow> ListRows(PriceSummary s)
    {
        var rows = s.Rows.Where(r => SearchText.Matches(PriceAnalysis.SearchKey(r.Product), search));
        return (sort switch
        {
            SortOrder.Bought => rows.OrderByDescending(r => r.Times).ThenByDescending(r => r.Spend),
            SortOrder.Spent => rows.OrderByDescending(r => r.Spend),
            _ => rows.OrderByDescending(r => r.Detail.Change is { } c ? Math.Abs(c) : -1m).ThenByDescending(r => r.Spend),
        }).ToList();
    }

    private ProductDetail? Detail(ProductRow row, PriceSummary s) =>
        perBase && row.Product.HasBase ? PriceAnalysis.Detail(row.Product, s.Start, s.Today, perBase: true) ?? row.Detail : row.Detail;

    private void SetPeriod(PricePeriod p) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("period", p == PricePeriod.TwelveMonths ? null : PeriodValue(p)), replace: true);

    private string ProductHref(string id) => Navigation.GetUriWithQueryParameter("product", id);

    private async Task MergeAsync(ProductHistory from, ProductHistory into)
    {
        await RunAsync(() => Service.MergeAsync(from.Id, into.Id));
        if (error == null) Navigation.NavigateTo(ProductHref(into.Id), replace: true);
    }

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is AccessDeniedException or InvalidOperationException)
        {
            error = ex.Message;
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing) Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose(disposing);
    }

    // ---- formatting ----

    private string ShopName(string s) => L["Shop_" + s] is { ResourceNotFound: false } n ? n.Value : s;

    private static string Money(long cents) => Formatting.FormatMoneyDe(cents / 100m);

    private string Price(long cents, PriceUnit unit) => Money(cents) + unit switch
    {
        PriceUnit.Kg => L["Per_Kg"].Value,
        PriceUnit.Litre => L["Per_Litre"].Value,
        _ => "",
    };

    private static string Quantity(Purchase x) => x.Weighed
        ? (x.Quantity * 1000m).ToString("0", CultureInfo.CurrentCulture) + " g"
        : x.Quantity.ToString("0.###", CultureInfo.CurrentCulture);

    private static string Date(DateOnly d) => d.ToString("d", CultureInfo.CurrentCulture);

    private static string Month(DateOnly d) => d.ToString("MMM yyyy", CultureInfo.CurrentCulture);

    private static string Percent(decimal f) => (f > 0 ? "+" : f < 0 ? "−" : "±") + Math.Abs(f).ToString("P1", CultureInfo.CurrentCulture);

    /// <summary>Orange for a rise, blue for a fall (both readable as text); a change below half a percent stays neutral.</summary>
    private static string ChangeClass(decimal f) => f > 0.005m ? "price-up" : f < -0.005m ? "price-down" : "";

    private string Every(double days) => days < 35 ? L["Every_Days", Math.Round(days)].Value : L["Every_Weeks", Math.Round(days / 7)].Value;

    private string RowMeta(ProductRow r)
    {
        var parts = new List<string> { ShopName(r.Product.Shop) };
        if (r.Product.Weighed) parts.Add(L["Meta_PerKg"].Value);
        if (r.IntervalDays is { } d) parts.Add(Every(d));
        else parts.Add(L["Meta_Times", r.Times].Value);
        return string.Join(" · ", parts);
    }

    private static string LineClass(int i) => i switch
    {
        0 => "pchart-line-all",
        _ => "pchart-line-shop" + ((i - 1) % 3 + 1),
    };

    // ---- charts ----

    private static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Maps days and values onto 0–100 of the plot (y grows downwards).</summary>
    private sealed record Scale(DateOnly Start, DateOnly End, double Min, double Max)
    {
        public double X(DateOnly d) => End.DayNumber == Start.DayNumber ? 0 : Math.Clamp((d.DayNumber - Start.DayNumber) * 100.0 / (End.DayNumber - Start.DayNumber), 0, 100);
        public double Y(double v) => Max - Min < 1e-9 ? 50 : (Max - v) * 100.0 / (Max - Min);
    }

    /// <summary>Round tick marks covering the values, about four steps.</summary>
    private static (double Min, double Max, double Step) Nice(double lo, double hi)
    {
        if (hi - lo < 1e-9) { lo -= Math.Max(1, Math.Abs(lo) * 0.05); hi += Math.Max(1, Math.Abs(hi) * 0.05); }
        var raw = (hi - lo) / 4;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var norm = raw / mag;
        var step = (norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10) * mag;
        return (Math.Floor(lo / step) * step, Math.Ceiling(hi / step) * step, step);
    }

    private static IEnumerable<double> Ticks((double Min, double Max, double Step) t)
    {
        for (var v = t.Min; v <= t.Max + t.Step / 2; v += t.Step) yield return Math.Round(v, 6);
    }

    /// <summary>Month labels for the x axis: about six, on the first of a month.</summary>
    private static IEnumerable<DateOnly> MonthTicks(DateOnly start, DateOnly end)
    {
        var months = new List<DateOnly>();
        for (var m = new DateOnly(start.Year, start.Month, 1).AddMonths(start.Day == 1 ? 0 : 1); m <= end; m = m.AddMonths(1)) months.Add(m);
        var step = Math.Max(1, (int)Math.Ceiling(months.Count / 6.0));
        return months.Where((_, i) => i % step == 0);
    }

    private static string MonthTick(DateOnly d, DateOnly start, DateOnly end) =>
        d.ToString(end.DayNumber - start.DayNumber > 400 ? "MMM yy" : "MMM", CultureInfo.CurrentCulture);

    private RenderFragment Axes(Scale sc, (double Min, double Max, double Step) ticks, Func<double, string> label) => __builder =>
    {
        foreach (var v in Ticks(ticks))
        {
            <span class="pchart-y" style="top: @N(sc.Y(v))%;">@label(v)</span>
        }
        foreach (var m in MonthTicks(sc.Start, sc.End))
        {
            <span class="pchart-x" style="left: @N(sc.X(m))%;">@MonthTick(m, sc.Start, sc.End)</span>
        }
    };

    private RenderFragment Grid(Scale sc, (double Min, double Max, double Step) ticks) => __builder =>
    {
        foreach (var v in Ticks(ticks))
        {
            <line x1="0" x2="100" y1="@N(sc.Y(v))" y2="@N(sc.Y(v))" class="pchart-grid" />
        }
    };

    private RenderFragment IndexChart(PriceSummary s) => __builder =>
    {
        var values = s.Index.SelectMany(l => l.Points).Select(p => (double)p.Value).Append(100).ToList();
        var ticks = Nice(values.Min(), values.Max());
        var sc = new Scale(s.Start, s.Today, ticks.Min, ticks.Max);
        var overall = s.Overall!;
        var last = overall.Points[^1];
        var aria = L["Index_Aria", Month(s.Start), overall.Latest.ToString("0.0", CultureInfo.CurrentCulture)].Value;
        <figure class="pchart" role="img" aria-label="@aria" data-testid="prices-index">
            <div class="pchart-plot">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @Grid(sc, ticks)
                    <line x1="0" x2="100" y1="@N(sc.Y(100))" y2="@N(sc.Y(100))" class="pchart-baseline" />
                    @foreach (var (line, i) in s.Index.Select((l, i) => (l, i)).Reverse())
                    {
                        <polyline class="@LineClass(i)" points="@string.Join(" ", line.Points.Select(p => $"{N(sc.X(p.Date))},{N(sc.Y((double)p.Value))}"))" />
                    }
                </svg>
                @Axes(sc, ticks, v => v.ToString("0", CultureInfo.CurrentCulture))
                <span class="pchart-dot pchart-dot-all" style="left: @N(sc.X(last.Date))%; top: @N(sc.Y((double)last.Value))%;"></span>
                <span class="pchart-tag pchart-tag-end" style="left: @N(sc.X(last.Date))%; top: @N(sc.Y((double)last.Value))%;" data-testid="prices-index-latest">@last.Value.ToString("0.0", CultureInfo.CurrentCulture)</span>
            </div>
        </figure>
    };

    private RenderFragment Spark(ProductRow r, PriceSummary s) => __builder =>
    {
        var usual = r.Detail.Points.Where(x => !x.Offer).ToList();
        var values = usual.Select(x => (double)x.Price).Append(r.Detail.Base).ToList();
        var lo = values.Min();
        var hi = values.Max();
        var sc = new Scale(s.Start, s.Today, lo - (hi - lo) * 0.15 - 0.5, hi + (hi - lo) * 0.15 + 0.5);
        <svg class="prices-spark" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <polyline class="@(r.Detail.Change > 0.005m ? "spark-up" : "spark")" points="@StepPoints(sc, r.Detail.Base, usual)" />
        </svg>
    };

    /// <summary>The usual price as steps: from the period's start at its base price, changing at each purchase, to today.</summary>
    private static string StepPoints(Scale sc, long start, IReadOnlyList<PricePoint> usual)
    {
        var parts = new List<string>();
        double level = start;
        parts.Add($"0,{N(sc.Y(level))}");
        foreach (var x in usual)
        {
            var px = N(sc.X(x.Date));
            parts.Add($"{px},{N(sc.Y(level))}");
            level = x.Price;
            parts.Add($"{px},{N(sc.Y(level))}");
        }
        parts.Add($"100,{N(sc.Y(level))}");
        return string.Join(" ", parts);
    }

    private RenderFragment DetailChart(ProductDetail d, PriceSummary s, PriceUnit unit) => __builder =>
    {
        var values = d.Points.Select(x => (double)x.Price).Append(d.Base).ToList();
        var ticks = Nice(values.Min() * 0.95, values.Max() * 1.03);
        var sc = new Scale(s.Start, s.Today, ticks.Min, ticks.Max);
        var usual = d.Points.Where(x => !x.Offer).ToList();
        var offers = d.Points.Where(x => x.Offer).ToList();
        var cheapestOffer = offers.OrderBy(x => x.Price).ThenByDescending(x => x.Date).FirstOrDefault();
        var aria = L["Detail_Aria", Price(d.Base, unit), Price(d.Now, unit), Month(s.Start), d.Points.Count, offers.Count, d.Rises.Count].Value;
        <figure class="pchart pchart-detail" role="img" aria-label="@aria" data-testid="price-chart">
            <div class="pchart-plot">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var rise in d.Rises)
                    {
                        var x1 = sc.X(rise.From);
                        var w = Math.Max(1.2, sc.X(rise.To) - x1);
                        <rect x="@N(Math.Min(x1, 100 - w))" y="0" width="@N(w)" height="100" class="pchart-rise" />
                    }
                    @Grid(sc, ticks)
                    <line x1="0" x2="100" y1="@N(sc.Y(d.Average))" y2="@N(sc.Y(d.Average))" class="pchart-avg" />
                    <polyline class="pchart-step" points="@StepPoints(sc, d.Base, usual)" />
                </svg>
                @Axes(sc, ticks, v => (v / 100).ToString("0.00", CultureInfo.CurrentCulture))
                @foreach (var x in usual)
                {
                    <span class="pchart-dot" style="left: @N(sc.X(x.Date))%; top: @N(sc.Y(x.Price))%;"></span>
                }
                @foreach (var x in offers)
                {
                    <span class="pchart-dot offer" style="left: @N(sc.X(x.Date))%; top: @N(sc.Y(x.Price))%;"></span>
                }
                @if (cheapestOffer != null)
                {
                    <span class="pchart-tag pchart-tag-offer @(sc.X(cheapestOffer.Date) > 70 ? "pchart-tag-end" : "")"
                          style="left: @N(sc.X(cheapestOffer.Date))%; top: @N(sc.Y(cheapestOffer.Price))%;">@L["Chart_Offer", Price(cheapestOffer.Price, unit)]</span>
                }
                <span class="pchart-tag pchart-tag-avg" style="top: @N(sc.Y(d.Average))%;">@L["Chart_Average", Price(d.Average, unit)]</span>
            </div>
        </figure>
    };
}
