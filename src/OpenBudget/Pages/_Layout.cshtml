@using Microsoft.AspNetCore.Components.Web
@namespace OpenBudget.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="~/" />

    @* Home-screen / standalone-app support. iOS uses the apple-* meta tags and the
       apple-touch-icon for its launcher; the manifest covers Android/Chrome. This is a
       Blazor Server app (live SignalR circuit) so it can't run offline — these just give a
       full-screen, icon'd launch when added to the home screen. *@
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png" />
    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#0d6efd" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Budget" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
    <script src="js/theme.js" asp-append-version="true"></script>
    @* Captures the browser's IANA timezone into the `tz` cookie before Blazor connects, so the
       first interactive render already knows the user's zone (see ClockService / App.razor). *@
    <script src="js/timezone.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/bootstrap-icons/bootstrap-icons.min.css" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="OpenBudget.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* Load the JS that Blazor interop calls into (chart helpers, expand-state, UI behaviors)
       BEFORE blazor.server.js. Otherwise the circuit can go interactive and fire a chart render
       (e.g. Cashflow's OnAfterRenderAsync) before charts.js has run, throwing
       "renderChart is not a function" — an unhandled JSException that terminates the circuit. *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="js/charts.js" asp-append-version="true"></script>
    <script src="js/expandState.js" asp-append-version="true"></script>
    <script src="js/uiBehaviors.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
