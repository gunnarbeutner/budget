@page "/projects/{ProjectId:int}/overview"
@inherits DataChangeAwareComponent
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject TransactionQueryService TransactionQueries
@inject FreshnessService FreshnessService
@inject NavigationManager Navigation
@inject ProjectTimeState TimeState
@inject IStringLocalizer<ProjectOverview> L

@* The project's landing tab: the at-a-glance summary that used to be crammed into a
   dashboard card, now given the full content column and always fully expanded. Owns the
   month/YTD/year anchor (via the shared PeriodNav) and forwards it to the Browse tab so the
   two month-model views stay on the same period as you switch between them. *@

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">
        @L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]
    </p>
    return;
}

<ProjectPageHeader ProjectId="@ProjectId" ProjectName="@(project?.Name ?? "")"
                   Subtitle="@project?.Description"
                   Active="ProjectTab.Overview"
                   Year="anchor.Year" Month="anchor.Month" Period="@period" />

<PeriodNav Anchor="anchor" Period="@period" ShowMonthPicker="true"
           MinMonth="monthMin" MaxMonth="monthMax" OnChanged="OnPeriodChanged" />

@if (summary == null)
{
    <div class="row g-3" aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="col-md-4">
            <div class="card"><div class="card-body">
                <div class="skeleton skeleton-line mb-2" style="width: 50%;"></div>
                <div class="skeleton skeleton-line-lg" style="width: 70%;"></div>
            </div></div>
        </div>
        <div class="col">
            <div class="card"><div class="card-body">
                <div class="skeleton skeleton-block"></div>
            </div></div>
        </div>
    </div>
}
else
{
    var statusClass = ProjectStatus.StatusClass(summary);
    var overallPercent = ProjectStatus.OverallPercent(summary);

    @if (alert is { } a)
    {
        <div class="alert alert-@(a.Severity == "secondary" ? "info" : a.Severity) d-flex gap-2">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" aria-hidden="true"></i>
            <div>
                <strong>@L["Alert_WarningsHeading"]</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var line in a.Lines)
                    {
                        <li>@line</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="row g-3 mb-4 align-items-stretch">
        @{
            var hasBalance = balance is { AccountCount: > 0 };
            var browseUrl = $"/projects/{ProjectId}/browse{AnchorQuery()}";
        }
        @if (hasBalance)
        {
            <div class="col-md-4">
                <a href="@browseUrl" class="text-decoration-none text-reset">
                    <div class="card project-card h-100"><div class="card-body">
                        <div class="text-body-secondary small">@L["Label_CurrentBalance"]</div>
                        <div class="h3 mb-1 text-nowrap @(balance!.Balance < 0 ? "text-danger" : "")">
                            @Formatting.FormatMoney(balance.Balance)
                        </div>
                        <div class="text-body-secondary small">
                            @L[balance.AccountCount == 1 ? "Label_Account_One" : "Label_Account_Other", balance.AccountCount]
                        </div>
                    </div></div>
                </a>
            </div>
        }
        <div class="@(hasBalance ? "col-md-8" : "col-12")">
            <div class="card h-100"><div class="card-body">
                @if (summary.HasBudget)
                {
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Budget"]</div>
                            <div class="h4 text-nowrap mb-0">@Formatting.FormatMoney(summary.TotalBudget)</div>
                        </div>
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Spent"]</div>
                            <div class="h4 text-nowrap mb-0 text-@statusClass">@Formatting.FormatMoney(summary.TotalSpent)</div>
                        </div>
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Remaining"]</div>
                            <div class="h4 text-nowrap mb-0 text-@statusClass">@Formatting.FormatMoney(summary.TotalRemaining)</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-3 mb-1">
                        <span class="small fw-semibold text-@statusClass">@overallPercent.ToString("F0")%</span>
                    </div>
                    <div class="progress position-relative" style="height: 8px;">
                        <div class="progress-bar bg-@statusClass" role="progressbar"
                             style="width: @(Math.Min(overallPercent, 100).ToString(CultureInfo.InvariantCulture))%"
                             aria-valuenow="@overallPercent.ToString(CultureInfo.InvariantCulture)"
                             aria-valuemin="0" aria-valuemax="100"></div>
                        @if (Anchoring.TodayMarkerPercent(anchor, period, DateTime.Today) is { } todayPct)
                        {
                            <div class="position-absolute top-0 bottom-0"
                                 style="left: @(todayPct.ToString("F2", CultureInfo.InvariantCulture))%; width: 2px; background-color: var(--today-marker-color);"
                                 title="@L["Title_TodayMarker", todayPct.ToString("F0")]"></div>
                        }
                    </div>
                }
                else
                {
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Income"]</div>
                            <div class="h4 text-nowrap mb-0 text-success">@Formatting.FormatMoney(summary.MonthIncome)</div>
                        </div>
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Expenses"]</div>
                            <div class="h4 text-nowrap mb-0 text-danger">@Formatting.FormatMoney(summary.MonthExpenses)</div>
                        </div>
                        <div class="col-4">
                            <div class="text-body-secondary small">@L["Label_Net"]</div>
                            <div class="h4 text-nowrap mb-0 text-@statusClass">@Formatting.FormatMoney(summary.MonthNet)</div>
                        </div>
                    </div>
                    <p class="small text-body-secondary mb-0 mt-3">
                        @L[summary.IsSingleMonth ? "NoBudget_ThisMonth" : "NoBudget_YearToDate", summary.Year]
                    </p>
                }
            </div></div>
        </div>
    </div>

    var expenseCategories = summary.CategorySpending
        .Where(c => !c.IsIncome)
        .OrderByDescending(c => c.Spent)
        .ToList();

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">@L["Card_Categories"]</h5>
        </div>
        <div class="card-body">
            @if (!expenseCategories.Any())
            {
                <p class="text-body-secondary mb-0">@L["Empty_NoCategories"]</p>
            }
            else
            {
                @foreach (var cat in expenseCategories)
                {
                    var selPrefix = cat.ItemType == CategoryItemType.Group ? "grp" : "cat";
                    var catUrl = $"/projects/{ProjectId}/browse{AnchorQuery()}&sel={selPrefix}-{cat.CategoryId}";
                    <div class="mb-3" @key="(cat.ItemType, cat.CategoryId)">
                        <a href="@catUrl" class="d-flex justify-content-between align-items-center text-decoration-none text-reset">
                            <span>@cat.CategoryName</span>
                            @if (summary.HasBudget)
                            {
                                <span class="badge bg-@(cat.PercentUsed > 100 ? "danger" : cat.PercentUsed > 80 ? "warning" : "secondary")">
                                    <span class="text-nowrap">@Formatting.FormatMoney(cat.Spent)</span> / <span class="text-nowrap">@Formatting.FormatMoney(cat.Budget)</span>
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-nowrap">@Formatting.FormatMoney(cat.Spent)</span>
                            }
                        </a>
                        @if (summary.HasBudget && cat.Budget > 0)
                        {
                            <div class="progress mt-1" style="height: 6px;">
                                <div class="progress-bar bg-@(cat.PercentUsed > 100 ? "danger" : cat.PercentUsed > 80 ? "warning" : "success")"
                                     role="progressbar"
                                     style="width: @(Math.Min(cat.PercentUsed, 100).ToString(CultureInfo.InvariantCulture))%"
                                     aria-valuenow="@cat.PercentUsed.ToString(CultureInfo.InvariantCulture)"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public int ProjectId { get; set; }

    private Project? project;
    private bool notFound;
    private ProjectSpendingSummary? summary;
    private ProjectBalanceSummary? balance;
    private (string Severity, List<string> Lines)? alert;

    private (int Year, int Month) anchor;
    private string period = "month";

    // Guards the per-project load so it runs once on first render and again only when the
    // {ProjectId} route param actually changes — i.e. a client-side switch via the header's
    // project picker, where the component is reused and OnInitializedAsync does not re-run.
    private int _loadedProjectId;

    // The selectable month window, derived from the source's first/last transaction (the latter may
    // be in the future — pending rows). Null until loaded / when the source has no transactions, in
    // which case EffectiveMin/Max fall back to [1900-01 .. current month].
    private (int Year, int Month)? monthMin;
    private (int Year, int Month)? monthMax;
    private (int Year, int Month) EffectiveMin => monthMin ?? (1900, 1);
    private (int Year, int Month) EffectiveMax => monthMax ?? (DateTime.Now.Year, DateTime.Now.Month);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        notFound = false;
        summary = null;
        balance = null;
        alert = null;
        await LoadProjectAndBoundsAsync();
        if (notFound) return;
        ReadStateFromQuery();
        await LoadSummaryAsync();
    }

    private void ReadStateFromQuery()
    {
        var now = DateTime.Now;
        // Seed from the remembered selection (survives a detour through Budgets/Cashflow),
        // falling back to the current month on a fresh session.
        anchor = (TimeState.Year ?? now.Year, TimeState.Month ?? now.Month);
        period = TimeState.Period ?? "month";

        // An explicit URL selection wins (shareable links, dashboard links to a given month).
        if (PageState.ReadIntQuery(Navigation, "year") is { } y &&
            PageState.ReadIntQuery(Navigation, "month") is { } m && m is >= 1 and <= 12)
        {
            anchor = (y, m);
        }

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("period", out var p) && p.ToString() is "month" or "ytd" or "year")
            period = p.ToString();

        anchor = Anchoring.Clamp(anchor, EffectiveMin, EffectiveMax);
        RememberTimeState();
    }

    private void RememberTimeState()
    {
        TimeState.Year = anchor.Year;
        TimeState.Month = anchor.Month;
        TimeState.Period = period;
    }

    private void UpdateUrl() => PageState.ReplaceQuery(Navigation, new Dictionary<string, object?>
    {
        ["year"] = anchor.Year,
        ["month"] = anchor.Month,
        ["period"] = period == "month" ? null : period,
    });

    /// <summary>"?year=&month=&period=" suffix for links into Browse (period omitted when default).</summary>
    private string AnchorQuery()
        => $"?year={anchor.Year}&month={anchor.Month}" + (period == "month" ? "" : $"&period={period}");

    private async Task OnPeriodChanged((int Year, int Month, string Period) next)
    {
        anchor = (next.Year, next.Month);
        period = next.Period;
        RememberTimeState();
        UpdateUrl();
        summary = null;
        await LoadSummaryAsync();
    }

    private async Task LoadProjectAndBoundsAsync()
    {
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null)
        {
            notFound = true;
            return;
        }
        (monthMin, monthMax) = await TransactionQueries.GetMonthBoundsAsync(project.SourceId);
    }

    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.MoneyMoneyData or DataArea.Sources => project != null && change.SourceId == project.SourceId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override async Task ReloadAfterChangeAsync()
    {
        await LoadProjectAndBoundsAsync();
        if (notFound) return;
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (project == null) return;

        var (fromMonth, toMonth) = Anchoring.Range(anchor.Month, period);
        summary = await BudgetService.GetSpendingSummaryAsync(project.Id, anchor.Year, fromMonth, toMonth);

        var balances = await ProjectService.GetAllProjectsBalancesAsync();
        balance = balances.GetValueOrDefault(ProjectId);

        var freshness = (await FreshnessService.GetDataFreshnessAsync()).ToDictionary(f => f.SourceId);
        var uncategorized = await FreshnessService.GetUncategorizedTransactionSummaryAsync();
        alert = ProjectStatus.BuildAlert(summary, freshness, uncategorized, L, DateTime.UtcNow);
    }
}
