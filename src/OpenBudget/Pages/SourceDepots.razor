@page "/sources/{SourceId:int}/depots"
@attribute [RequireSourceOwner]
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject DepotMappingService DepotMapping
@inject ProjectService ProjectService
@inject PortfolioService PortfolioService
@inject NavigationManager Navigation
@inject IStringLocalizer<SourceDepots> L

<SettingsShell Active="sources" Bare="@Embedded">
@if (!Embedded)
{
<PageTitle>@(sourceName != null ? L["PageTitle_WithSource", sourceName] : L["PageTitle"])</PageTitle>

<PageHeader Title="@L["Heading"]" Subtitle="@sourceName">
    <Actions>
        <a class="ob-btn" href="/sources"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@L["Back"]</a>
    </Actions>
</PageHeader>
}

@if (loading)
{
    <div class="skeleton skeleton-block" aria-busy="true"></div>
}
else if (notFound)
{
    <div class="alert alert-warning">@L["NotFound"]</div>
}
else if (!VisibleDepots.Any())
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <p class="text-body-secondary">@L["Intro"]</p>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Col_Depot"]</th>
                <th class="text-end">@L["Col_Lots"]</th>
                <th style="width: 22rem;">@L["Col_MmDepot"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in VisibleDepots)
            {
                <tr @key="d.PpUuid">
                    <td><strong>@d.PpName</strong></td>
                    <td class="text-end text-body-secondary">
                        @(d.LotCount > 0 ? L["Lots_Summary", d.LotCount, d.IsinCount] : L["Lots_None"])
                    </td>
                    <td>
                        <select class="form-select form-select-sm"
                                value="@(d.LinkedAccountId?.ToString() ?? "")"
                                @onchange="e => OnLinkChanged(d.PpUuid, e.Value)">
                            <option value="">@L["NotLinked"]</option>
                            @foreach (var a in VisibleAccounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

</SettingsShell>

@code {

    [Parameter] public int SourceId { get; set; }
    /// <summary>Shown inside the Portfolio view (no page title, header or back link, no redirect).</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>Inside a project's Portfolio view: only its depot accounts (and the not yet linked PortfolioPerformance depots).</summary>
    [Parameter] public IReadOnlyCollection<long>? AccountIds { get; set; }

    private IEnumerable<DepotMappingRow> VisibleDepots =>
        AccountIds == null ? mapping.Depots : mapping.Depots.Where(d => d.LinkedAccountId is not { } id || AccountIds.Contains(id));

    private IEnumerable<DepotAccountOption> VisibleAccounts =>
        AccountIds == null ? mapping.Accounts : mapping.Accounts.Where(a => AccountIds.Contains(a.Id));

    // The source-level page moved into the Portfolio view of a project that uses the source; it stays here only
    // when no project on the source has a depot (reached from the Sources page).
    private async Task<bool> RedirectToPortfolioAsync(string tab)
    {
        if (Embedded || await PortfolioService.FindPortfolioProjectAsync(SourceId) is not { } pid) return false;
        Navigation.NavigateTo($"/projects/{pid}/portfolio?tab={tab}", replace: true);
        return true;
    }

    private DepotMapping mapping = new();
    private string? sourceName;
    private bool loading = true;
    private bool notFound;
    private int _loadedSourceId = -1;

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportedData or DataArea.Sources && (change.SourceId == null || change.SourceId == SourceId);
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSourceId == SourceId) return;
        _loadedSourceId = SourceId;
        if (await RedirectToPortfolioAsync("positions")) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var sources = await ProjectService.GetAllSourcesAsync();
        var source = sources.FirstOrDefault(s => s.Id == SourceId);
        if (source == null) { notFound = true; loading = false; return; }
        sourceName = source.Name;
        mapping = await DepotMapping.GetAsync(SourceId);
        loading = false;
    }

    private async Task OnLinkChanged(string ppUuid, object? value)
    {
        long? accountId = long.TryParse(value?.ToString(), out var id) ? id : null;
        await DepotMapping.SaveLinkAsync(SourceId, ppUuid, accountId);
        mapping = await DepotMapping.GetAsync(SourceId);
    }
}
