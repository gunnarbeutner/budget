@page "/portfolio-performance/depots"
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject DepotMappingService DepotMapping
@inject ProjectService ProjectService
@inject IStringLocalizer<SourceDepots> L

<SettingsShell Active="portfolio-performance" Bare="@Embedded">
@if (!Embedded)
{
<PageTitle>@L["PageTitle"]</PageTitle>

<PageHeader Title="@L["Heading"]">
    <Actions>
        <a class="ob-btn" href="/portfolio-performance"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@L["Back"]</a>
    </Actions>
</PageHeader>
}

@if (loading)
{
    <div class="skeleton skeleton-block" aria-busy="true"></div>
}
else if (!VisibleDepots.Any())
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <p class="text-body-secondary">@L["Intro"]</p>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Col_Depot"]</th>
                <th class="text-end">@L["Col_Lots"]</th>
                <th style="width: 22rem;">@L["Col_MmDepot"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in VisibleDepots)
            {
                <tr @key="d.PpUuid">
                    <td><strong>@d.PpName</strong></td>
                    <td class="text-end text-body-secondary">
                        @(d.LotCount > 0 ? L["Lots_Summary", d.LotCount, d.IsinCount] : L["Lots_None"])
                    </td>
                    <td>
                        <select class="form-select form-select-sm"
                                value="@(d.LinkedAccountId?.ToString() ?? "")"
                                @onchange="e => OnLinkChanged(d.PpUuid, e.Value)">
                            <option value="">@L["NotLinked"]</option>
                            @foreach (var a in VisibleAccounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

</SettingsShell>

@code {

    /// <summary>Whose data to show (the Portfolio view passes its project's owner); the signed-in user when not set.</summary>
    [Parameter] public string OwnerUserId { get; set; } = string.Empty;
    /// <summary>Shown inside the Portfolio view (no page title, header or back link, no redirect).</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>Inside a project's Portfolio view: only its depot accounts (and the not yet linked PortfolioPerformance depots).</summary>
    [Parameter] public IReadOnlyCollection<long>? AccountIds { get; set; }

    private IEnumerable<DepotMappingRow> VisibleDepots =>
        AccountIds == null ? mapping.Depots : mapping.Depots.Where(d => d.LinkedAccountId is not { } id || AccountIds.Contains(id));

    private IEnumerable<DepotAccountOption> VisibleAccounts =>
        AccountIds == null ? mapping.Accounts : mapping.Accounts.Where(a => AccountIds.Contains(a.Id));


    private DepotMapping mapping = new();
    private bool loading = true;
    private string? _loadedOwnerId;

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportedData or DataArea.ImportState && (change.OwnerUserId == null || change.OwnerUserId == OwnerUserId);
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (OwnerUserId.Length == 0) OwnerUserId = (await Access.GetAsync()).UserId ?? string.Empty;
        if (OwnerUserId.Length == 0 || _loadedOwnerId == OwnerUserId) return;
        _loadedOwnerId = OwnerUserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        mapping = await DepotMapping.GetAsync(OwnerUserId);
        loading = false;
    }

    private async Task OnLinkChanged(string ppUuid, object? value)
    {
        long? accountId = long.TryParse(value?.ToString(), out var id) ? id : null;
        await DepotMapping.SaveLinkAsync(OwnerUserId, ppUuid, accountId);
        mapping = await DepotMapping.GetAsync(OwnerUserId);
    }
}
