@page "/portfolio-performance/instruments"
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject InstrumentMappingService Mapping
@inject ProjectService ProjectService
@inject PortfolioService PortfolioService
@inject NavigationManager Navigation
@inject IStringLocalizer<SourceInstruments> L

<SettingsShell Active="portfolio-performance" Bare="@Embedded">
@if (!Embedded)
{
<PageTitle>@L["PageTitle"]</PageTitle>

<PageHeader Title="@L["Heading"]">
    <Actions>
        <a class="ob-btn" href="/portfolio-performance"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@L["Back"]</a>
    </Actions>
</PageHeader>
}

@if (loading)
{
    <div class="skeleton skeleton-block" aria-busy="true"></div>
}
else if (mapping.Instruments.Count == 0)
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <p class="text-body-secondary">@L["Intro"]</p>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Col_Instrument"]</th>
                <th class="text-end">@L["Col_Lots"]</th>
                <th style="width: 24rem;">@L["Col_Holding"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in mapping.Instruments)
            {
                <tr @key="i.PpUuid">
                    <td><strong>@i.PpName</strong></td>
                    <td class="text-end text-body-secondary">@L["Lots_Summary", i.LotCount]</td>
                    <td>
                        <select class="form-select form-select-sm"
                                value="@(i.LinkedHoldingKey ?? "")"
                                @onchange="e => OnLinkChanged(i.PpUuid, e.Value)">
                            <option value="">@L["NotLinked"]</option>
                            @foreach (var h in mapping.Holdings)
                            {
                                <option value="@h.Key">@h.Name</option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

</SettingsShell>

@code {

    /// <summary>Whose data to show (the Portfolio view passes its project's owner); the signed-in user when not set.</summary>
    [Parameter] public string OwnerUserId { get; set; } = string.Empty;
    /// <summary>Shown inside the Portfolio view (no page title, header or back link, no redirect).</summary>
    [Parameter] public bool Embedded { get; set; }

    // The page moved into the Portfolio view of a project with the user's depots; it stays here only when no project
    // of theirs has a depot.
    private async Task<bool> RedirectToPortfolioAsync(string tab)
    {
        if (Embedded || await PortfolioService.FindPortfolioProjectAsync(OwnerUserId) is not { } pid) return false;
        Navigation.NavigateTo($"/projects/{pid}/portfolio?tab={tab}", replace: true);
        return true;
    }

    private InstrumentMapping mapping = new();
    private bool loading = true;
    private string? _loadedOwnerId;

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportedData or DataArea.ImportState && (change.OwnerUserId == null || change.OwnerUserId == OwnerUserId);
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (OwnerUserId.Length == 0) OwnerUserId = (await Access.GetAsync()).UserId ?? string.Empty;
        if (OwnerUserId.Length == 0 || _loadedOwnerId == OwnerUserId) return;
        _loadedOwnerId = OwnerUserId;
        if (await RedirectToPortfolioAsync("positions")) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        mapping = await Mapping.GetAsync(OwnerUserId);
        loading = false;
    }

    private async Task OnLinkChanged(string ppUuid, object? value)
    {
        await Mapping.SaveLinkAsync(OwnerUserId, ppUuid, value?.ToString());
        mapping = await Mapping.GetAsync(OwnerUserId);
    }
}
