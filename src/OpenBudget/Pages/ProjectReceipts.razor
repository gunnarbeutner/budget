@page "/projects/{ProjectId:int}/receipts"
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject ProjectService ProjectService
@inject IStringLocalizer<Receipts> L

@* The Receipts view of a project: the receipt list (ReceiptList) scoped to the project — receipts on its bookings the
   user may see, and the receipts without a booking whose payment method or source pays from its accounts. The title row
   (desktop only; on phones the bottom bar names the view) scrolls away so the list's filter bar is the sticky part.
   Categories, item memory and AI options stay in Settings › Receipts, linked from the filter bar. *@

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <NotFoundMessage />
    return;
}

<ProjectPageHeader ProjectId="ProjectId" ProjectName="@(project?.Name ?? "")" />

<ProjectShell ProjectId="ProjectId" Active="ProjectTab.Receipts" MainClass="shell-page">
    <div class="page-toolbar position-static d-none d-md-flex" data-testid="project-receipts-toolbar">
        <h1 class="view-title">@L["Heading"]</h1>
    </div>
    <ReceiptList ProjectId="ProjectId" SettingsHref="/receipts" />
</ProjectShell>

@code {
    [Parameter] public int ProjectId { get; set; }

    private Project? project;
    private bool notFound;
    private int _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    protected override bool IsRelevantChange(DataChange change) => change.Area == DataArea.Projects;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        notFound = false;
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) notFound = true;
    }
}
