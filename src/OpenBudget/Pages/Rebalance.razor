@page "/projects/{ProjectId:int}/rebalance"
@inherits DataChangeAwareComponent
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@inject PortfolioService Portfolio
@inject ProjectService ProjectService
@inject IStringLocalizer<Rebalance> L

<PageTitle>@(projectName != null ? L["PageTitle_WithProject", projectName] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">@L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]</p>
    return;
}

<ProjectPageHeader ProjectId="ProjectId" ProjectName="@projectName" Active="ProjectTab.Rebalance" />

<DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

@if (loading)
{
    <div class="card mb-3" aria-busy="true"><div class="card-body">
        <div class="skeleton skeleton-line-lg" style="width: 30%;"></div>
        <div class="skeleton skeleton-block mt-3"></div>
    </div></div>
}
else if (securities.Count == 0)
{
    <div class="text-body-secondary py-5 text-center">
        <i class="bi bi-sliders" style="font-size: 1.8rem;" aria-hidden="true"></i>
        <div class="mt-2">@L["Empty_NoSecurities"]</div>
    </div>
}
else
{
    var solved = RegionMode ? SolveRegions() : null;
    var plan = RegionMode ? BuildRegionPlan(solved) : BuildManualPlan();
    var tax = EstimateTax(plan);

    <p class="text-body-secondary d-print-none">@L[IntroKey]</p>

    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
        @* On paper, "Cash to add €0.00" is just noise — drop the whole block when no cash is added.
           On screen it always stays (it's the control for entering cash). *@
        <div class="@(cash == 0m ? "d-print-none" : "")">
            <label class="form-label small mb-1" for="cashInput">@L["Cash_Label"]</label>
            <div class="input-group input-group-sm d-print-none" style="width: 12rem;">
                <span class="input-group-text">€</span>
                <input id="cashInput" type="number" step="1000" min="0" class="form-control text-end"
                       value="@FormatNum(cash)" @onchange="OnCashChanged" />
            </div>
            <div class="d-none d-print-block h6 mb-0">@Formatting.FormatMoney(cash)</div>
        </div>
        <div class="d-print-none">
            <div class="form-label small mb-1">@L["Mode_Label"]</div>
            <div class="segmented" role="group" aria-label="@L["Mode_Label"]">
                <button type="button" class="btn @(targetBy == "ratio" ? "active" : "")"
                        @onclick='() => SetTargetBy("ratio")'>@L["Mode_Ratio"]</button>
                <button type="button" class="btn @(targetBy == "amount" ? "active" : "")"
                        @onclick='() => SetTargetBy("amount")'>@L["Mode_Amount"]</button>
                @if (taxonomyNames.Count > 0)
                {
                    <button type="button" class="btn @(targetBy == "region" ? "active" : "")"
                            @onclick='() => SetTargetBy("region")'>@L["Mode_Region"]</button>
                }
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-link" @onclick="ResetTargets">@L["Reset"]</button>
    </div>

    @if (RegionMode)
    {
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 d-print-none">
                <label class="small text-body-secondary mb-0" for="taxSel">@L["Region_Taxonomy"]</label>
                <select id="taxSel" class="form-select form-select-sm" style="width:auto"
                        value="@regionTaxonomy" @onchange="OnRegionTaxonomyChanged">
                    @foreach (var t in taxonomyNames)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span class="text-body-secondary small ms-2">@L["Region_Note"]</span>
            </div>
            @* Print shows the taxonomy name as a heading (the dropdown is hidden). *@
            <div class="d-none d-print-block fw-semibold mb-2">@regionTaxonomy</div>
            @* Classes laid out as columns (Target / Achievable as the two rows) so the panel is
               short and wide — it stacks above the securities table and prints compactly. *@
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 no-last-border rebal-class-table">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var cls in regionList)
                            {
                                <th @key="cls" class="text-end">@cls</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th class="fw-normal text-body-secondary small">@L["Region_Target"]</th>
                            @foreach (var cls in regionList)
                            {
                                <td @key="cls" class="text-end">
                                    <div class="input-group input-group-sm d-print-none">
                                        <input type="number" step="1" min="0" class="form-control text-end"
                                               value="@FormatNum(regionTargets.GetValueOrDefault(cls))"
                                               @onchange="e => OnRegionTargetChanged(cls, e.Value)" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    @* Print renders the value as plain text so it right-aligns like the Achievable row. *@
                                    <span class="d-none d-print-inline">@FormatNum(regionTargets.GetValueOrDefault(cls))%</span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <th class="fw-normal text-body-secondary small">@L["Region_Achieved"]</th>
                            @foreach (var cls in regionList)
                            {
                                <td @key="cls" class="text-end text-body-secondary">
                                    @(solved is { } sv ? sv.Achieved.GetValueOrDefault(cls).ToString("0.#", CultureInfo.InvariantCulture) + "%" : "")
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div></div>
    }

    <div class="table-responsive">
        <table class="table table-sm align-top no-last-border">
            <thead>
                <tr>
                    <th style="width: 2rem;" class="d-print-none"></th>
                    <th>@L["Col_Security"]</th>
                    <th class="text-end">@L["Col_Current"]</th>
                    @if (!RegionMode)
                    {
                        <th class="text-end" style="width: 9rem;">@(targetBy == "amount" ? L["Col_TargetAmount"] : L["Col_Weight"])</th>
                    }
                    <th class="text-end">@L["Col_Trade"]</th>
                    <th class="text-end">@L["Col_After"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in securities)
                {
                    var included = selected.Contains(s.Key);
                    var row = plan.Rows.FirstOrDefault(r => r.Key == s.Key);
                    var whole = IsWholeShare(s);
                    var sh = whole ? " sh" : "";
                    var curShares = (decimal)s.Quantity;
                    decimal? tradeShares = (s.Price is { } unitPrice && unitPrice > 0m && row is { } rr) ? rr.Delta / unitPrice : null;
                    var afterShares = curShares + (tradeShares ?? 0m);
                    // Unit counts need a price (or a real holding). An added, not-held security has
                    // neither yet, so show percentages only — "· 0 sh" would misread as "holds none".
                    var showUnits = s.Price is > 0m || s.Quantity > 0;
                    @* Every cell renders the same line structure regardless of selection (disabled
                       input + a non-breaking-space placeholder on each second line, so empty lines
                       keep the exact text height) — toggling a security doesn't reflow the row. *@
                    <tr @key="s.Key" class="@(included ? "" : "text-body-secondary d-print-none")">
                        <td class="d-print-none">
                            <input type="checkbox" class="form-check-input" checked="@included"
                                   @onchange="e => ToggleSelected(s.Key, e.Value)" aria-label="@s.Name" />
                        </td>
                        <td>
                            <div class="fw-semibold">
                                @s.Name
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 ms-1 align-baseline @(noBuy.Contains(s.Key) ? "text-warning" : "text-body-secondary")"
                                        title="@L["NoBuy_Tooltip"]" aria-pressed="@noBuy.Contains(s.Key).ToString().ToLower()"
                                        @onclick="() => ToggleNoBuy(s.Key)" disabled="@(!included)">
                                    <i class="bi @(noBuy.Contains(s.Key) ? "bi-cart-x-fill" : "bi-cart-x")" aria-hidden="true"></i>
                                </button>
                                @* The button is hidden on paper (it's a .btn); when "don't buy" is on, keep a
                                   static marker so the printed plan still shows the constraint. *@
                                @if (noBuy.Contains(s.Key))
                                {
                                    <i class="bi bi-cart-x-fill ms-1 d-none d-print-inline" title="@L["NoBuy_Tooltip"]" aria-hidden="true"></i>
                                }
                                @if (addedKeys.Contains(s.Key))
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline text-body-secondary d-print-none"
                                            title="@L["Added_Remove"]" @onclick="() => RemoveAdded(s.Key)">
                                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                            <div class="text-body-secondary small">@s.Isin@(addedKeys.Contains(s.Key) ? " · " + L["Added_NotHeld"] : "")</div>
                        </td>
                        <td class="text-end">
                            <div>@Formatting.FormatMoney(s.Value, s.PriceCurrency ?? "EUR")</div>
                            <div class="text-body-secondary small">@JoinDot(row is { } cr ? cr.CurrentFraction.ToString("P1", CultureInfo.CurrentCulture) : null, showUnits ? FormatShares(curShares, whole) + sh : null)</div>
                        </td>
                        @if (!RegionMode)
                        {
                            <td class="text-end">
                                <input type="number" step="@(targetBy == "amount" ? "1000" : "1")" min="0"
                                       class="form-control form-control-sm text-end" disabled="@(!included)"
                                       value="@FormatNum(targets.GetValueOrDefault(s.Key))"
                                       @onchange="e => OnTargetChanged(s.Key, e.Value)" />
                            </td>
                        }
                        <td class="text-end">
                            @if (included && row is { } tr2 && Math.Abs(tr2.Delta) >= 0.005m)
                            {
                                <div class="@(tr2.Delta < 0 ? "text-danger" : "text-success")">
                                    @(tr2.Delta < 0 ? L["Sell"] : L["Buy"]) @Formatting.FormatMoney(Math.Abs(tr2.Delta), s.PriceCurrency ?? "EUR")
                                </div>
                                <div class="text-body-secondary small">@(tradeShares is { } ts ? (ts < 0 ? "−" : "+") + FormatShares(Math.Abs(ts), whole) + sh : "")</div>
                            }
                            else
                            {
                                <div class="text-body-secondary">@L["Hold"]</div>
                                <div class="text-body-secondary small">@Nbsp</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (included && row is { } ar)
                            {
                                <div>@Formatting.FormatMoney(ar.TargetValue, s.PriceCurrency ?? "EUR")</div>
                                <div class="text-body-secondary small">@JoinDot(ar.TargetFraction.ToString("P1", CultureInfo.CurrentCulture), showUnits ? FormatShares(afterShares, whole) + sh : null)</div>
                            }
                            else
                            {
                                <div>@L["Hold"]</div>
                                <div class="text-body-secondary small">@Nbsp</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (AddableOptions.Any())
    {
        @* Add a security you don't hold (from the PortfolioPerformance catalogue) to plan buying
           into it. Datalist gives type-to-filter with no JS; the value carries the ISIN so the
           pick is unambiguous. Screen-only — it's an editing affordance, not part of the plan. *@
        <div class="d-print-none mb-3" style="max-width: 26rem;">
            <input class="form-control form-control-sm" list="rebal-addable" value="@addQuery"
                   placeholder="@L["Add_Placeholder"]" aria-label="@L["Add_Placeholder"]"
                   @onchange="OnAddSecurity" />
            <datalist id="rebal-addable">
                @foreach (var a in AddableOptions)
                {
                    <option @key="a.Isin" value="@($"{a.Name} · {a.Isin}")"></option>
                }
            </datalist>
        </div>
    }

    <div class="card mt-3"><div class="card-body">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="text-body-secondary small">@L["Summary_Pool"]</div>
                <div class="h5 mb-0">@Formatting.FormatMoney(plan.Pool)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-body-secondary small">@L["Summary_Buys"]</div>
                <div class="h5 mb-0 text-success">@Formatting.FormatMoney(plan.TotalBuys)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-body-secondary small">@L["Summary_Sells"]</div>
                <div class="h5 mb-0 text-danger">@Formatting.FormatMoney(plan.TotalSells)</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-body-secondary small">@(plan.Feasible ? L["Summary_Leftover"] : L["Summary_Shortfall"])</div>
                <div class="h5 mb-0 @(plan.Feasible ? "" : "text-danger")">
                    @Formatting.FormatMoney(plan.Feasible ? plan.Leftover : plan.Pool - SumTargets())
                </div>
            </div>
        </div>
        @if (!plan.Feasible)
        {
            <div class="alert alert-warning mt-3 mb-0 py-2 small">@L["Infeasible_Warning"]</div>
        }
    </div></div>

    @if (tax.Covered > 0)
    {
        <div class="card mt-3"><div class="card-body py-2">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <div class="text-body-secondary small">@L["Tax_RealisedGain"]</div>
                    <div class="h6 mb-0 @(tax.Gross < 0 ? "text-danger" : "")">@Formatting.FormatMoney(tax.Gross)</div>
                </div>
                <div class="col-auto">
                    <div class="text-body-secondary small">@L["Tax_Taxable"]</div>
                    <div class="h6 mb-0">@Formatting.FormatMoney(tax.Taxable)</div>
                </div>
                <div class="col">
                    <div class="text-body-secondary small">
                        @L["Tax_Caveat"]@(tax.Uncovered > 0 ? " · " + L["Tax_Excluded", tax.Uncovered] : "")
                    </div>
                </div>
            </div>
        </div></div>
    }

    <p class="text-body-secondary small mt-3"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@L["Disclaimer"]</p>
}

@code {
    [Parameter] public int ProjectId { get; set; }

    // Holds an otherwise-empty second line at full text height so toggling a row doesn't reflow it.
    private readonly MarkupString Nbsp = (MarkupString)"&nbsp;";

    private string? projectName;
    private bool notFound;
    private bool loading = true;
    private int _loadedProjectId = -1;
    private int sourceId;

    private List<HoldingRow> securities = new();
    // Securities the user added from the PortfolioPerformance catalogue (not currently held). Kept
    // in `securities` as Value=0 rows; tracked here so they can be marked, removed, and cleared on
    // reload. Ephemeral — a per-session scratchpad, never persisted.
    private readonly HashSet<string> addedKeys = new(StringComparer.Ordinal);
    private List<CatalogSecurity> addable = new();
    private string addQuery = "";
    // Tax profiles for the project's positions (lots + regime), keyed by position identity — drives
    // the realised-gain estimate.
    private Dictionary<string, TaxProfile> taxProfiles = new(StringComparer.Ordinal);
    private readonly HashSet<string> selected = new(StringComparer.Ordinal);
    // Securities the rebalance may hold or sell but not buy more of (e.g. distributing ETFs).
    private readonly HashSet<string> noBuy = new(StringComparer.Ordinal);
    private Dictionary<string, decimal> targets = new(StringComparer.Ordinal);
    private decimal cash;
    // "ratio" | "amount" (manual per-security targets) | "region" (solver-driven, live).
    private string targetBy = "ratio";
    private bool RegionMode => targetBy == "region";
    private RebalanceTargetMode ManualMode => targetBy == "amount" ? RebalanceTargetMode.Amount : RebalanceTargetMode.Ratio;
    private string IntroKey => targetBy switch
    {
        "amount" => "Intro_Amount",
        "region" => "Intro_Taxonomy",
        _ => "Intro_Ratio"
    };

    // Region/taxonomy targeting: solved into per-security targets via RebalanceSolver.
    private List<string> taxonomyNames = new();
    private string? regionTaxonomy;
    private List<string> regionList = new();
    private Dictionary<string, decimal> regionTargets = new(StringComparer.Ordinal);                  // class -> percent
    private Dictionary<string, Dictionary<string, decimal>> securityWeights = new(StringComparer.Ordinal); // isin -> class -> fraction
    private static readonly Dictionary<string, decimal> EmptyWeights = new(StringComparer.Ordinal);
    private const string UnclassifiedLabel = "Unclassified";

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area == DataArea.MoneyMoneyData && (change.SourceId == null || change.SourceId == sourceId);

    protected override async Task ReloadAfterChangeAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        notFound = false;
        var project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) { notFound = true; loading = false; return; }
        projectName = project.Name;
        sourceId = project.SourceId;

        var holdings = await Portfolio.GetProjectHoldingsAsync(ProjectId);
        securities = holdings?.Rows ?? new List<HoldingRow>();
        taxonomyNames = holdings?.Taxonomies.Select(t => t.TaxonomyName).ToList() ?? new List<string>();
        regionTaxonomy = taxonomyNames.FirstOrDefault();
        // Catalogue securities a user can add — everything PortfolioPerformance knows for this source
        // that isn't already held. Added rows are ephemeral, so start clean on every (re)load.
        addedKeys.Clear();
        addQuery = "";
        var heldIsins = securities.Where(s => !string.IsNullOrEmpty(s.Isin)).Select(s => s.Isin!).ToList();
        addable = await Portfolio.GetAddableSecuritiesAsync(ProjectId, heldIsins);
        taxProfiles = await Portfolio.GetProjectTaxProfilesAsync(ProjectId);
        targetBy = "ratio";
        regionList = new List<string>();
        regionTargets = new Dictionary<string, decimal>(StringComparer.Ordinal);
        securityWeights = new Dictionary<string, Dictionary<string, decimal>>(StringComparer.Ordinal);
        ResetTargets();
        loading = false;
    }

    // Default: every security selected, targeted at its current value — so the plan opens with
    // zero trades and the user nudges from there (works as weights in Ratio mode too).
    private void ResetTargets()
    {
        selected.Clear();
        noBuy.Clear();
        targets = new Dictionary<string, decimal>(StringComparer.Ordinal);
        foreach (var s in securities)
        {
            selected.Add(s.Key);
            targets[s.Key] = decimal.Round(s.Value, 2);
        }
        cash = 0m;
    }

    private RebalancePlan BuildManualPlan()
    {
        var items = securities
            .Where(s => selected.Contains(s.Key))
            .Select(s => new RebalanceInput
            {
                Key = s.Key,
                Name = s.Name,
                CurrentValue = s.Value,
                Price = s.Price,
                WholeShares = IsWholeShare(s)
            })
            .ToList();
        return RebalanceMath.ComputePlan(items, cash, ManualMode, targets, noBuy);
    }

    // Region mode: the per-security plan is the solver's output directly, so editing a region
    // target updates the trades live (no apply step).
    private RebalancePlan BuildRegionPlan((List<HoldingRow> Sel, double[] F, Dictionary<string, decimal> Achieved)? solved)
    {
        if (solved is not { } sv) return new RebalancePlan();
        decimal pool = sv.Sel.Sum(s => s.Value) + cash;
        var rows = new List<RebalanceRow>(sv.Sel.Count);
        for (int i = 0; i < sv.Sel.Count; i++)
        {
            var s = sv.Sel[i];
            decimal targetValue = decimal.Round((decimal)sv.F[i] * pool, 2);
            // Round share-based trades to whole units, then suppress sub-€1 dust.
            targetValue = RebalanceMath.QuantizeTarget(s.Value, targetValue, s.Price, IsWholeShare(s));
            if (Math.Abs(targetValue - s.Value) < RebalanceMath.TradeEpsilon) targetValue = s.Value;
            rows.Add(new RebalanceRow
            {
                Key = s.Key,
                Name = s.Name,
                CurrentValue = s.Value,
                CurrentFraction = pool > 0m ? s.Value / pool : 0m,
                TargetValue = targetValue,
                TargetFraction = pool > 0m ? targetValue / pool : 0m,
                Delta = targetValue - s.Value
            });
        }
        decimal totalTarget = rows.Sum(r => r.TargetValue);
        return new RebalancePlan
        {
            Pool = pool,
            Cash = cash,
            TotalBuys = rows.Where(r => r.Delta > 0m).Sum(r => r.Delta),
            TotalSells = rows.Where(r => r.Delta < 0m).Sum(r => -r.Delta),
            Leftover = Math.Max(0m, pool - totalTarget),
            Feasible = true,
            Rows = rows
        };
    }

    private void ToggleNoBuy(string key)
    {
        if (!noBuy.Remove(key)) noBuy.Add(key);
    }

    // Catalogue picks still offerable: not already in the working list (held or already added).
    private IEnumerable<CatalogSecurity> AddableOptions
    {
        get
        {
            var present = securities.Where(s => !string.IsNullOrEmpty(s.Isin))
                .Select(s => s.Isin!).ToHashSet(StringComparer.Ordinal);
            return addable.Where(a => !present.Contains(a.Isin));
        }
    }

    // Joins non-empty sub-line parts with " · " so a missing unit count doesn't leave a dangling dot.
    private static string JoinDot(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));

    private async Task OnAddSecurity(ChangeEventArgs e)
    {
        addQuery = "";
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val)) return;
        // The datalist option value is "Name · ISIN"; fall back to a bare ISIN if the user typed one.
        var pick = AddableOptions.FirstOrDefault(a => $"{a.Name} · {a.Isin}" == val)
                   ?? AddableOptions.FirstOrDefault(a => string.Equals(a.Isin, val.Trim(), StringComparison.OrdinalIgnoreCase));
        if (pick == null) return;

        var key = "isin:" + pick.Isin;
        if (securities.Any(s => s.Key == key)) return;
        securities.Add(new HoldingRow
        {
            Key = key,
            Name = pick.Name,
            Isin = pick.Isin,
            Symbol = pick.Symbol,
            Wkn = pick.Wkn,
            Value = 0m,
            Quantity = 0,
            // Use the catalogue price only when it's EUR — the pool is in EUR, so a foreign-quoted
            // price would give a wrong share count. Without a usable price the row shows € only.
            Price = string.Equals(pick.Currency, "EUR", StringComparison.OrdinalIgnoreCase) ? pick.Price : null,
            PriceCurrency = pick.Currency
        });
        addedKeys.Add(key);
        selected.Add(key);
        targets[key] = 0m;
        // Pull in the new security's taxonomy weights/classes without clobbering entered targets.
        if (RegionMode) await LoadRegionWeightsAsync(preserveTargets: true);
    }

    private async Task RemoveAdded(string key)
    {
        securities.RemoveAll(s => s.Key == key);
        addedKeys.Remove(key);
        selected.Remove(key);
        noBuy.Remove(key);
        targets.Remove(key);
        if (RegionMode) await LoadRegionWeightsAsync(preserveTargets: true);
    }

    private readonly record struct TaxReadout(decimal Gross, decimal Taxable, int Covered, int Uncovered);

    // Estimate the realised gain of the plan's sells from the FIFO lots (Abgeltungsteuer securities
    // only, for now). Sold positions without lot data (crypto, unlinked depots, no price) are counted
    // as uncovered so the estimate doesn't silently understate.
    private TaxReadout EstimateTax(RebalancePlan plan)
    {
        decimal gross = 0m, taxable = 0m;
        int covered = 0, uncovered = 0;
        var today = DateOnly.FromDateTime(DateTime.Today);
        foreach (var r in plan.Rows.Where(r => r.Delta < 0m))
        {
            var s = securities.FirstOrDefault(x => x.Key == r.Key);
            if (s?.Price is not { } price || price <= 0m
                || !taxProfiles.TryGetValue(r.Key, out var profile) || profile.Lots.Count == 0)
            {
                uncovered++;
                continue;
            }
            var rg = TaxMath.RealizeSale(profile.Lots, -r.Delta / price, price, today,
                profile.AssetKind, profile.TeilfreistellungRate, profile.SpekulationsfristYears);
            gross += rg.GrossGain;
            taxable += rg.TaxableGain;
            covered++;
        }
        return new TaxReadout(gross, taxable, covered, uncovered);
    }

    private decimal SumTargets() =>
        targetBy == "amount"
            ? securities.Where(s => selected.Contains(s.Key)).Sum(s => Math.Max(0m, targets.GetValueOrDefault(s.Key)))
            : 0m;

    private void ToggleSelected(string key, object? value)
    {
        if (value is true || (value is string vs && bool.TryParse(vs, out var b) && b)) selected.Add(key);
        else selected.Remove(key);
    }

    // Switch the target mode. Leaving region mode hands its solved mix to the manual targets so the
    // user can fine-tune from it; entering it loads the taxonomy weights once.
    private async Task SetTargetBy(string v)
    {
        if (v == targetBy) return;
        if (RegionMode && v != "region" && SolveRegions() is { } solved)
        {
            decimal pool = solved.Sel.Sum(s => s.Value) + cash;
            for (int i = 0; i < solved.Sel.Count; i++)
                targets[solved.Sel[i].Key] = decimal.Round((decimal)solved.F[i] * pool, 2);
        }
        targetBy = v;
        if (v == "region" && regionList.Count == 0) await LoadRegionWeightsAsync();
    }

    private void OnCashChanged(ChangeEventArgs e) => cash = ParseNum(e.Value);

    private void OnTargetChanged(string key, object? value) => targets[key] = ParseNum(value);

    // ----- Region/taxonomy targeting -----

    private async Task OnRegionTaxonomyChanged(ChangeEventArgs e)
    {
        regionTaxonomy = e.Value?.ToString();
        await LoadRegionWeightsAsync();
    }

    // preserveTargets keeps the user's entered class targets across a securities change (add/remove),
    // filling any newly-introduced class at 0; otherwise targets open at the current achieved mix.
    private async Task LoadRegionWeightsAsync(bool preserveTargets = false)
    {
        if (string.IsNullOrEmpty(regionTaxonomy)) { regionList = new List<string>(); return; }
        var isins = securities.Where(s => !string.IsNullOrEmpty(s.Isin)).Select(s => s.Isin!).Distinct(StringComparer.Ordinal).ToList();
        securityWeights = await Portfolio.GetSecurityTaxonomyWeightsAsync(ProjectId, regionTaxonomy, isins);
        var classes = securityWeights.Values.SelectMany(d => d.Keys).Distinct(StringComparer.Ordinal)
            .OrderBy(x => x, StringComparer.Ordinal).ToList();
        classes.Add(UnclassifiedLabel);
        regionList = classes;
        if (preserveTargets)
        {
            regionTargets = regionList.ToDictionary(r => r, r => regionTargets.GetValueOrDefault(r), StringComparer.Ordinal);
            return;
        }
        // Open at the current achieved mix so the user nudges from status quo.
        var solved = SolveRegions();
        regionTargets = solved?.Achieved ?? regionList.ToDictionary(r => r, _ => 0m, StringComparer.Ordinal);
    }

    private IReadOnlyDictionary<string, decimal> WeightsFor(HoldingRow s) =>
        !string.IsNullOrEmpty(s.Isin) && securityWeights.TryGetValue(s.Isin!, out var w) ? w : EmptyWeights;

    private double[] WeightVector(HoldingRow s, Dictionary<string, int> idx)
    {
        var vec = new double[regionList.Count];
        decimal assigned = 0m;
        foreach (var (cls, frac) in WeightsFor(s))
            if (idx.TryGetValue(cls, out var k)) { vec[k] += (double)frac; assigned += frac; }
        vec[idx[UnclassifiedLabel]] += (double)Math.Max(0m, 1m - assigned);
        return vec;
    }

    private (List<HoldingRow> Sel, double[] F, Dictionary<string, decimal> Achieved)? SolveRegions()
    {
        if (regionList.Count == 0) return null;
        var sel = securities.Where(s => selected.Contains(s.Key)).ToList();
        if (sel.Count == 0) return null;

        var idx = new Dictionary<string, int>(StringComparer.Ordinal);
        for (int i = 0; i < regionList.Count; i++) idx[regionList[i]] = i;
        var vectors = sel.Select(s => WeightVector(s, idx)).ToList();

        decimal sum = regionList.Sum(r => Math.Max(0m, regionTargets.GetValueOrDefault(r)));
        var tgt = regionList
            .Select(r => sum > 0m ? (double)(Math.Max(0m, regionTargets.GetValueOrDefault(r)) / sum) : 1.0 / regionList.Count)
            .ToArray();

        // "Don't buy more" caps a security at its current pool fraction, so the solver can only hold
        // or sell it and routes new money elsewhere.
        decimal pool = sel.Sum(s => s.Value) + cash;
        var upper = sel
            .Select(s => noBuy.Contains(s.Key) && pool > 0m ? (double)(s.Value / pool) : 1.0)
            .ToList();
        // Current mix drives the turnover penalty so the solver trades as little as possible
        // (otherwise it churns between look-through-identical securities like Acc/Dist share classes).
        var current = sel.Select(s => pool > 0m ? (double)(s.Value / pool) : 0.0).ToList();

        var f = RebalanceSolver.Solve(vectors, tgt, upper, current);

        var achieved = new Dictionary<string, decimal>(StringComparer.Ordinal);
        for (int k = 0; k < regionList.Count; k++)
        {
            double a = 0;
            for (int i = 0; i < sel.Count; i++) a += f[i] * vectors[i][k];
            achieved[regionList[k]] = decimal.Round((decimal)a * 100m, 1);
        }
        return (sel, f, achieved);
    }

    private void OnRegionTargetChanged(string cls, object? value) => regionTargets[cls] = ParseNum(value);

    // <input type="number"> posts its value in invariant form (decimal point), regardless of UI culture.
    private static decimal ParseNum(object? value) =>
        decimal.TryParse(value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? Math.Max(0m, v) : 0m;

    private static string FormatNum(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // ISIN-bearing securities (ETFs/stocks) trade in whole units; crypto (no ISIN) is fractional.
    private static bool IsWholeShare(HoldingRow s) => !string.IsNullOrEmpty(s.Isin);

    private static string FormatShares(decimal shares, bool whole) =>
        whole ? shares.ToString("N0", CultureInfo.CurrentCulture)
              : shares.ToString("0.######", CultureInfo.CurrentCulture);
}
