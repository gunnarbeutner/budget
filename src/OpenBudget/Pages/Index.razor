@page "/"
@using OpenBudget.Services
@inject ProjectService ProjectService
@inject AccessScopeProvider AccessProvider
@inject CurrentProjectState Current
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<Index> L

@* "/" has no page of its own any more: it opens the project the user was in last (this circuit's project, else the
   ob.lastProject cookie that ProjectPageHeader writes), else their default project, else the first one. The
   project switcher replaced the old start page. Only without any project is there something to show: the
   first-run welcome with "New Project". *@

<PageTitle>@L["PageTitle"]</PageTitle>

@if (noProjects)
{
    <div class="alert alert-info mt-4">
        <h4>@L["Welcome_Heading"]</h4>
        <p>@L["Welcome_Body"]</p>
        <a class="btn btn-primary" href="/projects/manage?new=1">@L["Button_NewProject"]</a>
    </div>
}

@code {
    private bool noProjects;

    protected override async Task OnInitializedAsync()
    {
        var projects = await ProjectService.GetProjectsAsync();
        if (projects.Count == 0)
        {
            noProjects = true;
            return;
        }
        var scope = await AccessProvider.GetAsync();
        var target = Find(projects, Current.ProjectId)
                     ?? Find(projects, LastProjectFromCookie())
                     ?? projects.FirstOrDefault(p => p.IsDefaultForNewAccounts && scope.IsOwner(p.Id))
                     ?? projects[0];
        // During prerendering this becomes an HTTP redirect; on a client-side visit a router navigation.
        Navigation.NavigateTo($"/projects/{target.Id}/browse", replace: true);
    }

    private static OpenBudget.Models.Project? Find(List<OpenBudget.Models.Project> projects, int? id) =>
        id is { } v ? projects.FirstOrDefault(p => p.Id == v) : null;

    private int? LastProjectFromCookie() =>
        HttpContextAccessor.HttpContext?.Request.Cookies["ob.lastProject"] is { } raw
        && int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : null;
}
