@page "/"
@inherits DataChangeAwareComponent
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject TransactionQueryService TransactionQueries
@inject NavigationManager Navigation
@inject IStringLocalizer<Index> L
@inject ILogger<Index> Logger

@* The dashboard is now a lean *portfolio*: one slim row per project for a fast scan + jump-in,
   plus the collection-level actions (reorder, create, sources). The rich per-project detail —
   balance, budget-vs-actual, category breakdown — moved to each project's Overview tab, so a
   row's job is just status-at-a-glance and a link inward. The shared PeriodNav drives the
   per-row numbers and matches the toolbar on Overview/Browse. *@

<PageTitle>@L["PageTitle"]</PageTitle>

<PeriodNav Anchor="anchor" Period="@period" ShowMonthPicker="true"
           MinMonth="monthMin" MaxMonth="monthMax" OnChanged="OnPeriodChanged">
    <Trailing>
        <a href="/sources" class="text-decoration-none text-body-secondary small d-inline-flex align-items-center gap-1"
           title="@L["Aria_Sources"]">
            <i class="bi bi-database" aria-hidden="true"></i>
            <span>@L["Aria_Sources"]</span>
        </a>
    </Trailing>
</PeriodNav>

@if (budgetSummaries == null)
{
    <div class="portfolio-list" aria-busy="true" aria-label="@L["Status_Loading"]">
        @for (int i = 0; i < 3; i++)
        {
            <div class="portfolio-row">
                <div class="portfolio-identity">
                    <span class="project-status-dot"></span>
                    <div class="flex-grow-1">
                        <div class="skeleton skeleton-line" style="width: 40%;"></div>
                        <div class="skeleton skeleton-line" style="width: 25%;"></div>
                    </div>
                </div>
                <div class="portfolio-health">
                    <div class="skeleton skeleton-line" style="width: 80%; margin-left: auto;"></div>
                </div>
                <div class="portfolio-actions"></div>
            </div>
        }
    </div>
}
else if (!budgetSummaries.Any())
{
    <div class="alert alert-info">
        <h4>@L["Welcome_Heading"]</h4>
        <p class="mb-0">@L["Welcome_Body"]</p>
    </div>
}
else
{
    <div class="portfolio-list">
        @for (int i = 0; i < budgetSummaries.Count; i++)
        {
            var summary = budgetSummaries[i];
            var isFirst = i == 0;
            var isLast = i == budgetSummaries.Count - 1;
            var projectId = summary.ProjectId;
            var statusClass = ProjectStatus.StatusClass(summary);
            var overallPercent = ProjectStatus.OverallPercent(summary);
            var balanceInfo = projectBalances.GetValueOrDefault(projectId);
            var hasBalance = balanceInfo is { AccountCount: > 0 };
            var overviewUrl = $"/projects/{projectId}/overview{AnchorQuery()}";

            <div class="portfolio-row status-@statusClass">
                <div class="portfolio-identity">
                    <span class="project-status-dot" aria-hidden="true"></span>
                    <div style="min-width: 0;">
                        <div class="portfolio-name">
                            <a href="@overviewUrl" class="stretched-link text-reset text-decoration-none">@summary.ProjectName</a>
                        </div>
                        @if (hasBalance)
                        {
                            <div class="portfolio-sub text-nowrap @(balanceInfo!.Balance < 0 ? "text-danger" : "")">
                                @Formatting.FormatMoney(balanceInfo.Balance)
                                <span class="text-body-secondary">·
                                    @L[balanceInfo.AccountCount == 1 ? "Label_Account_One" : "Label_Account_Other", balanceInfo.AccountCount]</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="portfolio-health">
                    @if (summary.HasBudget)
                    {
                        <div class="d-flex justify-content-end align-items-baseline gap-2">
                            <span class="small text-body-secondary text-nowrap">
                                @Formatting.FormatMoney(summary.TotalSpent) / @Formatting.FormatMoney(summary.TotalBudget)
                            </span>
                            <span class="small fw-semibold text-@statusClass">@overallPercent.ToString("F0")%</span>
                        </div>
                        <div class="progress mt-1" style="height: 6px;">
                            <div class="progress-bar bg-@statusClass" role="progressbar"
                                 style="width: @(Math.Min(overallPercent, 100).ToString(CultureInfo.InvariantCulture))%"
                                 aria-valuenow="@overallPercent.ToString(CultureInfo.InvariantCulture)"
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    }
                    else
                    {
                        <div class="small text-body-secondary">@L["Label_Net"]</div>
                        <div class="fw-semibold text-nowrap text-@statusClass">@Formatting.FormatMoney(summary.MonthNet)</div>
                    }
                </div>

                <div class="portfolio-actions">
                    <button type="button" class="btn btn-link text-body-secondary p-0"
                            title="@L["Aria_MoveUp"]" aria-label="@L["Aria_MoveUp"]"
                            disabled="@isFirst" @onclick="() => MoveProject(projectId, -1)">
                        <i class="bi bi-arrow-up" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-link text-body-secondary p-0"
                            title="@L["Aria_MoveDown"]" aria-label="@L["Aria_MoveDown"]"
                            disabled="@isLast" @onclick="() => MoveProject(projectId, 1)">
                        <i class="bi bi-arrow-down" aria-hidden="true"></i>
                    </button>
                    <a href="@($"/projects/{projectId}/settings")" class="text-body-secondary text-decoration-none"
                       title="@L["Aria_ProjectSettings"]" aria-label="@L["Aria_ProjectSettings"]">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <button class="btn btn-primary" @onclick="ShowCreateDialog">@L["Button_NewProject"]</button>
</div>

<Modal Show="@showCreateDialog" Title="@L["Modal_CreateNewProject"]" OnClose="@HideCreateDialog">
    <ChildContent>
        <div class="mb-3">
            <label for="projectName" class="form-label">@L["Form_NameLabel"]</label>
            <input type="text" class="form-control" id="projectName" @bind="newProjectName" />
        </div>
        <div class="mb-3">
            <label for="projectDescription" class="form-label">@L["Form_DescriptionLabel"]</label>
            <textarea class="form-control" id="projectDescription" @bind="newProjectDescription" rows="3"></textarea>
        </div>
        @if (availableSources.Count > 1)
        {
            <div class="mb-3">
                <label for="projectSource" class="form-label">@L["Form_SourceLabel"]</label>
                <select id="projectSource" class="form-select" @bind="newProjectSourceId">
                    @foreach (var s in availableSources)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="HideCreateDialog">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" @onclick="CreateProject" disabled="@string.IsNullOrWhiteSpace(newProjectName)">@L["Button_Create"]</button>
    </Footer>
</Modal>

@code {
    private List<ProjectSpendingSummary>? budgetSummaries;
    private Dictionary<int, ProjectBalanceSummary> projectBalances = new();
    private List<ImportSource> availableSources = new();
    private bool showCreateDialog = false;
    private string newProjectName = "";
    private string newProjectDescription = "";
    private int newProjectSourceId = SourceScope.LegacySourceId;

    // "month" = anchor month only, "ytd" = Jan..anchor.Month, "year" = full anchor year.
    private string period = "month";
    // The user-selected reference point; period reinterprets it (see Anchoring).
    private (int Year, int Month) anchor;

    // The selectable month window across every source (the dashboard spans them all). The latest
    // bound may sit in the future — pending, future-dated rows. Null until loaded / when there are no
    // transactions, in which case EffectiveMin/Max fall back to [1900-01 .. current month].
    private (int Year, int Month)? monthMin;
    private (int Year, int Month)? monthMax;
    private (int Year, int Month) EffectiveMin => monthMin ?? (1900, 1);
    private (int Year, int Month) EffectiveMax => monthMax ?? (DateTime.Now.Year, DateTime.Now.Month);

    protected override async Task OnInitializedAsync()
    {
        await RefreshBoundsAsync();
        ReadStateFromQuery();
        await LoadDashboard();
    }

    // Any committed change anywhere can move a dashboard number (balances, spending, project list).
    protected override bool IsRelevantChange(DataChange change) => true;
    protected override async Task ReloadAfterChangeAsync()
    {
        await RefreshBoundsAsync();
        await LoadDashboard();
    }

    private async Task RefreshBoundsAsync() => (monthMin, monthMax) = await TransactionQueries.GetMonthBoundsAsync(null);

    private void ReadStateFromQuery()
    {
        var now = DateTime.Now;
        anchor = (now.Year, now.Month);
        period = "month";

        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("period", out var p) && p.ToString() is "month" or "ytd" or "year")
            period = p.ToString();

        if (PageState.ReadIntQuery(Navigation, "year") is { } y &&
            PageState.ReadIntQuery(Navigation, "month") is { } m && m is >= 1 and <= 12)
        {
            anchor = Anchoring.Clamp((y, m), EffectiveMin, EffectiveMax);
        }
    }

    private void UpdateUrl() => PageState.ReplaceQuery(Navigation, new Dictionary<string, object?>
    {
        ["year"] = anchor.Year,
        ["month"] = anchor.Month,
        ["period"] = period == "month" ? null : period,
    });

    /// <summary>"?year=&month=&period=" suffix carried into each project's Overview tab.</summary>
    private string AnchorQuery()
        => $"?year={anchor.Year}&month={anchor.Month}" + (period == "month" ? "" : $"&period={period}");

    private async Task OnPeriodChanged((int Year, int Month, string Period) next)
    {
        anchor = (next.Year, next.Month);
        period = next.Period;
        UpdateUrl();
        budgetSummaries = null;
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        var projects = await ProjectService.GetProjectsAsync();
        budgetSummaries = new List<ProjectSpendingSummary>();

        var (fromMonth, toMonth) = Anchoring.Range(anchor.Month, period);
        foreach (var project in projects)
        {
            try
            {
                var summary = await BudgetService.GetSpendingSummaryAsync(project.Id, anchor.Year, fromMonth, toMonth);
                budgetSummaries.Add(summary);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading spending summary for project {ProjectId}.", project.Id);
            }
        }

        // Period-independent context for the status accents.
        projectBalances = await ProjectService.GetAllProjectsBalancesAsync();
        availableSources = await ProjectService.GetAllSourcesAsync();
        if (!availableSources.Any(s => s.Id == newProjectSourceId))
        {
            newProjectSourceId = availableSources.FirstOrDefault()?.Id ?? SourceScope.LegacySourceId;
        }
    }

    private async Task MoveProject(int projectId, int direction)
    {
        await ProjectService.MoveProjectAsync(projectId, direction);
        await LoadDashboard();
    }

    private void ShowCreateDialog()
    {
        newProjectName = "";
        newProjectDescription = "";
        showCreateDialog = true;
    }

    private void HideCreateDialog() => showCreateDialog = false;

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName))
            return;

        var sourceId = availableSources.Any(s => s.Id == newProjectSourceId)
            ? newProjectSourceId
            : (availableSources.FirstOrDefault()?.Id ?? SourceScope.LegacySourceId);
        await ProjectService.CreateProjectAsync(newProjectName, sourceId, newProjectDescription);
        showCreateDialog = false;
        await LoadDashboard();
    }
}
