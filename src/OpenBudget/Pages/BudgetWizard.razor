@page "/projects/{ProjectId:int}/budgets/new"
@attribute [RequireProjectRole(OpenBudget.Models.ProjectRole.Editor)]
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using OpenBudget.Shared
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject BudgetEntryService BudgetEntryService
@inject OpenBudget.Assist.BudgetSuggestionService BudgetSuggestions
@inject OpenBudget.Assist.AssistSettingsService AssistSettings
@inject CategoryHierarchyService CategoryHierarchyService
@inject NavigationManager Navigation
@inject IStringLocalizer<BudgetWizard> L
@inject ClockService Clock

<PageTitle>@L["PageTitle"]</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">@L["NotFound_Before"]<a href="/">@L["NotFound_LinkText"]</a>@L["NotFound_After"]</p>
    return;
}

<ProjectShell ProjectId="ProjectId" MainClass="shell-page settings-page">
@{
    var wizardProjectName = projects?.FirstOrDefault(p => p.Id == selectedProjectId)?.Name;
}
<ProjectPageHeader ProjectId="@selectedProjectId" ProjectName="@wizardProjectName" />
<PageHeader Title="@L["Header_Title"]" Subtitle="@wizardProjectName" />

<DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

@if (step == 1)
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">@L["Step_One_Title"]</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@L["Form_ProjectLabel"]</label>
                <input type="text" class="form-control" value="@(projects?.FirstOrDefault(p => p.Id == selectedProjectId)?.Name)" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label" for="wizardBudgetYear">@L["Form_BudgetYearLabel"]</label>
                <input type="number" class="form-control" id="wizardBudgetYear" @bind="selectedYear" min="2020" max="2030" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="wizardBudgetName">@L["Form_NameLabel"]</label>
                <input type="text" class="form-control" id="wizardBudgetName" @bind="budgetName" placeholder="@Clock.Today.ToString("yyyy-MM-dd")" />
                <small class="form-text text-body-secondary">@L["Form_NameHelp"]</small>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Form_NotesLabel"]</label>
                <textarea class="form-control" @bind="notes" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">@L["Form_SourceLabel"]</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="sourceMode" id="sourceModePredict"
                           checked="@(sourceMode == "predict")"
                           @onchange="@(() => sourceMode = "predict")" />
                    <label class="form-check-label" for="sourceModePredict">
                        @L["Form_SourcePredict"]
                        <small class="form-text text-body-secondary d-block">@L["Form_SourcePredictHelp"]</small>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="sourceMode" id="sourceModeClone"
                           checked="@(sourceMode == "clone")"
                           disabled="@(availableSourceBudgets == null || availableSourceBudgets.Count == 0)"
                           @onchange="@(() => sourceMode = "clone")" />
                    <label class="form-check-label" for="sourceModeClone">
                        @L["Form_SourceClone"]
                        <small class="form-text text-body-secondary d-block">@L["Form_SourceCloneHelp"]</small>
                    </label>
                </div>
                @if (sourceMode == "clone")
                {
                    <select class="form-select mt-2" @bind="sourceBudgetId" style="max-width: 28em;">
                        <option value="0">@L["Form_SourcePickBudget"]</option>
                        @if (availableSourceBudgets != null)
                        {
                            foreach (var bud in availableSourceBudgets.OrderByDescending(b => b.Year).ThenBy(b => b.Name))
                            {
                                <option value="@bud.Id">@bud.Year — @bud.Name@(bud.IsActive ? L["Form_ActiveSuffix"].Value : "")</option>
                            }
                        }
                    </select>
                }
            </div>

            <button class="btn btn-primary"
                    @onclick="GeneratePredictions"
                    disabled="@(sourceMode == "clone" && sourceBudgetId == 0)">
                @(sourceMode == "clone" ? L["Button_NextClone"] : L["Button_NextGenerate"])
            </button>
            <a href="@($"/projects/{selectedProjectId}/budgets")" class="btn btn-secondary">@L["Button_Cancel"]</a>
        </div>
    </div>
}
else if (step == 2)
{
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">@L["Step_Two_Title"]</h5>
        </div>
        <div class="card-body">
            @if (isGenerating)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">@L["Status_GeneratingShort"]</span>
                    </div>
                    <p>@L["Status_GeneratingLong"]</p>
                </div>
            }
            else if (predictions != null && categoryNames != null)
            {
                <p class="text-body-secondary">
                    @L["Predictions_Intro"]
                </p>
                @if (suggestionError is { } aiError)
                {
                    <div class="small text-danger mb-2" role="alert">@L["Error_Ai", aiError]</div>
                }

                var sortedPredictions = predictions
                    .OrderBy(p => categoryNames.GetValueOrDefault(p.Key, L["Category_Unknown"]))
                    .ToList();
                var wizIncomeRows = sortedPredictions.Where(p => incomeKeys.Contains(p.Key)).ToList();
                var wizExpenseRows = sortedPredictions.Where(p => !incomeKeys.Contains(p.Key)).ToList();
                decimal wizIncomeMonth(int idx) => wizIncomeRows.Sum(p => p.Value[idx]);
                decimal wizExpenseMonth(int idx) => wizExpenseRows.Sum(p => p.Value[idx]);
                var wizIncomeYear = wizIncomeRows.Sum(p => p.Value.Sum());
                var wizExpenseYear = wizExpenseRows.Sum(p => p.Value.Sum());
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@L["Table_Category"]</th>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <th class="text-end">@(new DateTime(2000, m, 1).ToString("MMM"))</th>
                                }
                                <th class="text-end">@L["Table_Total"]</th>
                            </tr>
                        </thead>
                        @if (wizIncomeRows.Any())
                        {
                            <tbody>
                                <tr class="table-secondary">
                                    <th colspan="14">@L["Section_Income"]</th>
                                </tr>
                                @foreach (var (key, amounts) in wizIncomeRows)
                                {
                                    <tr @key="key">
                                        <td>
                                            <div>@categoryNames.GetValueOrDefault(key, L["Category_Unknown"])</div>
                                            @if (suggestionRows.TryGetValue(key, out var suggestionRow))
                                            {
                                                <BudgetSuggestionNotes Row="suggestionRow" ShowBasis="true" />
                                            }
                                        </td>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            var idx = m;
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm amount-input"
                                                       step="0.01"
                                                       @bind="amounts[idx]" />
                                            </td>
                                        }
                                        <td class="text-end"><strong>@Formatting.FormatMoneyDe(amounts.Sum())</strong></td>
                                    </tr>
                                }
                                <tr class="table-primary">
                                    <th>@L["Subtotal_Income"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        <th class="text-end">@Formatting.FormatMoneyDe(wizIncomeMonth(m))</th>
                                    }
                                    <th class="text-end">@Formatting.FormatMoneyDe(wizIncomeYear)</th>
                                </tr>
                            </tbody>
                        }
                        @if (wizExpenseRows.Any())
                        {
                            <tbody>
                                <tr class="table-secondary">
                                    <th colspan="14">@L["Section_Expenses"]</th>
                                </tr>
                                @foreach (var (key, amounts) in wizExpenseRows)
                                {
                                    <tr @key="key">
                                        <td>
                                            <div>@categoryNames.GetValueOrDefault(key, L["Category_Unknown"])</div>
                                            @if (suggestionRows.TryGetValue(key, out var suggestionRow))
                                            {
                                                <BudgetSuggestionNotes Row="suggestionRow" ShowBasis="true" />
                                            }
                                        </td>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            var idx = m;
                                            <td class="text-end">
                                                <input type="number" class="form-control form-control-sm amount-input"
                                                       step="0.01"
                                                       @bind="amounts[idx]" />
                                            </td>
                                        }
                                        <td class="text-end"><strong>@Formatting.FormatMoneyDe(amounts.Sum())</strong></td>
                                    </tr>
                                }
                                <tr class="table-primary">
                                    <th>@L["Subtotal_Expenses"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        <th class="text-end">@Formatting.FormatMoneyDe(wizExpenseMonth(m))</th>
                                    }
                                    <th class="text-end">@Formatting.FormatMoneyDe(wizExpenseYear)</th>
                                </tr>
                            </tbody>
                        }
                        @if (wizIncomeRows.Any() && wizExpenseRows.Any())
                        {
                            var netYear = wizIncomeYear - wizExpenseYear;
                            var netClass = netYear >= 0 ? "text-success" : "text-danger";
                            <tfoot>
                                <tr>
                                    <th>@L["Net"]</th>
                                    @for (int m = 0; m < 12; m++)
                                    {
                                        var net = wizIncomeMonth(m) - wizExpenseMonth(m);
                                        var cls = net >= 0 ? "text-success" : "text-danger";
                                        <th class="text-end @cls">@Formatting.FormatMoneyDe(net)</th>
                                    }
                                    <th class="text-end @netClass">@Formatting.FormatMoneyDe(netYear)</th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary" @onclick="SaveBudget">@L["Button_SaveBudget"]</button>
                    <button class="btn btn-secondary" @onclick="() => step = 1">@L["Button_Back"]</button>
                </div>
            }
        </div>
    </div>
}
else if (step == 3)
{
    <div class="alert alert-success">
        <h4>@L["Success_Heading"]</h4>
        <p>@L["Success_Body", selectedYear]</p>
        <a href="@($"/projects/{selectedProjectId}/budgets")" class="btn btn-primary">@L["Button_ViewBudgets"]</a>
        <a href="@($"/projects/{selectedProjectId}/budgets/new")" class="btn btn-secondary" @onclick="Reset">@L["Button_CreateAnother"]</a>
    </div>
}

</ProjectShell>

@code {
    private List<Project>? projects;
    [Parameter] public int ProjectId { get; set; }

    private int selectedProjectId;
    private int selectedYear;
    private string budgetName = "";
    private string notes = "";
    private int step = 1;
    private bool isGenerating = false;
    private bool notFound = false;

    private Dictionary<(long Id, CategoryItemType ItemType), decimal[]>? predictions;
    private Dictionary<(long Id, CategoryItemType ItemType), string>? categoryNames;
    private HashSet<(long Id, CategoryItemType ItemType)> incomeKeys = new();
    private Dictionary<(long Id, CategoryItemType ItemType), OpenBudget.Assist.BudgetSuggestionRow> suggestionRows = new();
    private string? suggestionError;

    // Source of step-2 numbers: "predict" (the budget suggestion from history) or "clone"
    // (copy an existing budget's monthly amounts so the user only tweaks deltas).
    private string sourceMode = "predict";
    private int sourceBudgetId = 0;
    private List<Budget>? availableSourceBudgets;

    protected override async Task OnInitializedAsync()
    {
        // Project-scoped via the {ProjectId} route segment; the :int constraint rejects
        // non-numeric ids at routing, so an unknown project is the only failure left (404).
        // No free-floating project picker — the wizard is always entered for a known project.
        selectedProjectId = ProjectId;
        selectedYear = Clock.NowLocal.Year;

        projects = await ProjectService.GetProjectsAsync();
        if (!projects.Any(p => p.Id == ProjectId))
        {
            notFound = true;
            return;
        }

        availableSourceBudgets = await BudgetEntryService.GetBudgetsForProjectAsync(selectedProjectId);
    }

    // The wizard holds unsaved selections/predictions, so banner rather than auto-reload.
    protected override bool AutoReloadOnChange => false;
    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportedData or DataArea.ImportState
        || change.ProjectId is null || change.ProjectId == ProjectId;
    protected override Task ReloadAfterChangeAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task GeneratePredictions()
    {
        step = 2;
        isGenerating = true;
        StateHasChanged();

        await Task.Delay(100); // Allow UI to update

        var ownerIdForPredict = await ProjectService.GetOwnerIdForProjectAsync(selectedProjectId) ?? string.Empty;
        incomeKeys = await BudgetService.GetIncomeItemsForProjectAsync(selectedProjectId);

        // Load the hierarchy once so we can look up parent names without per-item DB calls.
        var allCategoryItems = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(ownerIdForPredict);
        var groupById = allCategoryItems
            .Where(c => c.ItemType == CategoryItemType.Group)
            .ToDictionary(c => c.Id, c => c.CategoryGroup);
        var categoryById = (await CategoryHierarchyService.GetAllCategoriesAsync(ownerIdForPredict))
            .ToDictionary(c => c.Id, c => c);

        predictions = new Dictionary<(long Id, CategoryItemType ItemType), decimal[]>();
        suggestionRows = new();
        suggestionError = null;
        var suggestKeys = new List<(long Id, CategoryItemType ItemType)>();

        if (sourceMode == "clone" && sourceBudgetId > 0)
        {
            // Copy the source budget's per-month amounts verbatim. Keys that aren't in the
            // project's current tracking still appear — the user can edit / drop them in
            // BudgetEdit afterwards. Save flow handles whatever's in `predictions`.
            var src = await BudgetEntryService.GetMonthlyBudgetAmountsAsync(sourceBudgetId);
            foreach (var (key, months) in src)
                predictions[key] = months.Select(p => Math.Round(p, 2)).ToArray();
        }
        else
        {
            // Suggest from history per tracking item; filled in once the names are known.
            var trackingItems = await ProjectService.GetProjectTrackingItemsAsync(selectedProjectId);
            foreach (var item in trackingItems)
            {
                if (item.CategoryGroupId is { } gid && groupById.ContainsKey(gid)) suggestKeys.Add((gid, CategoryItemType.Group));
                else if (item.CategoryId is { } cid && categoryById.ContainsKey(cid)) suggestKeys.Add((cid, CategoryItemType.Category));
            }
            foreach (var key in suggestKeys) predictions[key] = new decimal[12];
        }

        // Build display names from whatever ended up in predictions (handles both paths,
        // including cloned keys that may no longer be tracked). Prefix the parent group when
        // base names collide OR when the parent group itself is also a row — so coexisting
        // group + sub-cat rows read unambiguously (e.g. "Food" vs. "Food › Groceries").
        var labels = new List<((long Id, CategoryItemType ItemType) Key, string BaseName, string? ParentName, long? ParentGroupId)>();
        foreach (var key in predictions.Keys)
        {
            if (key.ItemType == CategoryItemType.Group)
            {
                if (!groupById.TryGetValue(key.Id, out var cg)) continue;
                var parentName = cg.ParentGroupId.HasValue
                    && groupById.TryGetValue(cg.ParentGroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                labels.Add((key, cg.Name ?? L["Category_Unknown"], parentName, cg.ParentGroupId));
            }
            else
            {
                if (!categoryById.TryGetValue(key.Id, out var cat)) continue;
                var parentName = cat.GroupId.HasValue
                    && groupById.TryGetValue(cat.GroupId.Value, out var parent)
                    ? parent.Name
                    : null;
                labels.Add((key, cat.Name ?? L["Category_Unknown"], parentName, cat.GroupId));
            }
        }

        var rowGroupIds = labels
            .Where(l => l.Key.ItemType == CategoryItemType.Group)
            .Select(l => l.Key.Id)
            .ToHashSet();
        var parentGroupByKey = labels.ToDictionary(l => l.Key, l => l.ParentGroupId);

        categoryNames = CategoryDisplay.Disambiguate(
            labels.Select(l => (l.Key, l.BaseName, l.ParentName)),
            key => parentGroupByKey.TryGetValue(key, out var pg)
                && pg.HasValue && rowGroupIds.Contains(pg.Value));

        if (suggestKeys.Count > 0)
        {
            var inputs = suggestKeys
                .Select(k => new OpenBudget.Assist.BudgetSuggestionInput(k, categoryNames.GetValueOrDefault(k, L["Category_Unknown"]), incomeKeys.Contains(k)))
                .ToList();
            var useAi = AssistSettings.Available && await AssistSettings.GetOptInAsync();
            var result = await BudgetSuggestions.SuggestAsync(selectedProjectId, selectedYear, inputs, useAi);
            suggestionError = result.AiError;
            foreach (var row in result.Rows)
            {
                predictions[row.Key] = row.Suggested.Select(p => Math.Round(p, 2)).ToArray();
                suggestionRows[row.Key] = row;
            }
        }

        isGenerating = false;
    }

    private async Task SaveBudget()
    {
        if (predictions == null)
            return;

        var budget = await BudgetEntryService.CreateBudgetAsync(selectedProjectId, selectedYear, budgetName, notes);
        var entries = predictions
            .Select(kvp => (kvp.Key.Id, kvp.Key.ItemType, kvp.Value))
            .ToList();
        await BudgetEntryService.SaveBudgetEntriesAsync(budget.Id, entries);

        step = 3;
    }

    private void Reset()
    {
        // "Create another" stays on the same project (its href preserves projectId), so leave
        // selectedProjectId intact — zeroing it dropped the wizard into a project-less state.
        step = 1;
        selectedYear = Clock.NowLocal.Year;
        budgetName = "";
        notes = "";
        predictions = null;
        categoryNames = null;
        suggestionRows = new();
        suggestionError = null;
        sourceMode = "predict";
        sourceBudgetId = 0;
    }
}
