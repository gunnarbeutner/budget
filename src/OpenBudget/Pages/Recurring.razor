@page "/projects/{ProjectId:int}/recurring"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

@* The subscriptions live in Scheduled's Subscriptions tab: this address forwards there, keeping ?show=. *@

@code {
    [Parameter] public int ProjectId { get; set; }

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var url = $"/projects/{ProjectId}/scheduled?tab=subscriptions";
        if (query.TryGetValue("show", out var show) && show.ToString() is { Length: > 0 } s) url += "&show=" + Uri.EscapeDataString(s);
        Navigation.NavigateTo(url, replace: true);
    }
}
