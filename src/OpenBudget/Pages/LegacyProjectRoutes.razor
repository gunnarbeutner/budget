@page "/projects/{ProjectId:int}/overview"
@inject NavigationManager Navigation

@* Old project URLs. The Overview page is gone (its numbers live in the summary strip on Transactions), so its
   links — bookmarks, "?year=&month=&period=" deep links — land on Transactions with the same period. *@

@code {
    [Parameter] public int ProjectId { get; set; }

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        Navigation.NavigateTo($"/projects/{ProjectId}/browse{query}", replace: true);
    }
}
