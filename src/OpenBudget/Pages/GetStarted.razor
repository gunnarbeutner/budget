@page "/get-started"
@inherits DataChangeAwareComponent
@using OpenBudget.Importers.MoneyMoney
@using OpenBudget.Models
@using OpenBudget.Services
@inject OnboardingService Onboarding
@inject AccountSwitchService Switcher
@inject MoneyMoneyBrowserImport BrowserImport
@inject IJSRuntime JS
@inject ClockService Clock
@inject IStringLocalizer<GetStarted> L
@inject NavigationManager Navigation
@inject GetStartedGate Gate

@* The way into OpenBudget, a wizard of four steps shown one at a time (?step=1…4, the first without it):
   (1) optionally the history from MoneyMoney, (2) bank logins, whose accounts link to the imported ones they match
   (the suggestion is preselected; switching keeps the imported history), (3) optionally Portfolio Performance,
   whose portfolios take over matching imported accounts, (4) the project's accounts and the imported budget.
   MoneyMoney is uploaded as a ZIP of its data folder and imported in the background (MoneyMoneyBrowserImport);
   while that import is unfinished, step 1 also
   switches its accounts to their bank connections (or keeps them as manual ones) and finishes the import. The gear
   menu offers this page, and signing in leads to it, until the MoneyMoney import is finished or the user ends it
   with Done (OnboardingState.ShowInMenu), and until then no other page opens (AccessRouteView). Each
   step brings what it needs inline: the bank logins (BankLoginsPanel), the MoneyMoney upload, the Portfolio
   Performance file (PortfolioPerformanceSource) and the project's accounts (ProjectAccountsPanel) with the
   imported budget. *@

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="get-started @(CurrentStep >= 3 ? "wide" : "")">
<h1 class="h4 mb-4">@L["Heading"]</h1>

@if (state == null)
{
    <div class="skeleton skeleton-block" aria-busy="true"></div>
}
else
{
<ol class="get-started-stepper" data-testid="get-started-stepper">
    @for (var n = 1; n <= StepCount; n++)
    {
        var current = n == CurrentStep;
        var done = !current && StepDone(n);
        <li class="@(current ? "current" : done ? "done" : "")" aria-current="@(current ? "step" : null)" data-testid="get-started-stepper-@n">
            <a href="@StepUrl(n)">
                <span class="get-started-stepper-mark" aria-hidden="true">@if (done) { <i class="bi bi-check-lg"></i> } else { @n }</span>
                <span class="get-started-stepper-label">@L[$"Stepper_{n}"]</span>
            </a>
        </li>
    }
</ol>
<ol class="list-unstyled get-started-steps">
    @if (CurrentStep == 2)
    {
    <li class="card mb-3" data-testid="step-banks">
        <div class="card-body">
            @if (job is { Phase: MoneyMoneyImportPhase.Done } done)
            {
                <div class="alert alert-success alert-dismissible py-2" data-testid="mm-job-done">
                    @L["Job_Done", done.Result?.AccountsImported ?? 0, done.Result?.TransactionsImported ?? 0, done.Statements?.Stored ?? 0]
                    @if (done.Budgets is { Imported: > 0 } budgets)
                    {
                        <span data-testid="mm-job-budgets"> @L["Job_Budgets", budgets.Imported]</span>
                    }
                    @if (done.Budgets is { SkippedTotal: > 0 } skipped)
                    {
                        <span data-testid="mm-job-budgets-skipped"> @L["Job_BudgetsSkipped", skipped.SkippedTotal]</span>
                    }
                    <button type="button" class="btn-close" aria-label="@L["Job_Ok"]" data-testid="mm-job-dismiss" @onclick="Dismiss"></button>
                </div>
            }
            <h2 class="h5 card-title">@L["Step1_Heading"]</h2>
            <p class="mb-2">@L["Step1_Body"]</p>
            @if (state.BankLogins > 0)
            {
                <p class="small text-body-secondary mb-2" data-testid="step-banks-count">@L[state.BankLogins == 1 ? "Step1_Count_One" : "Step1_Count", state.BankLogins]</p>
            }
            <div data-testid="step-banks-panel"><BankLoginsPanel ShowIntro="false" /></div>
        </div>
    </li>
    }

    @if (CurrentStep == 1)
    {
    <li class="mb-3" data-testid="step-moneymoney">
        <h2 class="h5 mb-3">@L["Start_Heading"]</h2>
        <div class="row g-3">
            @if (ShowImportCard)
            {
            <div class="col-12 @(ShowFreshCard ? "col-md-6" : "")">
            <div class="card h-100" data-testid="start-import">
                <div class="card-body">
                    <h3 class="h6 card-title">@L["Start_ImportHeading"]</h3>
                    <p class="small text-body-secondary mb-2">@L["Start_ImportBody"]</p>
                    @if (job is { Running: true } running)
                    {
                        <div data-testid="mm-job" role="status">
                            <div class="small mb-1">@PhaseText(running)</div>
                            <div class="progress" style="height: .5rem;"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @(PhasePercent(running))%"></div></div>
                        </div>
                    }
                    else if (state.Import is { MoneyMoneyImportFinishedAt: { } finishedAt } finishedState)
                    {
                        <p class="mb-0">
                            <span class="badge text-bg-secondary me-2" data-testid="import-finished">@L["Finished_Badge", Clock.ToLocal(finishedAt).ToString("yyyy-MM-dd")]</span>
                            <span class="small text-body-secondary me-2">@L["Finished_Hint"]</span>
                            <button class="btn btn-sm btn-outline-secondary" data-testid="import-resume" @onclick="() => SetFinishedAsync(finishedState.UserId, false)">@L["Finished_Resume"]</button>
                        </p>
                    }
                    else
                    {
                        @if (job is { Phase: MoneyMoneyImportPhase.Failed } failed)
                        {
                            <div class="alert alert-warning py-2" role="alert" data-testid="mm-job-error">@ErrorText(failed.Error)</div>
                        }
                        <ol class="small mb-2 ps-3" data-testid="mm-instructions">
                            <li>@L["Step2_How1"]</li>
                            <li>@L["Step2_How2"]</li>
                            <li>@L["Step2_How3"]</li>
                        </ol>
                        <div class="mb-2">
                            <label class="form-label small mb-1" for="mm-zip">@L["Upload_File"]</label>
                            <input type="file" id="mm-zip" class="form-control form-control-sm" accept=".zip,application/zip" @ref="fileInput"
                                   disabled="@uploading" @onchange="() => fileChosen = true" />
                        </div>
                        <div class="form-check small mb-2">
                            <input class="form-check-input" type="checkbox" id="mm-has-password" data-testid="mm-has-password" disabled="@uploading"
                                   checked="@hasPassword" @onchange="e => hasPassword = e.Value is true" />
                            <label class="form-check-label" for="mm-has-password">@L["Upload_HasPassword"]</label>
                        </div>
                        @if (hasPassword)
                        {
                            <div class="mb-2">
                                <label class="form-label small mb-1 visually-hidden" for="mm-password">@L["Upload_Password"]</label>
                                <input type="password" id="mm-password" class="form-control form-control-sm" autocomplete="off" disabled="@uploading"
                                       placeholder="@L["Upload_Password"]" @bind="password" @bind:event="oninput" />
                                <p class="small text-body-secondary mb-0 mt-1">@L["Upload_PasswordHint"]</p>
                            </div>
                        }
                        <button type="button" class="btn btn-primary" data-testid="mm-upload" disabled="@(uploading || !fileChosen)" @onclick="UploadAsync">@L["Upload_Button"]</button>
                        @if (uploading)
                        {
                            <div class="mt-2" data-testid="mm-upload-progress" role="status">
                                <div class="small mb-1">@L["Upload_Progress", FormatMb(uploaded), FormatMb(uploadSize)]</div>
                                <div class="progress" style="height: .5rem;"><div class="progress-bar" style="width: @(uploadSize > 0 ? uploaded * 100 / uploadSize : 0)%"></div></div>
                            </div>
                        }
                        @if (uploadError != null)
                        {
                            <div class="alert alert-warning py-2 mt-2 mb-0" role="alert" data-testid="mm-upload-error">@uploadError</div>
                        }
                    }
                </div>
            </div>
            </div>
            }
            @if (ShowFreshCard)
            {
            <div class="col-12 @(ShowImportCard ? "col-md-6" : "")">
            <div class="card h-100" data-testid="start-fresh">
                <div class="card-body">
                    <h3 class="h6 card-title">@L["Start_FreshHeading"]</h3>
                    <p class="small text-body-secondary mb-2">@L["Start_FreshBody"]</p>
                    <details class="small mb-3" data-testid="start-fresh-included">
                        <summary>@L["Start_FreshIncluded"]</summary>
                        <ul class="list-unstyled mt-2 mb-0">
                            @foreach (var g in StarterTree)
                            {
                                <li><span class="fw-semibold">@L[g.Group]</span>@(g.Categories.Length > 0 ? " · " + string.Join(", ", g.Categories.Select(c => L[c].Value)) : "")</li>
                            }
                            <li><span class="fw-semibold">@L["Start_FreshAccount"]</span> · @L["Starter_Cash"]</li>
                        </ul>
                    </details>
                    @if (state.HasCategories)
                    {
                        <p class="mb-0 text-body-secondary" data-testid="starter-done">@L["Starter_Done"]</p>
                    }
                    else
                    {
                        <BusyButton Class="btn btn-outline-primary" TestId="starter-categories" OnClick="CreateStarterCategoriesAsync">@L["Starter_Button"]</BusyButton>
                    }
                </div>
            </div>
            </div>
            }
        </div>
    </li>
    }

    @if (CurrentStep == 3)
    {
    <li class="card mb-3" data-testid="step-portfolio">
        <div class="card-body">
            <h2 class="h5 card-title">@L["Step3_Heading"] <span class="badge text-bg-light border fw-normal">@L["Optional"]</span></h2>
            <p class="mb-2">@L["Step3_Body"]</p>
            <PortfolioPerformanceSource FromGetStarted="true" OnImported="LoadAsync" />
            @if (state.HasPortfolioData)
            {
                <div class="mt-3" data-testid="step-portfolio-accounts"><SourcePortfolioAccounts Embedded="true" /></div>
            }
        </div>
    </li>
    }

    @if (CurrentStep == 4)
    {
    <li class="card mb-3" data-testid="step-cashflow">
        <div class="card-body">
            <h2 class="h5 card-title">@L["Step4_Heading"]</h2>
            @if (state.ProjectId is { } pid)
            {
                <p class="mb-2">@L["Step4_Body"]</p>
                <div data-testid="step-cashflow-accounts"><ProjectAccountsPanel ProjectId="pid" ShowIntro="false" Compact="true" /></div>
                @if (state.MoneyMoneyImported)
                {
                    <h3 class="h6 mt-4">@L["Setup_Heading"]</h3>
                    <p class="small text-body-secondary mb-2">@L["Setup_Body"]</p>
                    <div data-testid="step-category-setup"><CategorySetupPanel ProjectId="pid" /></div>
                }
            }
            else
            {
                <p class="small text-body-secondary mb-0">@L["Step4_NoProject"]</p>
            }
        </div>
    </li>
    }
</ol>
<div class="d-flex flex-wrap gap-2 mb-3" data-testid="get-started-nav">
    @if (CurrentStep > 1)
    {
        <a class="btn btn-outline-secondary" href="@StepUrl(CurrentStep - 1)" data-testid="get-started-back">@L["Wizard_Back"]</a>
    }
    @if (CurrentStep < StepCount && ImportRunning)
    {
        <button type="button" class="btn btn-outline-secondary" disabled data-testid="get-started-next">@L["Wizard_Next"]</button>
    }
    else if (CurrentStep < StepCount && (CurrentStep != 1 || StepDone(1)))
    {
        <a class="btn @(StepDone(CurrentStep) ? "btn-primary" : "btn-outline-secondary")" href="@StepUrl(CurrentStep + 1)" data-testid="get-started-next">@L[StepDone(CurrentStep) ? "Wizard_Next" : "Wizard_Skip"]</a>
    }
    else if (CurrentStep == StepCount)
    {
        <BusyButton Class="btn btn-primary" TestId="get-started-done" OnClick="DoneAsync">@L["Wizard_Done"]</BusyButton>
    }
</div>
}

</div>

@code {
    private OnboardingState? state;
    private string? userId;
    private MoneyMoneyImportJob? job;

    private ElementReference fileInput;
    private bool fileChosen;
    private string password = "";
    private bool hasPassword;
    private bool lastUploadHadPassword;
    private bool uploading;
    private long uploaded;
    private long uploadSize;
    private string? uploadError;
    private DotNetObjectReference<GetStarted>? selfRef;

    protected override async Task OnInitializedAsync()
    {
        userId = (await Access.GetAsync()).UserId;
        BrowserImport.Changed += OnJobChanged;
        await LoadAsync();
    }

    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.ImportState or DataArea.ImportedData or DataArea.Projects or DataArea.BankSync;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        job = userId == null ? null : BrowserImport.GetJob(userId);
        state = await Onboarding.GetAsync();
    }

    private void OnJobChanged(string changedUser)
    {
        if (changedUser != userId) return;
        _ = InvokeAsync(async () =>
        {
            var previous = job;
            job = BrowserImport.GetJob(changedUser);
            if (job is { Running: false } && previous is { Running: true }) await LoadAsync();
            // A successful import moves on to the bank logins, which show its result.
            if (job is { Phase: MoneyMoneyImportPhase.Done } && previous is { Running: true } && CurrentStep == 1)
                Navigation.NavigateTo(StepUrl(2));
            StateHasChanged();
        });
    }

    private string PhaseText(MoneyMoneyImportJob j) => j.Phase switch
    {
        MoneyMoneyImportPhase.Extracting => L["Job_Extracting"],
        MoneyMoneyImportPhase.Decrypting => L["Job_Decrypting"],
        MoneyMoneyImportPhase.Importing => L["Job_Importing"],
        // Until the statement count is known (and when there are none) the import step stays on screen.
        _ when j.Total == 0 => L["Job_Importing"],
        _ => L["Job_Statements", j.Done, j.Total],
    };

    private static int PhasePercent(MoneyMoneyImportJob j) => j.Phase switch
    {
        MoneyMoneyImportPhase.Extracting => 10,
        MoneyMoneyImportPhase.Decrypting => 25,
        MoneyMoneyImportPhase.Importing => 45,
        _ => 60 + (j.Total > 0 ? 40 * j.Done / j.Total : 0),
    };

    private string ErrorText(MoneyMoneyImportError error) => error switch
    {
        MoneyMoneyImportError.WrongPassword => L[lastUploadHadPassword ? "Error_WrongPassword" : "Error_PasswordNeeded"],
        MoneyMoneyImportError.NoDatabase => L["Error_NoDatabase"],
        MoneyMoneyImportError.NotAZip => L["Error_NotAZip"],
        MoneyMoneyImportError.ImportFinished => L["Error_Finished"],
        _ => L["Error_Failed"],
    };

    private static string FormatMb(long bytes) => (bytes / 1024d / 1024d).ToString("N1", System.Globalization.CultureInfo.CurrentCulture);

    private async Task UploadAsync()
    {
        uploadError = null;
        if (state?.Import is { MoneyMoneyImportFinishedAt: not null })
        {
            uploadError = L["Error_Finished"];
            return;
        }
        uploading = true;
        uploaded = 0;
        selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("obMoneyMoneyUpload.start", fileInput, selfRef);
    }

    [JSInvokable]
    public string BeginUpload(long size)
    {
        if (userId == null) throw new InvalidOperationException("Not signed in.");
        uploadSize = size;
        return BrowserImport.BeginUpload(userId, size);
    }

    [JSInvokable]
    public Task UploadProgress(long received, long size) => InvokeAsync(() =>
    {
        uploaded = received;
        uploadSize = size;
        StateHasChanged();
    });

    [JSInvokable]
    public Task UploadDone(string uploadId) => InvokeAsync(() =>
    {
        uploading = false;
        var secret = hasPassword ? password : "";
        lastUploadHadPassword = hasPassword;
        password = "";
        if (userId == null || !BrowserImport.StartImport(userId, uploadId, secret))
            uploadError = L["Error_Failed"];
        job = userId == null ? null : BrowserImport.GetJob(userId);
        StateHasChanged();
    });

    [JSInvokable]
    public Task UploadFailed(string reason) => InvokeAsync(() =>
    {
        uploading = false;
        uploadError = reason == "size" ? L["Error_TooLarge"] : L["Error_Upload"];
        StateHasChanged();
    });

    private async Task Dismiss()
    {
        if (userId != null) BrowserImport.Dismiss(userId);
        await LoadAsync();
    }

    // Started fresh with only the cash account: the last step has nothing to decide, so the wizard ends after step 3.
    private bool NothingToDecide => state is { MoneyMoneyImported: false, HasCategories: true, HasAccounts: true, NonCashAccounts: 0 };

    private int StepCount => NothingToDecide ? 3 : 4;

    /// <summary>The step to show (?step=1…4).</summary>
    [SupplyParameterFromQuery(Name = "step")] public int? Step { get; set; }

    private int CurrentStep => Step is { } s && s >= 1 && s <= StepCount ? s : 1;

    private int? renderedStep;
    private bool scrollToTop;

    protected override void OnParametersSet()
    {
        // A new step starts at the top of the page, not at the previous step's scroll position.
        if (renderedStep != null && renderedStep != CurrentStep) scrollToTop = true;
        renderedStep = CurrentStep;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToTop) return;
        scrollToTop = false;
        await JS.InvokeVoidAsync("scrollTo", 0, 0);
    }

    private static string StepUrl(int step) => $"/get-started?step={step}";

    private bool ImportRunning => job is { Running: true } || uploading;

    // Step 1 offers both ways to start; once one is under way the other one goes.
    private bool ImportStarted => uploading || job != null || state is { MoneyMoneyImported: true };
    private bool ShowImportCard => ImportStarted || state is not { HasCategories: true };
    private bool ShowFreshCard => !ImportStarted;

    /// <summary>Whether a step has what it brings; the MoneyMoney step only once its import succeeded.</summary>
    private bool StepDone(int step) => state != null && step switch
    {
        1 => !ImportRunning && (state.MoneyMoneyImported || state.HasCategories),
        2 => state.BankLogins > 0,
        3 => state.HasPortfolioData,
        _ => false,
    };


    // The starter category tree: resource keys of each group, its categories (none = one of the group's name) and whether it is income.
    private static readonly (string Group, string[] Categories, bool Income)[] StarterTree =
    [
        ("Starter_Income", ["Starter_Income_Salary", "Starter_Income_Interest", "Starter_Income_Refunds", "Starter_Income_OtherIncome"], true),
        ("Starter_Housing", ["Starter_Housing_Rent", "Starter_Housing_Utilities", "Starter_Housing_Internet"], false),
        ("Starter_Groceries", ["Starter_Groceries_Supermarket", "Starter_Groceries_Restaurants"], false),
        ("Starter_Household", ["Starter_Household_Supplies", "Starter_Household_Furnishings"], false),
        ("Starter_Transport", ["Starter_Transport_Car", "Starter_Transport_PublicTransport", "Starter_Transport_TravelCosts"], false),
        ("Starter_Insurance", ["Starter_Insurance_Liability", "Starter_Insurance_Contents", "Starter_Insurance_OtherInsurance"], false),
        ("Starter_Subscriptions", [], false),
        ("Starter_Leisure", ["Starter_Leisure_Entertainment", "Starter_Leisure_Hobbies", "Starter_Leisure_Holidays"], false),
        ("Starter_Gifts", [], false),
        ("Starter_Health", [], false),
        ("Starter_Savings", [], false),
        ("Starter_Transfers", ["Starter_Transfers_OwnAccounts"], false),
    ];

    private async Task CreateStarterCategoriesAsync()
    {
        await Onboarding.CreateStarterCategoriesAsync(StarterTree
            .Select(g => new StarterGroup(L[g.Group], g.Categories.Select(c => L[c].Value).ToList(), g.Income, Tracked: g.Group != "Starter_Transfers"))
            .ToList(), L["Starter_Cash"]);
        await LoadAsync();
        Navigation.NavigateTo(StepUrl(2));
    }


    /// <summary>Ends Get started and opens the project.</summary>
    private async Task DoneAsync()
    {
        // Imported accounts not linked to a bank login become manual ones, and the one-time import is finished.
        if (userId != null && state is { MoneyMoneyImported: true })
        {
            var st = await Switcher.GetSourceStateAsync(userId);
            if (st.MoneyMoneyAccounts.Count > 0) await Switcher.KeepManualAsync(st.MoneyMoneyAccounts.Select(a => a.AccountId).ToList());
            await Switcher.SetImportFinishedAsync(userId, true);
        }
        await Onboarding.CompleteAsync();
        Gate.Invalidate();
        Navigation.NavigateTo(state?.ProjectId is { } pid ? $"/projects/{pid}/browse" : "/");
    }

    private async Task SetFinishedAsync(string ownerId, bool finished)
    {
        await Switcher.SetImportFinishedAsync(ownerId, finished);
        await LoadAsync();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            BrowserImport.Changed -= OnJobChanged;
            selfRef?.Dispose();
        }
        base.Dispose(disposing);
    }
}
