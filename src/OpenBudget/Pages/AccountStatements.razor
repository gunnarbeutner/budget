@page "/accounts/{AccountId:long}/statements"
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@inject BankLoginService Bank
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject IStringLocalizer<AccountStatements> L
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle"]</PageTitle>

@* Statements of one account. Whoever can see the account (its owner, or a viewer of a project it is assigned to)
   sees its documents; the lookups run through the user's scoped context, so anything else is "not found". *@

@if (loaded && accountName == null)
{
    <NotFoundMessage />
}
else
{
    <PageHeader Title="@(accountName == null ? "" : L["Heading", accountName].Value)" />
    @if (statements == null)
    {
        <div aria-busy="true"><div class="skeleton skeleton-line" style="width: 50%;"></div></div>
    }
    else if (statements.Count == 0)
    {
        <div class="alert alert-secondary" id="no-statements">@L["Empty"]</div>
    }
    else
    {
        <table class="table table-sm align-middle" id="statements-table">
            <thead><tr><th>@L["Table_Date"]</th><th>@L["Table_Name"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in statements)
                {
                    <tr @key="s.Id">
                        <td>@s.Date.ToString("yyyy-MM-dd")</td>
                        <td>@s.Name</td>
                        <td class="text-end">
                            <a href="@($"/statements/{s.Id}")" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">@L["Link_View"]</a>
                            <a href="@($"/statements/{s.Id}?download=true")" class="btn btn-sm btn-outline-secondary">@L["Link_Download"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public long AccountId { get; set; }

    private List<StatementView>? statements;
    private string? accountName;
    private bool loaded;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override bool IsRelevantChange(DataChange change) => change.Area is DataArea.BankSync or DataArea.ImportedData;

    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        accountName = await db.Accounts.AsNoTracking().Where(a => a.Id == AccountId).Select(a => a.Name ?? "?").FirstOrDefaultAsync();
        statements = accountName == null ? [] : await Bank.GetAccountStatementsAsync(AccountId);
        loaded = true;
    }
}
