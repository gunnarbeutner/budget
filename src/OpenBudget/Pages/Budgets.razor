@page "/projects/{ProjectId:int}/budgets"
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject BudgetEntryService BudgetEntryService
@inject BudgetPredictionService BudgetPredictionService
@inject CategoryHierarchyService CategoryHierarchyService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<Budgets> L

<PageTitle>@L["PageTitle"]@(projectName != null ? $" — {projectName}" : "")</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">@L["NotFound_BodyBefore"]<a href="/">@L["NotFound_DashboardLink"]</a>@L["NotFound_BodyAfter"]</p>
    return;
}

<ProjectPageHeader ProjectId="@selectedProjectId" ProjectName="@projectName"
                   Active="ProjectTab.Budgets" />

<DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

<PeriodNav Anchor="(selectedYear, 1)" Period="@("year")" YearOnly="true"
           Years="availableYears" OnChanged="OnYearChanged" />

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <label class="form-label">@L["Form_CompareWithBudgetLabel"]</label>
                        @{
                            var selectedBudget = availableBudgets?.FirstOrDefault(b => b.Id == selectedCompareBudgetId);
                        }
                        @* flex-wrap so the action buttons drop to a second row instead of
                           squeezing the budget selector to a sliver (or pushing the last
                           button out of the card). min-width keeps the select readable
                           even when it does fit on the same row as the buttons. *@
                        <div class="d-flex flex-wrap gap-2 align-items-stretch">
                            <select class="form-select flex-grow-1" style="min-width: 14rem;"
                                    value="@selectedCompareBudgetId" @onchange="OnCompareBudgetChanged">
                                <option value="0">@L["Form_NoBudgetComparisonOption"]</option>
                                @if (availableBudgets != null)
                                {
                                    foreach (var bud in availableBudgets)
                                    {
                                        <option value="@bud.Id">@bud.Year — @bud.Name@(bud.IsActive ? L["Form_ActiveSuffix"].Value : "")</option>
                                    }
                                }
                            </select>
                            <a class="btn btn-primary text-nowrap" href="@($"/projects/{selectedProjectId}/budgets/new")">@L["Button_NewBudget"]</a>
                            @if (selectedBudget != null)
                            {
                                <a class="btn btn-outline-primary text-nowrap" href="/budgets/@selectedBudget.Id/edit">@L["Button_Edit"]</a>
                                @if (!selectedBudget.IsActive)
                                {
                                    <button type="button" class="btn btn-outline-success text-nowrap"
                                            title="@L["Title_MakeActive", selectedBudget.Year]"
                                            @onclick="() => SetBudgetActive(selectedBudget.Id)">@L["Button_MakeActive"]</button>
                                }
                                <button type="button" class="btn btn-outline-danger text-nowrap"
                                        @onclick="() => ShowDeleteBudgetDialog(selectedBudget)">@L["Button_Delete"]</button>
                            }
                        </div>
                        @if (selectedBudget != null && selectedBudget.Year != selectedYear)
                        {
                            <div class="small text-body-secondary mt-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i>
                                @L["Compare_YearMismatch", selectedBudget.Year, selectedYear]
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">@L["Card_CategoryTrendsTitle"]</h5>
            </div>
            <div class="card-body">
                @if (categoryTrends == null)
                {
                    <div class="skeleton" style="height: 600px;" aria-busy="true" aria-label="@L["Status_LoadingTrends"]"></div>
                }
                else if (!categoryTrends.Any())
                {
                    <p class="text-body-secondary">@L["Status_NoTrendData"]</p>
                }
                else
                {
                    <div style="position: relative; height: 600px; max-height: 900px;">
                        <canvas id="trendStackedBarChart"></canvas>
                    </div>

                    @if (selectedCompareBudgetId > 0 && varianceSummary != null && varianceSummary.Any())
                    {
                        <div class="mt-4">
                            <h6>@L["Heading_BudgetVsActualVariance"]</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Table_HeaderCategory"]</th>
                                            <th class="text-end">@L["Table_HeaderBudget"]</th>
                                            <th class="text-end">@L["Table_HeaderActual"]</th>
                                            <th class="text-end">@L["Table_HeaderVariance"]</th>
                                            <th class="text-end">@L["Table_HeaderPercentOfBudget"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var varianceTreeNodes = TrackedRowTree.Build(
                                                varianceSummary.Select(v => (v.CategoryId, v.ItemType)),
                                                allAvailableCategories ?? new List<CategoryGroupWithChildCount>(),
                                                k => varianceSummary.FirstOrDefault(v => v.CategoryId == k.Id && v.ItemType == k.ItemType)?.CategoryName ?? "");
                                            var varianceByKey = varianceSummary.ToDictionary(v => (v.CategoryId, v.ItemType));
                                        }
                                        @foreach (var node in varianceTreeNodes)
                                        {
                                            if (!varianceByKey.TryGetValue(node.Key, out var item)) continue;
                                            var percentOfBudget = item.HasBudget && item.BudgetAmount > 0
                                                ? (item.ActualAmount / item.BudgetAmount * 100) : 0;
                                            // Caret only when manual expand actually adds something — i.e. the group
                                            // has shadow sub-cats and isn't already showing budgeted descendants.
                                            var canExpand = item.ItemType == CategoryItemType.Group
                                                && HasManualExpand((item.CategoryId, item.ItemType));
                                            var isExpanded = expandedVarianceKeys.Contains(node.Key);
                                            // Auto-summed groups (computed from sub-cats) render muted+italic and prefix
                                            // numbers with Σ so the value reads as a roll-up rather than a user input.
                                            // Expansion adds nothing to the parent's styling — it just toggles whether
                                            // the sub-cat rows below are visible.
                                            var rowClass = item.IsAutoSummed ? "text-body-secondary fst-italic"
                                                : !item.HasBudget ? ""
                                                : percentOfBudget > 110 ? "table-danger"
                                                : percentOfBudget > 90 ? "table-warning"
                                                : "table-success";
                                            var sumPrefix = item.IsAutoSummed ? "Σ " : "";
                                            // Tree indent already disambiguates sub-cat vs. parent — drop the "Parent › Name"
                                            // prefix that BuildDisplayNames adds for the flat chart legend.
                                            var bareName = BareCategoryName(node.Key) ?? item.CategoryName;
                                            <tr @key="node.Key" class="@rowClass">
                                                <td style="@(FormattableString.Invariant($"padding-left: {0.5 + node.Level * 1.25}rem; white-space: nowrap;"))">
                                                    @if (canExpand)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link p-0 me-1"
                                                                style="text-decoration: none;"
                                                                @onclick="() => ToggleVarianceExpand(node.Key)"
                                                                title="@(isExpanded ? L["Button_Collapse"] : L["Button_Expand"])">
                                                            @(isExpanded ? "▾" : "▸")
                                                        </button>
                                                    }
                                                    @bareName
                                                </td>
                                                <td class="text-end">@(item.HasBudget ? $"{sumPrefix}€{item.BudgetAmount:N2}" : "—")</td>
                                                <td class="text-end">€@item.ActualAmount.ToString("N2")</td>
                                                <td class="text-end">@(item.HasBudget ? $"{sumPrefix}€{item.Variance:N2}" : "—")</td>
                                                <td class="text-end">@(item.HasBudget ? $"{percentOfBudget:N1}%" : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        @{
                                            var aggregateRows = varianceSummary.Where(v => v.IsAggregateRow).ToList();
                                            var totalBudget = aggregateRows.Sum(v => v.BudgetAmount);
                                            var totalActual = aggregateRows.Sum(v => v.ActualAmount);
                                            var totalVariance = aggregateRows.Sum(v => v.Variance);
                                            var totalPercent = totalBudget > 0 ? (totalActual / totalBudget * 100) : 0;
                                        }
                                        <tr class="table-primary">
                                            <th>@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">€@totalBudget.ToString("N2")</th>
                                            <th class="text-end">€@totalActual.ToString("N2")</th>
                                            <th class="text-end">€@totalVariance.ToString("N2")</th>
                                            <th class="text-end">@totalPercent.ToString("N1")%</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* No budget selected — show a plain summary so users always get a tabular
                           breakdown to scan alongside the chart. *@
                        <div class="mt-4">
                            <h6>@L["Heading_Summary"]</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Table_HeaderCategory"]</th>
                                            <th class="text-end">@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">@L["Table_HeaderAvgPerMonth"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (name, trend) in categoryTrends.OrderBy(kvp => categorySortKeys.GetValueOrDefault(kvp.Key, kvp.Key)).ThenBy(kvp => kvp.Key))
                                        {
                                            var total = trend.Sum(m => m.Amount);
                                            var avg = trend.Count > 0 ? total / trend.Count : 0m;
                                            <tr @key="name">
                                                <td>@name</td>
                                                <td class="text-end">€@total.ToString("N2")</td>
                                                <td class="text-end">€@avg.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        @{
                                            var aggregateTrendValues = categoryTrends
                                                .Where(kvp => aggregateRowNames.Contains(kvp.Key))
                                                .Select(kvp => kvp.Value)
                                                .ToList();
                                            var grandTotal = aggregateTrendValues.Sum(t => t.Sum(m => m.Amount));
                                            var grandMonths = aggregateTrendValues.Select(t => t.Count).DefaultIfEmpty(0).Max();
                                            var grandAvg = grandMonths > 0 ? grandTotal / grandMonths : 0m;
                                        }
                                        <tr class="table-primary">
                                            <th>@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">€@grandTotal.ToString("N2")</th>
                                            <th class="text-end">€@grandAvg.ToString("N2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleCategoriesPanel" style="cursor: pointer;">
                <h5 class="mb-0">@L["Card_CategoriesTitle"]</h5>
                <i class="bi @(categoriesExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
            </div>
            @if (categoriesExpanded)
            {
                <div class="card-body">
                    <div class="tracking-tree-scroll">
                        @if (allAvailableCategories != null && allActualCategories != null)
                        {
                            var filteredGroupIds = allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group)
                                .Select(c => c.Id)
                                .ToHashSet();
                            @foreach (var rootCat in allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group
                                    && !filteredGroupIds.Contains(c.ParentCategoryGroupId ?? -1))
                                .OrderBy(c => c.CategoryGroup.Name))
                            {
                                <CategoryTree
                                    @key="rootCat.CategoryGroup.Id"
                                    CategoryGroup="@rootCat"
                                    Level="0"
                                    RenderMode="CategoryTreeRenderMode.Checkbox"
                                    ParentSelected="false"
                                    SelectedCategoryGroupIds="@selectedCategoryGroupIds"
                                    SelectedCategoryIds="@selectedActualCategoryIds"
                                    OnCategoryGroupToggle="@HandleCategoryGroupToggle"
                                    OnCategoryToggle="@HandleCategoryToggle"
                                    AllCategories="@allAvailableCategories"
                                    ActualCategories="@allActualCategories" />
                            }
                        }
                    </div>
                    <small class="form-text text-body-secondary mt-2 d-block">
                        <strong>@L["HowToUse_Heading"]</strong><br/>
                        • @L["HowToUse_Item1"]<br/>
                        • @L["HowToUse_Item2"]<br/>
                        • @L["HowToUse_Item3"]
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<Modal Show="@(budgetPendingDelete != null)" Title="@L["Modal_DeleteBudget_Title"]" OnClose="@HideDeleteBudgetDialog">
    <ChildContent>
        @if (budgetPendingDelete != null)
        {
            <p>@L["Modal_DeleteBudget_Body", budgetPendingDelete.Year, string.IsNullOrEmpty(budgetPendingDelete.Notes) ? "" : L["Modal_DeleteBudget_Notes", budgetPendingDelete.Notes].Value]</p>
            <p class="text-body-secondary small mb-0">@L["Modal_DeleteBudget_Warning"]</p>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="HideDeleteBudgetDialog">@L["Button_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteBudget">@L["Button_Delete"]</button>
    </Footer>
</Modal>

@code {
    private List<CategoryGroupWithChildCount>? allCategories;
    private List<CategoryGroupWithChildCount>? filteredCategories;
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private HashSet<long> selectedCategoryGroupIds = new();
    private HashSet<long> selectedActualCategoryIds = new();
    private HashSet<(long Id, CategoryItemType ItemType)> incomeItems = new();
    private List<Category>? allActualCategories;
    private Dictionary<string, List<MonthlySpending>>? categoryTrends;
    private Dictionary<string, string> categorySortKeys = new();
    private HashSet<string> aggregateRowNames = new();
    /// <summary>Display names hidden from the chart — expanded tracked groups, whose sub-cat
    /// rows take their place in the chart. The variance table still shows the group row (with
    /// a ▾ caret) as a parent for the nested sub-cats.</summary>
    private HashSet<string> chartHiddenNames = new();
    private Dictionary<string, List<MonthlySpending>>? budgetTrends;
    /// <summary>(Id, ItemType) → unique display name. Bare category name when no collision,
    /// "Parent group > Name" when two or more selected items share the same bare name.
    /// Populated by LoadCategoryTrends; the other dictionaries are keyed by the resulting
    /// display name so collisions can't silently overwrite entries.</summary>
    private Dictionary<(long Id, CategoryItemType ItemType), string> categoryDisplayNames = new();
    private List<VarianceSummary>? varianceSummary;
    private List<Budget>? availableBudgets;
    /// <summary>Budget the user has clicked Delete on, awaiting confirmation in the modal.</summary>
    [Parameter] public int ProjectId { get; set; }

    private Budget? budgetPendingDelete;
    private int selectedProjectId = 0;
    private int selectedCompareBudgetId = 0;
    private int selectedYear = DateTime.UtcNow.Year;
    private List<int>? availableYears;
    private bool categoriesExpanded = false;
    private string? projectName;
    private int projectSourceId = SourceScope.LegacySourceId;
    private bool notFound = false;

    // Variance tree: groups the user has expanded. When a group is expanded, the variance
    // table replaces its row with its in-use sub-cats (sub-cats that have transactions in the
    // trailing 12 months — same set BudgetEdit uses for shadow rows). The chart follows suit:
    // expanded groups vanish, their sub-cats appear in their place. Persisted per (project,
    // year) in localStorage so the layout survives a reload.
    private HashSet<(long Id, CategoryItemType ItemType)> expandedVarianceKeys = new();
    // Per tracked group: the in-use leaf sub-cats we'd show if the group were expanded.
    // Computed on load + when the underlying tracking changes.
    private Dictionary<(long Id, CategoryItemType ItemType), List<(long Id, CategoryItemType ItemType)>>
        shadowSubcatsByGroup = new();
    // Per tracked group: descendants that hold a non-zero MonthlyBudgetEntry in the selected
    // compare-budget. Always included in the chart + variance table (replacing the group in
    // the chart, nested under it in the variance table) — that's "show the budget where it
    // actually lives" without requiring a manual expand step.
    private Dictionary<(long Id, CategoryItemType ItemType), List<(long Id, CategoryItemType ItemType)>>
        budgetedDescendantsByGroup = new();
    // Auto-default = "expand every group whose descendants carry the budget" — applied once
    // per session unless localStorage holds a user-set override. Reset on year/budget change
    // so a fresh budget gets the same friendly default before the user touches anything.
    private bool sessionAutoDefaultApplied = false;
    private string ExpandScope => $"budgets-variance:{selectedProjectId}:{selectedYear}";

    private void ToggleCategoriesPanel() => categoriesExpanded = !categoriesExpanded;

    private string? BareCategoryName((long Id, CategoryItemType ItemType) key)
    {
        if (key.ItemType == CategoryItemType.Category)
            return allActualCategories?.FirstOrDefault(c => c.Id == key.Id)?.Name;
        return allAvailableCategories?.FirstOrDefault(c =>
            c.ItemType == CategoryItemType.Group && c.Id == key.Id)?.CategoryGroup.Name;
    }

    private async Task ToggleVarianceExpand((long Id, CategoryItemType ItemType) key)
    {
        if (!expandedVarianceKeys.Add(key)) expandedVarianceKeys.Remove(key);
        try
        {
            await JS.InvokeVoidAsync("expandState.set", ExpandScope,
                expandedVarianceKeys.Select(k => $"{(int)k.ItemType}:{k.Id}").ToArray());
        }
        catch { /* localStorage unavailable */ }
        await LoadCategoryTrends();
        needsTrendChartRender = true;
    }

    // The compare/trend UI holds transient selection state, so banner rather than auto-reload.
    protected override bool AutoReloadOnChange => false;
    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.MoneyMoneyData or DataArea.Sources => change.SourceId == projectSourceId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override Task ReloadAfterChangeAsync()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    public override void Dispose()
    {
        // Best-effort: free the Chart.js instance JS-side so navigating away doesn't leave it
        // in window.chartInstances until the canvas id is reused. Fire-and-forget because Dispose
        // is synchronous; swallow the cases where JS is unreachable (circuit already gone, or
        // server-side prerender disposal).
        _ = DestroyChartAsync();
        base.Dispose();
    }

    private async Task DestroyChartAsync()
    {
        try { await JS.InvokeVoidAsync("destroyChart", "trendStackedBarChart"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        // Project-scoped via the {ProjectId} route segment; the :int constraint already rejects
        // non-numeric ids at routing, so the only failure left is an unknown project (404).
        selectedProjectId = ProjectId;

        var project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null)
        {
            notFound = true;
            return;
        }

        projectName = project.Name;
        projectSourceId = project.SourceId;

        // Load all category groups (including sub-categories), not just root ones
        var allCategoryGroups = await CategoryHierarchyService.GetAllCategoriesWithChildCountsAsync(projectSourceId);

        // Filter out the hidden root category (per-source rowid 1) and organize hierarchically
        var sentinelRoot = SourceScope.SentinelRoot(projectSourceId);
        allCategories = allCategoryGroups
            .Where(c => c.CategoryGroup.Id != sentinelRoot)
            .OrderBy(c => c.CategoryGroup.Name)
            .ToList();

        // Load all actual categories
        allActualCategories = await CategoryHierarchyService.GetAllCategoriesAsync(projectSourceId);

        // Populate the year picker from the years the project's tracked categories actually
        // have transactions in. Default to the current year, or the closest available if the
        // current year isn't in the dataset. Falls back to a single-entry list with the
        // current year so the dropdown isn't empty when a project has no transactions yet.
        availableYears = await BudgetService.GetYearsWithTransactionsForProjectAsync(selectedProjectId);
        if (!availableYears.Any())
            availableYears = new List<int> { DateTime.UtcNow.Year };
        if (!availableYears.Contains(selectedYear))
            selectedYear = availableYears.First();

        await LoadProjectContext();
        await LoadCategoryTrends();
    }

    private async Task LoadProjectContext()
    {
        if (selectedProjectId <= 0 || allCategories == null) return;

        incomeItems = await BudgetService.GetIncomeItemsForProjectAsync(selectedProjectId);
        availableBudgets = await BudgetEntryService.GetBudgetsForProjectAsync(selectedProjectId);

        // Default the budget-comparison dropdown to the project's active budget for the
        // currently-selected year, unless the user already picked a budget that still applies.
        var currentMatch = availableBudgets.FirstOrDefault(b => b.Id == selectedCompareBudgetId);
        if (currentMatch == null || currentMatch.Year != selectedYear)
        {
            selectedCompareBudgetId = availableBudgets
                .FirstOrDefault(b => b.Year == selectedYear && b.IsActive)?.Id ?? 0;
        }

        await FilterCategoriesByBudget();
        allAvailableCategories = filteredCategories;

        var trackingItems = await ProjectService.GetProjectTrackingItemsAsync(selectedProjectId);

        selectedCategoryGroupIds.Clear();
        selectedActualCategoryIds.Clear();

        foreach (var item in trackingItems)
        {
            if (item.CategoryGroupId.HasValue)
            {
                if (incomeItems.Contains((item.CategoryGroupId.Value, CategoryItemType.Group)))
                    continue;
                selectedCategoryGroupIds.Add(item.CategoryGroupId.Value);
            }
            else if (item.CategoryId.HasValue)
            {
                if (incomeItems.Contains((item.CategoryId.Value, CategoryItemType.Category)))
                    continue;
                selectedActualCategoryIds.Add(item.CategoryId.Value);
            }
        }

        // For each tracked expense group, fetch the leaf sub-cats that have transactions in
        // the trailing 12 months. These are the rows the variance table will reveal when the
        // group is expanded (and they'll show up in the chart in place of the group). Tracked
        // leaves are excluded since they already have their own row.
        shadowSubcatsByGroup.Clear();
        var trackedLeafIds = trackingItems
            .Where(ti => ti.CategoryId.HasValue)
            .Select(ti => ti.CategoryId!.Value)
            .ToHashSet();
        var groupIds = selectedCategoryGroupIds.ToList();
        if (groupIds.Count > 0)
        {
            var allRecentLeaves = await BudgetService.GetLeafCategoriesWithRecentTransactionsAsync(
                groupIds, projectSourceId);
            foreach (var groupId in groupIds)
            {
                var descendants = CategoryGroupWithChildCount.CollectDescendants(
                    groupId, allCategories, includeLeafCategories: true);
                var subKeys = descendants
                    .Where(d => d.ItemType == CategoryItemType.Category
                        && allRecentLeaves.Contains(d.Id)
                        && !trackedLeafIds.Contains(d.Id)
                        && !incomeItems.Contains((d.Id, CategoryItemType.Category)))
                    .Select(d => (d.Id, d.ItemType))
                    .ToList();
                if (subKeys.Count > 0)
                    shadowSubcatsByGroup[(groupId, CategoryItemType.Group)] = subKeys;
            }
        }
    }

    private bool HasManualExpand((long Id, CategoryItemType ItemType) key)
    {
        // Caret shows on any tracked group that has SOMETHING to drill into — either budgeted
        // descendants or shadow transactions. User can toggle either way.
        return budgetedDescendantsByGroup.ContainsKey(key) || shadowSubcatsByGroup.ContainsKey(key);
    }

    private async Task FilterCategoriesByBudget()
    {
        var budget = await ProjectService.GetProjectAsync(selectedProjectId);
        if (budget == null || allCategories == null)
        {
            filteredCategories = new List<CategoryGroupWithChildCount>();
            return;
        }

        // Get all category items that are in the budget (including descendants)
        // Use HashSet of actual items to avoid ID collision
        var budgetCategoryItems = new HashSet<CategoryGroupWithChildCount>();

        foreach (var assignment in budget.CategoryAssignments)
        {
            // Find the assigned category group - filter by ItemType to avoid ID collision
            var assignedGroup = allCategories.FirstOrDefault(c => c.ItemType == CategoryItemType.Group && c.Id == assignment.CategoryId);
            if (assignedGroup != null)
            {
                budgetCategoryItems.Add(assignedGroup);

                // Add all descendants using shared helper
                var descendants = CategoryGroupWithChildCount.CollectDescendants(assignment.CategoryId, allCategories);
                foreach (var descendant in descendants)
                {
                    budgetCategoryItems.Add(descendant);
                }
            }
        }

        // Exclude items resolved as income for this project
        filteredCategories = budgetCategoryItems
            .Where(item => !incomeItems.Contains((item.Id, item.ItemType)))
            .ToList();
    }

    private async Task HandleCategoryGroupToggle((long Id, bool IsChecked) args)
    {
        if (allAvailableCategories != null)
        {
            CategorySelection.ApplyGroupToggle(
                args.Id, args.IsChecked,
                selectedCategoryGroupIds, selectedActualCategoryIds,
                allAvailableCategories);
        }
        await LoadCategoryTrends();
    }

    private async Task HandleCategoryToggle((long Id, bool IsChecked) args)
    {
        if (args.IsChecked)
        {
            selectedActualCategoryIds.Add(args.Id);
        }
        else
        {
            selectedActualCategoryIds.Remove(args.Id);
        }

        // Refresh the chart
        await LoadCategoryTrends();
    }


    private bool needsTrendChartRender = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && selectedCompareBudgetId > 0)
        {
            try
            {
                var hasPreference = await JS.InvokeAsync<bool>("expandState.hasPreference", ExpandScope);
                if (hasPreference)
                {
                    var stored = await JS.InvokeAsync<string[]>("expandState.get", ExpandScope);
                    expandedVarianceKeys.Clear();
                    foreach (var s in stored)
                    {
                        var parts = s.Split(':');
                        if (parts.Length == 2
                            && int.TryParse(parts[0], out var typeInt)
                            && long.TryParse(parts[1], out var id))
                        {
                            expandedVarianceKeys.Add((id, (CategoryItemType)typeInt));
                        }
                    }
                    await LoadCategoryTrends();
                    needsTrendChartRender = true;
                    StateHasChanged();
                }
            }
            catch { /* localStorage unavailable — keep server-side auto-defaults */ }
        }

        if (needsTrendChartRender && categoryTrends != null && categoryTrends.Any())
        {
            needsTrendChartRender = false;
            await RenderStackedBarChart();
        }
    }

    private async Task OnYearChanged((int Year, int Month, string Period) sel)
    {
        if (sel.Year == selectedYear) return;
        selectedYear = sel.Year;
        // Re-pick the active budget for the new year unless the user already picked one
        // that matches it.
        if (availableBudgets != null)
        {
            var currentMatch = availableBudgets.FirstOrDefault(b => b.Id == selectedCompareBudgetId);
            if (currentMatch == null || currentMatch.Year != selectedYear)
            {
                selectedCompareBudgetId = availableBudgets
                    .FirstOrDefault(b => b.Year == selectedYear && b.IsActive)?.Id ?? 0;
            }
        }
        // New scope = fresh auto-default; user toggles are scoped to (budget, year).
        expandedVarianceKeys.Clear();
        sessionAutoDefaultApplied = false;
        await LoadCategoryTrends();
    }

    private async Task OnCompareBudgetChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var budgetId))
        {
            selectedCompareBudgetId = budgetId;
            expandedVarianceKeys.Clear();
            sessionAutoDefaultApplied = false;
            await LoadCategoryTrends();
        }
    }

    private async Task RefreshBudgets()
    {
        availableBudgets = await BudgetEntryService.GetBudgetsForProjectAsync(selectedProjectId);
    }

    private async Task SetBudgetActive(int budgetId)
    {
        await BudgetEntryService.SetActiveBudgetAsync(budgetId);
        await RefreshBudgets();
        // The currently-selected budget's Active flag may have flipped — re-render so the
        // dropdown shows the updated "(active)" suffix and the inline "Make Active" button
        // hides for the now-active row.
        await LoadCategoryTrends();
    }

    private void ShowDeleteBudgetDialog(Budget b)
    {
        budgetPendingDelete = b;
    }

    private void HideDeleteBudgetDialog()
    {
        budgetPendingDelete = null;
    }

    private async Task ConfirmDeleteBudget()
    {
        if (budgetPendingDelete == null) return;
        var id = budgetPendingDelete.Id;
        budgetPendingDelete = null;
        await BudgetEntryService.DeleteBudgetAsync(id);
        await RefreshBudgets();
        // If the deleted budget was the comparison target, fall back to "No comparison" so the
        // chart doesn't try to render against a budget that no longer exists.
        if (selectedCompareBudgetId == id)
        {
            selectedCompareBudgetId = 0;
        }
        await LoadCategoryTrends();
    }

    /// <summary>
    /// Resolves a unique display name for every selected (Id, ItemType). Bare category name is
    /// used unless two or more selections share it, in which case both are qualified as
    /// "Parent group › Name" so they're distinguishable in the chart, variance table, and
    /// summary. See <see cref="CategoryDisplay.Disambiguate" /> for the shared rule.
    /// </summary>
    private Dictionary<(long Id, CategoryItemType ItemType), string> BuildDisplayNames(
        IEnumerable<(long Id, CategoryItemType ItemType)> keys)
    {
        var items = keys.Select(key =>
        {
            string name;
            if (key.ItemType == CategoryItemType.Group)
            {
                var group = allAvailableCategories?.FirstOrDefault(c =>
                    c.ItemType == CategoryItemType.Group && c.Id == key.Id);
                name = group?.CategoryGroup.Name ?? L["Unknown"];
            }
            else
            {
                var category = allActualCategories?.FirstOrDefault(c => c.Id == key.Id);
                name = category?.Name ?? L["Unknown"];
            }
            return (key, name, (string?)(ResolveParentGroupName(key) ?? L["RootLabel"]));
        });
        return CategoryDisplay.Disambiguate(items);
    }

    private string? ResolveParentGroupName((long Id, CategoryItemType ItemType) key)
    {
        if (key.ItemType == CategoryItemType.Category)
        {
            var category = allActualCategories?.FirstOrDefault(c => c.Id == key.Id);
            if (category?.GroupId == null) return null;
            var parent = allAvailableCategories?.FirstOrDefault(c =>
                c.ItemType == CategoryItemType.Group && c.Id == category.GroupId.Value);
            return parent?.CategoryGroup.Name;
        }
        var group = allAvailableCategories?.FirstOrDefault(c =>
            c.ItemType == CategoryItemType.Group && c.Id == key.Id);
        if (group?.ParentCategoryGroupId == null) return null;
        var parentGroup = allAvailableCategories?.FirstOrDefault(c =>
            c.ItemType == CategoryItemType.Group && c.Id == group.ParentCategoryGroupId.Value);
        return parentGroup?.CategoryGroup.Name;
    }

    private async Task LoadCategoryTrends()
    {
        categoryTrends = new Dictionary<string, List<MonthlySpending>>();

        // Build the map of groups whose descendants carry the budget. Auto-default expansion
        // (below) opens these so the breakdown is visible without a click, but the caret still
        // works — user can collapse to see just the auto-summed parent.
        budgetedDescendantsByGroup = new();
        if (selectedCompareBudgetId > 0 && allCategories != null)
        {
            var budgetKeys = (await BudgetEntryService.GetMonthlyBudgetAmountsAsync(selectedCompareBudgetId))
                .Where(kvp => kvp.Value.Any(m => m != 0m))
                .Select(kvp => kvp.Key)
                .ToHashSet();
            budgetedDescendantsByGroup = BudgetTrendMath.ResolveBudgetedDescendants(
                budgetKeys, selectedCategoryGroupIds, allCategories);
        }

        if (!sessionAutoDefaultApplied && selectedCompareBudgetId > 0)
        {
            foreach (var k in budgetedDescendantsByGroup.Keys)
                expandedVarianceKeys.Add(k);
            sessionAutoDefaultApplied = true;
        }

        // Batch-load trends. A tracked group only pulls its descendants in when the user has
        // it expanded — collapsed = show just the (auto-summed) group row. Two kinds of
        // descendants:
        //   - budgeted: leaves/sub-groups carrying their own MonthlyBudgetEntry. They're the
        //     "real" breakdown for the subtree and participate in the chart + total.
        //   - shadow: leaves with recent transactions but no budget entry. Table-only
        //     drill-down; never enter the chart or total (no budget data to compare).
        var batchKeys = new List<(long Id, CategoryItemType ItemType)>();
        var batchKeySeen = new HashSet<(long Id, CategoryItemType ItemType)>();
        var shadowOnlyKeys = new HashSet<(long Id, CategoryItemType ItemType)>();
        void AddBatchKey((long Id, CategoryItemType ItemType) k)
        {
            // Dedup — a leaf can come in via both selectedActualCategoryIds (tracked at the
            // leaf level) AND budgetedDescendantsByGroup (auto-included under its tracked
            // parent). Duplicates would explode the ToDictionary on the variance render.
            if (batchKeySeen.Add(k)) batchKeys.Add(k);
        }
        foreach (var groupId in selectedCategoryGroupIds)
        {
            var key = (groupId, CategoryItemType.Group);
            AddBatchKey(key);
            if (!expandedVarianceKeys.Contains(key)) continue;
            if (budgetedDescendantsByGroup.TryGetValue(key, out var budgeted))
            {
                foreach (var b in budgeted) AddBatchKey(b);
            }
            else if (selectedCompareBudgetId > 0
                && shadowSubcatsByGroup.TryGetValue(key, out var subs))
            {
                foreach (var s in subs)
                {
                    AddBatchKey(s);
                    shadowOnlyKeys.Add(s);
                }
            }
        }
        foreach (var categoryId in selectedActualCategoryIds)
            AddBatchKey((categoryId, CategoryItemType.Category));

        // Budget-carrier keys: the rows whose budget figures into the chart + footer totals.
        //   - tracked leaves: always carriers
        //   - budgeted descendants (when their parent is expanded): carriers
        //   - tracked group when collapsed (or without budgeted descendants): carrier with its
        //     auto-summed/own amount
        //   - tracked group when expanded with budgeted descendants present: NOT a carrier —
        //     the descendants in batchKeys carry the value
        //   - shadow leaves: never carriers (table-only)
        var budgetCarrierKeys = batchKeys
            .Where(k => !shadowOnlyKeys.Contains(k))
            .Where(k => !(k.ItemType == CategoryItemType.Group
                          && expandedVarianceKeys.Contains(k)
                          && budgetedDescendantsByGroup.ContainsKey(k)))
            .ToHashSet();

        var trendBatch = await BudgetPredictionService.GetMonthlySpendingBatchAsync(batchKeys, selectedYear, projectSourceId);

        // Two leaf categories can share the same name (e.g. "Reparaturen" sits under both
        // "Umlagefähig" and "Nicht umlagefähig"). The downstream dictionaries are keyed by
        // display name, so collisions silently overwrite — disambiguate with the parent group
        // before any key is written.
        categoryDisplayNames = BuildDisplayNames(batchKeys);

        categorySortKeys = new Dictionary<string, string>();
        // Aggregate + chart-inclusion. With a budget: only carriers count, so totals stay
        // stable on expand/collapse and shadow drill-down rows never enter the chart.
        // Without a budget: fall back to tree-leaves dedup so user-picked group + sub-cat
        // doesn't double-count in the summary footer, and don't hide anything from the chart.
        HashSet<(long Id, CategoryItemType ItemType)> aggregateKeys;
        if (selectedCompareBudgetId > 0)
        {
            aggregateKeys = budgetCarrierKeys;
        }
        else
        {
            var chartTreeNodes = TrackedRowTree.Build(batchKeys, allAvailableCategories ?? new List<CategoryGroupWithChildCount>());
            aggregateKeys = chartTreeNodes.Where(n => !n.HasChildren).Select(n => n.Key).ToHashSet();
        }
        aggregateRowNames = new HashSet<string>();
        chartHiddenNames = new HashSet<string>();
        foreach (var (key, trend) in trendBatch)
        {
            if (!trend.Any()) continue;
            if (!categoryDisplayNames.TryGetValue(key, out var name)) continue;

            categoryTrends[name] = trend;
            categorySortKeys[name] = BudgetTrendMath.ComputeSortKey(key, allActualCategories, allCategories);
            if (aggregateKeys.Contains(key)) aggregateRowNames.Add(name);
            else if (selectedCompareBudgetId > 0) chartHiddenNames.Add(name);
        }

        // Load budget data if comparison is active
        budgetTrends = null;
        varianceSummary = null;

        if (selectedCompareBudgetId > 0 && categoryTrends.Any())
        {
            // Effective budget amounts. Tracked groups whose descendants carry the budget
            // (and the group has no entry of its own) get an injected zero stored amount so
            // ComputeEffectiveAmounts auto-sums them from their descendants — otherwise the
            // group row would render €0 next to a chart that shows the breakdown.
            var rawStored = await BudgetEntryService.GetMonthlyBudgetAmountsAsync(selectedCompareBudgetId);
            var augmentedStored = new Dictionary<(long Id, CategoryItemType ItemType), decimal[]>(rawStored);
            foreach (var groupKey in budgetedDescendantsByGroup.Keys)
            {
                if (!augmentedStored.ContainsKey(groupKey))
                    augmentedStored[groupKey] = new decimal[12];
            }
            var budgetEffective = BudgetEntryService.ComputeEffectiveAmounts(
                augmentedStored,
                allAvailableCategories ?? new List<CategoryGroupWithChildCount>());
            var compareBudget = await BudgetEntryService.GetBudgetAsync(selectedCompareBudgetId);
            var budgetYear = compareBudget?.Year ?? selectedYear;

            // Variance rows + per-category budget trend series (pure assembly; see BudgetTrendMath).
            (budgetTrends, varianceSummary) = BudgetTrendMath.BuildVarianceRows(
                batchKeys, categoryDisplayNames, budgetEffective, categoryTrends, aggregateRowNames, budgetYear);
        }

        if (categoryTrends.Any())
        {
            needsTrendChartRender = true;
            StateHasChanged();
        }
    }

    private async Task RenderStackedBarChart()
    {
        if (categoryTrends == null || !categoryTrends.Any())
            return;

        // Get all unique month labels from the first category's trend
        var firstTrend = categoryTrends.Values.First();
        var labels = firstTrend.Select(m => m.MonthName).ToArray();

        // Sort categories by average amount (descending - largest at bottom of stack).
        // Filter out expanded groups — their sub-cat rows appear in the chart instead.
        var sortedCategories = categoryTrends
            .Where(kvp => !chartHiddenNames.Contains(kvp.Key))
            .OrderByDescending(kvp => kvp.Value.Average(m => m.Amount))
            .ToList();

        // Create datasets for each category
        var datasets = new List<object>();
        // Palette templates carry a "{0}" placeholder for alpha; resolve to 0.8 here for
        // the actual bars and 0.3 / 1.0 below for budget overlays / borders.
        var palette = ChartPalette.Templates(sortedCategories.Count);
        var actualOrder = new Dictionary<string, int>(StringComparer.Ordinal);
        var actualColor = new Dictionary<string, string>(StringComparer.Ordinal);

        for (int i = 0; i < sortedCategories.Count; i++)
        {
            var kvp = sortedCategories[i];
            var categoryName = kvp.Key;
            var trend = kvp.Value;
            var data = trend.Select(m => m.Amount).ToArray();

            actualOrder[categoryName] = i;
            actualColor[categoryName] = palette[i];

            datasets.Add(new
            {
                label = categoryName,
                data = data,
                backgroundColor = ChartPalette.WithAlpha(palette[i], 0.8),
                type = "bar",
                stack = "actual", // Separate stack for actual spending
                // Picked up by the merged tooltip + hover-highlight in charts.js to pair
                // each "actual" dataset with its "budget" counterpart on the same category.
                highlightGroup = categoryName
            });
        }

        // Add budget bars if budget comparison is active
        if (budgetTrends != null && budgetTrends.Any())
        {
            // Create a lookup of budget data by (Year, Month) for proper alignment
            var budgetLookup = new Dictionary<string, Dictionary<(int Year, int Month), decimal>>();
            foreach (var kvp in budgetTrends)
            {
                var categoryName = kvp.Key;
                var trend = kvp.Value;
                budgetLookup[categoryName] = trend.ToDictionary(m => (m.Year, m.Month), m => m.Amount);
            }

            // Mirror the actuals' order so each budget segment lines up with its actual
            // counterpart in the stack. Categories that only exist on the budget side fall
            // to the end, sorted by their own average so the larger budget-only items still
            // sit nearer the bottom.
            var sortedBudgetCategories = budgetTrends
                .Where(kvp => !chartHiddenNames.Contains(kvp.Key))
                .OrderBy(kvp => actualOrder.GetValueOrDefault(kvp.Key, int.MaxValue))
                .ThenByDescending(kvp => kvp.Value.Average(m => m.Amount))
                .ToList();

            // Reserve extra colors for budget-only categories so they don't collide with
            // the actuals palette.
            var budgetOnlyCount = sortedBudgetCategories.Count(kvp => !actualColor.ContainsKey(kvp.Key));
            var extraColors = budgetOnlyCount > 0 ? ChartPalette.Templates(budgetOnlyCount) : Array.Empty<string>();
            var extraIndex = 0;

            // Build budget datasets in sort order, then prepend the whole block so within
            // the budget stack the first item (largest) ends up at the bottom — matching the
            // actuals stack convention.
            var budgetDatasets = new List<object>();
            foreach (var kvp in sortedBudgetCategories)
            {
                var categoryName = kvp.Key;
                var budgetData = budgetLookup[categoryName];

                // Align budget data with chart labels by matching (Year, Month)
                var data = firstTrend.Select(m =>
                    budgetData.ContainsKey((m.Year, m.Month)) ? (decimal?)budgetData[(m.Year, m.Month)] : null
                ).ToArray();

                // Reuse the matching actual color when available so the user can tell at a
                // glance which budget segment maps to which actual segment.
                var baseColor = actualColor.TryGetValue(categoryName, out var matched)
                    ? matched
                    : extraColors[extraIndex++];
                var budgetColor = ChartPalette.WithAlpha(baseColor, 0.3); // Make budget bars more transparent

                budgetDatasets.Add(new
                {
                    label = L["Chart_BudgetSuffix", categoryName].Value,
                    data = data,
                    backgroundColor = budgetColor,
                    borderColor = ChartPalette.WithAlpha(baseColor, 1),
                    borderWidth = 1,
                    stack = "budget", // Separate stack for budget
                    highlightGroup = categoryName
                });
            }
            datasets.InsertRange(0, budgetDatasets);
        }

        // Anchor the y-axis bottom at 0 only when every trend value is non-negative —
        // otherwise let Chart.js auto-fit so refund-dominated months still render below zero.
        bool hasNegativeTrend = categoryTrends != null
            && categoryTrends.Values.Any(t => t.Any(m => m.Amount < 0));
        decimal? yMin = hasNegativeTrend ? null : 0m;

        var chartData = new
        {
            type = "bar",
            data = new
            {
                labels = labels,
                datasets = datasets.ToArray()
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new
                    {
                        position = "bottom"
                    },
                    tooltip = new
                    {
                        mode = "index",
                        intersect = false,
                        position = "outerEdge",
                        // Drop the standalone budget rows when a matching actual row is also
                        // in the tooltip — that actual row will inline the budget value below.
                        filter = "function(item, idx, array) { if (item.dataset.stack !== 'budget') return true; const key = item.dataset.highlightGroup; return !array.some(o => o.dataset.stack !== 'budget' && o.dataset.highlightGroup === key); }",
                        callbacks = new
                        {
                            label = "function(context) { const ds = context.dataset; const key = ds.highlightGroup || ds.label; const isBudget = ds.stack === 'budget'; if (isBudget) { return key + ': — / €' + context.parsed.y.toFixed(2); } const budgetDs = context.chart.data.datasets.find(d => d.stack === 'budget' && d.highlightGroup === key); const budgetVal = budgetDs ? budgetDs.data[context.dataIndex] : null; const actual = '€' + context.parsed.y.toFixed(2); return key + ': ' + actual + (budgetVal != null ? ' / €' + Number(budgetVal).toFixed(2) : ''); }"
                        }
                    }
                },
                scales = new
                {
                    x = new
                    {
                        stacked = true // Required for grouped stacked bars
                    },
                    y = new
                    {
                        stacked = true, // Stack categories within actual spending
                        // Pass 0 to anchor the bottom for grace when data is all positive;
                        // null lets Chart.js auto-fit so refund-dominated months show below 0.
                        min = yMin,
                        // Push the axis max above the data so stackTotalLabelsPlugin's
                        // two-line Budget/Actual labels AND the net (budget − actual) label
                        // above them fit inside the plot area.
                        grace = "25%",
                        title = new
                        {
                            display = true,
                            text = L["Chart_YAxisTitle"].Value
                        },
                        ticks = new
                        {
                            callback = "function(value) { return '€' + value.toFixed(2); }"
                        }
                    }
                }
            }
        };

        await Task.Delay(100); // Give the DOM time to render

        try
        {
            await JS.InvokeVoidAsync("renderStackedBarChart", "trendStackedBarChart", chartData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering stacked bar chart: {ex.Message}");
        }
    }

