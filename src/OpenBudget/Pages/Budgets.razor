    private bool needsTrendChartRender = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-run after every per-project load (first render and project switch), not just
        // firstRender, since a client-side switch leaves firstRender false.
        if (_needsExpandRestore)
        {
            _needsExpandRestore = false;
            if (selectedCompareBudgetId > 0)
            {
                try
                {
                    var hasPreference = await JS.InvokeAsync<bool>("expandState.hasPreference", ExpandScope);
                    if (hasPreference)
                    {
                        var stored = await JS.InvokeAsync<string[]>("expandState.get", ExpandScope);
                        expandedVarianceKeys.Clear();
                        foreach (var s in stored)
                        {
                            var parts = s.Split(':');
                            if (parts.Length == 2
                                && int.TryParse(parts[0], out var typeInt)
                                && long.TryParse(parts[1], out var id))
                            {
                                expandedVarianceKeys.Add((id, (CategoryItemType)typeInt));
                            }
                        }
                        await LoadCategoryTrends();
                        needsTrendChartRender = true;
                        StateHasChanged();
                    }
                }
                catch { /* localStorage unavailable — keep server-side auto-defaults */ }
            }
        }

        if (firstRender)
        {
            try
            {
                if ((await JS.InvokeAsync<string[]>("expandState.get", ChartsPrefScope)).Contains("open"))
                {
                    chartsOpen = true;
                    needsTrendChartRender = true;
                    StateHasChanged();
                    return;
                }
            }
            catch (JSDisconnectedException) { /* page left */ }
        }

        if (chartsOpen && needsTrendChartRender && categoryTrends != null && categoryTrends.Any())
        {
            needsTrendChartRender = false;
            await RenderStackedBarChart();
        }
    }

    private async Task OnYearChanged(int year)
    {
        if (year == selectedYear) { await LoadTableAsync(); return; }
        selectedYear = year;
        // Re-pick the active budget for the new year unless the user already picked one
        // that matches it.
        if (availableBudgets != null)
        {
            var currentMatch = availableBudgets.FirstOrDefault(b => b.Id == selectedCompareBudgetId);
            if (currentMatch == null || currentMatch.Year != selectedYear)
            {
                selectedCompareBudgetId = availableBudgets
                    .FirstOrDefault(b => b.Year == selectedYear && b.IsActive)?.Id ?? 0;
            }
        }
        // New scope = fresh auto-default; user toggles are scoped to (budget, year).
        expandedVarianceKeys.Clear();
        sessionAutoDefaultApplied = false;
        await LoadCategoryTrends();
    }

