    /// <summary>Transactions filtered to the row's category, on this view's period.</summary>
    private string RowHref(BudgetTableRow row) =>
        $"/projects/{ProjectId}/browse?{CurrentPeriod.ToQueryString()}&sel={row.Selection}";

    private async Task LoadTableAsync()
    {
        if (selectedProjectId <= 0 || allCategories == null) return;
        var (from, to) = PeriodRange;
        var summary = await BudgetService.GetSpendingSummaryAsync(selectedProjectId, anchor.Year, from, to, selectedCompareBudgetId);
        table = BudgetTableModel.Build(summary, allCategories, await BudgetService.GetSentinelRootAsync(projectOwnerId));
    }

    private async Task OnPeriodChanged((int Year, int Month, string Period) next) =>
        await ChangePeriodAsync(new ViewPeriod(next.Year, next.Month, next.Period));

    private async Task OnRangeChanged((DateOnly From, DateOnly To) range) =>
        await ChangePeriodAsync(ViewPeriod.WithRange(range.From, range.To));

    private async Task ChangePeriodAsync(ViewPeriod next)
    {
        var yearChanged = next.Year != anchor.Year;
        ApplyPeriod(next);
        TimeState.Period = CurrentPeriod;
        PageState.ReplaceQuery(Navigation, CurrentPeriod.ToQuery());
        if (yearChanged) await OnYearChanged(anchor.Year);
        else await LoadTableAsync();
    }

    private void ApplyPeriod(ViewPeriod p)
    {
        anchor = (p.Year, p.Month);
        period = p.IsRange ? ViewPeriod.Range : p.Mode;
        (rangeFrom, rangeTo) = p.IsRange ? (p.From, p.To) : (null, null);
    }

    // The shared period of the project views, overlaid with the URL's.
    private void ReadPeriodFromQuery()
    {
        var now = Clock.NowLocal;
        ApplyPeriod(TimeState.ReadFromUrl(Navigation, now));
        if (period != ViewPeriod.Range) anchor = Anchoring.Clamp(anchor, monthMin ?? (1900, 1), monthMax ?? (now.Year, now.Month));
        TimeState.Period = CurrentPeriod;
    }

