@page "/projects/{ProjectId:int}/budgets"
@inherits DataChangeAwareComponent
@using OpenBudget.Services
@using OpenBudget.Models
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject BudgetEntryService BudgetEntryService
@inject BudgetPredictionService BudgetPredictionService
@inject CategoryHierarchyService CategoryHierarchyService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<Budgets> L
@inject ILogger<Budgets> Logger
@inject ClockService Clock
@inject AccessScopeProvider AccessProvider
@inject ProjectTimeState TimeState

<PageTitle>@L["PageTitle"]@(projectName != null ? $" — {projectName}" : "")</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">@L["NotFound_BodyBefore"]<a href="/">@L["NotFound_DashboardLink"]</a>@L["NotFound_BodyAfter"]</p>
    return;
}

<ProjectPageHeader ProjectId="@selectedProjectId" ProjectName="@projectName" />

<ProjectShell ProjectId="ProjectId" Active="ProjectTab.Budgets" MainClass="shell-page budget-view">

<div class="page-toolbar" data-testid="budget-toolbar">
    <h1 class="view-title">@L["View_Title"]</h1>
    @if (SelectedBudget is { } sb)
    {
        <span class="view-sub d-none d-md-inline">@sb.Name</span>
    }
    <PeriodNav Anchor="anchor" Period="@period" RangeFrom="rangeFrom" RangeTo="rangeTo" ShowMonthPicker="true"
               MinMonth="monthMin" MaxMonth="monthMax" OnChanged="OnPeriodChanged" OnRangeChanged="OnRangeChanged" />
    <div class="flex-grow-1"></div>
    <BudgetMenu AvailableBudgets="availableBudgets"
                SelectedBudgetId="selectedCompareBudgetId"
                SelectedYear="selectedYear"
                ProjectId="selectedProjectId"
                CanEdit="AccessProvider.Last.CanEdit(selectedProjectId)"
                OnSelectedBudgetChanged="OnCompareBudgetChanged"
                OnMakeActive="SetBudgetActive"
                OnDelete="ShowDeleteBudgetDialog" />
</div>

<DataChangeBanner Pending="ExternalChangePending" OnReload="ApplyPendingChangeAsync" />

@if (table == null)
{
    <div class="summary-strip cols-3" aria-busy="true">
        @for (var i = 0; i < 3; i++)
        {
            <div class="summary-tile"><div class="skeleton skeleton-line" style="width: 60%;"></div><div class="skeleton skeleton-line"></div></div>
        }
    </div>
}
else
{
    var overRows = table.Sections.SelectMany(s => s.Rows).Where(r => r.Budget > 0 && r.Spent > r.Budget).OrderByDescending(r => r.Spent - r.Budget).ToList();
    <div class="summary-strip cols-3" data-testid="budget-strip">
        <div class="summary-tile" data-testid="budget-spent">
            <span class="summary-label">@L["Strip_Spent"]</span>
            <span class="summary-value">@Formatting.FormatMoneyDe(table.TotalSpent)
                @if (table.HasBudget)
                {
                    <span class="summary-of">&nbsp;@L["Strip_Of", Formatting.FormatMoneyDe(table.TotalBudget)]</span>
                }
            </span>
            @if (table.HasBudget)
            {
                <span class="ob-bar" aria-hidden="true"><span class="status-bg-@ProjectStatus.BarClass(table.TotalSpent, table.TotalBudget)" style="width: @ProjectStatus.BarWidth(table.TotalSpent, table.TotalBudget)"></span></span>
            }
        </div>
        <div class="summary-tile" data-testid="budget-left">
            <span class="summary-label">@LeftLabel</span>
            <span class="summary-value @(table.TotalLeft < 0 ? "money-neg" : "")">@(table.HasBudget ? Formatting.FormatMoneyDe(table.TotalLeft) : "—")</span>
            <span class="summary-note">@LeftNote</span>
        </div>
        <div class="summary-tile" data-testid="budget-over">
            <span class="summary-label">@L["Strip_Over"]</span>
            @if (overRows.Count > 0)
            {
                <span class="summary-value">@L[overRows.Count == 1 ? "Strip_OverOne" : "Strip_OverOther", overRows.Count]
                    <span class="money-neg">+@Formatting.FormatMoneyDe(overRows.Sum(r => r.Spent - r.Budget))</span></span>
                <span class="summary-note">@string.Join(", ", overRows.Select(r => r.Name))</span>
            }
            else
            {
                <span class="summary-value status-success">@L["Strip_OverNone"]</span>
            }
        </div>
    </div>

    <div class="budget-table" role="table" aria-label="@L["Table_Aria"]" data-testid="budget-table">
        <div class="budget-row budget-head" role="row">
            <span role="columnheader">@L["Table_HeaderCategory"]</span>
            <span role="columnheader" class="num">@L["Table_HeaderBudget"]</span>
            <span role="columnheader" class="num">@L["Table_HeaderSpent"]</span>
            <span role="columnheader" class="num">@L["Table_HeaderLeft"]</span>
            <span role="columnheader"><span class="visually-hidden">@L["Table_HeaderBar"]</span></span>
        </div>
        @if (table.Sections.Count == 0)
        {
            <div class="budget-empty text-body-secondary">@L["Table_Empty"]</div>
        }
        @foreach (var section in table.Sections)
        {
            <div class="budget-row budget-group" role="row" @key="section.GroupId">
                <span role="rowheader">@(section.Name ?? L["Table_OtherGroup"])</span>
                <span role="cell" class="num muted">@Money(section.Budget)</span>
                <span role="cell" class="num">@Formatting.FormatMoneyDe(section.Spent)</span>
                <span role="cell" class="num @(section.Left < 0 ? "money-neg" : "")">@Money(section.Left)</span>
                <span role="cell">@Bar(section.Spent, section.Budget)</span>
            </div>
            @foreach (var row in section.Rows)
            {
                <a class="budget-row budget-cat" role="row" href="@RowHref(row)" data-testid="budget-row" @key="row.Selection">
                    <span role="rowheader" class="budget-name"><span class="budget-dot" style="@CategoryColors.For(row.Id, row.Color).Style" aria-hidden="true"></span><span class="text-truncate">@row.Name</span></span>
                    <span role="cell" class="num muted">@Money(row.Budget)</span>
                    <span role="cell" class="num">@Formatting.FormatMoneyDe(row.Spent)</span>
                    <span role="cell" class="num fw-semibold @(row.Left < 0 ? "money-neg" : "")">@Money(row.Left)</span>
                    <span role="cell">@Bar(row.Spent, row.Budget)</span>
                </a>
            }
        }
        <div class="budget-row budget-total" role="row" data-testid="budget-total">
            <span role="rowheader">@L["Table_HeaderTotal"]</span>
            <span role="cell" class="num">@Money(table.TotalBudget)</span>
            <span role="cell" class="num">@Formatting.FormatMoneyDe(table.TotalSpent)</span>
            <span role="cell" class="num @(table.TotalLeft < 0 ? "money-neg" : "")">@Money(table.TotalLeft)</span>
            <span role="cell">@Bar(table.TotalSpent, table.TotalBudget)</span>
        </div>
        @if (table.Income.Count > 0)
        {
            <div class="budget-row budget-head budget-income-head" role="row" data-testid="budget-income">
                <span role="columnheader">@L["Income_Heading"]</span>
                <span role="columnheader" class="num">@L["Income_Expected"]</span>
                <span role="columnheader" class="num">@L["Income_Received"]</span>
                <span role="columnheader" class="num">@L["Income_Outstanding"]</span>
                <span role="columnheader"><span class="visually-hidden">@L["Table_HeaderBar"]</span></span>
            </div>
            @foreach (var row in table.Income)
            {
                var outstanding = Math.Max(0, row.Budget - row.Spent);
                <a class="budget-row budget-cat" role="row" href="@RowHref(row)" data-testid="budget-income-row" @key="row.Selection">
                    <span role="rowheader" class="budget-name"><span class="budget-dot" style="@CategoryColors.For(row.Id, row.Color).Style" aria-hidden="true"></span><span class="text-truncate">@row.Name</span></span>
                    <span role="cell" class="num muted">@Money(row.Budget)</span>
                    <span role="cell" class="num">@Formatting.FormatMoneyDe(row.Spent)</span>
                    <span role="cell" class="num fw-semibold">@Money(outstanding)</span>
                    <span role="cell">@IncomeBar(row.Spent, row.Budget)</span>
                </a>
            }
            <div class="budget-row budget-total" role="row" data-testid="budget-income-total">
                <span role="rowheader">@L["Income_Total"]</span>
                <span role="cell" class="num">@Money(table.IncomeExpected)</span>
                <span role="cell" class="num">@Formatting.FormatMoneyDe(table.IncomeReceived)</span>
                <span role="cell" class="num">@Money(Math.Max(0, table.IncomeExpected - table.IncomeReceived))</span>
                <span role="cell">@IncomeBar(table.IncomeReceived, table.IncomeExpected)</span>
            </div>
        }
    </div>
    <p class="budget-hint text-body-secondary">@L["Table_Hint"]</p>
}

<div class="budget-charts-toggle">
    <button type="button" class="ob-btn" data-testid="budget-charts-toggle" aria-expanded="@chartsOpen.ToString().ToLowerInvariant()"
            aria-controls="budget-charts" @onclick="ToggleChartsAsync">
        <i class="bi bi-bar-chart" aria-hidden="true"></i> @L["Charts_Button"]
        <i class="bi @(chartsOpen ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
    </button>
</div>

@if (chartsOpen)
{
<div id="budget-charts">
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">@L["Card_CategoryTrendsTitle"]</h5>
            </div>
            <div class="card-body">
                @if (categoryTrends == null)
                {
                    <div class="skeleton" style="height: 600px;" aria-busy="true" aria-label="@L["Status_LoadingTrends"]"></div>
                }
                else if (!categoryTrends.Any())
                {
                    <p class="text-body-secondary">@L["Status_NoTrendData"]</p>
                }
                else
                {
                    <div style="position: relative; height: 600px; max-height: 900px;">
                        <canvas id="trendStackedBarChart"></canvas>
                    </div>

                    @if (selectedCompareBudgetId > 0 && varianceSummary != null && varianceSummary.Any())
                    {
                        <div class="mt-4">
                            <h6>@L["Heading_BudgetVsActualVariance"]</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Table_HeaderCategory"]</th>
                                            <th class="text-end">@L["Table_HeaderBudget"]</th>
                                            <th class="text-end">@L["Table_HeaderActual"]</th>
                                            <th class="text-end">@L["Table_HeaderVariance"]</th>
                                            <th class="text-end">@L["Table_HeaderPercentOfBudget"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var varianceTreeNodes = TrackedRowTree.Build(
                                                varianceSummary.Select(v => (v.CategoryId, v.ItemType)),
                                                allAvailableCategories ?? new List<CategoryGroupWithChildCount>(),
                                                k => varianceSummary.FirstOrDefault(v => v.CategoryId == k.Id && v.ItemType == k.ItemType)?.CategoryName ?? "");
                                            var varianceByKey = varianceSummary.ToDictionary(v => (v.CategoryId, v.ItemType));
                                        }
                                        @foreach (var node in varianceTreeNodes)
                                        {
                                            if (!varianceByKey.TryGetValue(node.Key, out var item)) continue;
                                            var percentOfBudget = item.HasBudget && item.BudgetAmount > 0
                                                ? (item.ActualAmount / item.BudgetAmount * 100) : 0;
                                            // Caret only when manual expand actually adds something — i.e. the group
                                            // has shadow sub-cats and isn't already showing budgeted descendants.
                                            var canExpand = item.ItemType == CategoryItemType.Group
                                                && HasManualExpand((item.CategoryId, item.ItemType));
                                            var isExpanded = expandedVarianceKeys.Contains(node.Key);
                                            // Auto-summed groups (computed from sub-cats) render muted+italic and prefix
                                            // numbers with Σ so the value reads as a roll-up rather than a user input.
                                            // Expansion adds nothing to the parent's styling — it just toggles whether
                                            // the sub-cat rows below are visible.
                                            var rowClass = item.IsAutoSummed ? "text-body-secondary fst-italic"
                                                : !item.HasBudget ? ""
                                                : percentOfBudget > 110 ? "table-danger"
                                                : percentOfBudget > 90 ? "table-warning"
                                                : "table-success";
                                            var sumPrefix = item.IsAutoSummed ? "Σ " : "";
                                            // Tree indent already disambiguates sub-cat vs. parent — drop the "Parent › Name"
                                            // prefix that BuildDisplayNames adds for the flat chart legend.
                                            var bareName = BareCategoryName(node.Key) ?? item.CategoryName;
                                            <tr @key="node.Key" class="@rowClass">
                                                <td style="@(FormattableString.Invariant($"padding-left: {0.5 + node.Level * 1.25}rem; white-space: nowrap;"))">
                                                    @if (canExpand)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-link p-0 me-1"
                                                                style="text-decoration: none;"
                                                                @onclick="() => ToggleVarianceExpand(node.Key)"
                                                                title="@(isExpanded ? L["Button_Collapse"] : L["Button_Expand"])">
                                                            @(isExpanded ? "▾" : "▸")
                                                        </button>
                                                    }
                                                    @bareName
                                                </td>
                                                <td class="text-end">@(item.HasBudget ? sumPrefix + Formatting.FormatMoneyDe(item.BudgetAmount) : "—")</td>
                                                <td class="text-end">@Formatting.FormatMoneyDe(item.ActualAmount)</td>
                                                <td class="text-end">@(item.HasBudget ? sumPrefix + Formatting.FormatMoneyDe(item.Variance) : "—")</td>
                                                <td class="text-end">@(item.HasBudget ? $"{percentOfBudget:N1}%" : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        @{
                                            var aggregateRows = varianceSummary.Where(v => v.IsAggregateRow).ToList();
                                            var totalBudget = aggregateRows.Sum(v => v.BudgetAmount);
                                            var totalActual = aggregateRows.Sum(v => v.ActualAmount);
                                            var totalVariance = aggregateRows.Sum(v => v.Variance);
                                            var totalPercent = totalBudget > 0 ? (totalActual / totalBudget * 100) : 0;
                                        }
                                        <tr class="table-primary">
                                            <th>@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">@Formatting.FormatMoneyDe(totalBudget)</th>
                                            <th class="text-end">@Formatting.FormatMoneyDe(totalActual)</th>
                                            <th class="text-end">@Formatting.FormatMoneyDe(totalVariance)</th>
                                            <th class="text-end">@totalPercent.ToString("N1")%</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* No budget selected — show a plain summary so users always get a tabular
                           breakdown to scan alongside the chart. *@
                        <div class="mt-4">
                            <h6>@L["Heading_Summary"]</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>@L["Table_HeaderCategory"]</th>
                                            <th class="text-end">@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">@L["Table_HeaderAvgPerMonth"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (name, trend) in categoryTrends.OrderBy(kvp => categorySortKeys.GetValueOrDefault(kvp.Key, kvp.Key)).ThenBy(kvp => kvp.Key))
                                        {
                                            var total = trend.Sum(m => m.Amount);
                                            var avg = trend.Count > 0 ? total / trend.Count : 0m;
                                            <tr @key="name">
                                                <td>@name</td>
                                                <td class="text-end">@Formatting.FormatMoneyDe(total)</td>
                                                <td class="text-end">@Formatting.FormatMoneyDe(avg)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        @{
                                            var aggregateTrendValues = categoryTrends
                                                .Where(kvp => aggregateRowNames.Contains(kvp.Key))
                                                .Select(kvp => kvp.Value)
                                                .ToList();
                                            var grandTotal = aggregateTrendValues.Sum(t => t.Sum(m => m.Amount));
                                            var grandMonths = aggregateTrendValues.Select(t => t.Count).DefaultIfEmpty(0).Max();
                                            var grandAvg = grandMonths > 0 ? grandTotal / grandMonths : 0m;
                                        }
                                        <tr class="table-primary">
                                            <th>@L["Table_HeaderTotal"]</th>
                                            <th class="text-end">@Formatting.FormatMoneyDe(grandTotal)</th>
                                            <th class="text-end">@Formatting.FormatMoneyDe(grandAvg)</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center" role="button" @onclick="ToggleCategoriesPanel" style="cursor: pointer;">
                <h5 class="mb-0">@L["Card_CategoriesTitle"]</h5>
                <i class="bi @(categoriesExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
            </div>
            @if (categoriesExpanded)
            {
                <div class="card-body">
                    <div class="tracking-tree-scroll">
                        @if (allAvailableCategories != null && allActualCategories != null)
                        {
                            var filteredGroupIds = allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group)
                                .Select(c => c.Id)
                                .ToHashSet();
                            @foreach (var rootCat in allAvailableCategories
                                .Where(c => c.ItemType == CategoryItemType.Group
                                    && !filteredGroupIds.Contains(c.ParentCategoryGroupId ?? -1))
                                .OrderBy(c => c.CategoryGroup.Name))
                            {
                                <CategoryTree
                                    @key="rootCat.CategoryGroup.Id"
                                    CategoryGroup="@rootCat"
                                    Level="0"
                                    RenderMode="CategoryTreeRenderMode.Checkbox"
                                    ParentSelected="false"
                                    SelectedCategoryGroupIds="@selectedCategoryGroupIds"
                                    SelectedCategoryIds="@selectedActualCategoryIds"
                                    OnCategoryGroupToggle="@HandleCategoryGroupToggle"
                                    OnCategoryToggle="@HandleCategoryToggle"
                                    AllCategories="@allAvailableCategories"
                                    ActualCategories="@allActualCategories" />
                            }
                        }
                    </div>
                    <small class="form-text text-body-secondary mt-2 d-block">
                        <strong>@L["HowToUse_Heading"]</strong><br/>
                        • @L["HowToUse_Item1"]<br/>
                        • @L["HowToUse_Item2"]<br/>
                        • @L["HowToUse_Item3"]
                    </small>
                </div>
            }
        </div>
    </div>
</div>

</div>
}

<Modal Show="@(budgetPendingDelete != null)" Title="@L["Modal_DeleteBudget_Title"]" OnClose="@HideDeleteBudgetDialog">
    <ChildContent>
        @if (budgetPendingDelete != null)
        {
            <p>@L["Modal_DeleteBudget_Body", budgetPendingDelete.Year, string.IsNullOrEmpty(budgetPendingDelete.Notes) ? "" : L["Modal_DeleteBudget_Notes", budgetPendingDelete.Notes].Value]</p>
            <p class="text-body-secondary small mb-0">@L["Modal_DeleteBudget_Warning"]</p>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="HideDeleteBudgetDialog">@L["Button_Cancel"]</button>
        <button class="btn btn-danger" @onclick="ConfirmDeleteBudget">@L["Button_Delete"]</button>
    </Footer>
</Modal>

</ProjectShell>

@code {
    private List<CategoryGroupWithChildCount>? allCategories;
    private List<CategoryGroupWithChildCount>? filteredCategories;
    private List<CategoryGroupWithChildCount>? allAvailableCategories;
    private readonly HashSet<long> selectedCategoryGroupIds = new();
    private HashSet<long> selectedActualCategoryIds = new();
    private HashSet<(long Id, CategoryItemType ItemType)> incomeItems = new();
    private List<Category>? allActualCategories;
    private Dictionary<string, List<MonthlySpending>>? categoryTrends;
    private Dictionary<string, string> categorySortKeys = new();
    private HashSet<string> aggregateRowNames = new();
    /// <summary>Display names hidden from the chart — expanded tracked groups, whose sub-cat
    /// rows take their place in the chart. The variance table still shows the group row (with
    /// a ▾ caret) as a parent for the nested sub-cats.</summary>
    private HashSet<string> chartHiddenNames = new();
    private Dictionary<string, List<MonthlySpending>>? budgetTrends;
    /// <summary>(Id, ItemType) → unique display name. Bare category name when no collision,
    /// "Parent group > Name" when two or more selected items share the same bare name.
    /// Populated by LoadCategoryTrends; the other dictionaries are keyed by the resulting
    /// display name so collisions can't silently overwrite entries.</summary>
    private Dictionary<(long Id, CategoryItemType ItemType), string> categoryDisplayNames = new();
    private List<VarianceSummary>? varianceSummary;
    private List<Budget>? availableBudgets;
    /// <summary>Budget the user has clicked Delete on, awaiting confirmation in the modal.</summary>
    [Parameter] public int ProjectId { get; set; }

    private Budget? budgetPendingDelete;
    private int selectedProjectId = 0;
    private int selectedCompareBudgetId = 0;
    // Set from the browser's current year in ResetForProjectSwitch (which runs before the first
    // render), since a field initializer can't reach the injected ClockService.
    private int selectedYear;
    private bool categoriesExpanded = false;
    private string? projectName;
    private string projectOwnerId = string.Empty;
    private bool notFound = false;

    // Variance tree: groups the user has expanded. When a group is expanded, the variance
    // table replaces its row with its in-use sub-cats (sub-cats that have transactions in the
    // trailing 12 months — same set BudgetEdit uses for shadow rows). The chart follows suit:
    // expanded groups vanish, their sub-cats appear in their place. Persisted per (project,
    // year) in localStorage so the layout survives a reload.
    private HashSet<(long Id, CategoryItemType ItemType)> expandedVarianceKeys = new();
    // Per tracked group: the in-use leaf sub-cats we'd show if the group were expanded.
    // Computed on load + when the underlying tracking changes.
    private Dictionary<(long Id, CategoryItemType ItemType), List<(long Id, CategoryItemType ItemType)>>
        shadowSubcatsByGroup = new();
    // Per tracked group: descendants that hold a non-zero MonthlyBudgetEntry in the selected
    // compare-budget. Always included in the chart + variance table (replacing the group in
    // the chart, nested under it in the variance table) — that's "show the budget where it
    // actually lives" without requiring a manual expand step.
    private Dictionary<(long Id, CategoryItemType ItemType), List<(long Id, CategoryItemType ItemType)>>
        budgetedDescendantsByGroup = new();
    // Auto-default = "expand every group whose descendants carry the budget" — applied once
    // per session unless localStorage holds a user-set override. Reset on year/budget change
    // so a fresh budget gets the same friendly default before the user touches anything.
    private bool sessionAutoDefaultApplied = false;
    private string ExpandScope => $"budgets-variance:{selectedProjectId}:{selectedYear}";

    private void ToggleCategoriesPanel() => categoriesExpanded = !categoriesExpanded;

    // ---- period, table, charts toggle ----

    private (int Year, int Month) anchor;
    private string period = "month";
    // A custom range's days; the budget covers the whole months the range touches in its last year.
    private DateOnly? rangeFrom, rangeTo;
    private (int Year, int Month)? monthMin;
    private (int Year, int Month)? monthMax;
    private BudgetTableModel? table;
    private bool chartsOpen;
    private const string ChartsPrefScope = "budget-charts";

    private Budget? SelectedBudget => availableBudgets?.FirstOrDefault(b => b.Id == selectedCompareBudgetId);

    private ViewPeriod CurrentPeriod => period == ViewPeriod.Range && rangeFrom is { } f && rangeTo is { } t
        ? ViewPeriod.WithRange(f, t)
        : new ViewPeriod(anchor.Year, anchor.Month, period == ViewPeriod.Range ? "month" : period);

    private (int FromMonth, int ToMonth) PeriodRange => CurrentPeriod.Months;

    private string PeriodName
    {
        get
        {
            var d = new DateTime(anchor.Year, anchor.Month, 1);
            var (fm, tm) = PeriodRange;
            return period switch
            {
                ViewPeriod.Range => L["Period_Range", new DateTime(anchor.Year, fm, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture),
                    new DateTime(anchor.Year, tm, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture)].Value,
                "year" => anchor.Year.ToString(CultureInfo.CurrentCulture),
                "ytd" => L["Period_Ytd", d.ToString("MMMM yyyy", CultureInfo.CurrentCulture)].Value,
                _ => d.ToString("MMMM yyyy", CultureInfo.CurrentCulture),
            };
        }
    }

    private string LeftLabel => period switch
    {
        "year" => L["Strip_LeftYear"],
        "ytd" => L["Strip_LeftYtd"],
        ViewPeriod.Range => L["Strip_LeftRange"],
        _ => L["Strip_LeftMonth"],
    };

    /// <summary>"24 days to go · on track" for the current month, else the period's name.</summary>
    private string LeftNote
    {
        get
        {
            var today = Clock.Today;
            if (table is { HasBudget: true } && period == "month" && anchor == (today.Year, today.Month))
            {
                var daysLeft = DateTime.DaysInMonth(today.Year, today.Month) - today.Day;
                var status = ProjectStatus.BarClass(table.TotalSpent, table.TotalBudget);
                return L["Strip_DaysLeft", daysLeft, L[$"Strip_Status_{status}"]];
            }
            return PeriodName;
        }
    }

    private string Money(decimal value) => table is { HasBudget: true } ? Formatting.FormatMoneyDe(value) : "—";

