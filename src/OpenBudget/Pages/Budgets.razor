    private string? BareCategoryName((long Id, CategoryItemType ItemType) key)
    {
        if (key.ItemType == CategoryItemType.Category)
            return allActualCategories?.FirstOrDefault(c => c.Id == key.Id)?.Name;
        return allAvailableCategories?.FirstOrDefault(c =>
            c.ItemType == CategoryItemType.Group && c.Id == key.Id)?.CategoryGroup.Name;
