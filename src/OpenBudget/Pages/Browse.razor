    /// <summary>
    /// Invoked from JS when the user clicks a bar in the chart. <paramref name="barIndex"/>
    /// is the bar's position in <see cref="chartBars"/>; we map it back through
    /// <see cref="chartBarMonths"/> to set the anchor to that month and re-highlight.
    /// </summary>
    [JSInvokable]
    public async Task OnChartBarClicked(int barIndex)
    {
        if (chartBarMonths == null || project == null) return;
        if (barIndex < 0 || barIndex >= chartBarMonths.Length) return;
        var (y, m) = chartBarMonths[barIndex];
        bool anchorChanged = !(y == anchor.Year && m == anchor.Month);
        if (period == ViewPeriod.Range)
        {
            // A bar of a custom range opens its month.
            chartSkipAnimation = true;
            ApplyPeriod(new ViewPeriod(y, m, "month"));
            await PeriodChangedAsync(true);
            return;
        }
        if (anchorChanged)
        {
            anchor = (y, m);
            chartSkipAnimation = true;
            RememberTimeState();
            UpdateUrl();
            await ReloadHighlightAsync();
        }
        await JumpListToAnchorAsync();
    }

    /// <summary>
    /// Scroll the virtualized tx list to the latest transaction at-or-before the current
    /// anchor period. Hands JS an approximate pixel offset (<c>newerCount * itemSize</c>);
    /// after Virtualize loads the items at that scroll position, the JS helper snaps the
    /// first <c>.in-period</c> row to the top.
    /// </summary>
    private async Task JumpListToAnchorAsync()
    {
        if (project == null || period == ViewPeriod.Range) return;
        var (_, tm) = PeriodRange;
        var periodEndExclusive = new DateTime(anchor.Year, tm, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(1);
        var newerCount = await TransactionQueries.CountNewerThanAsync(
            await BuildTransactionQueryAsync(0, 1), periodEndExclusive);
        try { await JS.InvokeVoidAsync("scrollListToTxOffset", newerCount * itemSize); }
        catch (JSDisconnectedException) { /* navigation in flight */ }
    }

    private async Task<TransactionQuery> BuildTransactionQueryAsync(int skip = 0, int take = 50, bool newOnlyOverride = false) =>
        _previewIds != null
            // Live preview of a draft rule: exactly the bookings it matches, across the project.
            ? new TransactionQuery { OwnerUserId = project!.OwnerUserId, OnlyIds = _previewIds, Skip = skip, Take = take }
            : await BuildFilteredTransactionQueryAsync(skip, take, newOnlyOverride);

    private async Task<TransactionQuery> BuildFilteredTransactionQueryAsync(int skip, int take, bool newOnlyOverride) => new()
    {
        OwnerUserId = project!.OwnerUserId,
        UncategorizedOnly = selectionKind == "uncategorized",
        // "Transactions" lists the tracked categories' bookings plus the uncategorized ones (pending rows mostly are) of the
        // project's accounts, scoped like the Uncategorized entry.
        IncludeUncategorized = selectionKind == "all",
        UncategorizedAccountIds = selectionKind == "all" ? ProjectAccountIds() : null,
        CategoryLeafIds = categoryFilter is { } cf && IsAccountScope ? new[] { cf } : await ResolveSelectionLeavesAsync(),
        AccountIds = ResolveSelectionAccounts(),
        SearchText = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        MinAbsAmount = amountMin,
        MaxAbsAmount = amountMax,
        Checked = checkedFilter switch { "yes" => true, "no" => false, _ => null },
        Direction = directionFilter switch { "in" => AmountDirection.Incoming, "out" => AmountDirection.Outgoing, _ => AmountDirection.Any },
        NewOnly = newOnly || newOnlyOverride,
        FromUtc = PeriodBoundsUtc.From,
        ToUtcExclusive = PeriodBoundsUtc.ToExclusive,
        PayeeEquals = payeeEquals,
        Skip = skip,
        Take = take
    };

    private async ValueTask<Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<TxListItem>> LoadTxRowsAsync(
        Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderRequest request)
    {
        if (project == null || tree == null)
            return new(Array.Empty<TxListItem>(), 0);
        // One row before the window (when there is one) tells whether the first row starts a new day.
        var lead = request.StartIndex > 0 ? 1 : 0;
        var q = await BuildTransactionQueryAsync(request.StartIndex - lead, request.Count + lead);
        var result = await TransactionQueries.QueryAsync(q, request.CancellationToken);

        var running = RunningBalance.Applies(IsAccountScope, SelectionAccountBalance != null, HasActiveFilter)
            ? await EnsureRunningBalanceAsync(request.CancellationToken)
            : null;
        var items = new List<TxListItem>(result.Rows.Count);
        DateOnly? previousDay = lead == 1 && result.Rows.Count > 0 ? ToLocalDay(result.Rows[0].Date) : null;
        for (var i = lead; i < result.Rows.Count; i++)
        {
            var row = result.Rows[i];
            var index = request.StartIndex - lead + i;
            var day = ToLocalDay(row.Date);
            var showDay = previousDay != day;
            decimal? dayBalance = showDay && running != null ? running.AtEndOf(day) : null;
            previousDay = day;
            rowIndex[row.Id] = index;
            rowCache[row.Id] = row;
            items.Add(new TxListItem(row, index, showDay, day, dayBalance));
        }
        return new(items, result.TotalCount);
    }

    // The handler returns at once (so the render that follows always carries the text the user has typed so far and
    // never overwrites keystrokes that are still in flight); the reload itself waits for a pause in typing.
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? "";
        _ = DebounceSearchAsync(++searchToken);
    }

    // Escape clears the search at once (no debounce) and reloads the list.
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || (searchInput.Length == 0 && searchEffective.Length == 0)) return;
        searchInput = ""; searchEffective = "";
        searchToken++;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task DebounceSearchAsync(long token)
    {
        try
        {
            await Task.Delay(250);
            await InvokeAsync(async () =>
            {
                if (token != searchToken || searchEffective == searchInput) return;
                searchEffective = searchInput;
                UpdateUrl();
                await ReloadTransactionsAsync();
            });
        }
        catch (ObjectDisposedException) { /* page left while waiting */ }
    }

