@page "/projects/{ProjectId:int}/browse"
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject BrowseService BrowseService
@inject TransactionQueryService TransactionQueries
@inject CategoryHierarchyService Hierarchy
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Browse> L
@implements IDisposable

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">
        @L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]
    </p>
    return;
}

<ProjectPageHeader ProjectId="@ProjectId" ProjectName="@(project?.Name ?? "")"
                   Active="ProjectTab.Browse" />

@* Period nav, sticky so the user can re-anchor while scrolling a long tx list.
   No negative top margin — the spacing above mirrors what every other project page
   has between its header and first content row (driven by ProjectPageHeader's
   own mb-2). py-1 + mb-2 keep the strip compact below. *@
<div class="d-flex flex-wrap mb-2 align-items-center gap-2 sticky-top bg-body py-1 bleed-sticky"
     style="z-index: 1020;">
    @* Mobile-only toggle for the left rail. On lg+ the rail is part of the grid; below lg
       it slides in as a drawer, opened via this button. *@
    <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none"
            @onclick="ToggleRail" aria-label="@L["Aria_ToggleTree"]" aria-expanded="@railOpen.ToString().ToLower()">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="() => StepAnchor(-1)" aria-label="@L["Aria_Previous"]">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <span class="text-body-secondary small browse-anchor-label">@AnchorHeading</span>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="() => StepAnchor(1)" aria-label="@L["Aria_Next"]" disabled="@IsAtMaxAnchor">
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            @onclick="GoToToday" disabled="@IsTodayAnchor">@L["Button_Today"]</button>
    <div class="segmented" role="group" aria-label="@L["Aria_Period"]">
        <button type="button" class="btn @(period == "month" ? "active" : "")"
                @onclick='() => SetPeriod("month")'>@L["Button_Month"]</button>
        <button type="button" class="btn @(period == "ytd" ? "active" : "")"
                @onclick='() => SetPeriod("ytd")'>@L["Button_YTD"]</button>
        <button type="button" class="btn @(period == "year" ? "active" : "")"
                @onclick='() => SetPeriod("year")'>@L["Button_Year"]</button>
    </div>
</div>

<div class="browse-layout">
    @if (railOpen)
    {
        <div class="browse-backdrop d-lg-none" @onclick="CloseRail" aria-hidden="true"></div>
    }
    <aside class="browse-rail @(railOpen ? "open" : "")" aria-label="@L["Aria_Tree"]">
        <div class="browse-rail-header d-lg-none">
            <span class="fw-semibold">@L["Tree_Heading"]</span>
            <button type="button" class="btn-close" @onclick="CloseRail" aria-label="@L["Aria_Close"]"></button>
        </div>
        @if (tree == null)
        {
            <div aria-busy="true">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton skeleton-line" style="margin-left: @(i % 3 * 12)px;"></div>
                }
            </div>
        }
        else
        {
            <div class="browse-tree" role="tree">
                @{
                    bool allSelected = selectionKind == "all";
                }
                <div class="browse-tree-row @(allSelected ? "selected" : "")"
                     role="treeitem" tabindex="0" aria-selected="@allSelected.ToString().ToLower()"
                     @onclick="SelectAll"
                     @onkeydown="OnAllKeydown">
                    <span class="browse-tree-name fw-semibold">
                        <i class="bi bi-list-ul me-1" aria-hidden="true"></i>@L["Tree_AllTransactions"]
                    </span>
                </div>

                @if (tree.Accounts.Count > 0)
                {
                    var visibleAccounts = showRelatedAccounts
                        ? (IEnumerable<BrowseAccountNode>)tree.Accounts
                        : tree.Accounts.Where(a => a.IsAssigned);
                    var hiddenRelatedCount = tree.Accounts.Count(a => !a.IsAssigned);
                    <div class="browse-tree-section">@L["Tree_Section_Accounts"]</div>
                    @foreach (var a in visibleAccounts)
                    {
                        var accountId = a.Id;
                        bool isSel = selectionKind == "account" && selectionId == accountId;
                        <div class="browse-tree-row @(isSel ? "selected" : "") @(!a.IsAssigned ? "related" : "")"
                             role="treeitem" tabindex="0" aria-selected="@isSel.ToString().ToLower()"
                             @onclick="() => SelectAccount(accountId)"
                             @onkeydown="e => OnAccountKeydown(e, accountId)">
                            <span class="browse-tree-name"><i class="bi bi-bank me-1" aria-hidden="true"></i>@a.Name</span>
                            @if (a.Balance.HasValue)
                            {
                                <span class="browse-tree-amount @(a.Balance < 0 ? "text-danger" : "text-body-secondary")">
                                    @Formatting.FormatMoney(a.Balance.Value, a.Currency ?? "EUR")
                                </span>
                            }
                        </div>
                    }
                    @if (hiddenRelatedCount > 0)
                    {
                        <button type="button" class="btn btn-link btn-sm browse-tree-toggle"
                                @onclick="() => showRelatedAccounts = !showRelatedAccounts">
                            @(showRelatedAccounts
                                ? L["Tree_HideRelatedAccounts"]
                                : L["Tree_ShowRelatedAccounts", hiddenRelatedCount])
                        </button>
                    }
                }

                @if (tree.Categories.Count > 0)
                {
                    <div class="browse-tree-section">@L["Tree_Section_Categories"]</div>
                    @foreach (var c in tree.Categories)
                    {
                        @RenderCategoryNode(c, 0)
                    }
                }
            </div>
        }
    </aside>

    <section class="browse-main">
        @if (tree == null)
        {
            <div class="card mb-3" aria-busy="true">
                <div class="card-body">
                    <div class="skeleton skeleton-line-lg" style="width: 40%;"></div>
                    <div class="skeleton skeleton-block mt-3"></div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-4 browse-header-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h5 class="mb-1">@SelectionName</h5>
                            @if (selectionKind != "account" && SelectionBudget is { } budget)
                            {
                                var avail = budget - SelectionSpent;
                                @* Direction-specific framing: income that hasn't been received
                                   yet ("Expected") is a neutral forecast, not a deficit, so it
                                   reads in the muted parent color rather than red. Exceeding an
                                   income target still pops as green. Expense keeps the under/
                                   over budget green/red mapping. *@
                                string availClass = SelectionIsIncome
                                    ? (avail < 0 ? "text-success fw-semibold" : "fw-semibold")
                                    : (avail < 0 ? "text-danger fw-semibold" : "text-success fw-semibold");
                                <div class="text-body-secondary small">
                                    @(SelectionIsIncome ? L["Header_Expected"] : L["Header_Available"])
                                    <span class="@availClass">
                                        @Formatting.FormatMoney(avail)
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <div class="text-end">
                                @if (selectionKind == "account" && SelectionAccountBalance is { } balance)
                                {
                                    // Account header reads its current balance — independent of the
                                    // anchor period. The period net flow (incoming − outgoing) reads
                                    // as a smaller secondary line below.
                                    <div class="h4 mb-0 @(balance < 0 ? "text-danger" : "")">
                                        @Formatting.FormatMoney(balance, SelectionAccountCurrency ?? "EUR")
                                    </div>
                                    <div class="text-body-secondary small">@L["Header_CurrentBalance"]</div>
                                    <div class="text-body-secondary small">
                                        @AnchorHeading: <span class="@(SelectionAccountPeriodSum < 0 ? "text-danger" : "text-success")">
                                            @Formatting.FormatMoney(SelectionAccountPeriodSum, SelectionAccountCurrency ?? "EUR")
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    @* Income shows the received amount as a positive number;
                                       expense shows it as negative ("money gone"). Color follows
                                       the natural-direction sign of SelectionSpent so a refund
                                       on an expense reads green and a reversal on income reads red. *@
                                    <div class="h4 mb-0 @((SelectionSpent > 0) == SelectionIsIncome ? "text-success" : "text-danger")">
                                        @Formatting.FormatMoney(SelectionIsIncome ? SelectionSpent : -SelectionSpent)
                                    </div>
                                    @if (SelectionBudget is { } b2)
                                    {
                                        <div class="text-body-secondary small">@L["Header_Budget"] @Formatting.FormatMoney(b2)</div>
                                    }
                                }
                            </div>
                            @if (chartBars != null && chartBars.Length > 0)
                            {
                                <button type="button" class="btn btn-sm btn-link text-body-secondary p-0"
                                        @onclick="ToggleChartCollapsed"
                                        aria-expanded="@((!chartCollapsed).ToString().ToLower())"
                                        aria-controls="browseChartScroll"
                                        title="@(chartCollapsed ? L["Chart_Expand"] : L["Chart_Collapse"])"
                                        aria-label="@(chartCollapsed ? L["Chart_Expand"] : L["Chart_Collapse"])">
                                    <i class="bi @(chartCollapsed ? "bi-chevron-down" : "bi-chevron-up")" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @if (chartBars != null && chartBars.Length > 0 && !chartCollapsed)
                    {
                        <div class="d-flex gap-2 mt-3 align-items-start">
                            <div id="browseChartScroll" class="browse-chart-scroll flex-grow-1">
                                <div class="browse-chart" style="width: @(ChartCanvasWidthPx)px;">
                                    <canvas id="browseChart" style="height: 140px;"></canvas>
                                </div>
                            </div>
                            <div class="segmented segmented-vertical" role="group" aria-label="@L["Chart_AriaGranularity"]">
                                @if (selectionKind == "account")
                                {
                                    <button type="button" class="btn @(chartGranularity == "D" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("D")'>@L["Chart_D"]</button>
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                }
                                else
                                {
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Q" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Q")'>@L["Chart_Q"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Y" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Y")'>@L["Chart_Y"]</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <div class="input-group input-group-sm filter-input-lg">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" placeholder="@L["Filter_SearchPlaceholder"]"
                           value="@searchInput" @oninput="OnSearchInput" />
                </div>
                <div class="input-group input-group-sm filter-input-sm">
                    <span class="input-group-text">€ ≥</span>
                    <input type="number" class="form-control" step="1" min="0"
                           value="@amountMinInput" @onchange="OnAmountMinChanged" />
                </div>
                <div class="input-group input-group-sm filter-input-sm">
                    <span class="input-group-text">€ ≤</span>
                    <input type="number" class="form-control" step="1" min="0"
                           value="@amountMaxInput" @onchange="OnAmountMaxChanged" />
                </div>
                @if (selectionKind != "account" && tree.Accounts.Count > 1)
                {
                    <select class="form-select form-select-sm filter-input-md"
                            value="@(accountFilter?.ToString() ?? "")"
                            @onchange="OnAccountFilterChanged">
                        <option value="">@L["Filter_AnyAccount"]</option>
                        @foreach (var a in tree.Accounts)
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                }
                @if (HasActiveFilter)
                {
                    <button type="button" class="btn btn-sm btn-link" @onclick="ClearFilters">@L["Filter_Clear"]</button>
                }
            </div>

            <div class="tx-scroll">
            @if (txTotals == null)
            {
                <div aria-busy="true">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="skeleton skeleton-line"></div>
                    }
                </div>
            }
            else if (txTotals.Value.Count == 0)
            {
                <div class="text-body-secondary py-4 text-center">
                    <i class="bi bi-inbox" style="font-size: 1.6rem;" aria-hidden="true"></i>
                    <div>@L["Empty_NoTransactions"]</div>
                </div>
            }
            else
            {
                <div class="tx-list">
                    <Virtualize @ref="txVirtualize" ItemsProvider="LoadTxRowsAsync" Context="row" ItemSize="@itemSize">
                        <ItemContent>
                            @{ var inPeriod = IsInAnchorPeriod(row.Date); }
                            <div class="tx-row @(inPeriod ? "in-period" : "")">
                                <div class="tx-date-col">
                                    <div class="tx-date">@row.Date.ToString("dd.MM.yyyy")</div>
                                    @if (showCategoryColumn && !string.IsNullOrEmpty(row.CategoryName))
                                    {
                                        <div class="tx-badges">
                                            <span class="badge text-bg-primary tx-badge">@row.CategoryName</span>
                                        </div>
                                    }
                                </div>
                                <div class="tx-payee">
                                    <span class="tx-name">@(row.Name ?? "")</span>
                                    @if (!string.IsNullOrEmpty(row.Comment))
                                    {
                                        <span class="tx-comment text-body-secondary">@row.Comment</span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Purpose))
                                    {
                                        <span class="tx-purpose text-body-secondary">@row.Purpose</span>
                                    }
                                </div>
                                <div class="tx-account">
                                    @if (showAccountColumn && !string.IsNullOrEmpty(row.AccountName))
                                    {
                                        <span class="badge text-bg-light border tx-badge">@row.AccountName</span>
                                    }
                                </div>
                                <div class="tx-amount @(row.Amount < 0 ? "text-danger" : "text-success")">
                                    @if (row.IsSplitChild)
                                    {
                                        <span class="badge text-bg-warning me-1" title="@L["Tx_SplitChildTitle"]">@L["Tx_SplitChild"]</span>
                                    }
                                    @Formatting.FormatMoney(row.Amount, row.Currency ?? "EUR")
                                </div>
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="tx-row">
                                <div class="tx-date-col"><div class="skeleton skeleton-line"></div></div>
                                <div class="tx-payee"><div class="skeleton skeleton-line"></div></div>
                                <div class="tx-account"></div>
                                <div class="tx-amount"></div>
                            </div>
                        </Placeholder>
                    </Virtualize>
                </div>

                <div class="d-flex justify-content-end mt-3 small text-body-secondary">
                    @L["Footer_Total", txTotals.Value.Count] · @L["Footer_Sum"] @Formatting.FormatMoney(txTotals.Value.Sum)
                </div>
            }
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public int ProjectId { get; set; }

    private const int pageSize = 50;

    private Project? project;
    private bool notFound;

    // Tree + tx totals (count + sum across the active filter, refreshed on filter change).
    // The list rows themselves are streamed by <Virtualize> via LoadTxRowsAsync.
    private BrowseTree? tree;
    private (int Count, decimal Sum)? txTotals;
    private Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize<TransactionRow>? txVirtualize;
    // Approximate row height in CSS pixels — drives Virtualize's spacer math and the bar-click
    // scroll-jump (offset = newerCount * itemSize). Real rows vary a few px either way; the
    // post-load scrollIntoView fine-tunes the final position.
    private const float itemSize = 56f;

    // URL state.
    private (int Year, int Month) anchor;
    private string period = "month";

    // Selection — "all" | "account" | "category" | "group".
    private string selectionKind = "all";
    private long? selectionId;

    // Filter state.
    private long? accountFilter;
    private string searchInput = "";
    private string searchEffective = "";
    private decimal? amountMin;
    private decimal? amountMax;
    private string amountMinInput = "";
    private string amountMaxInput = "";

    // Chart series: bucketed Spent for the selected node, spanning the source's full history
    // (earliest transaction → anchor bucket). Granularity picks the bucket width (M/Q/Y); the
    // anchor bucket is highlighted and the canvas auto-scrolls to it.
    private (string Label, decimal Value, bool IsAnchor)[]? chartBars;
    // Each chart bar's start month, in (Year, Month) tuples. Used by OnChartBarClicked to
    // translate the bar index back into an anchor date.
    private (int Year, int Month)[]? chartBarMonths;
    private string chartGranularity = "M";
    // Y-axis inversion: true for expense categories/groups so the bars still "grow upwards"
    // visually even though their underlying values are negative (the tick labels honestly
    // read "−300 €"). Income categories and accounts use the natural axis where positive
    // goes up and negative goes down.
    private bool chartInvertY;
    private long lastRenderToken;

    // JS ↔ Blazor bridge for chart bar clicks. Allocated once per page lifetime; the chart
    // re-render hands the same reference each time so click events route back to us.
    private DotNetObjectReference<Browse>? selfRef;

    // Defer JS interop until after the first browser render. OnInitializedAsync runs during
    // server prerender where JS calls are illegal — so we mark the chart dirty and let
    // OnAfterRenderAsync push it to the browser.
    private bool chartDirty;
    // Set by OnChartBarClicked so the next chart render skips the grow-from-zero animation
    // — animating while the user just clicked a bar feels jarring. Cleared after each render.
    private bool chartSkipAnimation;
    // User-driven collapse of the chart row to reclaim vertical space. The chart canvas is
    // removed from the DOM when collapsed, so expanding re-renders via the chartDirty path.
    private bool chartCollapsed;

    // Rail accounts section hides accounts that aren't explicitly assigned to the project
    // by default; the toggle below the list flips this when the user wants to see related
    // accounts (those with transactions in tracked categories but no direct assignment).
    private bool showRelatedAccounts;

    // Mobile-only: the left rail is hidden by default and slides in as a drawer when
    // toggled. On lg+ the rail is part of the grid and this flag is ignored (CSS keeps
    // .browse-rail visible regardless of .open). Closing happens on backdrop click, the X
    // button, or whenever the user picks a tree node — auto-closing on selection so they
    // immediately see the transactions on the right.
    private bool railOpen;

    private void ToggleRail() => railOpen = !railOpen;
    private void CloseRail() => railOpen = false;

    public void Dispose()
    {
        selfRef?.Dispose();
    }

    // Debounce search keystrokes — we throttle by token instead of timer/JS interop.
    private long searchToken;

    protected override async Task OnInitializedAsync()
    {
        ReadStateFromQuery();
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) { notFound = true; return; }
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The initial pipeline (OnInitializedAsync → ReloadAsync) computes chart data but
        // can't push it to JS during prerender. Flush any pending chart here, then on every
        // subsequent state change that flips chartDirty.
        if (chartDirty)
        {
            chartDirty = false;
            await RenderChartAsync();
        }
    }

    private void ReadStateFromQuery()
    {
        var now = DateTime.Now;
        anchor = (now.Year, now.Month);
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("year", out var y) && int.TryParse(y, out var py) && py >= 1900 && py <= now.Year)
            anchor.Year = py;
        if (query.TryGetValue("month", out var m) && int.TryParse(m, out var pm) && pm is >= 1 and <= 12)
            anchor.Month = pm;
        // Clamp future anchor.
        var picked = new DateTime(anchor.Year, anchor.Month, 1);
        var max = new DateTime(now.Year, now.Month, 1);
        if (picked > max) picked = max;
        anchor = (picked.Year, picked.Month);

        if (query.TryGetValue("period", out var p) && p.ToString() is var pv && (pv == "month" || pv == "ytd" || pv == "year"))
            period = pv;

        if (query.TryGetValue("sel", out var s) && !string.IsNullOrWhiteSpace(s))
        {
            var raw = s.ToString();
            if (raw.StartsWith("cat-") && long.TryParse(raw[4..], out var cid))
            {
                selectionKind = "category"; selectionId = cid;
            }
            else if (raw.StartsWith("grp-") && long.TryParse(raw[4..], out var gid))
            {
                selectionKind = "group"; selectionId = gid;
            }
            else if (raw.StartsWith("acct-") && long.TryParse(raw[5..], out var aid))
            {
                selectionKind = "account"; selectionId = aid;
            }
        }

        if (query.TryGetValue("acct", out var af) && long.TryParse(af, out var afl)) accountFilter = afl;
        if (query.TryGetValue("q", out var qs)) { searchInput = qs.ToString(); searchEffective = searchInput; }
        if (query.TryGetValue("amin", out var minRaw) && decimal.TryParse(minRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var minVal))
        { amountMin = minVal; amountMinInput = minRaw.ToString(); }
        if (query.TryGetValue("amax", out var maxRaw) && decimal.TryParse(maxRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var maxVal))
        { amountMax = maxVal; amountMaxInput = maxRaw.ToString(); }
        if (query.TryGetValue("g", out var g) && g.ToString() is var gv && (gv == "M" || gv == "Q" || gv == "Y" || gv == "D"))
            chartGranularity = gv;
        CoerceChartGranularityForSelection();
    }

    /// <summary>
    /// Account view exposes D/M; category, group and "all" expose M/Q/Y. Snap chartGranularity
    /// back to "M" whenever the current setting isn't valid for the active selection — happens
    /// after navigating between an account and a category, or after loading a URL whose g=
    /// value doesn't match its sel= scope.
    /// </summary>
    private void CoerceChartGranularityForSelection()
    {
        if (selectionKind == "account")
        {
            if (chartGranularity != "D" && chartGranularity != "M") chartGranularity = "M";
        }
        else
        {
            if (chartGranularity == "D") chartGranularity = "M";
        }
    }

    private void UpdateUrl() => PageState.ReplaceQuery(Navigation, new Dictionary<string, object?>
    {
        ["year"] = anchor.Year,
        ["month"] = anchor.Month,
        ["period"] = period == "month" ? null : period,
        ["sel"] = selectionKind switch
        {
            "category" => $"cat-{selectionId}",
            "group" => $"grp-{selectionId}",
            "account" => $"acct-{selectionId}",
            _ => null
        },
        ["acct"] = accountFilter?.ToString(),
        ["q"] = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        ["amin"] = amountMin?.ToString(CultureInfo.InvariantCulture),
        ["amax"] = amountMax?.ToString(CultureInfo.InvariantCulture),
        ["g"] = chartGranularity == "M" ? null : chartGranularity
    });

    private (int FromMonth, int ToMonth) PeriodRange => period switch
    {
        "year" => (1, 12),
        "ytd" => (1, anchor.Month),
        _ => (anchor.Month, anchor.Month)
    };

    private string AnchorHeading
    {
        get
        {
            var d = new DateTime(anchor.Year, anchor.Month, 1);
            return period switch
            {
                "year" => L["Heading_Year", anchor.Year].Value,
                "ytd" => L["Heading_YTD", d.ToString("MMMM yyyy")].Value,
                _ => d.ToString("MMMM yyyy")
            };
        }
    }

    private bool IsAtMaxAnchor
    {
        get
        {
            var now = DateTime.Now;
            if (period == "year") return anchor.Year >= now.Year;
            return anchor.Year > now.Year || (anchor.Year == now.Year && anchor.Month >= now.Month);
        }
    }

    private bool IsTodayAnchor
    {
        get
        {
            var now = DateTime.Now;
            return anchor.Year == now.Year && anchor.Month == now.Month;
        }
    }

    private async Task StepAnchor(int direction)
    {
        var dt = new DateTime(anchor.Year, anchor.Month, 1);
        dt = period == "year" ? dt.AddYears(direction) : dt.AddMonths(direction);
        var now = DateTime.Now;
        var max = new DateTime(now.Year, now.Month, 1);
        if (dt > max) dt = max;
        if (dt.Year < 1900) return;
        if (dt.Year == anchor.Year && dt.Month == anchor.Month) return;
        anchor = (dt.Year, dt.Month);
        UpdateUrl();
        await ReloadHighlightAsync();
        await JumpListToAnchorAsync();
    }

    private async Task GoToToday()
    {
        var now = DateTime.Now;
        if (anchor.Year == now.Year && anchor.Month == now.Month) return;
        anchor = (now.Year, now.Month);
        UpdateUrl();
        await ReloadHighlightAsync();
        await JumpListToAnchorAsync();
    }

    private async Task SetPeriod(string value)
    {
        if (period == value) return;
        period = value;
        UpdateUrl();
        await ReloadHighlightAsync();
        await JumpListToAnchorAsync();
    }

    /// <summary>
    /// Lightweight refresh when the anchor / period changes but the selection and filters
    /// don't. Rebuilds the tree (so its per-node period numbers update) and re-renders the
    /// chart highlight, but leaves the transaction list intact — the list is unfiltered by
    /// anchor, so its content doesn't change.
    /// </summary>
    private async Task ReloadHighlightAsync()
    {
        if (project == null) return;
        var (fm, tm) = PeriodRange;
        tree = await BrowseService.GetTreeAsync(ProjectId, anchor.Year, fm, tm);
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    private async Task SelectAll()
    {
        selectionKind = "all"; selectionId = null;
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

