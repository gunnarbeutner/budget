@page "/projects/{ProjectId:int}/browse"
@page "/projects/{ProjectId:int}"
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject BrowseService BrowseService
@inject PortfolioService Portfolio
@inject BudgetService BudgetService
@inject BudgetEntryService BudgetEntries
@inject TransactionQueryService TransactionQueries
@inject CategoryHierarchyService Hierarchy
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ProjectTimeState TimeState
@inject IStringLocalizer<Browse> L
@inject ClockService Clock
@inject BankLoginService BankLogins
@inject TransactionEditService Edits
@inject CategorizationService Categorization
@inject ManualTransactionService ManualBookings
@inject AccessScopeProvider AccessProvider
@inject IStringLocalizer<BrowseTreeRail> RailL
@inherits DataChangeAwareComponent

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">
        @L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]
    </p>
    return;
}

<ProjectPageHeader ProjectId="@ProjectId" ProjectName="@(project?.Name ?? "")" />

@* Transactions (Browse): the project shell's sidebar holds this page's account/category tree; the main column
   has the 48px toolbar (what is selected + balance) and the ledger list; the period selector and the search field it places
   render in the top bar. Below md the
   sidebar is an off-canvas sheet, opened from the title or the bottom bar. *@
<ProjectShell ProjectId="ProjectId" Active="ProjectTab.Browse" Tree="tree" @bind-RailOpen="railOpen" OnTransactions="SelectAll"
              TransactionsCurrent="@(selectionKind == "all")">
    <Rail>
        @if (tree == null)
        {
            <div aria-busy="true" class="px-3">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton skeleton-line" style="margin-left: @(i % 3 * 12)px;"></div>
                }
            </div>
        }
        else
        {
            <BrowseTreeRail Tree="tree"
                            SelectionKind="@selectionKind"
                            SelectionId="selectionId"
                            ShowAllRow="false"
                            @bind-ShowRelatedAccounts="showRelatedAccounts"
                            OnSelectAll="SelectAll"
                            OnSelectAccount="SelectAccount"
                            OnSelectAccountGroup="SelectAccountGroup"
                            OnSelectUncategorized="SelectUncategorized"
                            OnSelectCategory="SelectCategoryNode"
                            NodeMenu="NodeMenu"
                            OnNodeMenuPick="OnNodeMenuPickAsync"
                            RenamingNode="_structure?.RenamingNode"
                            OnRename="OnRenameNodeAsync"
                            CanDrag="CanDragNode"
                            OnDrop="OnDropNodeAsync"
                            @ref="_rail" />
        }
    </Rail>
    <ChildContent>
        <div class="page-toolbar browse-toolbar" data-testid="browse-toolbar">
            <div class="browse-ident" data-testid="browse-ident" data-ob-longpress="@(selectionKind == "account" ? "" : null)"
                 @oncontextmenu="OnHeaderContext" @oncontextmenu:preventDefault="@(selectionKind == "account")">
                <h1 class="browse-title">
                    <button type="button" class="browse-title-btn" @onclick="ToggleRail" title="@L["Aria_ToggleTree"]"
                            aria-expanded="@railOpen.ToString().ToLowerInvariant()">
                        <span>@SelectionName</span><i class="bi bi-chevron-down d-md-none ms-1" aria-hidden="true"></i>
                    </button>
                </h1>
                <div class="browse-sub">
                    @if (selectionKind == "account" && SelectedAccountNode is { } info)
                    {
                        var parts = 0;
                        @if (!string.IsNullOrWhiteSpace(info.Institution))
                        {
                            parts++;
                            <span data-testid="account-institution">@info.Institution</span>
                        }
                        @if (AccountDisplay.FormatIban(info.Iban) is { } ibanText)
                        {
                            @if (parts++ > 0) { <span> · </span> }
                            <button type="button" class="browse-iban-btn" data-testid="account-iban" title="@L["Header_CopyIban"]"
                                    @onclick="() => CopyAsync(AccountDisplay.CompactIban(info.Iban))">@ibanText</button>
                        }
                        @if (info.LastUpdatedUtc != null || info.Error != null)
                        {
                            @if (parts > 0) { <span> · </span> }
                            <span data-testid="account-last-updated">
                                @if (info.Error is { } err)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning me-1" title="@err" aria-label="@err" data-testid="account-error"></i>
                                }
                                @if (info.LastUpdatedUtc is { } at)
                                {
                                    <span>@L["Header_LastUpdated"] @AccountDisplay.FormatLastUpdated(at, Clock.Zone, Clock.UtcNow, CultureInfo.CurrentUICulture, L["Header_Today"], L["Header_Yesterday"])</span>
                                }
                                @if (info.SyncLoginId is { } loginId)
                                {
                                    <button type="button" class="btn btn-link p-0 ms-1 browse-sub-btn" data-testid="account-sync" disabled="@syncStarting"
                                            title="@L["Header_SyncNow"]" aria-label="@L["Header_SyncNow"]"
                                            @onclick="() => SyncAccountAsync(loginId)">
                                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                    </button>
                                }
                            </span>
                        }
                        @if (info.IsMoneyMoney)
                        {
                            <span class="browse-readonly ms-1" data-testid="browse-readonly" role="img" tabindex="0"
                                  title="@L["ReadOnly_MoneyMoney"]" aria-label="@L["ReadOnly_MoneyMoney"]"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                        }
                        @if (info.MarkedClosed)
                        {
                            <span class="badge text-bg-secondary ms-1" data-testid="account-closed">@L["Header_Closed"]</span>
                        }
                        @if (info.CanEnterTransactions && parts == 0)
                        {
                            parts++;
                            <span data-testid="account-manual">@L["Header_Manual"]</span>
                        }
                        @if (info.CanEnterTransactions && !info.MarkedClosed)
                        {
                            @if (parts > 0) { <span> · </span> }
                            <button type="button" class="btn btn-link p-0 browse-sub-link" data-testid="tx-add" @onclick="OpenAddBookingAsync">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["Header_AddBooking"]
                            </button>
                        }
                    }
                    else if (selectionKind == "accountgroup" && GroupAccounts() is { } members)
                    {
                        <span data-testid="group-account-count">@L[members.Count == 1 ? "Header_GroupAccounts_One" : "Header_GroupAccounts_Other", members.Count]</span>
                    }
                    else if (selectionKind != "account" && SelectionBudget is { } budget)
                    {
                        var avail = budget - SelectionSpent;
                        <span>@L["Header_Budget"] @Formatting.FormatMoneyDe(budget)</span>
                        <span> · @(SelectionIsIncome ? L["Header_Expected"] : L["Header_Available"])
                            <span class="@(avail < 0 && !SelectionIsIncome ? "money-neg" : "")">@Formatting.FormatMoneyDe(avail)</span>
                        </span>
                    }
                </div>
            </div>
            @* The view's actions share the title row: period sum, filter chips and toggles left of the balance. *@
            @if (tree != null)
            {
                <div class="browse-summary" data-testid="browse-summary" role="group">
                    @if (selectionKind == "account" && SelectedAccountNode is { } acct)
                    {
                        <span>@AnchorHeading: <span class="@(CurrencySums.AllNegative(acct.PeriodSums) ? "money-neg" : "")">@CurrencySums.Format(acct.PeriodSums, acct.Currency)</span></span>
                        @if (acct.PendingBalance is { } pending)
                        {
                            <span data-testid="account-pending">@L["Header_Pending"] @Formatting.FormatMoneyDe(pending, acct.Currency)</span>
                        }
                    }
                    @if (!string.IsNullOrEmpty(payeeEquals))
                    {
                        <span class="badge text-bg-secondary" data-testid="filter-payee">@L["Filter_Payee", payeeEquals]</span>
                    }
                    @if (HasActiveFilter)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="ClearFilters">@L["Filter_Clear"]</button>
                    }
                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none @(_filterOpen ? "fw-semibold" : "")" data-testid="filter-toggle" title="@L["Filter_Button"]"
                            aria-expanded="@_filterOpen.ToString().ToLowerInvariant()" aria-controls="browse-filter-panel" @onclick="() => _filterOpen = !_filterOpen">
                        <i class="bi @(_filterOpen || ActiveFilterCount > 0 ? "bi-funnel-fill" : "bi-funnel")" aria-hidden="true"></i><span class="browse-action-label"> @L["Filter_Button"]</span>
                        @if (ActiveFilterCount > 0)
                        {
                            <span class="ob-badge" data-testid="filter-count">@ActiveFilterCount</span>
                        }
                    </button>
                    @if (ShowSummaryStrip)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-testid="summary-toggle" title="@L["Summary_Button"]"
                                @onclick="ToggleSummaryAsync" aria-expanded="@((!summaryCollapsed).ToString().ToLowerInvariant())">
                            <i class="bi bi-layout-three-columns" aria-hidden="true"></i><span class="browse-action-label"> @L["Summary_Button"]</span>
                            <i class="bi @(summaryCollapsed ? "bi-chevron-down" : "bi-chevron-up")" aria-hidden="true"></i>
                        </button>
                    }
                    @if (txTotals is { Count: > 0 })
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-testid="mark-all-checked" @onclick="MarkAllCheckedAsync"
                                title="@L["MarkAll_Title"]">
                            <i class="bi bi-check2-all" aria-hidden="true"></i><span class="browse-action-label"> @L["MarkAll"]</span>
                        </button>
                    }
                    @if (chartBars != null && chartBars.Length > 0)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none"
                                @onclick="ToggleChartCollapsed"
                                aria-expanded="@((!chartCollapsed).ToString().ToLowerInvariant())"
                                aria-controls="browseChartScroll"
                                title="@(chartCollapsed ? L["Chart_Expand"] : L["Chart_Collapse"])">
                            <i class="bi bi-bar-chart" aria-hidden="true"></i><span class="browse-action-label"> @L["Chart_Button"]</span>
                            <i class="bi @(chartCollapsed ? "bi-chevron-down" : "bi-chevron-up")" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            }
            @if (ToolbarAmount is { } amount)
            {
                <span class="browse-balance @(CurrencySums.AllNegative(amount) ? "money-neg" : "")" data-testid="browse-balance">@CurrencySums.Format(amount, SumsBaseCurrency)</span>
                @if (selectionKind == "all" && uncategorizedPeriod is { } up && (up.Income != 0m || up.Spent != 0m))
                {
                    <span class="browse-balance-note" data-testid="browse-balance-uncategorized">@L["Header_InclUncategorized", Formatting.FormatMoneyDe(up.Income - up.Spent)]</span>
                }
            }
            @* The period selector and the search field both render into the top bar. *@
            <PeriodNav Anchor="anchor" Period="@period" RangeFrom="rangeFrom" RangeTo="rangeTo" ShowMonthPicker="true"
                       MinMonth="monthMin" MaxMonth="monthMax" OnChanged="OnPeriodChanged" OnRangeChanged="OnRangeChanged" />
            <SectionContent SectionName="@MainLayout.SearchSectionName">
                <label class="browse-search topbar-search mb-0 @(string.IsNullOrEmpty(searchInput) ? "" : "has-value")" title="@L["Filter_SearchPlaceholder"]">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" placeholder="@L["Filter_SearchPlaceholder"]" aria-label="@L["Filter_SearchPlaceholder"]" data-testid="tx-search"
                           value="@searchInput" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown" />
                </label>
            </SectionContent>
            @* The selection's actions as the toolbar's last row: above the list, never over it. *@
            @if (selected.Count > 0)
            {
                <div class="tx-actionbar" data-testid="action-bar" role="toolbar" aria-label="@L["Bar_Aria"]">
                    <span class="tx-actionbar-count" data-testid="action-bar-count">@L["Bar_Selected", selected.Count] · @CurrencySums.Format(selectionSums, SumsBaseCurrency)</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="action-category" @onclick="e => OpenPickerFromBar(e)">
                        <i class="bi bi-tag" aria-hidden="true"></i> @L["Bar_Category"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="action-note" @onclick="e => OpenNote(e.ClientX, e.ClientY)">
                        <i class="bi bi-sticky" aria-hidden="true"></i> @L["Bar_Note"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="action-check" @onclick="ToggleCheckSelectionAsync">
                        <i class="bi bi-check2-square" aria-hidden="true"></i> @L["Bar_Check"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="action-more" @onclick="e => OpenContextMenu(e.ClientX, e.ClientY)">
                        <i class="bi bi-three-dots" aria-hidden="true"></i> @L["Bar_More"]
                    </button>
                    <button type="button" class="btn btn-sm btn-link ms-auto" data-testid="action-clear" @onclick="ClearSelection">@L["Bar_Clear"]</button>
                </div>
            }
        </div>

        @if (RulesCategoryId is { } rulesCategory)
        {
            <RulesBar ProjectId="ProjectId" CategoryId="rulesCategory" CategoryName="@SelectionName"
                      PrefillPayee="@_rulesPrefill" PrefillToken="_rulesPrefillToken"
                      OnPreview="OnRulePreviewAsync" OnApplied="ReloadAsync" OnClose="CloseRulesAsync" />
        }

        @if (ShowSummaryStrip && !summaryCollapsed)
        {
            var (stripFrom, stripTo) = PeriodRange;
            <ProjectSummaryStrip ProjectId="ProjectId" Year="anchor.Year" FromMonth="stripFrom" ToMonth="stripTo"
                                 PeriodLabel="@AnchorHeading" NewCount="newCount" UncategorizedCount="tree!.UncategorizedCount"
                                 UncategorizedSpent="uncategorizedPeriod?.Spent ?? 0m" UncategorizedIncome="uncategorizedPeriod?.Income ?? 0m"
                                 Version="summaryVersion" OnPick="OnSummaryPickAsync" />
        }
        else if (selectionKind == "category" && SelectionBudget is { } lineBudget && tree != null)
        {
            var lineSpent = SelectionSpent;
            var lineStatus = SelectionIsIncome ? "success" : ProjectStatus.BarClass(lineSpent, lineBudget);
            <div class="category-budget-line" data-testid="category-budget-line">
                <span>@BudgetLineLabel <strong class="@(lineStatus == "danger" ? "money-neg" : "")">@Formatting.FormatMoneyDe(lineSpent)</strong>
                    @L["BudgetLine_Of", Formatting.FormatMoneyDe(lineBudget)]</span>
                <span class="ob-bar ob-bar-mini" aria-hidden="true"><span class="status-bg-@lineStatus" style="width: @ProjectStatus.BarWidth(lineSpent, lineBudget)"></span></span>
                <a href="@($"/projects/{ProjectId}/budgets")" data-testid="category-budget-link">@L["BudgetLine_Link"]</a>
            </div>
        }

        @if (selectionKind == "uncategorized" && tree != null && project != null)
        {
            <CategorySuggestPanel ProjectId="ProjectId" SelectedIds="selected" Current="_suggestions" ListCount="txTotals?.Count ?? 0"
                                  OnSuggestions="OnSuggestions" OnApplied="OnSuggestionsAppliedAsync" />
        }

        <div class="browse-head" data-testid="browse-head">
            @if (_filterOpen && tree != null)
            {
                <div id="browse-filter-panel" class="browse-filter-panel d-flex flex-wrap align-items-center gap-2 tx-filterbar" data-testid="filter-bar">
                    <div class="input-group input-group-sm filter-input-sm">
                        <span class="input-group-text">€ ≥</span>
                        <input type="number" class="form-control" step="1" min="0" aria-label="@L["Filter_AmountMin"]"
                               value="@amountMinInput" @onchange="OnAmountMinChanged" />
                    </div>
                    <div class="input-group input-group-sm filter-input-sm">
                        <span class="input-group-text">€ ≤</span>
                        <input type="number" class="form-control" step="1" min="0" aria-label="@L["Filter_AmountMax"]"
                               value="@amountMaxInput" @onchange="OnAmountMaxChanged" />
                    </div>
                    <select class="form-select form-select-sm filter-input-sm" aria-label="@L["Filter_Checked"]" data-testid="filter-checked"
                            value="@checkedFilter" @onchange="OnCheckedFilterChanged">
                        <option value="any">@L["Filter_CheckedAny"]</option>
                        <option value="yes">@L["Filter_CheckedYes"]</option>
                        <option value="no">@L["Filter_CheckedNo"]</option>
                    </select>
                    <select class="form-select form-select-sm filter-input-sm" aria-label="@L["Filter_Direction"]" data-testid="filter-direction"
                            value="@directionFilter" @onchange="OnDirectionFilterChanged">
                        <option value="any">@L["Filter_DirectionAny"]</option>
                        <option value="in">@L["Filter_Incoming"]</option>
                        <option value="out">@L["Filter_Outgoing"]</option>
                    </select>
                    @if (!IsAccountScope && tree.Accounts.Count > 1)
                    {
                        <select class="form-select form-select-sm filter-input-md" aria-label="@L["Filter_AnyAccount"]"
                                value="@(accountFilter?.ToString() ?? "")"
                                @onchange="OnAccountFilterChanged">
                            <option value="">@L["Filter_AnyAccount"]</option>
                            @foreach (var a in tree.Accounts)
                            {
                                <option @key="a.Id" value="@a.Id">@a.Name</option>
                            }
                        </select>
                    }
                    else if (IsAccountScope && pickerData is { } categoriesForFilter)
                    {
                        var chosen = categoriesForFilter.Options.FirstOrDefault(o => o.Id == categoryFilter);
                        <button type="button" class="form-select form-select-sm filter-input-md text-start text-truncate"
                                aria-label="@L["Filter_Category"]" aria-haspopup="dialog" title="@(chosen?.Path ?? L["Filter_AnyCategory"])"
                                data-testid="filter-category" @onclick="OpenFilterPickerAsync">
                            @(chosen?.Name ?? L["Filter_AnyCategory"])
                        </button>
                    }
                    <button type="button" class="ob-btn @(newOnly ? "active" : "")" data-testid="filter-new"
                            aria-pressed="@newOnly.ToString().ToLowerInvariant()" @onclick="ToggleNewOnly" title="@L["Filter_NewOnlyTitle"]">
                        <span class="tx-new-dot" aria-hidden="true"></span> @L["Filter_NewOnly"]
                    </button>
                    <button type="button" class="ob-btn @(pinFilters ? "active" : "")" data-testid="filter-pin"
                            aria-pressed="@pinFilters.ToString().ToLowerInvariant()" @onclick="TogglePin"
                            title="@(pinFilters ? L["Filter_PinOn"] : L["Filter_PinOff"])" aria-label="@L["Filter_Pin"]">
                        <i class="bi @(pinFilters ? "bi-pin-angle-fill" : "bi-pin-angle")" aria-hidden="true"></i>
                    </button>
                </div>
            }


            @if (tree == null)
            {
                <div class="browse-cards" aria-busy="true">
                    <div class="skeleton skeleton-line-lg" style="width: 40%;"></div>
                    <div class="skeleton skeleton-block mt-3"></div>
                </div>
            }
            else if (chartBars != null && chartBars.Length > 0 && !chartCollapsed)
            {
                <div class="browse-cards">
                    <div class="browse-chart-frame">
                        <div class="browse-chart-head">
                            <span class="browse-chart-title">@(chartIsBalance ? L["Chart_Balance"] : L["Chart_Amount"])</span>
                            <div class="segmented segmented-sm browse-chart-gran" role="group" aria-label="@L["Chart_AriaGranularity"]" data-testid="chart-granularity">
                                @if (IsAccountScope)
                                {
                                    <button type="button" class="btn @(chartGranularity == "D" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("D")'>@L["Chart_D"]</button>
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                }
                                else
                                {
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Q" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Q")'>@L["Chart_Q"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Y" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Y")'>@L["Chart_Y"]</button>
                                }
                            </div>
                        </div>
                        <div class="browse-chart">
                            <div id="browseChartScroll" class="browse-chart-scroll" data-testid="browse-chart-scroll">
                                <div class="browse-chart-canvas">
                                    <div class="browse-chart-window">
                                        <canvas id="browseChart" role="img" aria-label="@ChartAriaLabel" data-testid="browse-chart"></canvas>
                                    </div>
                                </div>
                            </div>
                            <canvas id="browseChartAxis" class="browse-chart-axis" aria-hidden="true"></canvas>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="browse-scroll tx-scroll">
            @if (tree != null)
            {
            @if (selectionKind == "account" && holdings is { } h)
            {
                <div class="browse-cards"><HoldingsCard Holdings="h" /></div>
            }


            @if (txTotals == null)
            {
                <div aria-busy="true" class="browse-cards">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="skeleton skeleton-line"></div>
                    }
                </div>
            }
            else if (txTotals.Count == 0)
            {
                <div class="text-body-secondary py-4 text-center">
                    <i class="bi bi-inbox" style="font-size: 1.6rem;" aria-hidden="true"></i>
                    <div data-testid="browse-empty">@(selectionKind == "uncategorized" && !HasActiveFilter ? L["Empty_AllCategorized"] : L["Empty_NoTransactions"])</div>
                </div>
            }
            else
            {
                <div class="tx-list" data-testid="tx-list">
                    <Virtualize @key="txListVersion" @ref="txVirtualize" ItemsProvider="LoadTxRowsAsync" Context="item" ItemSize="@itemSize">
                        <ItemContent>
                            @{
                                var row = item.Row;
                                var isSelected = selected.Contains(row.Id);
                                var isExpanded = expandedId == row.Id;
                                var showNew = row.IsNew && !viewedIds.Contains(row.Id);
                            }
                            <div class="tx-item @(isSelected ? "selected" : "") @(isExpanded ? "expanded" : "") @(row.IsPending ? "tx-item-pending" : "")" data-tx-id="@row.Id" data-testid="tx-item" @key="row.Id">
                                @if (item.ShowDay)
                                {
                                    <div class="tx-day" data-testid="tx-day">
                                        <span>@Clock.ToLocal(row.Date).ToString("dddd, dd.MM.yyyy")</span>
                                        @if (item.DayBalance is { } dayBalance)
                                        {
                                            <span class="tx-day-balance" data-testid="tx-day-balance">@Formatting.FormatMoneyDe(dayBalance, DayBalanceCurrency)</span>
                                        }
                                    </div>
                                }
                                <div class="tx-row @(cursorId == row.Id ? "tx-cursor" : "") @(row.Amount == 0 ? "text-body-secondary" : "")" data-testid="tx-row" title="@(row.IsPending ? L["Tx_PendingTitle"].Value : null)"
                                     aria-selected="@isSelected.ToString().ToLowerInvariant()"
                                     @onclick="e => OnRowClickAsync(item, e)"
                                     @oncontextmenu="e => OnRowContextAsync(item, e)" @oncontextmenu:preventDefault="true">
                                    <div class="tx-date-col">
                                        <span class="tx-date">@Clock.ToLocal(row.Date).ToString("dd.MM.yyyy")</span>
                                        @if (showCategoryColumn)
                                        {
                                            var hasCategory = !string.IsNullOrEmpty(row.CategoryName);
                                            var pillStyle = hasCategory ? CategoryColors.For(row.CategoryId ?? 0, row.CategoryColor).Style : null;
                                            @if (row.CanEdit && (hasCategory || row.Amount != 0))
                                            {
                                                <button type="button" class="cat-pill @(hasCategory ? "" : "empty")" style="@pillStyle" data-testid="tx-category"
                                                        title="@L["Tx_CategoryTitle"]" @onclick="e => OpenPickerFromRow(row, e)" @onclick:stopPropagation="true">
                                                    @(hasCategory ? row.CategoryName : L["Tx_NoCategory"])
                                                </button>
                                            }
                                            else if (hasCategory)
                                            {
                                                <span class="cat-pill" style="@pillStyle" data-testid="tx-category-label" title="@row.CategoryName">@row.CategoryName</span>
                                            }
                                        }
                                    </div>
                                    <div class="tx-payee">
                                        <div class="tx-line1">
                                            @if (showNew)
                                            {
                                                <span class="tx-new-dot" data-testid="tx-new-dot" title="@L["Tx_NewTitle"]" aria-label="@L["Tx_NewTitle"]"></span>
                                            }
                                            <span class="tx-name">@(row.Name ?? "")</span>
                                            @if (row.IsPending)
                                            {
                                                <span class="visually-hidden tx-pending">@L["Tx_Pending"]</span>
                                            }
                                            @if (row.IsSplitRemainder)
                                            {
                                                <span class="tx-flag" title="@L["Tx_SplitRemainderTitle"]">@L["Tx_SplitRemainder"]</span>
                                            }
                                            @if (row.IsSplitChild)
                                            {
                                                <span class="tx-flag" title="@L["Tx_SplitChildTitle"]">@L["Tx_SplitChild"]</span>
                                            }
                                            @if (row.SplitCheck)
                                            {
                                                <span class="tx-flag" data-testid="tx-split-check" title="@L["Tx_SplitCheckTitle"]">@L["Tx_SplitCheck"]</span>
                                            }
                                        </div>
                                        @{ var purpose = PurposeText.Clean(row.Purpose); }
                                        @if (!string.IsNullOrEmpty(purpose))
                                        {
                                            <div class="tx-purpose">@purpose</div>
                                        }
                                        @if (!string.IsNullOrEmpty(row.Note))
                                        {
                                            <div class="tx-comment" data-testid="tx-note"><i class="bi bi-sticky me-1" aria-hidden="true"></i>@row.Note</div>
                                        }
                                        @if (showCategoryColumn && row.CanEdit && string.IsNullOrEmpty(row.CategoryName) && row.Amount != 0
                                             && _suggestions.TryGetValue(row.Id, out var suggestion) && suggestion.Confidence >= SuggestionChip.InlineConfidence)
                                        {
                                            <SuggestionChip Suggestion="suggestion" OnAccept="() => AcceptSuggestionAsync(row, suggestion)"
                                                            Rule="_suggestionRules.GetValueOrDefault(row.Id)" OnAcceptWithRule="r => AcceptWithRuleAsync(row, suggestion, r)"
                                                            OnReject="() => RejectSuggestionAsync(row)" />
                                        }
                                    </div>
                                    <div class="tx-amount @(row.Amount < 0 ? "neg" : "")">@Formatting.FormatMoneyDe(row.Amount, row.Currency)</div>
                                    <input type="checkbox" class="tx-check" data-testid="tx-check" aria-label="@L["Tx_Checked"]"
                                           title="@(row.EditBlock == EditBlock.MoneyMoney ? L["Lock_MoneyMoney"].Value : null)"
                                           checked="@row.IsChecked" disabled="@(!row.CanEdit)"
                                           @onclick:stopPropagation="true" @onchange="() => SetCheckedForAsync(row.Id, !row.IsChecked)" />
                                </div>
                                @if (isExpanded)
                                {
                                    <TxDetails Row="row" Statement="expandedStatement" ShowAccount="showAccountColumn" Account="AccountNodeFor(row.AccountId)"
                                               OnNoteSave="note => SetNoteForAsync(row.Id, note)"
                                               OnShowSimilar="() => ShowSimilarAsync(row)"
                                               OnSuggest="() => SuggestForRowAsync(row)" HasSuggestion="_suggestions.ContainsKey(row.Id)"
                                               OnPickCategory="e => OpenPickerFromRow(row, e)"
                                               OnEditBooking="() => OpenEditBookingAsync(row)"
                                               OnCreateRule="e => CreateRuleFromAsync(row, e)"
                                               PickerData="pickerData" ProjectId="ProjectId"
                                               OffsetTargets="expandedOffsetTargets"
                                               OnCreateOffset="accountId => CreateOffsettingEntryAsync(row, accountId)"
                                               OnChanged="RefreshAfterEditAsync" />
                                }
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="tx-row">
                                <div class="tx-date-col"><div class="skeleton skeleton-line w-100"></div></div>
                                <div class="tx-payee"><div class="skeleton skeleton-line"></div></div>
                                <div class="tx-amount"></div>
                                <div></div>
                            </div>
                        </Placeholder>
                    </Virtualize>
                </div>

                <div class="tx-footer">
                    <span>@L["Footer_Total", txTotals.Count] · @L["Footer_Sum"] @CurrencySums.Format(txTotals.Sums, SumsBaseCurrency)</span>
                    <button type="button" class="btn btn-link btn-sm p-0" data-testid="shortcuts-open" @onclick="() => showShortcuts = true">
                        <i class="bi bi-keyboard" aria-hidden="true"></i> @L["Shortcuts_Link"]
                    </button>
                </div>
            }
            }
        </div>
    </ChildContent>
</ProjectShell>

@if (popup == PopupKind.Picker && pickerData is { } pickerModel)
{
    <CategoryPicker Data="pickerModel" CurrentCategoryId="popupCurrentCategory"
                    SuggestedCategoryId="popupSuggestion?.CategoryId"
                    SuggestedHint="@(popupSuggestion is { } ps ? $"{(int)Math.Round(ps.Confidence * 100)} %" : null)"
                    AllowRemove="@(_rulePickPayee == null)" X="popupX" Y="popupY" OnPick="PickCategoryAsync" OnClose="ClosePopup" />
}

@if (popup == PopupKind.FilterPicker && pickerData is { } filterPickerModel)
{
    <CategoryPicker Data="filterPickerModel" CurrentCategoryId="categoryFilter" RemoveLabel="@L["Filter_AnyCategory"]"
                    X="popupX" Y="popupY" OnPick="PickCategoryFilterAsync" OnClose="ClosePopup" />
}

@if (popup == PopupKind.Context)
{
    <ContextMenu Items="contextItems" X="popupX" Y="popupY" OnPick="OnContextPickAsync" OnClose="ClosePopup" />
}

@if (popup == PopupKind.Note)
{
    <NotePanel Initial="PopupNoteInitial" Count="popupTargets.Count" X="popupX" Y="popupY" OnSave="SaveNotePanelAsync" OnClose="ClosePopup" />
}

<ManualTxDialog Open="_manualTxOpen" AccountId="@(SelectedAccountNode?.Id ?? _manualTxRow?.AccountId ?? 0)"
                AccountCurrency="@(SelectedAccountNode?.Currency ?? _manualTxRow?.Currency)" Row="_manualTxRow" Categories="pickerData"
                OnClose="CloseBookingDialog" OnSaved="BookingSavedAsync" />

<UndoToasts Toasts="toasts" OnAction="OnToastAction" OnDismiss="DismissToast" />

@if (project != null)
{
    <SidebarStructure @ref="_structure" ProjectId="ProjectId" Tree="tree"
                      MenuPosition="() => _rail?.MenuPosition ?? (200, 200)"
                      OnChanged="OnStructureChangedAsync" OnMessage="OnStructureMessage" />
}

<Modal Show="@showShortcuts" Title="@L["Shortcuts_Title"]" OnClose="@(() => showShortcuts = false)">
    <ChildContent>
        <dl class="shortcut-list" data-testid="shortcuts-list">
            @foreach (var (keys, text) in ShortcutRows)
            {
                <dt><kbd>@keys</kbd></dt>
                <dd>@text</dd>
            }
        </dl>
    </ChildContent>
</Modal>

@code {
    [Parameter] public int ProjectId { get; set; }

