    private long? categoryFilter;
    private bool pinFilters;
    private string? payeeEquals;


    private Project? project;
    private bool notFound;

    // ---- summary strip (whole project, no filter) ----

    private int newCount;
    private int summaryVersion;
    private bool summaryCollapsed;
    private const string SummaryPrefScope = "browse-summary";

    private string BudgetLineLabel =>
        period == "month" && anchor == (Clock.NowLocal.Year, Clock.NowLocal.Month)
            ? L["BudgetLine_ThisMonth"] : L["BudgetLine", AnchorHeading];

    private bool ShowSummaryStrip => tree != null && selectionKind == "all" && !HasActiveFilter;

    private async Task ToggleSummaryAsync()
    {
        summaryCollapsed = !summaryCollapsed;
        try { await JS.InvokeVoidAsync("expandState.set", SummaryPrefScope, summaryCollapsed ? new[] { "collapsed" } : Array.Empty<string>()); }
        catch (JSDisconnectedException) { /* page left */ }
    }

    /// <summary>A summary tile was clicked: show the matching part of the list.</summary>
    private async Task OnSummaryPickAsync(string key)
    {
        switch (key)
