    private string period = "month";
    // First and last day of a custom range (period "range"); the list, chart and sidebar sums cover exactly these days.
    private DateOnly? rangeFrom, rangeTo;

    // Selection — "all" | "account" | "category" | "group".
    private string selectionKind = "all";
    private long? selectionId;

    // Filter state.
    private long? accountFilter;
    private string searchInput = "";
    private string searchEffective = "";
    private decimal? amountMin;
    private decimal? amountMax;
    private string amountMinInput = "";
    private string amountMaxInput = "";

    // Chart series: bucketed Spent for the selected node, spanning the source's full history
    // (earliest transaction → anchor bucket). Granularity picks the bucket width (M/Q/Y); the
