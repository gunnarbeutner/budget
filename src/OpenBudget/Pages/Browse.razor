    private decimal? SelectionBudget
    {
        get
        {
            if (tree == null) return null;
            if (selectionKind == "category" && selectionId is { } cid)
                return FindCategoryNode(tree.Categories, cid, CategoryItemType.Category)?.Budget;
            if (selectionKind == "group" && selectionId is { } gid)
            {
                var node = FindCategoryNode(tree.Categories, gid, CategoryItemType.Group);
                if (node == null) return null;
                // A group that's not itself a tracked budget entry has Budget == null even when
                // some sub-categories are tracked. Roll their budgets up so the header still
                // reads "Available / Budget" for the group selection — without this the labels
                // disappear and the header looks broken next to children that do show them.
                return node.Budget ?? SumDescendantBudgets(node);
            }
            return null;
        }
    }

    private static decimal? SumDescendantBudgets(BrowseCategoryNode node)
    {
        // Roll up budgets only when every budgeted descendant matches the parent's direction.
        // A "Gemeinsam" group that mixes income and expense kids has no single meaningful
        // budget — abs-summing both sides gives a misleading number, so bail out instead.
        decimal sum = 0m;
        bool any = false;
        foreach (var d in EnumerateBudgetedDescendants(node))
        {
            if (d.IsIncome != node.IsIncome) return null;
            sum += d.Budget!.Value;
            any = true;
        }
        return any ? sum : null;
    }

    private static IEnumerable<BrowseCategoryNode> EnumerateBudgetedDescendants(BrowseCategoryNode node)
    {
        foreach (var child in node.Children)
        {
            if (child.Budget.HasValue) yield return child;
            else foreach (var deeper in EnumerateBudgetedDescendants(child)) yield return deeper;
        }
    }

