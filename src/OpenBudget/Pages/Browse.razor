    /// <summary>The chart's text alternative: series, span, lowest, highest and latest value.</summary>
    private string ChartAriaLabel
    {
        get
        {
            if (chartBars is not { Length: > 0 } bars || chartBarStarts is not { Length: > 0 } starts) return "";
            var real = Enumerable.Range(0, bars.Length).Where(i => !chartIsBalance || starts[i] <= Clock.Today).ToArray();
            if (real.Length == 0) real = [0];
            var values = real.Select(i => bars[i].Value).ToArray();
            var fmt = chartGranularity == "D" ? "dd.MM.yyyy" : "MM.yyyy";
            var ci = System.Globalization.CultureInfo.InvariantCulture;
            return string.Format(L["Chart_AriaSummary"].Value,
                chartIsBalance ? L["Chart_Balance"].Value : L["Chart_Amount"].Value,
                starts[real[0]].ToString(fmt, ci), starts[real[^1]].ToString(fmt, ci),
                Formatting.FormatMoneyDe(values.Min()), Formatting.FormatMoneyDe(values.Max()),
                Formatting.FormatMoneyDe(values[^1]));
        }
    }

    private static BrowseCategoryNode? FindCategoryNode(IEnumerable<BrowseCategoryNode> nodes, long id, CategoryItemType type)
    {
        foreach (var n in nodes)
        {
            if (n.Id == id && n.ItemType == type) return n;
            var found = FindCategoryNode(n.Children, id, type);
            if (found != null) return found;
        }
        return null;
    }

    private async Task ComputeChartAsync()
    {
        // History series for the selected node, bucketed by chartGranularity. We support
        // category / group selections (chart of period spend signed by the source's
        // natural convention — expenses negative, refunds offsetting) and account
        // selections (signed net flow). "All" has no single meaningful chart yet.
        if (project == null || tree == null) { chartBars = null; return; }

        IReadOnlyCollection<long>? leaves = null;
        IReadOnlyCollection<long>? accounts = null;
        bool invertY = false;

        if (selectionKind == "category" || selectionKind == "group")
        {
            leaves = await ResolveSelectionLeavesAsync();
            if (leaves == null || leaves.Count == 0) { chartBars = null; return; }
            bool isIncome = false;
            if (selectionKind == "category" && selectionId is { } cidIncome)
                isIncome = FindCategoryNode(tree.Categories, cidIncome, CategoryItemType.Category)?.IsIncome ?? false;
            else if (selectionKind == "group" && selectionId is { } gidIncome)
                isIncome = FindCategoryNode(tree.Categories, gidIncome, CategoryItemType.Group)?.IsIncome ?? false;
            // Expense items invert the axis so spending grows upward (the values are still
            // negative — the tick labels read "−300 €"). Income items keep the natural axis.
            invertY = !isIncome;
        }
        else if (IsAccountScope && ResolveSelectionAccounts() is { Count: > 0 } ids)
        {
            accounts = ids;
            // Accounts use the natural axis: net inflow up, net outflow down.
        }
        else
        {
            // "all" selection — defer until we decide what aggregate makes sense.
            chartBars = null;
            return;
        }

        // The window spans the selected node's whole history — its earliest booking (or depot value)
        // through max(anchor, its latest booking); a daily window ends today. The selected period
        // only decides which bars are highlighted, and the chart scrolls to them.
        var (fm, tm) = PeriodRange;
        // Depots in a balance chart contribute their stored value history (portfolio_chart) instead of
        // their bookings; the remaining accounts walk back from today's balance minus the depots' value.
        var isAccountDaily = IsAccountScope && SelectionAccountBalance != null;
        var depotSeries = new List<DepotValueSeries>();
        decimal? bookingBalance = SelectionAccountBalance;
        DateTime? depotEarliest = null;
        if (isAccountDaily && accounts != null)
        {
            var history = await TransactionQueries.GetDepotValueHistoryAsync(project.OwnerUserId, accounts);
            if (history.Count > 0)
            {
                foreach (var (id, points) in history)
                {
                    var current = tree.Accounts.FirstOrDefault(a => a.Id == id)?.Balance ?? points[^1].Value;
                    depotSeries.Add(new DepotValueSeries(points, current));
                    bookingBalance -= current;
                    if (depotEarliest == null || points[0].Day < depotEarliest) depotEarliest = points[0].Day;
                }
                accounts = accounts.Where(id => !history.ContainsKey(id)).ToList();
            }
        }
        var (hlFrom, hlTo) = CurrentPeriod.Days;
        var highlight = (From: hlFrom.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc),
            ToExclusive: hlTo.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc));
        DateTime? scopeEarliest = null, scopeLatest = null;
        if (leaves != null || accounts is { Count: > 0 })
            (scopeEarliest, scopeLatest) = await TransactionQueries.GetScopeDateRangeAsync(
                project.OwnerUserId, leaves, accounts);
        if (depotEarliest is { } de && (scopeEarliest == null || de < scopeEarliest)) scopeEarliest = de;
        if (scopeEarliest == null) { chartBars = null; return; }

        var today = Clock.Today;
        // The chart reaches the selected period's last month, but not past today's month unless
        // the anchor month itself lies beyond it; a daily chart always reaches today.
        var todayMonth = new DateTime(today.Year, today.Month, 1);
        var anchorDate = new DateTime(hlTo.Year, hlTo.Month, 1);
        if (anchorDate > todayMonth) anchorDate = todayMonth;
        var anchorMonth = new DateTime(anchor.Year, anchor.Month, 1);
        if (anchorMonth > anchorDate) anchorDate = anchorMonth;
        if (chartGranularity == "D" && todayMonth > anchorDate) anchorDate = todayMonth;
        var earliest = scopeEarliest.Value;
        var rightEdge = scopeLatest is { } lt && lt > anchorDate
            ? new DateTime(lt.Year, lt.Month, 1)
            : anchorDate;
        if (chartGranularity == "D" && earliest > today) earliest = today;
        // rightEdge is a month start, earliest a day within its month
        if (rightEdge < new DateTime(earliest.Year, earliest.Month, 1)) { chartBars = null; return; }
        DateTime? lastDay = chartGranularity == "D" ? today : null;
        var (windowStart, windowEndExclusive, _, _, _) = BrowseChart.ResolveChartWindow(earliest, rightEdge, chartGranularity, lastDay);

        // For the account-D running-balance pass below we need every transaction between the
        // chart's right edge and "today" so we can back-compute the closing balance at the
        // end of the window. Extend only the query window — bucketing still discards anything
        // past windowEndExclusive via the standard bounds check.
        var queryEndExclusive = windowEndExclusive;
        // Accounts and account groups chart their balance over time (end of each day / month), walked back from
        // today's balance; the query has to reach today for that.
        if (isAccountDaily)
        {
            var tomorrow = Clock.Today.AddDays(1);
            if (tomorrow > queryEndExclusive) queryEndExclusive = tomorrow;
        }
        var raw = await TransactionQueries.GetRawByDateRangeAsync(
            project.OwnerUserId, leaves, accounts, windowStart, queryEndExclusive);

        // Bucketing, anchor-period highlighting, and the account-daily running-balance back-walk
        // all live in BrowseChart.BuildChartSeries (pure + unit-tested); the page just feeds it
        // the resolved window inputs and the fetched rows.
        var chart = BrowseChart.BuildChartSeries(
            earliest, rightEdge, chartGranularity,
            anchor.Year, fm, tm,
            invertY, isAccountDaily,
            raw, bookingBalance, depotSeries, Clock.Today, highlight, lastDay);
        chartBarMonths = chart.BarMonths;
        chartInvertY = chart.InvertY;
        chartIsBalance = isAccountDaily;
        chartBarStarts = chart.BarStarts;
        chartBudget = leaves != null ? await ComputeChartBudgetAsync(chart.BarMonths) : null;
        chartBars = chart.Bars;
    }

    private async Task<decimal?[]?> ComputeChartBudgetAsync((int Year, int Month)[] barMonths)
    {
        if (project == null || selectionId is not { } id || chartGranularity == "D") return null;
        var itemType = selectionKind == "group" ? CategoryItemType.Group : CategoryItemType.Category;
        var budgets = (await BudgetEntries.GetBudgetsForProjectAsync(project.Id)).Where(b => b.IsActive).ToList();
        if (budgets.Count == 0) return null;
        var hierarchy = await Hierarchy.GetAllCategoriesWithChildCountsAsync(project.OwnerUserId);
        // signed like the bars: income budgets positive, expense budgets negative, a group netting both
        var incomeItems = await BudgetService.GetIncomeItemsForProjectAsync(project.Id);
        var byYear = new Dictionary<int, decimal[]>();
        foreach (var b in budgets)
        {
            var stored = b.MonthlyEntries.ToDictionary(e => (e.CategoryId, e.ItemType),
                e => Enumerable.Range(1, 12).Select(e.GetMonthAmount).ToArray());
            if (BrowseChart.BudgetMonthsFor(id, itemType, stored, hierarchy, incomeItems.Contains) is { } months)
                byYear.TryAdd(b.Year, months);
        }
        return BrowseChart.BuildBudgetSeries(barMonths, chartGranularity, byYear);
    }


    private async Task RenderChartAsync()
    {
        if (chartBars == null || chartBarStarts == null) return;
        selfRef ??= DotNetObjectReference.Create(this);
        var noAnimate = chartSkipAnimation;
        chartSkipAnimation = false;
        var ci = System.Globalization.CultureInfo.CurrentUICulture;
        var data = new
        {
            labels = chartBars.Select(b => b.Label).ToArray(),
            values = chartBars.Select(b => (double)b.Value).ToArray(),
            anchors = chartBars.Select(b => b.IsAnchor).ToArray(),
            starts = chartBarStarts.Select(d => d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)).ToArray(),
            monthNames = ci.DateTimeFormat.AbbreviatedMonthNames.Take(12).Select(n => n.TrimEnd('.')).ToArray(),
            today = Clock.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            granularity = chartGranularity,
            invertY = chartInvertY,
            balance = chartIsBalance,
            noAnimate,
            budget = chartBudget?.Select(b => b is { } v ? (double?)v : null).ToArray(),
            budgetLabel = L["Chart_Budget"].Value,
        };
        try
        {
            await JS.InvokeVoidAsync("renderBrowseChart", "browseChart", data, selfRef);
        }
        catch (JSDisconnectedException) { /* page navigation in flight */ }
    }

