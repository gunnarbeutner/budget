        if (tree != null && key.Length > 4 && long.TryParse(key[4..], out var id))
        {
            var type = key.StartsWith("grp-", StringComparison.Ordinal) ? CategoryItemType.Group : CategoryItemType.Category;
            if (FindCategoryNode(tree.Categories, id, type) is { } node) await SelectCategoryNode(node);
        }
    }

    // Tree + tx totals (count + sum across the active filter, refreshed on filter change).
    // The list rows themselves are streamed by <Virtualize> via LoadTxRowsAsync.
    private BrowseTree? tree;
    private (int Count, decimal Sum)? txTotals;
    // Live holdings for the selected depot account; null whenever the selection isn't a
    // portfolio account (or it holds nothing). Drives the holdings card above the tx list.
    private AccountHoldings? holdings;
    private Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize<TxListItem>? txVirtualize;
    // Approximate row height in CSS pixels — drives Virtualize's spacer math and the bar-click
    // scroll-jump (offset = newerCount * itemSize). Real rows vary a few px either way; the
    // post-load scrollIntoView fine-tunes the final position.
    private const float itemSize = 62f;

    // URL state.
    private (int Year, int Month) anchor;
    private string period = "month";

    // Selection — "all" | "account" | "category" | "group".
    private string selectionKind = "all";
    private long? selectionId;

    // Filter state.
    private long? accountFilter;
    private string searchInput = "";
    private string searchEffective = "";
    private decimal? amountMin;
    private decimal? amountMax;
    private string amountMinInput = "";
    private string amountMaxInput = "";

    // Chart series: bucketed Spent for the selected node, spanning the source's full history
    // (earliest transaction → anchor bucket). Granularity picks the bucket width (M/Q/Y); the
    // anchor bucket is highlighted and the canvas auto-scrolls to it.
    private (string Label, decimal Value, bool IsAnchor)[]? chartBars;
    // Each chart bar's start month, in (Year, Month) tuples. Used by OnChartBarClicked to
    // translate the bar index back into an anchor date.
    private (int Year, int Month)[]? chartBarMonths;
    private string chartGranularity = "M";
    /// <summary>The user chose the monthly history for an account balance (the default there is daily over the shown period).</summary>
    private bool chartMonthlyPicked;
    // Y-axis inversion: true for expense categories/groups so the bars still "grow upwards"
    // visually even though their underlying values are negative (the tick labels honestly
    // read "−300 €"). Income categories and accounts use the natural axis where positive
    // goes up and negative goes down.
    private bool chartInvertY;
    // Accounts and account groups chart their balance over time as a line (like MoneyMoney's header chart);
    // categories keep the bars of their period sums.
    private bool chartIsBalance;

    // JS ↔ Blazor bridge for chart bar clicks. Allocated once per page lifetime; the chart
    // re-render hands the same reference each time so click events route back to us.
    private DotNetObjectReference<Browse>? selfRef;

    // Defer JS interop until after the first browser render. OnInitializedAsync runs during
    // server prerender where JS calls are illegal — so we mark the chart dirty and let
    // OnAfterRenderAsync push it to the browser.
    private bool chartDirty;
    // Set by OnChartBarClicked so the next chart render skips the grow-from-zero animation
    // — animating while the user just clicked a bar feels jarring. Cleared after each render.
    private bool chartSkipAnimation;
    // User-driven collapse of the chart row to reclaim vertical space. The chart canvas is
    // removed from the DOM when collapsed, so expanding re-renders via the chartDirty path.
    private bool chartCollapsed = true;

    // Rail accounts section hides accounts that aren't explicitly assigned to the project
    // by default; the toggle below the list flips this when the user wants to see related
    // accounts (those with transactions in tracked categories but no direct assignment).
    private bool showRelatedAccounts;

    // Mobile-only: the left rail is hidden by default and slides in as a drawer when
    // toggled. On lg+ the rail is part of the grid and this flag is ignored (CSS keeps
    // .browse-rail visible regardless of .open). Closing happens on backdrop click, the X
    // button, or whenever the user picks a tree node — auto-closing on selection so they
    // immediately see the transactions on the right.
    private bool railOpen;

    private void ToggleRail() => railOpen = !railOpen;

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            // Best-effort: free the Chart.js instance JS-side so navigating away doesn't leave it
            // (and the onClick closure capturing selfRef) in window.chartInstances until the canvas
            // id is reused. Fire-and-forget because Dispose is synchronous; swallow the cases where
            // JS is unreachable (circuit already gone, or server-side prerender disposal).
            _ = DestroyChartAsync();
            _ = DetachShortcutsAsync();
            selfRef?.Dispose();
            foreach (var cts in toastTimers.Values) cts.Cancel();
        }
        base.Dispose(disposing);
    }

    private async Task DestroyChartAsync()
    {
        try { await JS.InvokeVoidAsync("destroyChart", "browseChart"); }
        catch (JSDisconnectedException) { /* no-op: circuit already gone */ }
        catch (InvalidOperationException) { /* no-op: JS unreachable (prerender disposal) */ }
    }

    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.ImportedData or DataArea.Sources => project != null && change.SourceId == project.SourceId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override async Task ReloadAfterChangeAsync()
    {
        summaryVersion++;
        if (project != null)
            (monthMin, monthMax) = await BudgetService.GetMonthBoundsForProjectAsync(ProjectId);
        await ReloadAsync();
    }

    // Debounce search keystrokes — we throttle by token instead of timer/JS interop.
    private long searchToken;

    // The selectable month window for *this project's* tracked categories (first..last transaction;
    // the latter may be in the future — pending rows). Bounds the navigator to the project's own data
    // rather than the whole source, and stays stable across the in-project category/account selection.
    // Null until loaded / when the project has no transactions, in which case EffectiveMin/Max fall
    // back to [1900-01 .. current month].
    private (int Year, int Month)? monthMin;
    private (int Year, int Month)? monthMax;
    private (int Year, int Month) EffectiveMin => monthMin ?? (1900, 1);
    private (int Year, int Month) EffectiveMax => monthMax ?? (Clock.NowLocal.Year, Clock.NowLocal.Month);

    // Guards the per-project load so it runs once on first render and again only when the
    // {ProjectId} route param changes — i.e. a client-side switch via the header's project
    // picker, where the component is reused and OnInitializedAsync would not re-run.
    private int _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        ResetForProjectSwitch();
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) { notFound = true; return; }
        (monthMin, monthMax) = await BudgetService.GetMonthBoundsForProjectAsync(ProjectId);
        ReadStateFromQuery();
        await ReloadAsync();
    }

    // On a client-side switch the component is reused, so reset all per-project view state to its
    // initial values before re-reading the (filter-less) switch URL — otherwise the previous
    // project's selection/filters/chart would linger.
    private void ResetForProjectSwitch()
    {
        notFound = false;
        tree = null; txTotals = null; holdings = null; chartBars = null; chartBarMonths = null;
        selectionKind = "all"; selectionId = null;
        accountFilter = null;
        searchInput = ""; searchEffective = "";
        amountMin = null; amountMax = null; amountMinInput = ""; amountMaxInput = "";
        chartGranularity = "M"; chartMonthlyPicked = false;
        showRelatedAccounts = false; railOpen = false; chartCollapsed = true;
        periodFilter = PeriodFilter.All; customFrom = null; customTo = null;
        checkedFilter = "any"; directionFilter = "any"; newOnly = false; categoryFilter = null; pinFilters = false;
        ResetSelectionState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The initial pipeline (OnInitializedAsync → ReloadAsync) computes chart data but
        // can't push it to JS during prerender. Flush any pending chart here, then on every
        // subsequent state change that flips chartDirty.
        if (chartDirty)
        {
            chartDirty = false;
            await RenderChartAsync();
        }
        if (firstRender)
        {
            await AttachShortcutsAsync();
            try
            {
                if ((await JS.InvokeAsync<string[]>("expandState.get", SummaryPrefScope)).Contains("collapsed"))
                {
                    summaryCollapsed = true;
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException) { /* page left */ }
        }
    }

    private void ReadStateFromQuery()
    {
        var now = Clock.NowLocal;
        // Seed from the remembered selection (survives a detour through Budgets/Cashflow),
        // falling back to the current month on a fresh session.
        anchor = (TimeState.Year ?? now.Year, TimeState.Month ?? now.Month);
        period = TimeState.Period ?? "month";
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("year", out var y) && int.TryParse(y, out var py) && py >= 1900)
            anchor.Year = py;
        if (query.TryGetValue("month", out var m) && int.TryParse(m, out var pm) && pm is >= 1 and <= 12)
            anchor.Month = pm;
        // Clamp into the source's [first..last transaction] month window.
        anchor = Anchoring.Clamp(anchor, EffectiveMin, EffectiveMax);

        if (query.TryGetValue("period", out var p) && p.ToString() is var pv && (pv == "month" || pv == "ytd" || pv == "year"))
            period = pv;

        RememberTimeState();

        if (query.TryGetValue("sel", out var s) && !string.IsNullOrWhiteSpace(s))
        {
            var raw = s.ToString();
            if (raw.StartsWith("cat-") && long.TryParse(raw[4..], out var cid))
            {
                selectionKind = "category"; selectionId = cid;
            }
            else if (raw.StartsWith("grp-") && long.TryParse(raw[4..], out var gid))
            {
                selectionKind = "group"; selectionId = gid;
            }
            else if (raw.StartsWith("acct-") && long.TryParse(raw[5..], out var aid))
            {
                selectionKind = "account"; selectionId = aid;
            }
            else if (raw.StartsWith('g') && long.TryParse(raw[1..], out var agid))
            {
                selectionKind = "accountgroup"; selectionId = agid;
            }
            else if (raw == "uncategorized")
            {
                selectionKind = "uncategorized"; selectionId = null;
            }
            else if (raw == "securities")
            {
                selectionKind = "portfolio"; selectionId = null;
            }
        }

        if (query.TryGetValue("acct", out var af) && long.TryParse(af, out var afl)) accountFilter = afl;
        if (query.TryGetValue("q", out var qs)) { searchInput = qs.ToString(); searchEffective = searchInput; }
        if (query.TryGetValue("amin", out var minRaw) && decimal.TryParse(minRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var minVal))
        { amountMin = minVal; amountMinInput = minRaw.ToString(); }
        if (query.TryGetValue("amax", out var maxRaw) && decimal.TryParse(maxRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var maxVal))
        { amountMax = maxVal; amountMaxInput = maxRaw.ToString(); }
        if (query.TryGetValue("per", out var perRaw) && IsKnownPeriodKey(perRaw.ToString())) periodFilter = perRaw.ToString();
        if (query.TryGetValue("from", out var fromRaw) && DateOnly.TryParseExact(fromRaw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fromDate)) customFrom = fromDate;
        if (query.TryGetValue("to", out var toRaw) && DateOnly.TryParseExact(toRaw, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var toDate)) customTo = toDate;
        if (query.TryGetValue("chk", out var chkRaw) && chkRaw.ToString() is "yes" or "no") checkedFilter = chkRaw.ToString();
        if (query.TryGetValue("dir", out var dirRaw) && dirRaw.ToString() is "in" or "out") directionFilter = dirRaw.ToString();
        if (query.TryGetValue("new", out var newRaw) && newRaw.ToString() == "1") newOnly = true;
        if (query.TryGetValue("cat", out var catRaw) && long.TryParse(catRaw, out var catFilterId)) categoryFilter = catFilterId;
        if (query.TryGetValue("payee", out var payeeRaw) && !string.IsNullOrWhiteSpace(payeeRaw)) payeeEquals = payeeRaw.ToString();
        if (query.TryGetValue("pin", out var pinRaw) && pinRaw.ToString() == "1") pinFilters = true;
        if (query.TryGetValue("g", out var g) && g.ToString() is var gv && (gv == "M" || gv == "Q" || gv == "Y" || gv == "D"))
        {
            chartGranularity = gv;
            chartMonthlyPicked = gv == "M";
        }
        CoerceChartGranularityForSelection();
    }

    /// <summary>
    /// Account view exposes D/M; category, group and "all" expose M/Q/Y. Snap chartGranularity
    /// back to "M" whenever the current setting isn't valid for the active selection — happens
    /// after navigating between an account and a category, or after loading a URL whose g=
    /// value doesn't match its sel= scope.
    /// </summary>
    private void CoerceChartGranularityForSelection()
    {
        if (IsAccountScope)
        {
            // Balances default to daily points over the shown period; monthly history only when picked.
            if (chartGranularity != "D" && chartGranularity != "M") chartGranularity = "D";
            else if (chartGranularity == "M" && !chartMonthlyPicked) chartGranularity = "D";
        }
        else
        {
            if (chartGranularity == "D") chartGranularity = "M";
        }
    }

    private void UpdateUrl() => PageState.ReplaceQuery(Navigation, new Dictionary<string, object?>
    {
        ["year"] = anchor.Year,
        ["month"] = anchor.Month,
        ["period"] = period == "month" ? null : period,
        ["sel"] = selectionKind switch
        {
            "category" => $"cat-{selectionId}",
            "group" => $"grp-{selectionId}",
            "account" => $"acct-{selectionId}",
            "accountgroup" => $"g{selectionId}",
            "portfolio" => "securities",
            "uncategorized" => "uncategorized",
            _ => null
        },
        ["acct"] = accountFilter?.ToString(),
        ["q"] = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        ["amin"] = amountMin?.ToString(CultureInfo.InvariantCulture),
        ["amax"] = amountMax?.ToString(CultureInfo.InvariantCulture),
        ["g"] = chartGranularity == (IsAccountScope ? "D" : "M") ? null : chartGranularity,
        ["per"] = periodFilter == PeriodFilter.All ? null : periodFilter,
        ["from"] = periodFilter == PeriodFilter.Custom ? customFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : null,
        ["to"] = periodFilter == PeriodFilter.Custom ? customTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : null,
        ["chk"] = checkedFilter == "any" ? null : checkedFilter,
        ["dir"] = directionFilter == "any" ? null : directionFilter,
        ["new"] = newOnly ? "1" : null,
        ["cat"] = categoryFilter?.ToString(),
        ["pin"] = pinFilters ? "1" : null,
        ["payee"] = string.IsNullOrEmpty(payeeEquals) ? null : payeeEquals
    });

    private (int FromMonth, int ToMonth) PeriodRange => period switch
    {
        "year" => (1, 12),
        "ytd" => (1, anchor.Month),
        _ => (anchor.Month, anchor.Month)
    };

    private string AnchorHeading
    {
        get
        {
            var d = new DateTime(anchor.Year, anchor.Month, 1);
            return period switch
            {
                "year" => L["Heading_Year", anchor.Year].Value,
                "ytd" => L["Heading_YTD", d.ToString("MMMM yyyy")].Value,
                _ => d.ToString("MMMM yyyy")
            };
        }
    }

    private async Task OnPeriodChanged((int Year, int Month, string Period) sel)
    {
        if (sel.Year == anchor.Year && sel.Month == anchor.Month && sel.Period == period) return;
        anchor = (sel.Year, sel.Month);
        period = sel.Period;
        RememberTimeState();
        UpdateUrl();
        await ReloadHighlightAsync();
        await JumpListToAnchorAsync();
    }

    private void RememberTimeState()
    {
        TimeState.Year = anchor.Year;
        TimeState.Month = anchor.Month;
        TimeState.Period = period;
    }

    /// <summary>
    /// Lightweight refresh when the anchor / period changes but the selection and filters
    /// don't. Rebuilds the tree (so its per-node period numbers update) and re-renders the
    /// chart highlight, but leaves the transaction list intact — the list is unfiltered by
    /// anchor, so its content doesn't change.
    /// </summary>
    private async Task ReloadHighlightAsync()
    {
        if (project == null) return;
        var (fm, tm) = PeriodRange;
        tree = await BrowseService.GetTreeAsync(ProjectId, anchor.Year, fm, tm);
        if (ActiveFilterCount > 0) _filterOpen = true;
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    private async Task SelectAll()
    {
        selectionKind = "all"; selectionId = null;
        ResetTransientFilters();
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SelectAccount(long id)
    {
        selectionKind = "account"; selectionId = id;
        ResetTransientFilters();
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    // Portfolio (depot) accounts in the rail. The combined "All securities" view aggregates these.
    private List<long> PortfolioAccountIds() =>
        tree?.Accounts.Where(a => a.IsPortfolio).Select(a => a.Id).ToList() ?? new List<long>();

    private async Task SelectPortfolio()
    {
        selectionKind = "portfolio"; selectionId = null;
        ResetTransientFilters();
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SelectUncategorized()
    {
        selectionKind = "uncategorized"; selectionId = null;
        ResetTransientFilters();
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SelectCategoryNode(BrowseCategoryNode n)
    {
        selectionKind = n.ItemType == CategoryItemType.Category ? "category" : "group";
        selectionId = n.Id;
        ResetTransientFilters();
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SetChartGranularity(string g)
    {
        if (chartGranularity == g) return;
        chartGranularity = g;
        chartMonthlyPicked = g == "M";
        UpdateUrl();
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    private void ToggleChartCollapsed()
    {
        chartCollapsed = !chartCollapsed;
        // Coming out of collapsed mode the canvas was unmounted, so the existing Chart.js
        // instance is bound to a detached element. Re-render fresh; skip the animation so
        // it doesn't replay every time the user toggles.
        if (!chartCollapsed)
        {
            chartSkipAnimation = true;
            chartDirty = true;
        }
    }

    /// <summary>
    /// Invoked from JS when the user clicks a bar in the chart. <paramref name="barIndex"/>
    /// is the bar's position in <see cref="chartBars"/>; we map it back through
    /// <see cref="chartBarMonths"/> to set the anchor to that month and re-highlight.
    /// </summary>
    [JSInvokable]
    public async Task OnChartBarClicked(int barIndex)
    {
        if (chartBarMonths == null || project == null) return;
        if (barIndex < 0 || barIndex >= chartBarMonths.Length) return;
        var (y, m) = chartBarMonths[barIndex];
        bool anchorChanged = !(y == anchor.Year && m == anchor.Month);
        if (anchorChanged)
        {
            anchor = (y, m);
            chartSkipAnimation = true;
            UpdateUrl();
            await ReloadHighlightAsync();
        }
        await JumpListToAnchorAsync();
    }

    /// <summary>
    /// Scroll the virtualized tx list to the latest transaction at-or-before the current
    /// anchor period. Hands JS an approximate pixel offset (<c>newerCount * itemSize</c>);
    /// after Virtualize loads the items at that scroll position, the JS helper snaps the
    /// first <c>.in-period</c> row to the top.
    /// </summary>
    private async Task JumpListToAnchorAsync()
    {
        if (project == null) return;
        var (_, tm) = PeriodRange;
        var periodEndExclusive = new DateTime(anchor.Year, tm, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(1);
        var newerCount = await TransactionQueries.CountNewerThanAsync(
            await BuildTransactionQueryAsync(0, 1), periodEndExclusive);
        try { await JS.InvokeVoidAsync("scrollListToTxOffset", newerCount * itemSize); }
        catch (JSDisconnectedException) { /* navigation in flight */ }
    }

    private async Task<TransactionQuery> BuildTransactionQueryAsync(int skip = 0, int take = 50, bool newOnlyOverride = false) => new()
    {
        SourceId = project!.SourceId,
        UncategorizedOnly = selectionKind == "uncategorized",
        CategoryLeafIds = categoryFilter is { } cf && IsAccountScope ? new[] { cf } : await ResolveSelectionLeavesAsync(),
        AccountIds = ResolveSelectionAccounts(),
        SearchText = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        MinAbsAmount = amountMin,
        MaxAbsAmount = amountMax,
        Checked = checkedFilter switch { "yes" => true, "no" => false, _ => null },
        Direction = directionFilter switch { "in" => AmountDirection.Incoming, "out" => AmountDirection.Outgoing, _ => AmountDirection.Any },
        NewOnly = newOnly || newOnlyOverride,
        FromUtc = PeriodBoundsUtc.From,
        ToUtcExclusive = PeriodBoundsUtc.ToExclusive,
        PayeeEquals = payeeEquals,
        Skip = skip,
        Take = take
    };

    private async ValueTask<Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<TxListItem>> LoadTxRowsAsync(
        Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderRequest request)
    {
        if (project == null || tree == null)
            return new(Array.Empty<TxListItem>(), 0);
        // One row before the window (when there is one) tells whether the first row starts a new day.
        var lead = request.StartIndex > 0 ? 1 : 0;
        var q = await BuildTransactionQueryAsync(request.StartIndex - lead, request.Count + lead);
        var result = await TransactionQueries.QueryAsync(q, request.CancellationToken);

        var running = RunningBalance.Applies(IsAccountScope, SelectionAccountBalance != null, HasActiveFilter)
            ? await EnsureRunningBalanceAsync(request.CancellationToken)
            : null;
        var items = new List<TxListItem>(result.Rows.Count);
        DateOnly? previousDay = lead == 1 && result.Rows.Count > 0 ? ToLocalDay(result.Rows[0].Date) : null;
        for (var i = lead; i < result.Rows.Count; i++)
        {
            var row = result.Rows[i];
            var index = request.StartIndex - lead + i;
            var day = ToLocalDay(row.Date);
            var showDay = previousDay != day;
            decimal? dayBalance = showDay && running != null ? running.AtEndOf(day) : null;
            previousDay = day;
            rowIndex[row.Id] = index;
            rowCache[row.Id] = row;
            items.Add(new TxListItem(row, index, showDay, day, dayBalance));
        }
        return new(items, result.TotalCount);
    }

    // The handler returns at once (so the render that follows always carries the text the user has typed so far and
    // never overwrites keystrokes that are still in flight); the reload itself waits for a pause in typing.
    private void OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? "";
        _ = DebounceSearchAsync(++searchToken);
    }

    private async Task DebounceSearchAsync(long token)
    {
        try
        {
            await Task.Delay(250);
            await InvokeAsync(async () =>
            {
                if (token != searchToken || searchEffective == searchInput) return;
                searchEffective = searchInput;
                UpdateUrl();
                await ReloadTransactionsAsync();
            });
        }
        catch (ObjectDisposedException) { /* page left while waiting */ }
    }

    private async Task OnAccountFilterChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        accountFilter = long.TryParse(v, out var af) ? af : null;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

