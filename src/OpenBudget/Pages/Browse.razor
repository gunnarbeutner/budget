@page "/projects/{ProjectId:int}/browse"
@using System.Globalization
@using OpenBudget.Services
@using OpenBudget.Models
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@inject BrowseService BrowseService
@inject PortfolioService Portfolio
@inject BudgetService BudgetService
@inject TransactionQueryService TransactionQueries
@inject CategoryHierarchyService Hierarchy
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ProjectTimeState TimeState
@inject IStringLocalizer<Browse> L
@inject ClockService Clock
@inherits DataChangeAwareComponent

<PageTitle>@(project?.Name is { Length: > 0 } n ? L["PageTitle_WithProject", n] : L["PageTitle"])</PageTitle>

@if (notFound)
{
    <PageHeader Title="@L["NotFound_Heading"]" />
    <p class="text-body-secondary">
        @L["NotFound_Body_Before"]<a href="/">@L["NotFound_Body_LinkText"]</a>@L["NotFound_Body_After"]
    </p>
    return;
}

<ProjectPageHeader ProjectId="@ProjectId" ProjectName="@(project?.Name ?? "")"
                   Active="ProjectTab.Browse"
                   Year="anchor.Year" Month="anchor.Month" Period="@period" />

@* Shared period nav, sticky so the user can re-anchor while scrolling a long tx list.
   The mobile-only left-rail toggle rides in the Leading slot (on lg+ the rail is part of
   the grid; below lg it slides in as a drawer, opened via this button). *@
<PeriodNav Anchor="anchor" Period="@period" ShowMonthPicker="true"
           MinMonth="monthMin" MaxMonth="monthMax" OnChanged="OnPeriodChanged">
    <Leading>
        <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none"
                @onclick="ToggleRail" aria-label="@L["Aria_ToggleTree"]" aria-expanded="@railOpen.ToString().ToLower()">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
    </Leading>
</PeriodNav>

<div class="browse-layout">
    @if (railOpen)
    {
        <div class="browse-backdrop d-lg-none" @onclick="CloseRail" aria-hidden="true"></div>
    }
    <aside class="browse-rail @(railOpen ? "open" : "")" aria-label="@L["Aria_Tree"]">
        <div class="browse-rail-header d-lg-none">
            <span class="fw-semibold">@L["Tree_Heading"]</span>
            <button type="button" class="btn-close" @onclick="CloseRail" aria-label="@L["Aria_Close"]"></button>
        </div>
        @if (tree == null)
        {
            <div aria-busy="true">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton skeleton-line" style="margin-left: @(i % 3 * 12)px;"></div>
                }
            </div>
        }
        else
        {
            <BrowseTreeRail Tree="tree"
                            SelectionKind="selectionKind"
                            SelectionId="selectionId"
                            @bind-ShowRelatedAccounts="showRelatedAccounts"
                            OnSelectAll="SelectAll"
                            OnSelectAccount="SelectAccount"
                            OnSelectPortfolio="SelectPortfolio"
                            OnSelectCategory="SelectCategoryNode" />
        }
    </aside>

    <section class="browse-main">
        @if (tree == null)
        {
            <div class="card mb-3" aria-busy="true">
                <div class="card-body">
                    <div class="skeleton skeleton-line-lg" style="width: 40%;"></div>
                    <div class="skeleton skeleton-block mt-3"></div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-4 browse-header-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h5 class="mb-1">@SelectionName</h5>
                            @if (selectionKind != "account" && SelectionBudget is { } budget)
                            {
                                var avail = budget - SelectionSpent;
                                @* Direction-specific framing: income that hasn't been received
                                   yet ("Expected") is a neutral forecast, not a deficit, so it
                                   reads in the muted parent color rather than red. Exceeding an
                                   income target still pops as green. Expense keeps the under/
                                   over budget green/red mapping. *@
                                string availClass = SelectionIsIncome
                                    ? (avail < 0 ? "text-success fw-semibold" : "fw-semibold")
                                    : (avail < 0 ? "text-danger fw-semibold" : "text-success fw-semibold");
                                <div class="text-body-secondary small">
                                    @(SelectionIsIncome ? L["Header_Expected"] : L["Header_Available"])
                                    <span class="@availClass">
                                        @Formatting.FormatMoney(avail)
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <div class="text-end">
                                @if (selectionKind == "account" && SelectionAccountBalance is { } balance)
                                {
                                    // Account header reads its current balance — independent of the
                                    // anchor period. The period net flow (incoming − outgoing) reads
                                    // as a smaller secondary line below.
                                    <div class="h4 mb-0 @(balance < 0 ? "text-danger" : "")">
                                        @Formatting.FormatMoney(balance, SelectionAccountCurrency ?? "EUR")
                                    </div>
                                    <div class="text-body-secondary small">@L["Header_CurrentBalance"]</div>
                                    <div class="text-body-secondary small">
                                        @AnchorHeading: <span class="@(SelectionAccountPeriodSum < 0 ? "text-danger" : "text-success")">
                                            @Formatting.FormatMoney(SelectionAccountPeriodSum, SelectionAccountCurrency ?? "EUR")
                                        </span>
                                    </div>
                                }
                                else if (selectionKind == "portfolio" && holdings is { } ph)
                                {
                                    <div class="h4 mb-0">@Formatting.FormatMoney(ph.TotalValue, ph.Currency)</div>
                                    <div class="text-body-secondary small">@L["Header_TotalValue"]</div>
                                }
                                else
                                {
                                    @* Income shows the received amount as a positive number;
                                       expense shows it as negative ("money gone"). Color follows
                                       the natural-direction sign of SelectionSpent so a refund
                                       on an expense reads green and a reversal on income reads red. *@
                                    <div class="h4 mb-0 @((SelectionSpent > 0) == SelectionIsIncome ? "text-success" : "text-danger")">
                                        @Formatting.FormatMoney(SelectionIsIncome ? SelectionSpent : -SelectionSpent)
                                    </div>
                                    @if (SelectionBudget is { } b2)
                                    {
                                        <div class="text-body-secondary small">@L["Header_Budget"] @Formatting.FormatMoney(b2)</div>
                                    }
                                }
                            </div>
                            @if (chartBars != null && chartBars.Length > 0)
                            {
                                <button type="button" class="btn btn-sm btn-link text-body-secondary p-0"
                                        @onclick="ToggleChartCollapsed"
                                        aria-expanded="@((!chartCollapsed).ToString().ToLower())"
                                        aria-controls="browseChartScroll"
                                        title="@(chartCollapsed ? L["Chart_Expand"] : L["Chart_Collapse"])"
                                        aria-label="@(chartCollapsed ? L["Chart_Expand"] : L["Chart_Collapse"])">
                                    <i class="bi @(chartCollapsed ? "bi-chevron-down" : "bi-chevron-up")" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @if (chartBars != null && chartBars.Length > 0 && !chartCollapsed)
                    {
                        <div class="d-flex gap-2 mt-3 align-items-start">
                            <div id="browseChartScroll" class="browse-chart-scroll flex-grow-1">
                                <div class="browse-chart" style="width: @(ChartCanvasWidthPx)px;">
                                    <canvas id="browseChart" style="height: 140px;"></canvas>
                                </div>
                            </div>
                            <div class="segmented segmented-vertical" role="group" aria-label="@L["Chart_AriaGranularity"]">
                                @if (selectionKind == "account")
                                {
                                    <button type="button" class="btn @(chartGranularity == "D" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("D")'>@L["Chart_D"]</button>
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                }
                                else
                                {
                                    <button type="button" class="btn @(chartGranularity == "M" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("M")'>@L["Chart_M"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Q" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Q")'>@L["Chart_Q"]</button>
                                    <button type="button" class="btn @(chartGranularity == "Y" ? "active" : "")"
                                            @onclick='() => SetChartGranularity("Y")'>@L["Chart_Y"]</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if ((selectionKind == "account" || selectionKind == "portfolio") && holdings is { } h)
            {
                var allocColors = ChartPalette.Templates(h.Allocation.Count);
                <div class="card mb-4 holdings-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">@L["Holdings_Title"]</h6>
                            <span class="text-body-secondary small">@L["Holdings_PositionCount", h.Rows.Count]</span>
                        </div>

                        @if (h.Allocation.Count > 0 && h.TotalValue > 0)
                        {
                            <div class="holdings-alloc-bar" role="img" aria-label="@L["Holdings_Allocation"]"
                                 style="display:flex;height:10px;border-radius:4px;overflow:hidden;">
                                @for (int i = 0; i < h.Allocation.Count; i++)
                                {
                                    var slice = h.Allocation[i];
                                    <div style="width:@CssPercent(slice.Fraction);background:@ChartPalette.WithAlpha(allocColors[i], 0.85);"
                                         title="@slice.Label @FormatPercent(slice.Fraction)"></div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-3 mt-2 mb-3 small">
                                @for (int i = 0; i < h.Allocation.Count; i++)
                                {
                                    var slice = h.Allocation[i];
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@ChartPalette.WithAlpha(allocColors[i], 0.85);"></span>
                                        @slice.Label
                                        <span class="text-body-secondary">@FormatPercent(slice.Fraction)</span>
                                    </span>
                                }
                            </div>
                        }

                        @if (h.Taxonomies.Count > 0)
                        {
                            var selectedTax = h.Taxonomies.FirstOrDefault(t => t.TaxonomyName == holdingsTaxonomy) ?? h.Taxonomies[0];
                            var ltColors = ChartPalette.Templates(selectedTax.Slices.Count);
                            <div class="mb-3">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="text-body-secondary small">@L["Holdings_LookThrough"]</span>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="@L["Holdings_LookThrough"]">
                                        @foreach (var t in h.Taxonomies)
                                        {
                                            <button type="button"
                                                    class="btn @(t.TaxonomyName == selectedTax.TaxonomyName ? "btn-primary" : "btn-outline-secondary")"
                                                    @onclick="() => SelectHoldingsTaxonomy(t.TaxonomyName)">@t.TaxonomyName</button>
                                        }
                                    </div>
                                </div>
                                <div class="holdings-alloc-bar" role="img" aria-label="@selectedTax.TaxonomyName"
                                     style="display:flex;height:10px;border-radius:4px;overflow:hidden;">
                                    @for (int i = 0; i < selectedTax.Slices.Count; i++)
                                    {
                                        var slice = selectedTax.Slices[i];
                                        <div style="width:@CssPercent(slice.Fraction);background:@ChartPalette.WithAlpha(ltColors[i], 0.85);"
                                             title="@slice.Label @FormatPercent(slice.Fraction)"></div>
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-3 mt-2 small">
                                    @for (int i = 0; i < selectedTax.Slices.Count; i++)
                                    {
                                        var slice = selectedTax.Slices[i];
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@ChartPalette.WithAlpha(ltColors[i], 0.85);"></span>
                                            @slice.Label
                                            <span class="text-body-secondary">@FormatPercent(slice.Fraction)</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm align-middle holdings-table mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Holdings_ColName"]</th>
                                        <th class="text-end">@L["Holdings_ColQuantity"]</th>
                                        <th class="text-end">@L["Holdings_ColPrice"]</th>
                                        <th class="text-end">@L["Holdings_ColValue"]</th>
                                        <th class="text-end">@L["Holdings_ColGain"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int ri = 0; ri < h.Rows.Count; ri++)
                                    {
                                        var row = h.Rows[ri];
                                        <tr @key="ri">
                                            <td>
                                                <div class="fw-semibold">@row.Name</div>
                                                <div class="text-body-secondary small">
                                                    <span class="badge text-bg-light border me-1">@row.AssetClassLabel</span>
                                                    @if (!string.IsNullOrEmpty(row.Isin)) { <span>@row.Isin</span> }
                                                </div>
                                            </td>
                                            <td class="text-end">@FormatQuantity(row.Quantity)</td>
                                            <td class="text-end">
                                                @(row.Price is { } p ? Formatting.FormatMoney(p, row.PriceCurrency ?? h.Currency) : "—")
                                            </td>
                                            <td class="text-end">
                                                <div>@Formatting.FormatMoney(row.Value, h.Currency)</div>
                                                <div class="text-body-secondary small">@FormatPercent(row.ShareOfAccount)</div>
                                            </td>
                                            <td class="text-end">
                                                @if (row.Gain is { } g)
                                                {
                                                    <span class="@(g < 0 ? "text-danger" : "text-success")">
                                                        @Formatting.FormatMoney(g, h.Currency)
                                                        @if (row.GainFraction is { } gf)
                                                        {
                                                            <span class="small">&nbsp;(@FormatPercent((decimal)gf))</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-semibold border-top">
                                        <td>@L["Holdings_Total"]</td>
                                        <td></td>
                                        <td></td>
                                        <td class="text-end">@Formatting.FormatMoney(h.TotalValue, h.Currency)</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <div class="input-group input-group-sm filter-input-lg">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" placeholder="@L["Filter_SearchPlaceholder"]"
                           value="@searchInput" @oninput="OnSearchInput" />
                </div>
                <div class="input-group input-group-sm filter-input-sm">
                    <span class="input-group-text">€ ≥</span>
                    <input type="number" class="form-control" step="1" min="0"
                           value="@amountMinInput" @onchange="OnAmountMinChanged" />
                </div>
                <div class="input-group input-group-sm filter-input-sm">
                    <span class="input-group-text">€ ≤</span>
                    <input type="number" class="form-control" step="1" min="0"
                           value="@amountMaxInput" @onchange="OnAmountMaxChanged" />
                </div>
                @if (selectionKind != "account" && tree.Accounts.Count > 1)
                {
                    <select class="form-select form-select-sm filter-input-md"
                            value="@(accountFilter?.ToString() ?? "")"
                            @onchange="OnAccountFilterChanged">
                        <option value="">@L["Filter_AnyAccount"]</option>
                        @foreach (var a in tree.Accounts)
                        {
                            <option @key="a.Id" value="@a.Id">@a.Name</option>
                        }
                    </select>
                }
                @if (HasActiveFilter)
                {
                    <button type="button" class="btn btn-sm btn-link" @onclick="ClearFilters">@L["Filter_Clear"]</button>
                }
            </div>

            <div class="tx-scroll">
            @if (txTotals == null)
            {
                <div aria-busy="true">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="skeleton skeleton-line"></div>
                    }
                </div>
            }
            else if (txTotals.Value.Count == 0)
            {
                <div class="text-body-secondary py-4 text-center">
                    <i class="bi bi-inbox" style="font-size: 1.6rem;" aria-hidden="true"></i>
                    <div>@L["Empty_NoTransactions"]</div>
                </div>
            }
            else
            {
                <div class="tx-list">
                    <Virtualize @ref="txVirtualize" ItemsProvider="LoadTxRowsAsync" Context="row" ItemSize="@itemSize">
                        <ItemContent>
                            @{ var inPeriod = IsInAnchorPeriod(row.Date); }
                            <div class="tx-row @(inPeriod ? "in-period" : "")">
                                <div class="tx-date-col">
                                    <div class="tx-date">@Clock.ToLocal(row.Date).ToString("dd.MM.yyyy")</div>
                                    @if (showCategoryColumn && !string.IsNullOrEmpty(row.CategoryName))
                                    {
                                        <div class="tx-badges">
                                            <span class="badge text-bg-primary tx-badge">@row.CategoryName</span>
                                        </div>
                                    }
                                </div>
                                <div class="tx-payee">
                                    <span class="tx-name">@(row.Name ?? "")</span>
                                    @if (!string.IsNullOrEmpty(row.Comment))
                                    {
                                        <span class="tx-comment text-body-secondary">@row.Comment</span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Purpose))
                                    {
                                        <span class="tx-purpose text-body-secondary">@row.Purpose</span>
                                    }
                                </div>
                                <div class="tx-account">
                                    @if (showAccountColumn && !string.IsNullOrEmpty(row.AccountName))
                                    {
                                        <span class="badge text-bg-light border tx-badge">@row.AccountName</span>
                                    }
                                </div>
                                <div class="tx-amount @(row.Amount < 0 ? "text-danger" : "text-success")">
                                    @if (row.IsSplitChild)
                                    {
                                        <span class="badge text-bg-warning me-1" title="@L["Tx_SplitChildTitle"]">@L["Tx_SplitChild"]</span>
                                    }
                                    @Formatting.FormatMoney(row.Amount, row.Currency ?? "EUR")
                                </div>
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="tx-row">
                                <div class="tx-date-col"><div class="skeleton skeleton-line"></div></div>
                                <div class="tx-payee"><div class="skeleton skeleton-line"></div></div>
                                <div class="tx-account"></div>
                                <div class="tx-amount"></div>
                            </div>
                        </Placeholder>
                    </Virtualize>
                </div>

                <div class="d-flex justify-content-end mt-3 small text-body-secondary">
                    @L["Footer_Total", txTotals.Value.Count] · @L["Footer_Sum"] @Formatting.FormatMoney(txTotals.Value.Sum)
                </div>
            }
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public int ProjectId { get; set; }

    private Project? project;
    private bool notFound;

    // Tree + tx totals (count + sum across the active filter, refreshed on filter change).
    // The list rows themselves are streamed by <Virtualize> via LoadTxRowsAsync.
    private BrowseTree? tree;
    private (int Count, decimal Sum)? txTotals;
    // Live holdings for the selected depot account; null whenever the selection isn't a
    // portfolio account (or it holds nothing). Drives the holdings card above the tx list.
    private AccountHoldings? holdings;
    // Which PortfolioPerformance taxonomy the holdings card's look-through is showing.
    private string? holdingsTaxonomy;
    private Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize<TransactionRow>? txVirtualize;
    // Approximate row height in CSS pixels — drives Virtualize's spacer math and the bar-click
    // scroll-jump (offset = newerCount * itemSize). Real rows vary a few px either way; the
    // post-load scrollIntoView fine-tunes the final position.
    private const float itemSize = 56f;

    // URL state.
    private (int Year, int Month) anchor;
    private string period = "month";

    // Selection — "all" | "account" | "category" | "group".
    private string selectionKind = "all";
    private long? selectionId;

    // Filter state.
    private long? accountFilter;
    private string searchInput = "";
    private string searchEffective = "";
    private decimal? amountMin;
    private decimal? amountMax;
    private string amountMinInput = "";
    private string amountMaxInput = "";

    // Chart series: bucketed Spent for the selected node, spanning the source's full history
    // (earliest transaction → anchor bucket). Granularity picks the bucket width (M/Q/Y); the
    // anchor bucket is highlighted and the canvas auto-scrolls to it.
    private (string Label, decimal Value, bool IsAnchor)[]? chartBars;
    // Each chart bar's start month, in (Year, Month) tuples. Used by OnChartBarClicked to
    // translate the bar index back into an anchor date.
    private (int Year, int Month)[]? chartBarMonths;
    private string chartGranularity = "M";
    // Y-axis inversion: true for expense categories/groups so the bars still "grow upwards"
    // visually even though their underlying values are negative (the tick labels honestly
    // read "−300 €"). Income categories and accounts use the natural axis where positive
    // goes up and negative goes down.
    private bool chartInvertY;

    // JS ↔ Blazor bridge for chart bar clicks. Allocated once per page lifetime; the chart
    // re-render hands the same reference each time so click events route back to us.
    private DotNetObjectReference<Browse>? selfRef;

    // Defer JS interop until after the first browser render. OnInitializedAsync runs during
    // server prerender where JS calls are illegal — so we mark the chart dirty and let
    // OnAfterRenderAsync push it to the browser.
    private bool chartDirty;
    // Set by OnChartBarClicked so the next chart render skips the grow-from-zero animation
    // — animating while the user just clicked a bar feels jarring. Cleared after each render.
    private bool chartSkipAnimation;
    // User-driven collapse of the chart row to reclaim vertical space. The chart canvas is
    // removed from the DOM when collapsed, so expanding re-renders via the chartDirty path.
    private bool chartCollapsed;

    // Rail accounts section hides accounts that aren't explicitly assigned to the project
    // by default; the toggle below the list flips this when the user wants to see related
    // accounts (those with transactions in tracked categories but no direct assignment).
    private bool showRelatedAccounts;

    // Mobile-only: the left rail is hidden by default and slides in as a drawer when
    // toggled. On lg+ the rail is part of the grid and this flag is ignored (CSS keeps
    // .browse-rail visible regardless of .open). Closing happens on backdrop click, the X
    // button, or whenever the user picks a tree node — auto-closing on selection so they
    // immediately see the transactions on the right.
    private bool railOpen;

    private void ToggleRail() => railOpen = !railOpen;
    private void CloseRail() => railOpen = false;

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            // Best-effort: free the Chart.js instance JS-side so navigating away doesn't leave it
            // (and the onClick closure capturing selfRef) in window.chartInstances until the canvas
            // id is reused. Fire-and-forget because Dispose is synchronous; swallow the cases where
            // JS is unreachable (circuit already gone, or server-side prerender disposal).
            _ = DestroyChartAsync();
            selfRef?.Dispose();
        }
        base.Dispose(disposing);
    }

    private async Task DestroyChartAsync()
    {
        try { await JS.InvokeVoidAsync("destroyChart", "browseChart"); }
        catch (JSDisconnectedException) { /* no-op: circuit already gone */ }
        catch (InvalidOperationException) { /* no-op: JS unreachable (prerender disposal) */ }
    }

    protected override bool IsRelevantChange(DataChange change) => change.Area switch
    {
        DataArea.MoneyMoneyData or DataArea.Sources => project != null && change.SourceId == project.SourceId,
        _ => change.ProjectId is null || change.ProjectId == ProjectId,
    };
    protected override async Task ReloadAfterChangeAsync()
    {
        if (project != null)
            (monthMin, monthMax) = await BudgetService.GetMonthBoundsForProjectAsync(ProjectId);
        await ReloadAsync();
    }

    // Debounce search keystrokes — we throttle by token instead of timer/JS interop.
    private long searchToken;

    // The selectable month window for *this project's* tracked categories (first..last transaction;
    // the latter may be in the future — pending rows). Bounds the navigator to the project's own data
    // rather than the whole source, and stays stable across the in-project category/account selection.
    // Null until loaded / when the project has no transactions, in which case EffectiveMin/Max fall
    // back to [1900-01 .. current month].
    private (int Year, int Month)? monthMin;
    private (int Year, int Month)? monthMax;
    private (int Year, int Month) EffectiveMin => monthMin ?? (1900, 1);
    private (int Year, int Month) EffectiveMax => monthMax ?? (DateTime.Now.Year, DateTime.Now.Month);

    // Guards the per-project load so it runs once on first render and again only when the
    // {ProjectId} route param changes — i.e. a client-side switch via the header's project
    // picker, where the component is reused and OnInitializedAsync would not re-run.
    private int _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId) return;
        _loadedProjectId = ProjectId;
        ResetForProjectSwitch();
        project = await ProjectService.GetProjectAsync(ProjectId);
        if (project == null) { notFound = true; return; }
        (monthMin, monthMax) = await BudgetService.GetMonthBoundsForProjectAsync(ProjectId);
        ReadStateFromQuery();
        await ReloadAsync();
    }

    // On a client-side switch the component is reused, so reset all per-project view state to its
    // initial values before re-reading the (filter-less) switch URL — otherwise the previous
    // project's selection/filters/chart would linger.
    private void ResetForProjectSwitch()
    {
        notFound = false;
        tree = null; txTotals = null; holdings = null; holdingsTaxonomy = null; chartBars = null; chartBarMonths = null;
        selectionKind = "all"; selectionId = null;
        accountFilter = null;
        searchInput = ""; searchEffective = "";
        amountMin = null; amountMax = null; amountMinInput = ""; amountMaxInput = "";
        chartGranularity = "M";
        showRelatedAccounts = false; railOpen = false; chartCollapsed = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The initial pipeline (OnInitializedAsync → ReloadAsync) computes chart data but
        // can't push it to JS during prerender. Flush any pending chart here, then on every
        // subsequent state change that flips chartDirty.
        if (chartDirty)
        {
            chartDirty = false;
            await RenderChartAsync();
        }
    }

    private void ReadStateFromQuery()
    {
        var now = DateTime.Now;
        // Seed from the remembered selection (survives a detour through Budgets/Cashflow),
        // falling back to the current month on a fresh session.
        anchor = (TimeState.Year ?? now.Year, TimeState.Month ?? now.Month);
        period = TimeState.Period ?? "month";
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("year", out var y) && int.TryParse(y, out var py) && py >= 1900)
            anchor.Year = py;
        if (query.TryGetValue("month", out var m) && int.TryParse(m, out var pm) && pm is >= 1 and <= 12)
            anchor.Month = pm;
        // Clamp into the source's [first..last transaction] month window.
        anchor = Anchoring.Clamp(anchor, EffectiveMin, EffectiveMax);

        if (query.TryGetValue("period", out var p) && p.ToString() is var pv && (pv == "month" || pv == "ytd" || pv == "year"))
            period = pv;

        RememberTimeState();

        if (query.TryGetValue("sel", out var s) && !string.IsNullOrWhiteSpace(s))
        {
            var raw = s.ToString();
            if (raw.StartsWith("cat-") && long.TryParse(raw[4..], out var cid))
            {
                selectionKind = "category"; selectionId = cid;
            }
            else if (raw.StartsWith("grp-") && long.TryParse(raw[4..], out var gid))
            {
                selectionKind = "group"; selectionId = gid;
            }
            else if (raw.StartsWith("acct-") && long.TryParse(raw[5..], out var aid))
            {
                selectionKind = "account"; selectionId = aid;
            }
            else if (raw == "securities")
            {
                selectionKind = "portfolio"; selectionId = null;
            }
        }

        if (query.TryGetValue("acct", out var af) && long.TryParse(af, out var afl)) accountFilter = afl;
        if (query.TryGetValue("q", out var qs)) { searchInput = qs.ToString(); searchEffective = searchInput; }
        if (query.TryGetValue("amin", out var minRaw) && decimal.TryParse(minRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var minVal))
        { amountMin = minVal; amountMinInput = minRaw.ToString(); }
        if (query.TryGetValue("amax", out var maxRaw) && decimal.TryParse(maxRaw, NumberStyles.Number, CultureInfo.InvariantCulture, out var maxVal))
        { amountMax = maxVal; amountMaxInput = maxRaw.ToString(); }
        if (query.TryGetValue("g", out var g) && g.ToString() is var gv && (gv == "M" || gv == "Q" || gv == "Y" || gv == "D"))
            chartGranularity = gv;
        CoerceChartGranularityForSelection();
    }

    /// <summary>
    /// Account view exposes D/M; category, group and "all" expose M/Q/Y. Snap chartGranularity
    /// back to "M" whenever the current setting isn't valid for the active selection — happens
    /// after navigating between an account and a category, or after loading a URL whose g=
    /// value doesn't match its sel= scope.
    /// </summary>
    private void CoerceChartGranularityForSelection()
    {
        if (selectionKind == "account")
        {
            if (chartGranularity != "D" && chartGranularity != "M") chartGranularity = "M";
        }
        else
        {
            if (chartGranularity == "D") chartGranularity = "M";
        }
    }

    private void UpdateUrl() => PageState.ReplaceQuery(Navigation, new Dictionary<string, object?>
    {
        ["year"] = anchor.Year,
        ["month"] = anchor.Month,
        ["period"] = period == "month" ? null : period,
        ["sel"] = selectionKind switch
        {
            "category" => $"cat-{selectionId}",
            "group" => $"grp-{selectionId}",
            "account" => $"acct-{selectionId}",
            "portfolio" => "securities",
            _ => null
        },
        ["acct"] = accountFilter?.ToString(),
        ["q"] = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        ["amin"] = amountMin?.ToString(CultureInfo.InvariantCulture),
        ["amax"] = amountMax?.ToString(CultureInfo.InvariantCulture),
        ["g"] = chartGranularity == "M" ? null : chartGranularity
    });

    private (int FromMonth, int ToMonth) PeriodRange => period switch
    {
        "year" => (1, 12),
        "ytd" => (1, anchor.Month),
        _ => (anchor.Month, anchor.Month)
    };

    private string AnchorHeading
    {
        get
        {
            var d = new DateTime(anchor.Year, anchor.Month, 1);
            return period switch
            {
                "year" => L["Heading_Year", anchor.Year].Value,
                "ytd" => L["Heading_YTD", d.ToString("MMMM yyyy")].Value,
                _ => d.ToString("MMMM yyyy")
            };
        }
    }

    private async Task OnPeriodChanged((int Year, int Month, string Period) sel)
    {
        if (sel.Year == anchor.Year && sel.Month == anchor.Month && sel.Period == period) return;
        anchor = (sel.Year, sel.Month);
        period = sel.Period;
        RememberTimeState();
        UpdateUrl();
        await ReloadHighlightAsync();
        await JumpListToAnchorAsync();
    }

    private void RememberTimeState()
    {
        TimeState.Year = anchor.Year;
        TimeState.Month = anchor.Month;
        TimeState.Period = period;
    }

    /// <summary>
    /// Lightweight refresh when the anchor / period changes but the selection and filters
    /// don't. Rebuilds the tree (so its per-node period numbers update) and re-renders the
    /// chart highlight, but leaves the transaction list intact — the list is unfiltered by
    /// anchor, so its content doesn't change.
    /// </summary>
    private async Task ReloadHighlightAsync()
    {
        if (project == null) return;
        var (fm, tm) = PeriodRange;
        tree = await BrowseService.GetTreeAsync(ProjectId, anchor.Year, fm, tm);
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    private async Task SelectAll()
    {
        selectionKind = "all"; selectionId = null;
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SelectAccount(long id)
    {
        selectionKind = "account"; selectionId = id;
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    // Portfolio (depot) accounts in the rail. The combined "All securities" view aggregates these.
    private List<long> PortfolioAccountIds() =>
        tree?.Accounts.Where(a => a.IsPortfolio).Select(a => a.Id).ToList() ?? new List<long>();

    private async Task SelectPortfolio()
    {
        selectionKind = "portfolio"; selectionId = null;
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SelectCategoryNode(BrowseCategoryNode n)
    {
        selectionKind = n.ItemType == CategoryItemType.Category ? "category" : "group";
        selectionId = n.Id;
        CoerceChartGranularityForSelection();
        railOpen = false;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task SetChartGranularity(string g)
    {
        if (chartGranularity == g) return;
        chartGranularity = g;
        UpdateUrl();
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    private void ToggleChartCollapsed()
    {
        chartCollapsed = !chartCollapsed;
        // Coming out of collapsed mode the canvas was unmounted, so the existing Chart.js
        // instance is bound to a detached element. Re-render fresh; skip the animation so
        // it doesn't replay every time the user toggles.
        if (!chartCollapsed)
        {
            chartSkipAnimation = true;
            chartDirty = true;
        }
    }

    /// <summary>
    /// Invoked from JS when the user clicks a bar in the chart. <paramref name="barIndex"/>
    /// is the bar's position in <see cref="chartBars"/>; we map it back through
    /// <see cref="chartBarMonths"/> to set the anchor to that month and re-highlight.
    /// </summary>
    [JSInvokable]
    public async Task OnChartBarClicked(int barIndex)
    {
        if (chartBarMonths == null || project == null) return;
        if (barIndex < 0 || barIndex >= chartBarMonths.Length) return;
        var (y, m) = chartBarMonths[barIndex];
        bool anchorChanged = !(y == anchor.Year && m == anchor.Month);
        if (anchorChanged)
        {
            anchor = (y, m);
            chartSkipAnimation = true;
            UpdateUrl();
            await ReloadHighlightAsync();
        }
        await JumpListToAnchorAsync();
    }

    /// <summary>
    /// Scroll the virtualized tx list to the latest transaction at-or-before the current
    /// anchor period. Hands JS an approximate pixel offset (<c>newerCount * itemSize</c>);
    /// after Virtualize loads the items at that scroll position, the JS helper snaps the
    /// first <c>.in-period</c> row to the top.
    /// </summary>
    private async Task JumpListToAnchorAsync()
    {
        if (project == null) return;
        var (_, tm) = PeriodRange;
        var periodEndExclusive = new DateTime(anchor.Year, tm, 1, 0, 0, 0, DateTimeKind.Utc).AddMonths(1);
        var newerCount = await TransactionQueries.CountNewerThanAsync(
            await BuildTransactionQueryAsync(0, 1), periodEndExclusive);
        try { await JS.InvokeVoidAsync("scrollListToTxOffset", newerCount * itemSize); }
        catch (JSDisconnectedException) { /* navigation in flight */ }
    }

    private async Task<TransactionQuery> BuildTransactionQueryAsync(int skip = 0, int take = 50) => new()
    {
        SourceId = project!.SourceId,
        CategoryLeafIds = await ResolveSelectionLeavesAsync(),
        AccountIds = ResolveSelectionAccounts(),
        SearchText = string.IsNullOrWhiteSpace(searchEffective) ? null : searchEffective,
        MinAbsAmount = amountMin,
        MaxAbsAmount = amountMax,
        Skip = skip,
        Take = take
    };

    private async ValueTask<Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderResult<TransactionRow>> LoadTxRowsAsync(
        Microsoft.AspNetCore.Components.Web.Virtualization.ItemsProviderRequest request)
    {
        if (project == null || tree == null)
            return new(Array.Empty<TransactionRow>(), 0);
        var q = await BuildTransactionQueryAsync(request.StartIndex, request.Count);
        var result = await TransactionQueries.QueryAsync(q, request.CancellationToken);
        return new(result.Rows, result.TotalCount);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? "";
        var token = ++searchToken;
        // Tiny debounce: wait, then check we're still the latest typed value.
        await Task.Delay(250);
        if (token != searchToken) return;
        if (searchEffective == searchInput) return;
        searchEffective = searchInput;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task OnAccountFilterChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        accountFilter = long.TryParse(v, out var af) ? af : null;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task OnAmountMinChanged(ChangeEventArgs e)
    {
        amountMinInput = e.Value?.ToString() ?? "";
        amountMin = decimal.TryParse(amountMinInput, NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task OnAmountMaxChanged(ChangeEventArgs e)
    {
        amountMaxInput = e.Value?.ToString() ?? "";
        amountMax = decimal.TryParse(amountMaxInput, NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : null;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private async Task ClearFilters()
    {
        accountFilter = null;
        searchInput = ""; searchEffective = "";
        amountMin = null; amountMax = null;
        amountMinInput = ""; amountMaxInput = "";
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

    private bool HasActiveFilter =>
        accountFilter.HasValue || !string.IsNullOrWhiteSpace(searchEffective) || amountMin.HasValue || amountMax.HasValue;

    private async Task ReloadAsync()
    {
        tree = null; txTotals = null;
        // The hierarchy may have changed (external data change) — drop the leaf-id cache so the
        // current selection re-resolves against fresh data.
        _leafCacheKey = null; _leafCache = null;
        StateHasChanged();
        var (fm, tm) = PeriodRange;
        tree = await BrowseService.GetTreeAsync(ProjectId, anchor.Year, fm, tm);
        if (tree == null) { notFound = true; return; }
        // If the URL selected a related (non-assigned) account, auto-expand the related
        // section so the selected row is visible instead of hidden behind the toggle.
        if (selectionKind == "account" && selectionId is { } selAcct
            && tree.Accounts.FirstOrDefault(a => a.Id == selAcct) is { IsAssigned: false })
        {
            showRelatedAccounts = true;
        }
        await ReloadTransactionsAsync();
    }

    private async Task ReloadTransactionsAsync()
    {
        if (project == null || tree == null) return;

        // Holdings are independent of the tx filters/period; load them only while a depot account
        // is selected and clear them otherwise so the card doesn't linger on the next selection.
        if (selectionKind == "account" && SelectedAccountNode is { IsPortfolio: true } depot)
            holdings = await Portfolio.GetAccountHoldingsAsync(ProjectId, depot.Id);
        else if (selectionKind == "portfolio")
            holdings = await Portfolio.GetCombinedHoldingsAsync(ProjectId, PortfolioAccountIds());
        else
            holdings = null;

        // Keep the look-through taxonomy selection valid for the newly loaded holdings.
        if (holdings?.Taxonomies is { Count: > 0 } taxos
            && (holdingsTaxonomy is null || taxos.All(t => t.TaxonomyName != holdingsTaxonomy)))
            holdingsTaxonomy = taxos[0].TaxonomyName;

        // The transaction list is intentionally unfiltered by the period anchor — matches
        // MoneyMoney's "Period: Show All" default. The anchor only drives chart-highlight
        // and the header period sum. Other filters (search/amount/account) still apply.
        // Totals (count + sum) feed the footer; row data streams through <Virtualize> via
        // LoadTxRowsAsync below.
        txTotals = await TransactionQueries.QueryTotalsAsync(await BuildTransactionQueryAsync(0, 1));
        if (txVirtualize is not null) await txVirtualize.RefreshDataAsync();
        await ComputeChartAsync();
        chartDirty = true;
        StateHasChanged();
    }

    // Resolving a group/all selection to its leaf category ids hits the category hierarchy.
    // ResolveSelectionLeavesAsync runs on every Virtualize window fetch (via LoadTxRowsAsync),
    // plus totals and chart compute, so cache the result for the current selection. The key
    // (kind + id) changes whenever the user picks a different node, which invalidates the cache;
    // ReloadAsync clears it so an external data change re-resolves the hierarchy.
    private (string Kind, long? Id)? _leafCacheKey;
    private IReadOnlyCollection<long>? _leafCache;

    private async Task<IReadOnlyCollection<long>?> ResolveSelectionLeavesAsync()
    {
        var key = (selectionKind, selectionId);
        if (_leafCacheKey == key) return _leafCache;
        var leaves = await ResolveSelectionLeavesCoreAsync();
        _leafCacheKey = key;
        _leafCache = leaves;
        return leaves;
    }

    private async Task<IReadOnlyCollection<long>?> ResolveSelectionLeavesCoreAsync()
    {
        if (project == null) return null;
        if (selectionKind == "category" && selectionId is { } cid) return new[] { cid };
        if (selectionKind == "group" && selectionId is { } gid)
        {
            var hier = await Hierarchy.GetAllCategoriesWithChildCountsAsync(project.SourceId);
            var map = CategoryHierarchyService.BuildItemToLeafCategoryIds(
                new[] { (gid, CategoryItemType.Group) }, hier);
            return map.TryGetValue((gid, CategoryItemType.Group), out var leaves) ? leaves.ToList() : null;
        }
        if (selectionKind == "all")
        {
            // "All transactions" still means "all transactions in this project's scope" —
            // expand every tracked item to its leaf categories. Without this the query falls
            // through to "any transaction in the source", which surfaces categories the
            // project doesn't track.
            var trackedKeys = project.TrackingItems.ToTrackedKeys().ToList();
            if (trackedKeys.Count == 0) return Array.Empty<long>();
            var hier = await Hierarchy.GetAllCategoriesWithChildCountsAsync(project.SourceId);
            var map = CategoryHierarchyService.BuildItemToLeafCategoryIds(trackedKeys, hier);
            var union = map.Values.SelectMany(s => s).Distinct().ToList();
            return union;
        }
        return null;
    }

    private IReadOnlyCollection<long>? ResolveSelectionAccounts()
    {
        if (selectionKind == "account" && selectionId is { } aid) return new[] { aid };
        // Combined securities view: the transaction list spans all the project's depot accounts.
        if (selectionKind == "portfolio")
        {
            var ids = PortfolioAccountIds();
            return ids.Count > 0 ? ids : null;
        }
        if (accountFilter is { } af) return new[] { af };
        return null;
    }

    private string SelectionName
    {
        get
        {
            if (selectionKind == "account" && selectionId is { } aid && tree != null)
                return tree.Accounts.FirstOrDefault(a => a.Id == aid)?.Name ?? "";
            if (selectionKind == "portfolio")
                return L["Header_AllSecurities"];
            if ((selectionKind == "category" || selectionKind == "group") && selectionId is { } cid && tree != null)
                return FindCategoryNode(tree.Categories, cid, selectionKind == "category" ? CategoryItemType.Category : CategoryItemType.Group)?.Name ?? "";
            return L["Header_AllTransactions"];
        }
    }

    private decimal SelectionSpent
    {
        get
        {
            if (tree == null) return 0m;
            // Header is anchor-period scoped, independent of the (unfiltered) transaction
            // list. Read straight from the tree-decoration the BrowseService computed so the
            // header number always matches what the tree row shows for the selected node.
            if (selectionKind == "category" && selectionId is { } cid)
                return FindCategoryNode(tree.Categories, cid, CategoryItemType.Category)?.Spent ?? 0m;
            if (selectionKind == "group" && selectionId is { } gid)
                return FindCategoryNode(tree.Categories, gid, CategoryItemType.Group)?.Spent ?? 0m;
            if (selectionKind == "account" && selectionId is { } aid)
            {
                // Accounts use MoneyMoney's natural signing: inflow positive, outflow negative.
                // Flip so "Spent" reads positive in the header for negative-net periods.
                var acct = tree.Accounts.FirstOrDefault(a => a.Id == aid);
                return acct == null ? 0m : -acct.PeriodSum;
            }
            // "All": sum of root category Spent values for the period.
            return tree.Categories.Sum(c => c.Spent);
        }
    }

    private BrowseAccountNode? SelectedAccountNode =>
        tree != null && selectionKind == "account" && selectionId is { } aid
            ? tree.Accounts.FirstOrDefault(a => a.Id == aid)
            : null;

    private decimal? SelectionAccountBalance => SelectedAccountNode?.Balance;
    private string? SelectionAccountCurrency => SelectedAccountNode?.Currency;
    private decimal SelectionAccountPeriodSum => SelectedAccountNode?.PeriodSum ?? 0m;

    private bool SelectionIsIncome
    {
        get
        {
            if (tree == null) return false;
            if (selectionKind == "category" && selectionId is { } cid)
                return FindCategoryNode(tree.Categories, cid, CategoryItemType.Category)?.IsIncome ?? false;
            if (selectionKind == "group" && selectionId is { } gid)
                return FindCategoryNode(tree.Categories, gid, CategoryItemType.Group)?.IsIncome ?? false;
            return false;
        }
    }

    private decimal? SelectionBudget
    {
        get
        {
            if (tree == null) return null;
            if (selectionKind == "category" && selectionId is { } cid)
                return FindCategoryNode(tree.Categories, cid, CategoryItemType.Category)?.Budget;
            if (selectionKind == "group" && selectionId is { } gid)
            {
                var node = FindCategoryNode(tree.Categories, gid, CategoryItemType.Group);
                if (node == null) return null;
                // A group that's not itself a tracked budget entry has Budget == null even when
                // some sub-categories are tracked. Roll their budgets up so the header still
                // reads "Available / Budget" for the group selection — without this the labels
                // disappear and the header looks broken next to children that do show them.
                return node.Budget ?? SumDescendantBudgets(node);
            }
            return null;
        }
    }

    private static decimal? SumDescendantBudgets(BrowseCategoryNode node)
    {
        // Roll up budgets only when every budgeted descendant matches the parent's direction.
        // A "Gemeinsam" group that mixes income and expense kids has no single meaningful
        // budget — abs-summing both sides gives a misleading number, so bail out instead.
        decimal sum = 0m;
        bool any = false;
        foreach (var d in EnumerateBudgetedDescendants(node))
        {
            if (d.IsIncome != node.IsIncome) return null;
            sum += d.Budget!.Value;
            any = true;
        }
        return any ? sum : null;
    }

    private static IEnumerable<BrowseCategoryNode> EnumerateBudgetedDescendants(BrowseCategoryNode node)
    {
        foreach (var child in node.Children)
        {
            if (child.Budget.HasValue) yield return child;
            else foreach (var deeper in EnumerateBudgetedDescendants(child)) yield return deeper;
        }
    }

    // Holdings card formatting. Percent for display follows the UI culture; the allocation-bar
    // segment widths must use an invariant decimal point or a German "25,0%" silently voids the
    // CSS width (same trap as the rail's padding-left — see BrowseTreeRail).
    // Switches the holdings look-through taxonomy. Data is already loaded, so this is pure view
    // state — Blazor re-renders after the synchronous handler returns.
    private void SelectHoldingsTaxonomy(string taxonomyName) => holdingsTaxonomy = taxonomyName;

    private static string FormatPercent(decimal fraction) => fraction.ToString("P1", CultureInfo.CurrentCulture);

    private static string CssPercent(decimal fraction) =>
        FormattableString.Invariant($"{fraction * 100m:0.##}%");

    // Quantities range from thousands of ETF units to sub-microcoin crypto dust, so show up to
    // eight decimals and trim trailing zeros rather than forcing a fixed scale.
    private static string FormatQuantity(double quantity) =>
        quantity.ToString("0.########", CultureInfo.CurrentCulture);

    private bool showCategoryColumn => selectionKind != "category";
    private bool showAccountColumn => selectionKind != "account" && (tree?.Accounts.Count ?? 0) > 0;

    private bool IsInAnchorPeriod(DateTime date)
    {
        var (fm, tm) = PeriodRange;
        if (date.Year != anchor.Year) return false;
        return date.Month >= fm && date.Month <= tm;
    }

    /// <summary>
    /// Canvas width in pixels — bar width × bucket count, floored at 320 so a near-empty
    /// source doesn't collapse the chart to nothing. Lives here rather than inline in markup
    /// because Razor doesn't allow @{} statement blocks inside an @if body.
    /// </summary>
    private int ChartCanvasWidthPx
    {
        get
        {
            if (chartBars == null) return 320;
            int barPx = chartGranularity switch { "Y" => 64, "Q" => 52, "D" => 10, _ => 36 };
            return Math.Max(chartBars.Length * barPx, 320);
        }
    }

    private static BrowseCategoryNode? FindCategoryNode(IEnumerable<BrowseCategoryNode> nodes, long id, CategoryItemType type)
    {
        foreach (var n in nodes)
        {
            if (n.Id == id && n.ItemType == type) return n;
            var found = FindCategoryNode(n.Children, id, type);
            if (found != null) return found;
        }
        return null;
    }

    private async Task ComputeChartAsync()
    {
        // History series for the selected node, bucketed by chartGranularity. We support
        // category / group selections (chart of period spend signed by MoneyMoney's
        // natural convention — expenses negative, refunds offsetting) and account
        // selections (signed net flow). "All" has no single meaningful chart yet.
        if (project == null || tree == null) { chartBars = null; return; }

        IReadOnlyCollection<long>? leaves = null;
        IReadOnlyCollection<long>? accounts = null;
        bool invertY = false;

        if (selectionKind == "category" || selectionKind == "group")
        {
            leaves = await ResolveSelectionLeavesAsync();
            if (leaves == null || leaves.Count == 0) { chartBars = null; return; }
            bool isIncome = false;
            if (selectionKind == "category" && selectionId is { } cidIncome)
                isIncome = FindCategoryNode(tree.Categories, cidIncome, CategoryItemType.Category)?.IsIncome ?? false;
            else if (selectionKind == "group" && selectionId is { } gidIncome)
                isIncome = FindCategoryNode(tree.Categories, gidIncome, CategoryItemType.Group)?.IsIncome ?? false;
            // Expense items invert the axis so spending grows upward (the values are still
            // negative — the tick labels read "−300 €"). Income items keep the natural axis.
            invertY = !isIncome;
        }
        else if (selectionKind == "account" && selectionId is { } aid)
        {
            accounts = new[] { aid };
            // Accounts use the natural axis: net inflow up, net outflow down.
        }
        else
        {
            // "all" selection — defer until we decide what aggregate makes sense.
            chartBars = null;
            return;
        }

        // Window spans the selected node's actual transaction history — its earliest
        // transaction through max(anchor, its latest). A category that started in 2026 won't
        // drag the chart back to 2020 just because the source has older rows in other
        // categories. Anchoring on an earlier month still doesn't shrink the right edge.
        var (scopeEarliest, scopeLatest) = await TransactionQueries.GetScopeDateRangeAsync(
            project.SourceId, leaves, accounts);
        if (scopeEarliest == null) { chartBars = null; return; }

        var anchorDate = new DateTime(anchor.Year, anchor.Month, 1);
        var earliest = scopeEarliest.Value;
        var rightEdge = scopeLatest is { } lt && lt > anchorDate
            ? new DateTime(lt.Year, lt.Month, 1)
            : anchorDate;
        var (windowStart, windowEndExclusive, _, _, _) = BrowseChart.ResolveChartWindow(earliest, rightEdge, chartGranularity);

        // For the account-D running-balance pass below we need every transaction between the
        // chart's right edge and "today" so we can back-compute the closing balance at the
        // end of the window. Extend only the query window — bucketing still discards anything
        // past windowEndExclusive via the standard bounds check.
        var queryEndExclusive = windowEndExclusive;
        var isAccountDaily = selectionKind == "account" && chartGranularity == "D";
        if (isAccountDaily)
        {
            var tomorrow = DateTime.UtcNow.Date.AddDays(1);
            if (tomorrow > queryEndExclusive) queryEndExclusive = tomorrow;
        }
        var raw = await TransactionQueries.GetRawByDateRangeAsync(
            project.SourceId, leaves, accounts, windowStart, queryEndExclusive);

        // Bucketing, anchor-period highlighting, and the account-daily running-balance back-walk
        // all live in BrowseChart.BuildChartSeries (pure + unit-tested); the page just feeds it
        // the resolved window inputs and the fetched rows.
        var (fm, tm) = PeriodRange;
        var chart = BrowseChart.BuildChartSeries(
            earliest, rightEdge, chartGranularity,
            anchor.Year, fm, tm,
            invertY, isAccountDaily,
            raw, SelectionAccountBalance);
        chartBarMonths = chart.BarMonths;
        chartInvertY = chart.InvertY;
        chartBars = chart.Bars;
    }


    private async Task RenderChartAsync()
    {
        if (chartBars == null) return;
        selfRef ??= DotNetObjectReference.Create(this);
        var labels = chartBars.Select(b => b.Label).ToArray();
        var values = chartBars.Select(b => (double)b.Value).ToArray();
        var bg = chartBars.Select(b => b.IsAnchor
            ? "rgba(54, 162, 235, 0.9)"
            : "rgba(54, 162, 235, 0.4)").ToArray();
        var noAnimate = chartSkipAnimation;
        chartSkipAnimation = false;
        try
        {
            await JS.InvokeVoidAsync("renderBrowseChart", "browseChart", "browseChartScroll",
                labels, values, bg, chartInvertY, selfRef, noAnimate);
        }
        catch (JSDisconnectedException) { /* page navigation in flight */ }
    }

}
