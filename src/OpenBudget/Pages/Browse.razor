        var token = ++searchToken;
        // Tiny debounce: wait, then check we're still the latest typed value.
        await Task.Delay(250);
        if (token != searchToken) return;
        if (searchEffective == searchInput) return;
        searchEffective = searchInput;
        UpdateUrl();
        await ReloadTransactionsAsync();
    }

