@page "/sources"
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject BudgetService BudgetService
@inject SourceService SourceService
@inject StructureTakeoverService Takeover
@inject AccountSwitchService Switcher
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject IStringLocalizer<Sources> L
@inject ClockService Clock
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle"]</PageTitle>

<SettingsShell Active="sources">
<PageHeader Title="@L["Heading"]" />

<p class="text-body-secondary">
    @L["Intro_Before"]<code>POST /api/import/moneymoney/{name}</code>@L["Intro_After"]
</p>

<p class="small">
    <a href="/banklogins" id="bank-logins-link"><i class="bi bi-bank" aria-hidden="true"></i> @L["Link_BankLogins"]</a>
    <span class="text-body-secondary">@L["Link_BankLogins_Hint"]</span>
</p>

<form class="d-flex flex-wrap gap-2 align-items-start mb-3" @onsubmit="CreateSourceAsync" @onsubmit:preventDefault>
    <input type="text" id="new-source-name" class="form-control w-auto" @bind="newSourceName" @bind:event="oninput"
           placeholder="@L["Create_Placeholder"]" aria-label="@L["Create_Placeholder"]" maxlength="100" />
    <button type="submit" class="btn btn-primary" id="new-source-create" disabled="@string.IsNullOrWhiteSpace(newSourceName)">@L["Create_Button"]</button>
    @if (!string.IsNullOrEmpty(createError))
    {
        <div class="text-danger small align-self-center" role="alert">@createError</div>
    }
</form>

@if (sources == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line mb-2" style="width: 70%;"></div>
        <div class="skeleton skeleton-line mb-2" style="width: 50%;"></div>
        <div class="skeleton skeleton-line" style="width: 60%;"></div>
    </div>
}
else if (!sources.Any())
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Table_Name"]</th>
                <th class="d-none d-md-table-cell">@L["Table_Created"]</th>
                <th>@L["Table_LastUpload"]</th>
                <th class="text-end">@L["Table_Projects"]</th>
                <th class="text-end">@L["Table_Transactions"]</th>
                <th class="text-end d-none d-md-table-cell" title="@L["Table_Documents_Title"]">@L["Table_Documents"]</th>
                <th class="text-end d-none d-md-table-cell">@L["Table_Bytes"]</th>
                <th></th>
            </tr>
        </thead>
            @foreach (var s in sources)
            {
                <tbody data-testid="source-row">
                <tr>
                    <td><strong>@s.Name</strong></td>
                    <td class="d-none d-md-table-cell text-nowrap"><span title="@s.CreatedAt.ToString("u")">@Clock.ToLocal(s.CreatedAt).ToString("yyyy-MM-dd")</span></td>
                    <td class="text-nowrap">
                        @if (s.LastUploadAt.HasValue)
                        {
                            <span title="@s.LastUploadAt.Value.ToString("u")">@Clock.ToLocal(s.LastUploadAt.Value).ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">@L["Never"]</span>
                        }
                    </td>
                    <td class="text-end">@projectCounts.GetValueOrDefault(s.Id, 0)</td>
                    <td class="text-end">@transactionCounts.GetValueOrDefault(s.Id, 0).ToString("N0")</td>
                    <td class="text-end d-none d-md-table-cell" data-testid="source-documents">@documentCounts.GetValueOrDefault(s.Id, 0).ToString("N0")</td>
                    <td class="text-end d-none d-md-table-cell">@(s.LastUploadSizeBytes.HasValue ? s.LastUploadSizeBytes.Value.ToString("N0") : "—")</td>
                    <td></td>
                </tr>
                <tr class="source-actions-row">
                    <td colspan="8" class="border-top-0 pt-0">
                        <div class="d-flex flex-wrap align-items-center gap-1">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ToggleToken(s.Id)">
                            @(revealed.Contains(s.Id) ? L["Token_Hide"] : L["Token_Show"])
                        </button>
                        @if (s.StructureTakenOverAt is { } takenAt)
                        {
                            <span class="badge text-bg-light border me-1" data-testid="structure-owned" title="@L["Takeover_DoneTitle"]">
                                <i class="bi bi-check2" aria-hidden="true"></i> @L["Takeover_Done", Clock.ToLocal(takenAt).ToString("yyyy-MM-dd")]
                            </span>
                        }
                        else if (s.LastUploadAt.HasValue)
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" data-testid="structure-takeover" @onclick="() => pendingTakeover = s">@L["Takeover_Button"]</button>
                        }
                        @if (ppDepotCounts.GetValueOrDefault(s.Id, 0) > 0)
                        {
                            <a class="btn btn-sm btn-outline-secondary me-1" href="@($"/sources/{s.Id}/portfolios")" data-testid="source-portfolio-accounts">@L["Button_PortfolioAccounts"]</a>
                            <a class="btn btn-sm btn-outline-secondary me-1" href="@($"/sources/{s.Id}/depots")">@L["Button_Depots"]</a>
                            <a class="btn btn-sm btn-outline-secondary me-1" href="@($"/sources/{s.Id}/instruments")">@L["Button_Instruments"]</a>
                            <a class="btn btn-sm btn-outline-secondary me-1" href="@($"/sources/{s.Id}/tax")">@L["Button_Tax"]</a>
                        }
                        @if (projectCounts.GetValueOrDefault(s.Id, 0) == 0 && s.Id != SourceScope.LegacySourceId)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(s)">@L["Button_Delete"]</button>
                        }
                        else
                        {
                            <span class="text-body-secondary small">@L["InUse"]</span>
                        }
                        </div>
                    </td>
                </tr>
                @if (revealed.Contains(s.Id))
                {
                    <tr class="table-light" data-source-token-row="@s.Name">
                        <td colspan="8">
                            <div class="small text-body-secondary mb-1">@L["Token_Label"]</div>
                            <code class="user-select-all" data-source-token="@s.Name">@s.UploadToken</code>
                            <div class="small text-body-secondary mt-2">
                                @L["Token_Usage_Before"]<code>Authorization: Bearer &lt;token&gt;</code>@L["Token_Usage_After"]
                            </div>
                            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => pendingRotate = s">@L["Token_Rotate"]</button>
                        </td>
                    </tr>
                }
                </tbody>
            }
    </table>
    </div>
}

@foreach (var st in switchStates.Where(x => x.Links.Count > 0 || x.ImportFinishedAt != null || sources?.Any(s => s.Id == x.SourceId && s.LastUploadAt != null) == true))
{
    var pending = st.Links.Where(l => !l.Switched).ToList();
    <div class="card mb-3" data-source-switch="@st.SourceName">
        <div class="card-body">
            <h2 class="h6 card-title">@L["Switch_Heading", st.SourceName]</h2>
            <p class="small mb-2" data-testid="switch-progress">@L["Switch_Progress", st.Links.Count - pending.Count, st.Links.Count]
                @if (st.MoneyMoneyAccountsWithoutLink > 0)
                {
                    <span class="text-body-secondary"> @L["Switch_Unlinked", st.MoneyMoneyAccountsWithoutLink]</span>
                }
            </p>
            @if (pending.Count > 0)
            {
                <button class="btn btn-sm btn-primary me-2" data-testid="switch-all" @onclick="() => switchIds = pending.Select(l => l.LoginAccountId).ToList()">@L["Switch_All", pending.Count]</button>
            }
            @if (st.ImportFinishedAt is { } finishedAt)
            {
                <span class="badge text-bg-secondary me-2" data-testid="import-finished">@L["Finished_Badge", Clock.ToLocal(finishedAt).ToString("yyyy-MM-dd")]</span>
                <span class="small text-body-secondary me-2">@L["Finished_Hint"]</span>
                <button class="btn btn-sm btn-outline-secondary" data-testid="import-resume" @onclick="() => SetFinishedAsync(st.SourceId, false)">@L["Finished_Resume"]</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" data-testid="import-finish" @onclick="() => pendingFinish = st">@L["Finished_Button"]</button>
            }
        </div>
    </div>
}

<AccountSwitchDialog LoginAccountIds="switchIds" OnClose="() => switchIds = null" OnSwitched="SwitchedAsync" />

<Modal Show="@(pendingFinish != null)" Title="@(pendingFinish != null ? L["Finished_Title", pendingFinish.SourceName].Value : "")" OnClose="@(() => pendingFinish = null)">
    <ChildContent>
        <p>@L["Finished_Body"]</p>
        @if (pendingFinish is { } pf && (pf.Links.Any(l => !l.Switched) || pf.MoneyMoneyAccountsWithoutLink > 0))
        {
            <div class="alert alert-warning small" data-testid="finish-warning">
                @L["Finished_Warning", pf.Links.Count(l => !l.Switched), pf.MoneyMoneyAccountsWithoutLink]
            </div>
        }
        <p class="small text-body-secondary mb-0">@L["Finished_Reversible"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingFinish = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" data-testid="import-finish-confirm" @onclick="FinishConfirmedAsync">@L["Finished_Button"]</button>
    </Footer>
</Modal>

<OneDriveSettings />

<Modal Show="@(pendingTakeover != null)"
       Title="@(pendingTakeover != null ? L["Takeover_Title", pendingTakeover.Name].Value : "")"
       OnClose="@(() => pendingTakeover = null)">
    <ChildContent>
        <p>@L["Takeover_Body"]</p>
        <p class="small text-body-secondary mb-0">@L["Takeover_Body2"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingTakeover = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-primary" data-testid="structure-takeover-confirm" @onclick="TakeoverConfirmed">@L["Takeover_Confirm"]</button>
    </Footer>
</Modal>

<Modal Show="@(pendingRotate != null)"
       Title="@(pendingRotate != null ? L["Rotate_Title", pendingRotate.Name].Value : "")"
       OnClose="@(() => pendingRotate = null)">
    <ChildContent>
        <p>@L["Rotate_Body"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingRotate = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" @onclick="RotateConfirmed">@L["Token_Rotate"]</button>
    </Footer>
</Modal>

<Modal Show="@(pendingDelete != null)"
       Title="@(pendingDelete != null ? L["Modal_Title", pendingDelete.Name].Value : "")"
       OnClose="@(() => pendingDelete = null)">
    <ChildContent>
        <p>@L["Modal_Body"]</p>
        <p class="text-danger">@L["Modal_BodyWarning"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingDelete = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteConfirmed">@L["Button_Delete"]</button>
    </Footer>
</Modal>

</SettingsShell>

@code {
    private List<ImportSource>? sources;
    private Dictionary<int, int> projectCounts = new();
    private Dictionary<int, int> transactionCounts = new();
    private Dictionary<int, int> documentCounts = new();
    private Dictionary<int, int> ppDepotCounts = new();
    private ImportSource? pendingDelete;
    private ImportSource? pendingRotate;
    private ImportSource? pendingTakeover;
    private List<SourceSwitchState> switchStates = new();
    private IReadOnlyList<int>? switchIds;
    private SourceSwitchState? pendingFinish;

    private async Task SwitchedAsync(int count)
    {
        switchIds = null;
        await LoadAsync();
    }

    private async Task FinishConfirmedAsync()
    {
        if (pendingFinish is not { } st) return;
        pendingFinish = null;
        await SetFinishedAsync(st.SourceId, true);
    }

    private async Task SetFinishedAsync(int sourceId, bool finished)
    {
        await Switcher.SetImportFinishedAsync(sourceId, finished);
        await LoadAsync();
    }
    private readonly HashSet<int> revealed = new();
    private string newSourceName = "";
    private string? createError;

    private void ToggleToken(int sourceId)
    {
        if (!revealed.Remove(sourceId)) revealed.Add(sourceId);
    }

    private async Task CreateSourceAsync()
    {
        createError = null;
        try
        {
            var created = await SourceService.CreateSourceAsync(newSourceName);
            newSourceName = "";
            revealed.Add(created.Id);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or AccessDeniedException)
        {
            createError = ex.Message;
        }
    }

    private async Task TakeoverConfirmed()
    {
        if (pendingTakeover == null) return;
        var id = pendingTakeover.Id;
        pendingTakeover = null;
        await Takeover.TakeOverAsync(id);
        await LoadAsync();
    }

    private async Task RotateConfirmed()
    {
        if (pendingRotate == null) return;
        var id = pendingRotate.Id;
        pendingRotate = null;
        await SourceService.RotateTokenAsync(id);
        revealed.Add(id);
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // Source registrations, imports, and project counts all show on this page.
    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.Sources or DataArea.ImportedData or DataArea.Projects or DataArea.BankSync;
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        sources = await SourceService.GetOwnedSourcesAsync(ensureTokens: true);
        var states = new List<SourceSwitchState>();
        foreach (var s in sources)
            states.Add(await Switcher.GetSourceStateAsync(s.Id));
        switchStates = states;
        await using var db = await DbFactory.CreateDbContextAsync();
        projectCounts = await db.Projects
            .GroupBy(p => p.SourceId)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
        transactionCounts = await db.Transactions
            .GroupBy(t => t.SourceId)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
        // Documents the source's uploads imported (MoneyMoney's stored statements).
        documentCounts = await db.BankStatements
            .Where(s => s.SourceId != null && s.BankLoginId == null)
            .GroupBy(s => s.SourceId!.Value)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
        ppDepotCounts = await db.PpPortfolios
            .GroupBy(p => p.SourceId)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
    }

    private void ConfirmDelete(ImportSource s)
    {
        pendingDelete = s;
    }

    private async Task DeleteConfirmed()
    {
        if (pendingDelete == null) return;
        var sourceId = pendingDelete.Id;
        pendingDelete = null;
        // Owner-only; refused (false) while projects still use the source. The UI doesn't offer the
        // button in that case, but guard anyway.
        await SourceService.DeleteSourceAsync(sourceId);
        await LoadAsync();
    }
}
