@page "/sources"
@inherits DataChangeAwareComponent
@using OpenBudget.Models
@using OpenBudget.Services
@inject BudgetService BudgetService
@inject ProjectService ProjectService
@inject IDbContextFactory<BudgetDbContext> DbFactory
@inject ChangeNotificationService Notifier
@inject IStringLocalizer<Sources> L
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle"]</PageTitle>

<PageHeader Title="@L["Heading"]" />

<p class="text-body-secondary">
    @L["Intro_Before"]<code>POST /api/moneymoney-db/{name}</code>@L["Intro_After"]
</p>

@if (sources == null)
{
    <div aria-busy="true" aria-label="@L["Status_Loading"]">
        <div class="skeleton skeleton-line mb-2" style="width: 70%;"></div>
        <div class="skeleton skeleton-line mb-2" style="width: 50%;"></div>
        <div class="skeleton skeleton-line" style="width: 60%;"></div>
    </div>
}
else if (!sources.Any())
{
    <div class="alert alert-info">@L["Empty"]</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>@L["Table_Name"]</th>
                <th>@L["Table_Created"]</th>
                <th>@L["Table_LastUpload"]</th>
                <th class="text-end">@L["Table_Projects"]</th>
                <th class="text-end">@L["Table_Transactions"]</th>
                <th class="text-end">@L["Table_Bytes"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in sources)
            {
                <tr>
                    <td><strong>@s.Name</strong></td>
                    <td><span title="@s.CreatedAt.ToString("u")">@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span></td>
                    <td>
                        @if (s.LastUploadAt.HasValue)
                        {
                            <span title="@s.LastUploadAt.Value.ToString("u")">@s.LastUploadAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">@L["Never"]</span>
                        }
                    </td>
                    <td class="text-end">@projectCounts.GetValueOrDefault(s.Id, 0)</td>
                    <td class="text-end">@transactionCounts.GetValueOrDefault(s.Id, 0).ToString("N0")</td>
                    <td class="text-end">@(s.LastUploadSizeBytes.HasValue ? s.LastUploadSizeBytes.Value.ToString("N0") : "—")</td>
                    <td class="text-end">
                        @if (projectCounts.GetValueOrDefault(s.Id, 0) == 0 && s.Id != SourceScope.LegacySourceId)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(s)">@L["Button_Delete"]</button>
                        }
                        else
                        {
                            <span class="text-body-secondary small">@L["InUse"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<Modal Show="@(pendingDelete != null)"
       Title="@(pendingDelete != null ? L["Modal_Title", pendingDelete.Name].Value : "")"
       OnClose="@(() => pendingDelete = null)">
    <ChildContent>
        <p>@L["Modal_Body"]</p>
        <p class="text-danger">@L["Modal_BodyWarning"]</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pendingDelete = null">@L["Button_Cancel"]</button>
        <button type="button" class="btn btn-danger" @onclick="DeleteConfirmed">@L["Button_Delete"]</button>
    </Footer>
</Modal>

@code {
    private List<ImportSource>? sources;
    private Dictionary<int, int> projectCounts = new();
    private Dictionary<int, int> transactionCounts = new();
    private ImportSource? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // Source registrations, imports, and project counts all show on this page.
    protected override bool IsRelevantChange(DataChange change) =>
        change.Area is DataArea.Sources or DataArea.MoneyMoneyData or DataArea.Projects;
    protected override Task ReloadAfterChangeAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        sources = await ProjectService.GetAllSourcesAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        projectCounts = await db.Projects
            .GroupBy(p => p.SourceId)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
        transactionCounts = await db.Transactions
            .GroupBy(t => t.SourceId)
            .Select(g => new { SourceId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.SourceId, x => x.Count);
    }

    private void ConfirmDelete(ImportSource s)
    {
        pendingDelete = s;
    }

    private async Task DeleteConfirmed()
    {
        if (pendingDelete == null) return;
        var sourceId = pendingDelete.Id;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Projects.AnyAsync(p => p.SourceId == sourceId))
        {
            // UI shouldn't even offer the button in this case, but guard anyway.
            pendingDelete = null;
            return;
        }
        await db.Database.ExecuteSqlRawAsync("DELETE FROM mm_transactions WHERE SourceId = {0}", new object[] { sourceId });
        await db.Database.ExecuteSqlRawAsync("DELETE FROM mm_categories WHERE SourceId = {0}", new object[] { sourceId });
        await db.Database.ExecuteSqlRawAsync("DELETE FROM mm_category_groups WHERE SourceId = {0}", new object[] { sourceId });
        await db.Database.ExecuteSqlRawAsync("DELETE FROM mm_accounts WHERE SourceId = {0}", new object[] { sourceId });
        db.ImportSources.Remove(pendingDelete);
        await db.SaveChangesAsync();
        var deletedId = sourceId;
        pendingDelete = null;
        Notifier.Publish(new DataChange(DataArea.Sources, SourceId: deletedId));
        Notifier.Publish(new DataChange(DataArea.MoneyMoneyData, SourceId: deletedId));
        await LoadAsync();
    }
}
