@inject OpenBudget.Services.ClockService Clock

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AccessRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFoundMessage />
        </LayoutView>
    </NotFound>
</Router>

@code {
    // The browser's IANA timezone, captured into the `tz` cookie by wwwroot/js/timezone.js and
    // forwarded here from _Host.cshtml. Seeding it on the root component means ClockService is
    // already correct before any page's OnInitialized runs.
    [Parameter] public string? TimeZoneId { get; set; }

    protected override void OnInitialized() => Clock.SetZone(TimeZoneId);
}
