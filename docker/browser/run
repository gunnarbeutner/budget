#!/bin/bash
set -eu
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.25; done
# Inherit the display selected by the upstream supervisor without printing credentials.
. "${XDG_RUNTIME_DIR}/container-env"
export DISPLAY="${DISPLAY:-:20}"
until xdpyinfo -display "${DISPLAY}" >/dev/null 2>&1; do sleep 0.25; done
exec /usr/local/bin/browser-launcher
